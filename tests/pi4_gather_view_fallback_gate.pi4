; Pinned Gather fallback: 24 noncontiguous and multiple-index cases.
; CC000000..CDFFFFFF arena; no neural model assets.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"


Global MoveIdle.i,MoveFault.i,ViewNegativeAxis.i
Procedure MoveService()
 If PmKernelCore() : MoveFault+1 : Else : MoveIdle+1 : EndIf
EndProcedure
Procedure.i EqualTensor(a.i,b.i)
 Protected i.i
 If Dt(a)\Rank<>Dt(b)\Rank Or Dt(a)\Kind<>Dt(b)\Kind Or Dt(a)\Count<>Dt(b)\Count Or Dt(a)\Bytes<>Dt(b)\Bytes : ProcedureReturn 0 : EndIf
 For i=0 To Dt(a)\Rank-1 : If DDims(a*8+i)<>DDims(b*8+i) : ProcedureReturn 0 : EndIf : Next
 For i=0 To Dt(a)\Bytes-1 : If PeekA(Dt(a)\Data+i)<>PeekA(Dt(b)\Data+i) : ProcedureReturn 0 : EndIf : Next
 ProcedureReturn 1
EndProcedure
Procedure.i GatherCase(kind.i,shape.i,idx.i,ir.i,borrowed.i,guard.i)
 Protected Dim dims.i(8),Dim idims.i(8)
 Protected rank.i=3,i.i,refused.i,rc.i,base.i,owned.i,taken.i,normalized.i,selectedOffset.i,axis.i
 dims(0)=2 : dims(1)=3 : dims(2)=7
 Select shape
 Case 1 : dims(1)=4 : dims(2)=16
 Case 2 : dims(0)=3 : dims(1)=5 : dims(2)=0
 Case 3 : dims(0)=1 : dims(1)=0 : dims(2)=3
 Case 4 : dims(0)=0 : dims(1)=2 : dims(2)=3
 Case 5 : rank=1
 Case 6 : rank=4 : dims(1)=3 : dims(2)=5 : dims(3)=16
 EndSelect
 DError=0 : DCancel=0 : PmTensorInt64Ok=1
 If DAlloc(1,kind,rank,@dims(0))=0 Or DAlloc(4,kind,rank,@dims(0))=0 : ProcedureReturn 10 : EndIf
 For i=0 To Dt(1)\Bytes-1 : PokeA(Dt(1)\Data+i,(i*73+31) & 255) : PokeA(Dt(4)\Data+i,(i*73+31) & 255) : Next
 If borrowed
  For i=0 To Dt(4)\Bytes-1 : PokeA($CE000100+i,(i*73+31) & 255) : Next
  DRelease(4)
  If DBindMutableState(4,kind,rank,@dims(0),$CE000100,$100000)=0 : ProcedureReturn 11 : EndIf
 EndIf
 base=Dt(4)\Data : owned=Dt(4)\Owned
 idims(0)=1 : If DAlloc(2,7,ir,@idims(0))=0 : ProcedureReturn 12 : EndIf
 PokeI(Dt(2)\Data,idx)
 If guard=1 : DFail("Existing test failure.") : EndIf
 If guard=2 : DCancel=1 : EndIf
 axis=0 : If ViewNegativeAxis : axis=-rank : EndIf
 DGather(3,1,2,axis) : refused=Bool(DError<>0)
 DError=0 : If guard=1 : DFail("Existing test failure.") : EndIf
 DGatherView(5,4,2,axis)
 If Bool(DError<>0)<>refused : rc=20 : EndIf
 If refused=0
  If EqualTensor(3,5)=0 : rc=21 : EndIf
  normalized=idx : If normalized<0 : normalized+dims(0) : EndIf
  selectedOffset=normalized*Dt(3)\Bytes
  If Dt(4)\Owned<>owned Or DMutable(4)<>borrowed Or Dt(5)\Owned Or DMutable(5) Or Dt(5)\Data<>base+selectedOffset : rc=22 : EndIf
  If DConsumeShape(6,5,Dt(5)\Rank,@DDims(5*8))<>0 Or DError : rc=23 : EndIf
  idims(0)=Dt(5)\Rank
  If DAlloc(7,7,1,@idims(0))=0 : rc=24 : EndIf
  For i=0 To Dt(5)\Rank-1 : PokeI(Dt(7)\Data+i*8,DDims(5*8+i)) : Next
  DReshapeConsume(6,5,7,0)
  If DError Or EqualTensor(3,6)=0 Or Dt(6)\Owned<>1 : rc=25 : EndIf
  For i=0 To Dt(4)\Bytes-1 : If (PeekA(Dt(4)\Data+i) & 255)<>((i*73+31) & 255) : rc=26 : Break : EndIf : Next
  DRelease(5) : DRelease(6)
  For i=0 To Dt(4)\Bytes-1 : If (PeekA(Dt(4)\Data+i) & 255)<>((i*73+31) & 255) : rc=27 : Break : EndIf : Next

 EndIf
 DError=0 : DCancel=0
 For i=1 To 8 : DRelease(i) : Next
 If DLive Or DHeapUsed : rc=29 : EndIf
 ProcedureReturn rc
EndProcedure

Procedure.i FallbackCase(kind.i,mode.i)
 Protected Dim dims.i(8),Dim ids.i(8)
 Protected axis.i=1,ir.i=0,i.i,rc.i
 dims(0)=2 : dims(1)=3 : dims(2)=4 : ids(0)=2
 If mode=0 : axis=0 : ir=1 : EndIf
 If mode=2 : ir=1 : EndIf
 If mode=3 : axis=-2 : ir=1 : EndIf
 DError=0 : DCancel=0
 If DAlloc(1,kind,3,@dims(0))=0 Or DAlloc(2,7,ir,@ids(0))=0 : ProcedureReturn 10 : EndIf
 For i=0 To Dt(1)\Bytes-1 : PokeA(Dt(1)\Data+i,(i*31+73) & 255) : Next
 PokeI(Dt(2)\Data,0) : If ir : PokeI(Dt(2)\Data+8,1) : EndIf
 DGather(3,1,2,axis) : DGatherView(5,1,2,axis)
 If DError Or EqualTensor(3,5)=0 Or Dt(5)\Owned<>1 Or DMutable(5) : rc=20 : EndIf
 For i=0 To Dt(1)\Bytes-1 : If (PeekA(Dt(1)\Data+i) & 255)<>((i*31+73) & 255) : rc=21 : EndIf : Next
 For i=1 To 5 : DRelease(i) : Next
 If DLive Or DHeapUsed : rc=22 : EndIf
 ProcedureReturn rc
EndProcedure
Procedure.i Main(services.i)
 Protected Dim kinds.i(6)
 Protected k.i,mode.i,rc.i,cases.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6) : DZero($E1C00000,8192) : PmTensorInt64Ok=1
 If DHeapBind($CC000000,$2000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 kinds(0)=1 : kinds(1)=2 : kinds(2)=3 : kinds(3)=6 : kinds(4)=7 : kinds(5)=9
 For k=0 To 5
 For mode=0 To 3
  rc=FallbackCase(kinds(k),mode) : cases+1 : If *pet : pet() : EndIf
  If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next
 PokeI($E1C01FD0,cases)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
