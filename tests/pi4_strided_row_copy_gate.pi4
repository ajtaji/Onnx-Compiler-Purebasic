; Exact strided row copies through Gather and Concat.
; Independent previous implementations preserve output and refusal behavior.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"

Procedure OldDGather(Y.i,A.i,Indices.i,Axis.i)
  Protected Dim dims.i(8)
  Protected rank.i=Dt(A)\Rank+Dt(Indices)\Rank-1
  Protected i.i=0
  Protected j.i=0
  Protected k.i=0
  Protected p.i=0
  Protected idx.i=0
  Protected inner.i=0
  Protected outer.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Axis<0
    Axis+Dt(A)\Rank
  EndIf
  If rank>8 Or Axis<0 Or Axis>=Dt(A)\Rank
    DFail("Invalid Gather rank or axis.")
    ProcedureReturn
  EndIf
  For i=0 To Axis-1
    dims(p)=DDims((A)*8+(i))
    p+1
  Next
  For i=0 To Dt(Indices)\Rank-1
    dims(p)=DDims((Indices)*8+(i))
    p+1
  Next
  For i=Axis+1 To Dt(A)\Rank-1
    dims(p)=DDims((A)*8+(i))
    p+1
  Next
  If DAlloc(Y,Dt(A)\Kind,rank,@dims(0))=0
    ProcedureReturn
  EndIf
  inner=DProduct(A,Axis+1,Dt(A)\Rank-1)
  outer=DProduct(A,0,Axis-1)
  For i=0 To outer-1
    For j=0 To Dt(Indices)\Count-1
      idx=DInt(Indices,j)
      If idx<0
        idx+DDims((A)*8+(Axis))
      EndIf
      If idx<0 Or idx>=DDims((A)*8+(Axis))
        DFail("Gather index is out of bounds.")
        ProcedureReturn
      EndIf
      DCopy(Dt(A)\Data+(i*DDims((A)*8+(Axis))+idx)*inner*size,Dt(Y)\Data+(i*Dt(Indices)\Count+j)*inner*size,inner*size)
    Next
  Next
EndProcedure
Procedure OldDScatter(Y.i,A.i,Indices.i,Updates.i)
  Protected k.i=0
  Protected i.i=0
  Protected j.i=0
  Protected offset.i=0
  Protected idx.i=0
  Protected block.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  Protected tuples.i=0
  If Dt(Indices)\Rank<1
    DFail("ScatterND indices need a tuple axis.")
    ProcedureReturn
  EndIf
  k=DDims((Indices)*8+(Dt(Indices)\Rank-1))
  If k<=0 Or k>Dt(A)\Rank
    DFail("Invalid ScatterND tuple width.")
    ProcedureReturn
  EndIf
  block=DProduct(A,k,Dt(A)\Rank-1)
  tuples=Dt(Indices)\Count/k
  If Dt(Updates)\Count<>tuples*block
    DFail("ScatterND update count mismatch.")
    ProcedureReturn
  EndIf
  If DLike(Y,A,0)=0
    ProcedureReturn
  EndIf
  DCopy(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Bytes)
  For i=0 To tuples-1
    offset=0
    For j=0 To k-1
      idx=DInt(Indices,i*k+j)
      If idx<0
        idx+DDims((A)*8+(j))
      EndIf
      If idx<0 Or idx>=DDims((A)*8+(j))
        DFail("ScatterND index is out of bounds.")
        ProcedureReturn
      EndIf
      offset=offset*DDims((A)*8+(j))+idx
    Next
    DCopy(Dt(Updates)\Data+i*block*size,Dt(Y)\Data+offset*block*size,block*size)
  Next
EndProcedure
Procedure.i GatherCase(rank.i,axis.i,kind.i,ishape.i,pattern.i,empty.i)
 Protected Dim ds.i(8)
 Protected Dim ix.i(8)
 Protected i.i,j.i,n.i,extent.i,err.i,expected.i
 For i=0 To rank-1 : ds(i)=2+i % 3 : Next
 If empty=1 And axis>0 : ds(0)=0 : EndIf
 If empty=2 And axis<rank-1 : ds(rank-1)=0 : EndIf
 If DAlloc(1,kind,rank,@ds(0))=0 : ProcedureReturn 1 : EndIf
 For i=0 To Dt(1)\Bytes-1 : PokeA(Dt(1)\Data+i,(i*37+19) & 255) : Next
 n=6 : ix(0)=n
 If ishape=0 : n=1 : EndIf
 If ishape=2 : ix(0)=2 : ix(1)=3 : EndIf
 If ishape=3 : ix(0)=0 : n=0 : EndIf
 j=1 : If ishape=0 : j=0 : EndIf
 If ishape=2 : j=2 : EndIf
 If DAlloc(2,7,j,@ix(0))=0 : ProcedureReturn 2 : EndIf
 extent=ds(axis)
 For i=0 To n-1
  j=i % extent
  If pattern=1 : j=extent-1-j : EndIf
  If pattern=2 : j=0 : EndIf
  If pattern=3 : j=j-extent : EndIf
  If pattern=4 And i=n-1 : j=extent : EndIf
  PokeI(Dt(2)\Data+i*8,j)
 Next
 DError=0 : OldDGather(4,1,2,axis) : expected=DError
 DError=0 : DGather(5,1,2,axis) : err=DError
 If Bool(err<>0)<>Bool(expected<>0) : ProcedureReturn 3 : EndIf
 If err=0
  If Dt(4)\Kind<>Dt(5)\Kind Or Dt(4)\Rank<>Dt(5)\Rank Or Dt(4)\Bytes<>Dt(5)\Bytes : ProcedureReturn 4 : EndIf
  For i=0 To Dt(4)\Rank-1
   If DDims(4*8+i)<>DDims(5*8+i) : ProcedureReturn 5 : EndIf
  Next
  For i=0 To Dt(4)\Bytes-1
   If PeekA(Dt(4)\Data+i)<>PeekA(Dt(5)\Data+i) : ProcedureReturn 6 : EndIf
  Next
 EndIf
 For i=1 To 5 : DRelease(i) : Next
 DError=0
 If DLive<>0 : ProcedureReturn 7 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i ScatterCase(kind.i,pattern.i)
 Protected Dim ds.i(8)
 Protected Dim ix.i(8)
 Protected i.i,expected.i,err.i
 ds(0)=4 : ds(1)=3 : ds(2)=2
 If DAlloc(1,kind,3,@ds(0))=0 : ProcedureReturn 11 : EndIf
 For i=0 To Dt(1)\Bytes-1 : PokeA(Dt(1)\Data+i,(i*17+9) & 255) : Next
 ix(0)=3 : ix(1)=2
 If pattern=3 : ix(0)=0 : EndIf
 If DAlloc(2,7,2,@ix(0))=0 : ProcedureReturn 12 : EndIf
 For i=0 To ix(0)-1
  PokeI(Dt(2)\Data+i*16,i) : PokeI(Dt(2)\Data+i*16+8,i)
  If pattern=1 : PokeI(Dt(2)\Data+i*16,-1) : PokeI(Dt(2)\Data+i*16+8,-1) : EndIf
  If pattern=2 And i=2 : PokeI(Dt(2)\Data+i*16,4) : EndIf
 Next
 ds(0)=ix(0) : ds(1)=2
 If DAlloc(3,kind,2,@ds(0))=0 : ProcedureReturn 13 : EndIf
 For i=0 To Dt(3)\Bytes-1 : PokeA(Dt(3)\Data+i,(i*11+93) & 255) : Next
 DError=0 : OldDScatter(4,1,2,3) : expected=DError
 DError=0 : DScatter(5,1,2,3) : err=DError
 If Bool(err<>0)<>Bool(expected<>0) : ProcedureReturn 14 : EndIf
 If err=0
  For i=0 To Dt(4)\Bytes-1
   If PeekA(Dt(4)\Data+i)<>PeekA(Dt(5)\Data+i) : ProcedureReturn 15 : EndIf
  Next
 EndIf
 For i=1 To 5 : DRelease(i) : Next
 DError=0
 If DLive<>0 : ProcedureReturn 16 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure OldDConcat(Y.i,Inputs.i,Axis.i)
  Protected Dim dims.i(8)
  Protected count.i=DListCount(Inputs)
  Protected a.i=DListValue(Inputs,1)
  Protected i.i=0
  Protected j.i=0
  Protected outer.i=0
  Protected inner.i=0
  Protected offset.i=0
  Protected span.i=0
  Protected size.i=DSize(Dt(a)\Kind)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Axis<0
    Axis+Dt(a)\Rank
  EndIf
  If Axis<0 Or Axis>=Dt(a)\Rank
    DFail("Invalid Concat axis.")
    ProcedureReturn
  EndIf
  For i=0 To Dt(a)\Rank-1
    dims(i)=DDims((a)*8+(i))
  Next
  dims(Axis)=0
  For i=1 To count
    a=DListValue(Inputs,i)
    If Dt(a)\Rank<>Dt(DListValue(Inputs,1))\Rank Or DSize(Dt(a)\Kind)<>size
      DFail("Concat rank/type mismatch.")
      ProcedureReturn
    EndIf
    For j=0 To Dt(a)\Rank-1
      If j<>Axis And DDims((a)*8+(j))<>dims(j)
        DFail("Concat non-axis extent mismatch.")
        ProcedureReturn
      EndIf
    Next
    dims(Axis)=dims(Axis)+DDims((a)*8+(Axis))
  Next
  If DAlloc(Y,Dt(a)\Kind,Dt(a)\Rank,@dims(0))=0
    ProcedureReturn
  EndIf
  outer=DProduct(Y,0,Axis-1)
  inner=DProduct(Y,Axis+1,Dt(Y)\Rank-1)
  For j=0 To outer-1
    offset=j*dims(Axis)*inner
    For i=1 To count
      a=DListValue(Inputs,i)
      span=DDims((a)*8+(Axis))*inner
      DCopy(Dt(a)\Data+j*span*size,Dt(Y)\Data+offset*size,span*size)
      offset+span
    Next
  Next
EndProcedure
Procedure.i CheckConcat(variant.i,kind.i,repeated.i)
 Protected Dim dims.i(8)
 Protected rank.i=2,axis.i=-1,id.i,j.i,n.i,rc.i,oldError.i,newError.i
 Protected inputs.i
 For id=1 To 3
  dims(0)=3 : dims(1)=id
  Select variant
   Case 0 : rank=1 : axis=0 : dims(0)=id-1
   Case 2 : rank=3 : axis=1 : dims(0)=2 : dims(1)=id-1 : dims(2)=5
   Case 3 : rank=4 : axis=2 : dims(0)=2 : dims(1)=3 : dims(2)=id : dims(3)=7
   Case 4 : dims(0)=16384 : dims(1)=id
   Case 5 : rank=3 : axis=1 : dims(0)=0 : dims(1)=id : dims(2)=5
   Case 6 : dims(0)=id : dims(1)=257 : axis=0
   Case 7 : rank=1 : dims(0)=0 : If id=1 : dims(0)=4099 : EndIf : axis=-1
   Case 8 : If id=3 : dims(0)=4 : EndIf
   Case 9 : axis=2
   Case 10 : axis=-3
   Case 11 : dims(0)=1 : dims(1)=1
  EndSelect
  If DAlloc(id,kind,rank,@dims(0))=0 : ProcedureReturn 1 : EndIf
  For j=0 To Dt(id)\Bytes-1 : PokeA(Dt(id)\Data+j,(j*73+id*117) & 255) : Next
 Next
 inputs="1,2,3" : If repeated : inputs="1,2,3,1" : EndIf
 DError=0 : OldDConcat(4,inputs,axis) : oldError=DError
 DError=0 : DConcat(5,inputs,axis) : newError=DError
 If Bool(oldError<>0)<>Bool(newError<>0) : ProcedureReturn 2 : EndIf
 If oldError=0
  If Dt(4)\Rank<>Dt(5)\Rank Or Dt(4)\Kind<>Dt(5)\Kind Or Dt(4)\Count<>Dt(5)\Count Or Dt(4)\Bytes<>Dt(5)\Bytes : ProcedureReturn 3 : EndIf
  For j=0 To Dt(4)\Rank-1 : If DDims(4*8+j)<>DDims(5*8+j) : ProcedureReturn 4 : EndIf : Next
  For j=0 To Dt(4)\Bytes-1 : If PeekA(Dt(4)\Data+j)<>PeekA(Dt(5)\Data+j) : ProcedureReturn j+10 : EndIf : Next
 EndIf
 DError=0
 For id=1 To 5 : DRelease(id) : Next
 If DLive<>0 : ProcedureReturn 5 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i Main(services.i)
 Protected rank.i,axis.i,kind.i,ishape.i,pattern.i,empty.i,rc.i,cases.i,ki.i,*pet,v.i,repeat.i
 Protected Dim kinds.i(4)
 kinds(0)=1 : kinds(1)=6 : kinds(2)=7 : kinds(3)=9
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6)
 DZero($E1C00000,8192) : PmTensorInt64Ok=1 : PokeI($E1C01FF0,PmParallelCores())
 If DHeapBind($EA000000,$1000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 For rank=1 To 5
 For axis=0 To rank-1
 For ki=0 To 3
 For ishape=0 To 3
 For pattern=0 To 4
 For empty=0 To 2
  rc=GatherCase(rank,axis,kinds(ki),ishape,pattern,empty) : cases+1
  If rc : Break : EndIf
  If *pet : pet() : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next
 If rc=0
  For ki=0 To 3
  For v=0 To 11
  For repeat=0 To 1
   rc=CheckConcat(v,kinds(ki),repeat) : cases+1
   If *pet : pet() : EndIf
   If rc : Break : EndIf
  Next : If rc : Break : EndIf
  Next : If rc : Break : EndIf
  Next
 EndIf
 PokeI($E1C01FD0,cases) : PokeI($E1C01FD8,rc) : PokeI($E1C01FE0,DLive)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
