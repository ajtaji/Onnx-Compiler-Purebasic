    fadd v27.4s, v0.4s, v27.4s
    fadd v28.4s, v0.4s, v28.4s
    fadd v29.4s, v0.4s, v29.4s
    fadd v30.4s, v0.4s, v30.4s
    fadd v31.4s, v0.4s, v31.4s
    st1 {v16.4s, v17.4s, v18.4s, v19.4s}, [x5], #64
    st1 {v20.4s, v21.4s, v22.4s, v23.4s}, [x5], #64
    st1 {v24.4s, v25.4s, v26.4s, v27.4s}, [x5], #64
    st1 {v28.4s, v29.4s, v30.4s, v31.4s}, [x5]
pmoI8PackedReferenceDone:
    ldr x8, [x0, #104]
    subs x8, x8, #1
    str x8, [x0, #104]
    b.eq pmoI8PackedReferenceReturn
    ldr x8, [x0, #112]
    ldr x1, [x0]
    add x1, x1, x8
    str x1, [x0]
    ldr x8, [x0, #56]
    ldr x1, [x0, #16]
    add x1, x1, x8, lsl #2
    str x1, [x0, #16]
    ldr x1, [x0, #24]
    add x1, x1, #1
    str x1, [x0, #24]
    ldr x1, [x0, #32]
    add x1, x1, #1
    str x1, [x0, #32]
    ldr x1, [x0, #40]
    add x1, x1, #1
    str x1, [x0, #40]
    ldr x8, [x0, #120]
    ldr x1, [x0, #72]
    add x1, x1, x8
    str x1, [x0, #72]
    str xzr, [x0, #96]
    ldr x8, [x0, #128]
    add x8, x8, #8
    str x8, [x0, #128]
    b pmoI8PackedReferenceBegin
pmoI8PackedReferenceReturn:
    ldp q10, q11, [sp, #32]
    ldp q12, q13, [sp, #64]
    ldp q14, q15, [sp, #96]
    ldp q8, q9, [sp], #128
  EndASM
EndProcedure
Procedure PmI8ConvReferenceRange(*g.PmTensorConv1DArgs, bn.i, ocFirst.i, ocLast.i, tile.i,positionFirst.i,positionLast.i)
  Protected Dim addArgs.i[10]
  Protected Dim addTail.i[32]
  Protected ra.i,rr.i,ii.i
  Protected ta.PmI8TileArgs
  Protected Dim native.i[17]
  Protected word.i
  Protected ea.PmI8EpiArgs
  Protected qp.i
  Protected es.i
  Protected cg.i
  Protected og.i
  Protected q.i
  Protected s.i
  Protected elements.i
  Protected oc.i
  Protected grp.i
  Protected rows.i
  Protected i.i
  Protected r.i
  Protected p0.i
  Protected p.i
  Protected j.i
  Protected c0.i
  Protected cnt.i
  Protected valid.i
  Protected qrow.i
  Protected w0.i
  Protected w1.i
  Protected w2.i
  Protected w3.i
  Protected wlast.i
  Protected qps.i
  Protected ph.i
  qps = PmI8ConvPhase(*g)
  qp = qps * *g\Stride
  es = 1 + *g\Wide
  cg = *g\InChannels / *g\Groups
  og = *g\OutChannels / *g\Groups
  q = PmI8Base()
  s = q + PmI8Align(*g\InChannels * qp * es)
  elements = *g\OutChannels * cg * *g\Kernel
  ta\LStep = qp * es : ta\PStep = *g\Kernel : ta\RowScale = 0 : ta\Kind = *g\Wide
  oc = ocFirst
  While oc < ocLast
    grp = oc / og
    rows = ocLast - oc
    If rows > 4 : rows = 4 : EndIf
    If rows > (grp + 1) * og - oc : rows = (grp + 1) * og - oc : EndIf
    wlast = *g\Weight + (oc + rows - 1) * cg * *g\Kernel
    w0 = *g\Weight + oc * cg * *g\Kernel
    w1 = wlast : If rows > 1 : w1 = w0 + cg * *g\Kernel : EndIf
    w2 = wlast : If rows > 2 : w2 = w1 + cg * *g\Kernel : EndIf
    w3 = wlast : If rows > 3 : w3 = w2 + cg * *g\Kernel : EndIf
    qrow = q + grp * cg * qp * es
    p0 = positionFirst
    While p0 < positionLast
      If (p0 & 255)=0 : PmKernelIdle() : EndIf
      p = 0
      While p <= *g\Wide
        ta\F = tile + p * 256 : ta\Zero = 1
        If *g\Stride=1 And *g\Kernel>1 And *g\Wide=0 And (cg=64 Or cg=128)
          ta\L=qrow+p0*es : ta\P0=w0+p*elements : ta\P1=w1+p*elements
          ta\P2=w2+p*elements : ta\P3=w3+p*elements
          ta\Count=cg : ta\S=s+p0*4
          For word=0 To 12 : native[word]=PeekI(@ta+word*8) : Next
          native[13]=*g\Kernel : native[14]=*g\Dilation*es : native[15]=*g\Dilation*4
          If PmConvFourWeight=*g\Weight And *g\Groups=1 And (oc & 3)=0
            native[16]=PmConvFourMaskBase+(oc/4)* *g\Kernel*8
            If PmConvPackedWeight=*g\Weight
              native[2]=PmConvPackedBase+(oc/4)* *g\Kernel*cg*4
              PmI8PackedReferenceA64(@native[0])
            Else
              PmI8FourTapsA64(@native[0])
            EndIf
          Else
            PmI8AllTapsA64(@native[0])
          EndIf
        Else
        j = 0
        While j < *g\Kernel
          c0 = 0
          While c0 < cg
            cnt = cg - c0
            If *g\Wide <> 0 And cnt > 512 : cnt = 512 : EndIf
            ph = ((j * *g\Dilation) % *g\Stride) * qps + p0 + (j * *g\Dilation) / *g\Stride
            ta\L = qrow + (c0 * qp + ph) * es
            ta\P0 = w0 + p * elements + c0 * *g\Kernel + j
            ta\P1 = w1 + p * elements + c0 * *g\Kernel + j
            ta\P2 = w2 + p * elements + c0 * *g\Kernel + j
            ta\P3 = w3 + p * elements + c0 * *g\Kernel + j
            ta\Count = cnt : ta\S = s + ph * 4
            PmI8TileNeon(@ta)
            ta\Zero = 0
            c0 = c0 + cnt
          Wend
          j = j + 1
        Wend
        EndIf
        p = p + 1
      Wend
      ea\F1 = tile : ea\F2 = 0 : If *g\Wide <> 0 : ea\F2 = tile + 256 : EndIf
      ea\WS = *g\WeightScales + oc * 4
      ea\Bias = 0 : If *g\Bias <> 0 : ea\Bias = *g\Bias + oc * 4 : EndIf
      ea\Rows = rows : ea\LaneScale = 0
      valid = *g\OutWidth - p0
      If valid >= 16
        ea\Dst = *g\Dst + ((bn * *g\OutChannels + oc) * *g\OutWidth + p0) * 4
        ea\DStride = *g\OutWidth * 4
        If PmConvAddBase<>0
          For word=0 To 7 : addArgs[word]=PeekI(@ea+word*8) : Next
          addArgs[8]=PmConvAddBase+((bn* *g\OutChannels+oc)* *g\OutWidth+p0)*4 : addArgs[9]=PmConvAddOrder
          PmI8EpiAddNeon(@addArgs[0])
        Else
          PmI8EpiNeon(@ea)
        EndIf
      Else
        ea\Dst = tile + 512 : ea\DStride = 64
        If PmConvAddBase<>0
          For word=0 To 31 : addTail[word]=0 : Next
          For rr=0 To rows-1
            ra=PmConvAddBase+((bn* *g\OutChannels+oc+rr)* *g\OutWidth+p0)*4
            For ii=0 To valid-1 : PokeL(@addTail[0]+rr*64+ii*4,PeekL(ra+ii*4)) : Next
          Next
          For word=0 To 7 : addArgs[word]=PeekI(@ea+word*8) : Next
          addArgs[8]=@addTail[0] : addArgs[9]=PmConvAddOrder
          PmI8EpiAddNeon(@addArgs[0])
        Else
          PmI8EpiNeon(@ea)
        EndIf
        r = 0
        While r < rows
          i = 0
          While i < valid
            PokeL(*g\Dst + ((bn * *g\OutChannels + oc + r) * *g\OutWidth + p0 + i) * 4, PeekL(tile + 512 + (r * 16 + i) * 4))
            i = i + 1
          Wend
          r = r + 1
        Wend
      EndIf
      p0 = p0 + 16
    Wend
    oc = oc + rows
  Wend
EndProcedure
Global *gatePet
Procedure.i QuantClock()
 ASM
  mrs x0, cntpct_el0
 EndASM
EndProcedure
Procedure.i GateRun(services.i)
 Protected g.PmTensorConv1DArgs,c.i,i.i,bad.i,start.i,old.i,fast.i,bytes.i,used.i,ok1.i,ok2.i,outputBytes.i
 If PmSetAnvilServices(services)=0 : ProcedureReturn 1 : EndIf
 *gatePet=pmAnvilSlot(6)
 If PmParallelCores()<>4 : ProcedureReturn 2 : EndIf
 For c=0 To 35
  gatePet()
  g\Src=$43000000 : g\Batches=1 : g\InChannels=64 : g\OutChannels=64
  g\Kernel=11 : g\Dilation=1 : g\Stride=1 : g\PadLeft=5 : g\Groups=1 : g\Wide=c & 1
  g\InWidth=520
  If c % 6=0 : g\InWidth=129 : g\InChannels=128 : EndIf
  If c % 6=1 : g\InWidth=513 : g\InChannels=128 : EndIf
  If c % 6=2 : g\InWidth=3121 : EndIf
  If c % 6=3 : g\InWidth=65 : g\InChannels=256 : EndIf
  If c % 6=4 : g\Stride=3 : EndIf
  If c % 6=5 : g\Stride=10 : g\PadLeft=7 : EndIf
  g\OutWidth=(g\InWidth+g\PadLeft*2-g\Kernel)/g\Stride+1
  For i=0 To g\InWidth*g\InChannels-1
   PmTensorPut(g\Src,i,((i*1337) % 997-498)/123.0)
   If i % 41=0 : PokeL(g\Src+i*4,$80000000) : EndIf
   If i % 29=0 : PokeL(g\Src+i*4,1) : EndIf
   If i % 43=0 : PokeL(g\Src+i*4,$0DA24260) : EndIf
  Next
  If c=35 : PokeL(g\Src+(g\InWidth-1)*4,$7FC00342) : EndIf

  g\Weight=$43100000 : g\WeightScales=$431F0000 : g\Bias=$431F1000
  For i=0 To g\OutChannels*g\InChannels*g\Kernel*(1+g\Wide)-1
   PokeA(g\Weight+i,(i*19) % 256-128)
   If c<6 : PokeA(g\Weight+i,(i*19) % 65-32) : EndIf
   If c>=6 And c<18
    If ((i/g\Kernel) % 8)=7
     PokeA(g\Weight+i,34+Bool(c>=12))
    Else
     PokeA(g\Weight+i,32)
    EndIf
   EndIf
  Next
  For i=0 To g\OutChannels-1
   PmTensorPut(g\WeightScales,i,0.0003+i/1000000.0)
   PmTensorPut(g\Bias,i,(i-31)/97.0)
  Next
  outputBytes=g\OutChannels*g\OutWidth*4
  bytes=PmI8ConvScratchBytes(@g)
  used=PmI8Align(g\InChannels*PmI8ConvRow(@g)*(1+g\Wide))+PmI8Align(PmI8ConvRow(@g)*4)*2
  For i=0 To bytes+16 Step 8
   PokeI($43800000+i,$12345678) : PokeI($43A00000+i,$12345678)
  Next
  PmConvAddBase=0 : PmConvAddOrder=0
  If c>=6 And c<12 : g\Bias=0 : EndIf
  If c>=12
   PmConvAddBase=$43600000 : PmConvAddOrder=(c/6) & 1
   For i=0 To outputBytes/4-1
    PmTensorPut(PmConvAddBase,i,((i*13) % 271-135)/31.0)
    If c>=24 And i % 17=0 : PokeL(PmConvAddBase+i*4,$7FC12345) : EndIf
    If c>=24 And i % 19=0 : PokeL(PmConvAddBase+i*4,$7F812345) : EndIf
   Next
  EndIf
  PmConvPackedCacheReset($43D00000,$100000)
  If g\Wide=0 And g\Stride=1 And (g\InChannels=64 Or g\InChannels=128)
   If PmConvPackedCacheWeight(g\Weight,g\InChannels,g\OutChannels,g\Kernel)=0 : ProcedureReturn 50 : EndIf
  EndIf
  PmTensorInt8Scratch=$43800000 : PmTensorInt8ScratchBytes=bytes : PmTensorInt8Fault=0
  PmConvFourCacheReset($43C00000,$40000)
  If g\Wide=0 And g\Stride=1 And (g\InChannels=64 Or g\InChannels=128)
   If PmConvFourCacheWeight(g\Weight,g\InChannels,g\OutChannels,g\Kernel)=0 : ProcedureReturn 20 : EndIf
  EndIf
  PmConvFourPrepare(@g)
  start=QuantClock() : ok1=PmParallelConvQuantize(@g,0)
  If ok1
   start=QuantClock()
   g\Dst=$43200000 : g\QuantBatch=0 : PmI8ConvReferenceRange(@g,0,0,g\OutChannels,PmI8ConvTile(@g,0),0,g\OutWidth)
  EndIf
  old=QuantClock()-start
  PmTensorInt8Scratch=$43A00000 : PmTensorInt8Fault=0
  PokeI($433FFFF8,$12345678) : PokeI($43400000+outputBytes,$12345678)
  start=QuantClock() : ok2=PmParallelConvQuantize(@g,0)
  If ok2
   PmConvFourCacheReset($43C00000,$40000)
   If g\Wide=0 And g\Stride=1 And (g\InChannels=64 Or g\InChannels=128)
    If PmConvFourCacheWeight(g\Weight,g\InChannels,g\OutChannels,g\Kernel)=0 : ProcedureReturn 5 : EndIf
    If PmConvFourCacheWeight(g\Weight,g\InChannels,g\OutChannels,g\Kernel)=0 : ProcedureReturn 6 : EndIf
    If PmConvFourCacheCount<>1 : ProcedureReturn 7 : EndIf
   EndIf
   If PmConvFourCacheCount=1
    PmConvEightMaskA64(g\Weight,PmConvFourCacheBase,g\InChannels,g\OutChannels,g\Kernel)
   EndIf
   PmConvPackedCacheReset($43D00000,$100000)
   If g\Wide=0 And g\Stride=1 And (g\InChannels=64 Or g\InChannels=128)
    If PmConvPackedCacheWeight(g\Weight,g\InChannels,g\OutChannels,g\Kernel)=0 : ProcedureReturn 30 : EndIf
    If PmConvPackedCacheWeight(g\Weight,g\InChannels,g\OutChannels,g\Kernel)=0 Or PmConvPackedCacheCount<>1 : ProcedureReturn 31 : EndIf
    ; Independent scalar inverse of the entire packed byte layout.
    Protected oc.i,tap.i,ch.i,row.i,at.i=$43D00000
    For oc=0 To g\OutChannels-1 Step 4
     For tap=0 To g\Kernel-1
      For ch=0 To g\InChannels-1
       For row=0 To 3
        If PeekA(at)<>PeekA(g\Weight+((oc+row)*g\InChannels+ch)*g\Kernel+tap) : ProcedureReturn 32 : EndIf
        at=at+1
       Next
      Next
     Next
    Next
   EndIf
   PmConvFourPrepare(@g)
   start=QuantClock()
   g\Dst=$43400000 : g\QuantBatch=0 : PmI8Conv1DNeonPositionRange(@g,0,0,g\OutChannels,PmI8ConvTile(@g,0),0,g\OutWidth)
  EndIf
  fast=QuantClock()-start
  If ok1<>ok2 : bad+1 : EndIf
  If ok1
   For i=0 To used-1
    If PeekA($43800010+i)<>PeekA($43A00010+i) : bad+1 : EndIf
   Next
  EndIf
  If ok1
   For i=0 To outputBytes-1 Step 4
    If PeekL($43200000+i)<>PeekL($43400000+i) : bad+1 : EndIf
   Next
  EndIf
  If PeekI($433FFFF8)<>$12345678 Or PeekI($43400000+outputBytes)<>$12345678 : ProcedureReturn 4 : EndIf
  If PeekI($43A00000+bytes)<>$12345678 : ProcedureReturn 3 : EndIf
  PokeI($41374000+c*32,used) : PokeI($41374008+c*32,bad)
  PokeI($41374010+c*32,old) : PokeI($41374018+c*32,fast)
 Next
 PmConvPackedCacheReset(0,0)
 If PmConvPackedCacheWeight($43100000,64,4,2)<>0 : ProcedureReturn 33 : EndIf
 PokeI($43D00000,$12345678) : PokeI($43D00200,$12345678)
 PmConvPackedCacheReset($43D00000,511)
 If PmConvPackedCacheWeight($43100000,64,4,2)<>0 : ProcedureReturn 34 : EndIf
 If PeekI($43D00000)<>$12345678 : ProcedureReturn 35 : EndIf
 PmConvPackedCacheReset($43D00000,512)
 If PmConvPackedCacheWeight($43100000,64,4,2)<>1 : ProcedureReturn 36 : EndIf
 If PmConvPackedCacheUsed<>512 Or PmConvPackedCacheCount<>1 Or PeekI($43D00200)<>$12345678 : ProcedureReturn 37 : EndIf
 If PmConvPackedCacheWeight($43100001,64,4,2)<>0 : ProcedureReturn 38 : EndIf
 If PmConvPackedCacheWeight($43100000,64,$7FFFFFFFFFFFFFFC,$7FFFFFFFFFFFFFFF)<>0 : ProcedureReturn 39 : EndIf
 PmConvPackedCacheReset($43D00001,1024)
 If PmConvPackedCacheWeight($43100000,64,4,2)<>0 : ProcedureReturn 40 : EndIf
 PmConvPackedCacheReset(0,0)
 If PmConvPackedBase<>0 Or PmConvPackedWeight<>0 Or PmConvPackedCacheCount<>0 : ProcedureReturn 41 : EndIf
 PmConvFourCacheReset(0,0)
 If PmConvFourCacheWeight($43100000,64,4,2)<>0 : ProcedureReturn 8 : EndIf
 PokeI($43C00000,$12345678)
 PmConvFourCacheReset($43C00000,7)
 If PmConvFourCacheWeight($43100000,64,4,2)<>0 : ProcedureReturn 9 : EndIf
 If PeekI($43C00000)<>$12345678 : ProcedureReturn 10 : EndIf
 PmConvFourCacheReset($43C00000,16)
 PokeI($43C00010,$12345678)
 If PmConvFourCacheWeight($43100000,64,4,2)<>1 : ProcedureReturn 11 : EndIf
 If PmConvFourCacheWeight($43100000,64,4,2)<>1 Or PmConvFourCacheUsed<>16 Or PmConvFourCacheCount<>1 : ProcedureReturn 12 : EndIf
 If PeekI($43C00010)<>$12345678 : ProcedureReturn 13 : EndIf
 If PmConvFourCacheWeight($43100001,64,4,2)<>0 : ProcedureReturn 14 : EndIf
 If PmConvFourCacheWeight($43100000,64,$7FFFFFFFFFFFFFFC,$7FFFFFFFFFFFFFFF)<>0 : ProcedureReturn 15 : EndIf
 PmConvFourCacheReset(0,0)
 If PmConvFourWeight<>0 Or PmConvFourMaskBase<>0 Or PmConvFourCacheCount<>0 : ProcedureReturn 16 : EndIf
 ProcedureReturn bad
EndProcedure
Procedure.i Main(services.i)
  Protected rc.i
  MmuClearNc()
  MmuAddNc($08A00000,$09200000)
  MmuAddNc($08100000,$08180000)
  If MmuBuildTables($00800000)<>0 : ProcedureReturn 8 : EndIf
  MmuEnableCached()
  rc=GateRun(services)
  MmuDisableCachedFlushed()
  ProcedureReturn rc
EndProcedure
