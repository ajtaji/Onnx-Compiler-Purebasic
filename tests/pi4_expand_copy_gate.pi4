; Independent Expand raw-byte shape checks.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"

Procedure.i ExpandCase(variant.i,kind.i)
 Protected Dim da.i(8)
 Protected Dim dy.i(8)
 Protected rank.i=2,arank.i=2,i.i,j.i,n.i,source.i,bytes.i
 da(0)=1 : da(1)=5 : dy(0)=3 : dy(1)=5
 Select variant
  Case 1 : arank=0 : rank=3 : dy(0)=2 : dy(1)=3 : dy(2)=7
  Case 2 : rank=3 : arank=3 : da(0)=2 : da(1)=1 : da(2)=7 : dy(0)=2 : dy(1)=4 : dy(2)=7
  Case 3 : rank=4 : arank=2 : da(0)=3 : da(1)=1 : dy(0)=2 : dy(1)=4 : dy(2)=3 : dy(3)=5
  Case 4 : rank=3 : arank=3 : da(0)=2 : da(1)=3 : da(2)=7 : dy(0)=2 : dy(1)=1 : dy(2)=7
  Case 5 : da(0)=0 : da(1)=5 : dy(0)=0 : dy(1)=5
  Case 6 : rank=0 : arank=0
  Case 7 : rank=4 : arank=2 : da(0)=3 : da(1)=7 : dy(0)=1 : dy(1)=1 : dy(2)=3 : dy(3)=7
 EndSelect
 If DAlloc(1,kind,arank,@da(0))=0 : ProcedureReturn 1 : EndIf
 For i=0 To Dt(1)\Bytes-1 : PokeA(Dt(1)\Data+i,(i*73+101)%256) : Next
 n=rank
 If DAlloc(2,7,1,@n)=0 : ProcedureReturn 2 : EndIf
 For i=0 To rank-1 : PokeI(Dt(2)\Data+i*8,dy(i)) : Next
 DExpand(3,1,2)
 If DError Or DCancel : ProcedureReturn 3 : EndIf
 bytes=DSize(kind)
 For i=0 To Dt(3)\Count-1
  source=DBroadcastIndex(i,3,1)
  For j=0 To bytes-1
   If PeekA(Dt(3)\Data+i*bytes+j)<>PeekA(Dt(1)\Data+source*bytes+j) : ProcedureReturn i+10 : EndIf
  Next
 Next
 DRelease(3) : DRelease(2) : DRelease(1)
 ProcedureReturn 0
EndProcedure
Procedure.i Main(services.i)
 Protected i.i,k.i,kind.i,cases.i,rc.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6)
 DZero($E1C00000,8192) : PokeI($E1C01FF0,PmParallelCores())
 If DHeapBind($EA000000,$100000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 PmTensorInt64Ok=1
 For k=0 To 3
  kind=1 : If k=1 : kind=6 : EndIf : If k=2 : kind=7 : EndIf : If k=3 : kind=9 : EndIf
  For i=0 To 7
   rc=ExpandCase(i,kind)
   PokeI($E1C00000+cases*32,i) : PokeI($E1C00000+cases*32+8,kind) : PokeI($E1C00000+cases*32+24,rc)
   cases+1 : If *pet : pet() : EndIf
   If rc : MmuDisableCachedFlushed() : ProcedureReturn rc : EndIf
  Next
 Next
 PokeI($E1C01FD0,cases) : MmuDisableCachedFlushed() : ProcedureReturn 0
EndProcedure
