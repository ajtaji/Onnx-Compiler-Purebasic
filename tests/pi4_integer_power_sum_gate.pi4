XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
; Reusable model: emitted tensor calls with runtime dimensions.
; BUILD THIS AS AN ANVIL PAYLOAD WITH --wants-services, and call
; PmOnnxAnvilEnter(x0) as the first statement of Main. Without both, every
; convolution runs on one core - the same bytes, several times slower.
EnableFloatingPoint
#PMD_TENSOR_COUNT = 255
#PMD_NODE_COUNT = 142
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=34816
#PMO_WEIGHT_FILE_BYTES=5748288
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"

Global GateChecks.i,GateFailures.i
Procedure GateAssert(ok.i)
 GateChecks+1 : If ok=0 : GateFailures+1 : EndIf
EndProcedure
Procedure GateReset()
 Protected i.i
 For i=1 To 5 : DRelease(i) : Next
 DError=0 : DCancel=0 : PmTensorInt64Ok=1
EndProcedure
Procedure.i Main(services.i)
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000)<>0 : ProcedureReturn 12 : EndIf
 MmuEnableCached()
 DHeapBind($60000000,$1000000)
 GateReset()
 DShape(1,7,1,1,0,0,0) : DShape(2,7,1,1,0,0,0)
 DWriteI64(Dt(1)\Data,0) : DWriteI64(Dt(2)\Data,0)
 DBinary(3,1,2,4)
