; Last-use no-broadcast Expand: 540 independent value and lifecycle cases.
; CC000000..CDFFFFFF arena; CE000100 caller state.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"


Procedure OldExpand(Y.i,A.i,Shape.i)
  Protected Dim dims.i(8)
  Protected i.i=0
  Protected rank.i=Dt(Shape)\Count
  Protected size.i=DSize(Dt(A)\Kind)
  Protected ax.i=0
  Protected width.i,step.i,row.i,source.i,x.i,destination.i,filled.i,take.i
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If rank>8 Or rank<Dt(A)\Rank
    DFail("Invalid Expand rank.")
    ProcedureReturn
  EndIf
  For i=0 To rank-1
    dims(i)=DInt(Shape,i)
    ax=i-rank+Dt(A)\Rank
    If ax>=0
      If dims(i)=1
        dims(i)=DDims((A)*8+(ax))
      EndIf
      If dims(i)<>DDims((A)*8+(ax)) And DDims((A)*8+(ax))<>1
        DFail("Invalid Expand extent.")
        ProcedureReturn
      EndIf
    EndIf
  Next
  If DAllocCore(Y,Dt(A)\Kind,rank,@dims(0),Bool(Y=A))=0
    ProcedureReturn
  EndIf
  If Dt(Y)\Count=0 : ProcedureReturn : EndIf
  If Dt(A)\Count=Dt(Y)\Count
    DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(Y)\Bytes) : ProcedureReturn
  EndIf
  width=1 : If rank : width=dims(rank-1) : EndIf
  step=0
  If Dt(A)\Rank : step=Bool(DDims(A*8+Dt(A)\Rank-1)<>1) : EndIf
  For row=0 To Dt(Y)\Count/width-1
    source=Dt(A)\Data+DBroadcastIndex(row*width,Y,A)*size
    If step
      DCopyServiced(source,Dt(Y)\Data+row*width*size,width*size)
    Else
      destination=Dt(Y)\Data+row*width*size
      DCopyServiced(source,destination,size)
      filled=1
      While filled<width
        take=DMin(filled,width-filled)
        DCopyServiced(destination,destination+filled*size,take*size)
        filled+take
      Wend
    EndIf
    PmKernelIdle()
  Next
EndProcedure
Procedure.i EqualTensor(a.i,b.i)
 Protected i.i
 If Dt(a)\Rank<>Dt(b)\Rank Or Dt(a)\Kind<>Dt(b)\Kind Or Dt(a)\Count<>Dt(b)\Count Or Dt(a)\Bytes<>Dt(b)\Bytes : ProcedureReturn 0 : EndIf
 For i=0 To Dt(a)\Rank-1 : If DDims(a*8+i)<>DDims(b*8+i) : ProcedureReturn 0 : EndIf : Next
 For i=0 To Dt(a)\Bytes-1 : If PeekA(Dt(a)\Data+i)<>PeekA(Dt(b)\Data+i) : ProcedureReturn 0 : EndIf : Next
 ProcedureReturn 1
EndProcedure

Procedure.i ExpandCase(kind.i,shape.i,mode.i,guard.i)
 Protected Dim dims.i(8),Dim target.i(9),Dim sdims.i(8)
 Protected rank.i=2,tr.i=2,i.i,bytes.i,base.i,refused.i,rc.i,take.i
 dims(0)=2 : dims(1)=3 : target(0)=2 : target(1)=3
 Select shape
 Case 0 : rank=0 : tr=0
 Case 1 : rank=0 : target(0)=2 : target(1)=3
 Case 3 : rank=3 : dims(1)=1 : dims(2)=3 : tr=3 : target(0)=2 : target(1)=4 : target(2)=3
 Case 4 : tr=3 : target(0)=1 : target(1)=2 : target(2)=3
 Case 5 : dims(0)=0 : target(0)=0
 Case 6 : target(1)=4
 Case 7 : tr=9 : For i=0 To 8 : target(i)=1 : Next
 Case 8 : dims(0)=1 : target(0)=0
 Case 9 : target(1)=-1
 EndSelect
 DError=0 : DCancel=0 : PmTensorInt64Ok=1
 If DAlloc(1,kind,rank,@dims(0))=0 Or DAlloc(4,kind,rank,@dims(0))=0 : ProcedureReturn 10 : EndIf
 bytes=Dt(1)\Bytes
 For i=0 To bytes-1 : PokeA(Dt(1)\Data+i,(i*73+31) & 255) : PokeA(Dt(4)\Data+i,(i*73+31) & 255) : Next
 If mode
  For i=0 To bytes-1 : PokeA($CE000100+i,(i*73+31) & 255) : Next
  DRelease(4)
  If mode=1 : rc=DBindBorrowed(4,kind,rank,@dims(0),$CE000100,$100000) : Else : rc=DBindMutableState(4,kind,rank,@dims(0),$CE000100,$100000) : EndIf
  If rc=0 : ProcedureReturn 11 : EndIf
 EndIf
 base=Dt(4)\Data : sdims(0)=tr
 If DAlloc(2,7,1,@sdims(0))=0 : ProcedureReturn 12 : EndIf
 For i=0 To tr-1 : PokeI(Dt(2)\Data+i*8,target(i)) : Next
 If guard=1 : DFail("Existing Expand error.") : EndIf
 If guard=2 : DCancel=1 : EndIf
 OldExpand(3,1,2) : refused=Bool(DError<>0)
 DError=0 : If guard=1 : DFail("Existing Expand error.") : EndIf
 DExpandConsume(5,4,2)
 rc=0
 If Bool(DError<>0)<>refused : rc=20 : EndIf
 If refused=0
  If EqualTensor(3,5)=0 : rc=21 : EndIf
  take=Bool((mode=0 Or mode=2) And (shape=0 Or shape=2 Or shape=4 Or shape=5))
  If take
   If Dt(5)\Data<>base Or Dt(4)\Owned Or DMutable(4) : rc=22 : EndIf
   If mode=0
    If Dt(5)\Owned<>1 Or DMutable(5) : rc=23 : EndIf
   Else
    If Dt(5)\Owned Or DMutable(5)<>1 Or DMutableCapacity(5)<>$100000 : rc=24 : EndIf
   EndIf
   DRelease(4)
   If DConsumeShape(6,5,Dt(5)\Rank,@DDims(5*8))=0 : rc=25 : EndIf
   DRelease(5)
   If EqualTensor(3,6)=0 : rc=26 : EndIf
  Else
   If Dt(5)\Owned<>1 Or DMutable(5) : rc=27 : EndIf
  EndIf
 EndIf
 DError=0 : DCancel=0
 For i=1 To 6 : DRelease(i) : Next
 If DLive Or DHeapUsed : rc=28 : EndIf
 ProcedureReturn rc
EndProcedure
Procedure.i Main(services.i)
 Protected Dim kinds.i(6)
 Protected k.i,shape.i,mode.i,guard.i,rc.i,cases.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6) : DZero($E1C00000,8192)
 If DHeapBind($CC000000,$2000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 kinds(0)=1 : kinds(1)=2 : kinds(2)=3 : kinds(3)=6 : kinds(4)=7 : kinds(5)=9
 For k=0 To 5
 For shape=0 To 9
 For mode=0 To 2
 For guard=0 To 2
  rc=ExpandCase(kinds(k),shape,mode,guard) : cases+1 : If *pet : pet() : EndIf
  If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next
 PokeI($E1C01FD0,cases)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
