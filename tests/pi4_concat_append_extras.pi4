 ProcedureReturn rc
EndProcedure
Procedure.i Main(services.i)
 Protected rc.i,cases.i,*pet,kind.i
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6) : DZero($E1C00000,8192)
 If DHeapBind($CC000000,$2000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 rc=ConcatDuplicate(1,2,2,1,1,0,0,0) : cases+1
 If rc=0 : rc=ConcatDuplicate(7,1,1,1,1,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatDuplicate(9,1,1,1,1,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatThree(1,2,1,1,1,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatThree(7,2,1,1,1,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatThree(9,2,1,1,1,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatNegative(1,2,1,1,1,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatNegative(1,2,1,1,2,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatAxisZero(1,2,1,1,1,0,0,0) : cases+1 : EndIf
 If rc=0 : rc=ConcatAxisZero(7,2,1,1,1,0,0,0) : cases+1 : EndIf
 If *pet : pet() : EndIf
 PokeI($E1C01FD0,cases) : PokeI($E1C01FD8,DLive) : PokeI($E1C01FE0,DHeapUsed)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
