 Protected a.i=$CE000100,b.i=$CE010100,snapshot.i=$CE020100,size.i=DSize(kind),oldBytes.i=outer*prefix*2*size,totalBytes.i=outer*(prefix+tail)*2*size
 Protected cap.i=1024,i.i,rc.i,refused.i,expected.i,axis.i=0,direct.i
 ad(0)=prefix : ad(1)=outer : ad(2)=2 : bd(0)=tail : bd(1)=outer : bd(2)=2
 If small : cap=oldBytes : EndIf
