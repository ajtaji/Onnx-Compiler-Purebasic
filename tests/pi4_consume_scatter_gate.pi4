; Last-use ownership transfer and ordinary borrowed-input behavior.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"

Procedure OldDScatter(Y.i,A.i,Indices.i,Updates.i)
  Protected k.i=0
  Protected i.i=0
  Protected j.i=0
  Protected offset.i=0
  Protected idx.i=0
  Protected block.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  Protected tuples.i=0
  If Dt(Indices)\Rank<1
    DFail("ScatterND indices need a tuple axis.")
    ProcedureReturn
  EndIf
  k=DDims((Indices)*8+(Dt(Indices)\Rank-1))
  If k<=0 Or k>Dt(A)\Rank
    DFail("Invalid ScatterND tuple width.")
    ProcedureReturn
  EndIf
  block=DProduct(A,k,Dt(A)\Rank-1)
  tuples=Dt(Indices)\Count/k
  If Dt(Updates)\Count<>tuples*block
    DFail("ScatterND update count mismatch.")
    ProcedureReturn
  EndIf
  If DLike(Y,A,0)=0
    ProcedureReturn
  EndIf
  DCopy(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Bytes)
  For i=0 To tuples-1
    offset=0
    For j=0 To k-1
      idx=DInt(Indices,i*k+j)
      If idx<0
        idx+DDims((A)*8+(j))
      EndIf
      If idx<0 Or idx>=DDims((A)*8+(j))
        DFail("ScatterND index is out of bounds.")
        ProcedureReturn
      EndIf
      offset=offset*DDims((A)*8+(j))+idx
    Next
    DCopy(Dt(Updates)\Data+i*block*size,Dt(Y)\Data+offset*block*size,block*size)
  Next
EndProcedure
Procedure.i ScatterCase(kind.i,pattern.i,borrowed.i)
 Protected Dim ds.i(8)
 Protected Dim ix.i(8)
 Protected i.i,expected.i,err.i
 ds(0)=4 : ds(1)=3 : ds(2)=2
 If DAlloc(1,kind,3,@ds(0))=0 : ProcedureReturn 11 : EndIf
 For i=0 To Dt(1)\Bytes-1 : PokeA(Dt(1)\Data+i,(i*17+9) & 255) : Next
 ix(0)=3 : ix(1)=2
 If pattern=3 : ix(0)=0 : EndIf
 If DAlloc(2,7,2,@ix(0))=0 : ProcedureReturn 12 : EndIf
 For i=0 To ix(0)-1
  PokeI(Dt(2)\Data+i*16,i) : PokeI(Dt(2)\Data+i*16+8,i)
  If pattern=1 : PokeI(Dt(2)\Data+i*16,-1) : PokeI(Dt(2)\Data+i*16+8,-1) : EndIf
  If pattern=2 And i=2 : PokeI(Dt(2)\Data+i*16,4) : EndIf
 Next
 ds(0)=ix(0) : ds(1)=2
 If DAlloc(3,kind,2,@ds(0))=0 : ProcedureReturn 13 : EndIf
 For i=0 To Dt(3)\Bytes-1 : PokeA(Dt(3)\Data+i,(i*11+93) & 255) : Next
 If borrowed
  i=Dt(1)\Bytes : DCopy(Dt(1)\Data,$EC000000,i) : DRelease(1)
  ds(0)=4 : ds(1)=3 : ds(2)=2
  If DBindBorrowed(1,kind,3,@ds(0),$EC000000,i)=0 : ProcedureReturn 17 : EndIf
 EndIf
 DError=0 : OldDScatter(4,1,2,3) : expected=DError
 DError=0 : DScatterConsume(5,1,2,3) : err=DError
 If Bool(err<>0)<>Bool(expected<>0) : ProcedureReturn 14 : EndIf
 If err=0
  For i=0 To Dt(4)\Bytes-1
   If PeekA(Dt(4)\Data+i)<>PeekA(Dt(5)\Data+i) : ProcedureReturn 15 : EndIf
  Next
 EndIf
 For i=1 To 5 : DRelease(i) : Next
 DError=0
 If DLive<>0 : ProcedureReturn 16 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i Main(services.i)
 Protected Dim kinds.i(6)
 Protected ki.i,pattern.i,borrowed.i,cases.i,rc.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6)
 DZero($E1C00000,8192) : PmTensorInt64Ok=1
 If DHeapBind($EA000000,$1000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 kinds(0)=1 : kinds(1)=6 : kinds(2)=7 : kinds(3)=2 : kinds(4)=3 : kinds(5)=9
 For ki=0 To 5
 For pattern=0 To 3
 For borrowed=0 To 1
  rc=ScatterCase(kinds(ki),pattern,borrowed) : cases+1
  If *pet : pet() : EndIf
  If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next
 PokeI($E1C01FD0,cases) : PokeI($E1C01FD8,DLive)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
