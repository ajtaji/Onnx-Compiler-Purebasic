; Direct attention matrix: 7026 differential cases plus marked four-core execution.
; CC/CD arena, CE inputs, CE800000 worker markers.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"


Procedure.i EqualTensor(a.i,b.i)
 Protected i.i
 If Dt(a)\Rank<>Dt(b)\Rank Or Dt(a)\Kind<>Dt(b)\Kind Or Dt(a)\Count<>Dt(b)\Count Or Dt(a)\Bytes<>Dt(b)\Bytes : ProcedureReturn 0 : EndIf
 For i=0 To Dt(a)\Rank-1 : If DDims(a*8+i)<>DDims(b*8+i) : ProcedureReturn 0 : EndIf : Next
 For i=0 To Dt(a)\Bytes-1 : If PeekA(Dt(a)\Data+i)<>PeekA(Dt(b)\Data+i) : ProcedureReturn 0 : EndIf : Next
 ProcedureReturn 1
EndProcedure

Global MatrixIdle.i,MatrixFault.i
Procedure MatrixService()
 If PmKernelCore() : MatrixFault+1 : Else : MatrixIdle+1 : EndIf
EndProcedure
Procedure.i MatrixMarkedWorker(p.i)
 PokeI($CE800000+PmKernelCore()*8,1)
 ProcedureReturn PmInterleavedHeadWorker(p)
EndProcedure
Procedure FillFloats(id.i,pattern.i,shift.i)
 Protected i.i,seed.i=$12345678,bits.i,v.f
 For i=0 To Dt(id)\Count-1
  seed=(seed*1664525+1013904223) & $FFFFFFFF : v=(seed & $FFFF)/16384.0 : v=v-2.0 : bits=PeekL(@v)
  If pattern
   Select (i+shift) % 12
   Case 0 : bits=0
   Case 1 : bits=$80000000
   Case 2 : bits=$7F800000
   Case 3 : bits=$FF800000
   Case 4 : bits=$7FC12345
   Case 5 : bits=$7FA12345
   Case 6 : bits=$80000001
   Case 7 : bits=1
   Case 8 : bits=$7F7FFFFF
   Case 9 : bits=$BF800000
   Case 10 : bits=$3F800000
   Case 11 : bits=$00800000
   EndSelect
  EndIf
  PokeL(Dt(id)\Data+i*4,bits)
 Next
EndProcedure
Procedure.i MatrixCase(geometry.i,m.i,k.i,n.i,pattern.i,releaseB.i,bad.i)
 Protected Dim ad.i(8),Dim bd.i(8)
 Protected i.i,refused.i,refnode.i,rc.i,perm.i
 ad(0)=1 : ad(1)=1 : ad(2)=m : ad(3)=k
 bd(0)=1 : bd(1)=k : bd(2)=1 : bd(3)=n
 Select geometry
 Case 1 : bd(0)=2 : bd(2)=3
 Case 2 : ad(0)=2 : ad(1)=3
 Case 3 : ad(0)=2 : ad(1)=3 : bd(0)=2 : bd(2)=3
 Case 4 : ad(0)=2 : bd(0)=2 : bd(2)=3
 Case 5 : ad(1)=3 : bd(0)=2
 Case 6 : ad(0)=0 : bd(0)=0 : ad(1)=3 : bd(2)=3
 EndSelect
 If bad=1 : ad(3)=k+1 : EndIf
 If bad=2 : ad(1)=2 : bd(2)=3 : EndIf
 perm="0,2,1,3" : If bad=3 : perm="0,2,2,3" : EndIf
 DError=0 : DCancel=0 : PmTensorInt64Ok=1
 If DAlloc(1,1,4,@ad(0))=0 Or DAlloc(2,1,4,@bd(0))=0 Or DAlloc(7,1,4,@bd(0))=0 : ProcedureReturn 10 : EndIf
 FillFloats(1,pattern,3) : FillFloats(2,pattern,5) : DCopy(Dt(2)\Data,Dt(7)\Data,Dt(2)\Bytes)
 If bad=4 : DFail("Prior matrix error.") : EndIf
 If bad=5 : DCancel=1 : EndIf
 DNode=31 : DTranspose(3,2,perm)
 If DError=0
  If releaseB : DRelease(2) : EndIf
  DNode=32 : DMatMul(4,1,3)
 EndIf
 refused=Bool(DError<>0) : refnode=DNode
 DError=0 : If bad=4 : DFail("Prior matrix error.") : EndIf
 DNode=32 : DMatMulInterleavedHeads(6,5,1,7,perm,31,releaseB)
 If geometry=3 And m=16 And k=64 And n=65 And pattern=0 And releaseB=0 And bad=0 And DError=0
  DZero($CE800000,32)
  If PmParallelCores()<>4 : rc=31 : EndIf
  If pmSvcParRun(@MatrixMarkedWorker,@PmInterleavedHeadParts[0],104,4)<>#PMP_SVC_OK : rc=32 : EndIf
  For i=0 To 3 : If PeekI($CE800000+i*8)<>1 : rc=33 : EndIf : Next
 EndIf
 If Bool(DError<>0)<>refused : rc=20 : EndIf
 If refused
  If DNode<>refnode : rc=21 : EndIf
 Else
  If EqualTensor(4,6)=0 : rc=22 : EndIf
  If releaseB And (Dt(7)\Owned Or Dt(7)\Data) : rc=23 : EndIf
 EndIf
 If rc : PokeI($E1C01F80,geometry) : PokeI($E1C01F88,m) : PokeI($E1C01F90,k) : PokeI($E1C01F98,n) : PokeI($E1C01FA0,bad) : EndIf
 DError=0 : DCancel=0
 For i=1 To 7 : DRelease(i) : Next
 If DLive Or DHeapUsed : rc=24 : EndIf
 ProcedureReturn rc
EndProcedure
Procedure.i Main(services.i)
 Protected Dim ks.i(5),Dim ns.i(10)
 Protected geometry.i,m.i,ki.i,ni.i,pat.i,releaseB.i,bad.i,rc.i,cases.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6) : DZero($E1C00000,8192)
 If DHeapBind($CC000000,$2000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 ks(0)=0 : ks(1)=1 : ks(2)=3 : ks(3)=16 : ks(4)=64
 ns(0)=0 : ns(1)=1 : ns(2)=3 : ns(3)=4 : ns(4)=15 : ns(5)=16 : ns(6)=17 : ns(7)=63 : ns(8)=64 : ns(9)=65
 PmSetIdleCallback(@MatrixService)
 For geometry=0 To 6
 For m=1 To 5
 For ki=0 To 4
 For ni=0 To 9
 For pat=0 To 1
 For releaseB=0 To 1
  rc=MatrixCase(geometry,m,ks(ki),ns(ni),pat,releaseB,0) : cases+1 : If *pet : pet() : EndIf
  If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next
 If rc=0
 For bad=1 To 5
 For releaseB=0 To 1
  rc=MatrixCase(0,1,16,17,0,releaseB,bad) : cases+1 : If *pet : pet() : EndIf
  If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next
 EndIf
 If rc=0
 For pat=0 To 1
 For releaseB=0 To 1
  rc=MatrixCase(0,1,4097,1,pat,releaseB,0) : cases+1 : If *pet : pet() : EndIf
  If rc : Break : EndIf
 Next : If rc : Break : EndIf
 Next
 EndIf
 If rc=0 : rc=MatrixCase(3,16,64,65,0,0,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,16,64,65,0,1,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,16,64,65,1,0,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,16,64,65,1,1,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,32,64,65,0,0,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,32,64,65,0,1,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,32,64,65,1,0,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,32,64,65,1,1,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,33,64,65,0,0,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,33,64,65,0,1,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,33,64,65,1,0,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 If rc=0 : rc=MatrixCase(3,33,64,65,1,1,0) : cases+1 : If *pet : pet() : EndIf : EndIf
 PmSetIdleCallback(0)
 If MatrixFault Or MatrixIdle=0 : rc=30 : EndIf
 PokeI($E1C01FD0,cases) : PokeI($E1C01FD8,MatrixFault) : PokeI($E1C01FE0,MatrixIdle)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
