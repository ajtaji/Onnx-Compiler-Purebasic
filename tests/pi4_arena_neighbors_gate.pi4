; Gemm reuse of the exact matrix kernel versus the old scalar Gemm.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_fp32.pmi"
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_fp32_neon.pmi"
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_trig_a64.pmi"
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_dynamic_portable.pmi"
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_norm_small.pmi"
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_ops.pmi"
XIncludeFile "C:/Users/ajtaj/Desktop/Onnx-Compiler-Purebasic/runtime/tensor_dynamic_ops_portable.pmi"

Global RefDHeap.i,RefDHeapBytes.i,RefDLimit.i,RefDHeapUsed.i,RefDHeapPeak.i,RefError.i
Procedure.i RefDFail(message.i)
 RefError=1 : ProcedureReturn 0
EndProcedure
Procedure.i RefDHeapBind(Address.i,Bytes.i)
  If Address=0 Or (Address & 15)<>0 Or Bytes<32 Or Bytes>$7FFFFF00
    ProcedureReturn RefDFail("Bind an aligned arena between 32 bytes and the signed addressable size limit.")
  EndIf
  RefDHeap=Address
  RefDHeapBytes=Bytes & -16
  RefDLimit=RefDHeapBytes
  RefDHeapUsed=0
  RefDHeapPeak=0
  PokeL(RefDHeap,RefDHeapBytes)
  PokeL(RefDHeap+4,0)
  ProcedureReturn 1
EndProcedure
Procedure.i RefDAcquireCore(Bytes.i,clear.i)
  Protected offset.i=0
  Protected span.i=0
  Protected needed.i=0
  Protected address.i=0
  If RefDHeap=0 Or Bytes<0 Or Bytes>RefDHeapBytes-16
    RefDFail("Allocation exceeds the bound arena.")
    ProcedureReturn 0
  EndIf
  needed=((DMax(Bytes,1)+15) & -16)+16
  offset=0
  While offset<RefDHeapBytes
    span=PeekL(RefDHeap+offset)
    If span<32 Or span>RefDHeapBytes-offset
      RefDFail("Arena block metadata is invalid.")
      ProcedureReturn 0
    EndIf
    If PeekL(RefDHeap+offset+4)=0 And span>=needed
      If span-needed>=32
        PokeL(RefDHeap+offset+needed,span-needed)
        PokeL(RefDHeap+offset+needed+4,0)
        span=needed
        PokeL(RefDHeap+offset,span)
      EndIf
      PokeL(RefDHeap+offset+4,1)
      RefDHeapUsed=RefDHeapUsed+span
      RefDHeapPeak=DMax(RefDHeapPeak,RefDHeapUsed)
      address=RefDHeap+offset+16
      ; THE WHOLE PAYLOAD IS ZEROED, NOT ONLY THE REQUESTED BYTES.  An
      ; acquired block reads as zero: DAlloc's consumers rely on it where a
      ; kernel writes only part of its output - ONNX LSTM leaves Y at zero
      ; for every timestep past a batch's sequence length, and the kernel
      ; skips those stores rather than writing zeros over them - and the
      ; rounding slack past the requested length is zeroed too so that a
      ; vector kernel reading a tail never meets a stale bit pattern.
      If clear
        DZero(address,span-16)
      Else
        ; Full-overwrite kernels own every requested byte. Keep the rounded
        ; tail zero for kernels whose vector loads may inspect that slack.
        DZero(address+Bytes,span-16-Bytes)
      EndIf
      ProcedureReturn address
    EndIf
    offset=offset+span
  Wend
  RefDFail("Request cannot fit in the remaining contiguous arena memory.")
  ProcedureReturn 0
EndProcedure
Procedure.i RefDAcquire(Bytes.i)
  ProcedureReturn RefDAcquireCore(Bytes,1)
EndProcedure
Procedure.i RefDAcquireOverwrite(Bytes.i)
  ProcedureReturn RefDAcquireCore(Bytes,0)
EndProcedure
Procedure RefDFree(Address.i)
  Protected offset.i=0
  Protected span.i=0
  Protected nextSpan.i=0
  If Address=0
    ProcedureReturn
  EndIf
  offset=Address-RefDHeap-16
  If offset<0 Or offset>=RefDHeapBytes Or (offset & 15)<>0
    RefDFail("Invalid arena release.")
    ProcedureReturn
  EndIf
  span=PeekL(RefDHeap+offset)
  If span<32 Or span>RefDHeapBytes-offset Or PeekL(RefDHeap+offset+4)<>1
    RefDFail("Invalid or duplicate arena release.")
    ProcedureReturn
  EndIf
  PokeL(RefDHeap+offset+4,0)
  RefDHeapUsed=RefDHeapUsed-span
  offset=0
  While offset<RefDHeapBytes
    span=PeekL(RefDHeap+offset)
    If PeekL(RefDHeap+offset+4)=0 And offset+span<RefDHeapBytes
      If PeekL(RefDHeap+offset+span+4)=0
        nextSpan=PeekL(RefDHeap+offset+span)
        PokeL(RefDHeap+offset,span+nextSpan)
        Continue
      EndIf
    EndIf
    offset=offset+span
  Wend
EndProcedure


Procedure.i CompareHeap()
 Protected off.i=0,span.i
 If DHeapUsed<>RefDHeapUsed Or DHeapPeak<>RefDHeapPeak : ProcedureReturn 1 : EndIf
 While off<DHeapBytes
  span=PeekL(DHeap+off)
  If span<>PeekL(RefDHeap+off) Or PeekL(DHeap+off+4)<>PeekL(RefDHeap+off+4) : ProcedureReturn 2 : EndIf
  off+span
 Wend
 ProcedureReturn Bool(off<>DHeapBytes)*3
EndProcedure
Procedure.i Main(services.i)
 Protected Dim slots.i(64)
 Protected Dim refs.i(64)
 Protected Dim sizes.i(3)
 Protected trial.i,step.i,index.i,seed.i=$12345678,bytes.i,clear.i,a.i,b.i,i.i,span.i,rc.i,cases.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6)
 DZero($E1C00000,8192)
 sizes(0)=32 : sizes(1)=512 : sizes(2)=$100000
 For trial=0 To 2
  DZero($EA000000,$100000) : DZero($EC000000,$100000)
  DError=0 : RefError=0
  If DHeapBind($EA000000,sizes(trial))=0 Or RefDHeapBind($EC000000,sizes(trial))=0 : rc=10 : Break : EndIf
  For step=0 To 4095
   seed=(seed*1664525+1013904223) & $FFFFFFFF : index=(seed >> 16) & 63
   If slots(index)
    DFree(slots(index)) : RefDFree(refs(index)) : slots(index)=0 : refs(index)=0
   Else
    bytes=(seed >> 3) & 8191 : clear=(seed >> 13) & 1
    If step<128 : bytes=step % 33 : EndIf
    DError=0 : RefError=0
    a=DAcquireCore(bytes,clear) : b=RefDAcquireCore(bytes,clear)
    If Bool(a<>0)<>Bool(b<>0) Or Bool(DError<>0)<>Bool(RefError<>0) : rc=20 : Break : EndIf
    If a
     If a-DHeap<>b-RefDHeap : rc=21 : Break : EndIf
     span=PeekL(a-16)-16
     For i=0 To span-1
      If (clear Or i>=bytes) And PeekA(a+i)<>0 : rc=22 : Break : EndIf
      If (clear Or i>=bytes) And PeekA(a+i)<>PeekA(b+i) : rc=23 : Break : EndIf
      PokeA(a+i,(i+step) & 255) : PokeA(b+i,(i+step) & 255)
     Next
     slots(index)=a : refs(index)=b
    EndIf
   EndIf
   If rc : Break : EndIf
   rc=CompareHeap() : cases+1
   If rc : Break : EndIf
   If *pet : pet() : EndIf
  Next
  If rc : Break : EndIf
  DError=0 : RefError=0
  For index=0 To 63
   DFree(slots(index)) : RefDFree(refs(index)) : slots(index)=0 : refs(index)=0
   rc=CompareHeap() : cases+1 : If rc : Break : EndIf
  Next
  If rc Or DHeapUsed<>0 Or PeekL(DHeap)<>DHeapBytes : rc=30 : Break : EndIf
 Next
 PokeI($E1C01FD0,cases) : PokeI($E1C01FD8,DHeapUsed) : PokeI($E1C01FE0,trial) : PokeI($E1C01FE8,step)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
