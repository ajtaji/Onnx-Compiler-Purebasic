; Concat raw-byte, metadata and refusal checks against the old scalar implementation.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"

Procedure OldDConcat(Y.i,Inputs.i,Axis.i)
  Protected Dim dims.i(8)
  Protected count.i=DListCount(Inputs)
  Protected a.i=DListValue(Inputs,1)
  Protected i.i=0
  Protected j.i=0
  Protected outer.i=0
  Protected inner.i=0
  Protected offset.i=0
  Protected span.i=0
  Protected size.i=DSize(Dt(a)\Kind)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Axis<0
    Axis+Dt(a)\Rank
  EndIf
  If Axis<0 Or Axis>=Dt(a)\Rank
    DFail("Invalid Concat axis.")
    ProcedureReturn
  EndIf
  For i=0 To Dt(a)\Rank-1
    dims(i)=DDims((a)*8+(i))
  Next
  dims(Axis)=0
  For i=1 To count
    a=DListValue(Inputs,i)
    If Dt(a)\Rank<>Dt(DListValue(Inputs,1))\Rank Or DSize(Dt(a)\Kind)<>size
      DFail("Concat rank/type mismatch.")
      ProcedureReturn
    EndIf
    For j=0 To Dt(a)\Rank-1
      If j<>Axis And DDims((a)*8+(j))<>dims(j)
        DFail("Concat non-axis extent mismatch.")
        ProcedureReturn
      EndIf
    Next
    dims(Axis)=dims(Axis)+DDims((a)*8+(Axis))
  Next
  If DAlloc(Y,Dt(a)\Kind,Dt(a)\Rank,@dims(0))=0
    ProcedureReturn
  EndIf
  outer=DProduct(Y,0,Axis-1)
  inner=DProduct(Y,Axis+1,Dt(Y)\Rank-1)
  For j=0 To outer-1
    offset=j*dims(Axis)*inner
    For i=1 To count
      a=DListValue(Inputs,i)
      span=DDims((a)*8+(Axis))*inner
      DCopy(Dt(a)\Data+j*span*size,Dt(Y)\Data+offset*size,span*size)
      offset+span
    Next
  Next
EndProcedure
Procedure.i CheckConcat(variant.i,kind.i,repeated.i)
 Protected Dim dims.i(8)
 Protected rank.i=2,axis.i=-1,id.i,j.i,n.i,rc.i,oldError.i,newError.i
 Protected inputs.i
 For id=1 To 3
  dims(0)=3 : dims(1)=id
  Select variant
   Case 0 : rank=1 : axis=0 : dims(0)=id-1
   Case 2 : rank=3 : axis=1 : dims(0)=2 : dims(1)=id-1 : dims(2)=5
   Case 3 : rank=4 : axis=2 : dims(0)=2 : dims(1)=3 : dims(2)=id : dims(3)=7
   Case 4 : dims(0)=16384 : dims(1)=id
   Case 5 : rank=3 : axis=1 : dims(0)=0 : dims(1)=id : dims(2)=5
   Case 6 : dims(0)=id : dims(1)=257 : axis=0
   Case 7 : rank=1 : dims(0)=0 : If id=1 : dims(0)=4099 : EndIf : axis=-1
   Case 8 : If id=3 : dims(0)=4 : EndIf
   Case 9 : axis=2
   Case 10 : axis=-3
   Case 11 : dims(0)=1 : dims(1)=1
  EndSelect
  If DAlloc(id,kind,rank,@dims(0))=0 : ProcedureReturn 1 : EndIf
  For j=0 To Dt(id)\Bytes-1 : PokeA(Dt(id)\Data+j,(j*73+id*117) & 255) : Next
 Next
 inputs="1,2,3" : If repeated : inputs="1,2,3,1" : EndIf
 DError=0 : OldDConcat(4,inputs,axis) : oldError=DError
 DError=0 : DConcat(5,inputs,axis) : newError=DError
 If Bool(oldError<>0)<>Bool(newError<>0) : ProcedureReturn 2 : EndIf
 If oldError=0
  If Dt(4)\Rank<>Dt(5)\Rank Or Dt(4)\Kind<>Dt(5)\Kind Or Dt(4)\Count<>Dt(5)\Count Or Dt(4)\Bytes<>Dt(5)\Bytes : ProcedureReturn 3 : EndIf
  For j=0 To Dt(4)\Rank-1 : If DDims(4*8+j)<>DDims(5*8+j) : ProcedureReturn 4 : EndIf : Next
  For j=0 To Dt(4)\Bytes-1 : If PeekA(Dt(4)\Data+j)<>PeekA(Dt(5)\Data+j) : ProcedureReturn j+10 : EndIf : Next
 EndIf
 DError=0
 For id=1 To 5 : DRelease(id) : Next
 If DLive<>0 : ProcedureReturn 5 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i Main(services.i)
 Protected k.i,v.i,again.i,kind.i,rc.i,cases.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6)
 DZero($E1C00000,8192) : PokeI($E1C01FF0,PmParallelCores())
 If DHeapBind($EA000000,$1000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 PmTensorInt64Ok=1
 For k=0 To 3
  kind=1 : If k=1 : kind=6 : EndIf : If k=2 : kind=7 : EndIf : If k=3 : kind=9 : EndIf
  For v=0 To 11
   For again=0 To 1
    rc=CheckConcat(v,kind,again)
    PokeI($E1C00000+cases*32,v) : PokeI($E1C00000+cases*32+8,kind) : PokeI($E1C00000+cases*32+16,again) : PokeI($E1C00000+cases*32+24,rc)
    cases+1 : If *pet : pet() : EndIf
    If rc : PokeI($E1C01FD0,cases) : MmuDisableCachedFlushed() : ProcedureReturn rc : EndIf
   Next
  Next
 Next
 PokeI($E1C01FD0,cases) : PokeI($E1C01FD8,DLive)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
