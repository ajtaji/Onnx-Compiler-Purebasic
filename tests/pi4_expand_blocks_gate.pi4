; Exact Expand output and refusal comparison against the preceding implementation.
XIncludeFile "RaspberryPi4/Lib/mmu.pi4"
EnableFloatingPoint
#PMD_TENSOR_COUNT = 64
#PMD_NODE_COUNT = 64
#PMD_NATIVE_BYTES=8
#PMO_INT8_BACKEND=1
#PMO_INT64_SPLIT=0
#PMD_WORKING_MEMORY_LIMIT=1073741824
#PMD_METADATA_RESERVE=16384
#PMO_WEIGHT_FILE_BYTES=0
#PMO_USE_BATCHNORM=1
 #PMO_USE_STFT=1
 #PMO_USE_RESIZE=1
 #PMO_USE_CONVTRANSPOSE=1
 #PMO_USE_CONV=1
 #PMO_USE_LSTM=1
 #PMO_USE_INT8=1
 #PMO_USE_EXPLOG=1
 #PMO_USE_TRIG=1
 #PMO_USE_ATAN=1
XIncludeFile "RaspberryPi4/Lib/math.pi4"
XIncludeFile "../runtime/tensor_fp32.pmi"
XIncludeFile "../runtime/tensor_fp32_neon.pmi"
XIncludeFile "../runtime/tensor_trig_a64.pmi"
XIncludeFile "../runtime/tensor_dynamic_portable.pmi"
XIncludeFile "../runtime/tensor_norm_small.pmi"
XIncludeFile "../runtime/tensor_dynamic_norm_small_portable.pmi"
#PMO_OPS_INT32=0
XIncludeFile "../runtime/tensor_ops.pmi"
XIncludeFile "../runtime/tensor_dynamic_ops_portable.pmi"

Procedure RefDExpand(Y.i,A.i,Shape.i)
  Protected Dim dims.i(8)
  Protected i.i=0
  Protected rank.i=Dt(Shape)\Count
  Protected size.i=DSize(Dt(A)\Kind)
  Protected ax.i=0
  Protected width.i,step.i,row.i,source.i,x.i
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If rank>8 Or rank<Dt(A)\Rank
    DFail("Invalid Expand rank.")
    ProcedureReturn
  EndIf
  For i=0 To rank-1
    dims(i)=DInt(Shape,i)
    ax=i-rank+Dt(A)\Rank
    If ax>=0
      If dims(i)=1
        dims(i)=DDims((A)*8+(ax))
      EndIf
      If dims(i)<>DDims((A)*8+(ax)) And DDims((A)*8+(ax))<>1
        DFail("Invalid Expand extent.")
        ProcedureReturn
      EndIf
    EndIf
  Next
  If DAlloc(Y,Dt(A)\Kind,rank,@dims(0))=0
    ProcedureReturn
  EndIf
  If Dt(Y)\Count=0 : ProcedureReturn : EndIf
  If Dt(A)\Count=Dt(Y)\Count
    DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(Y)\Bytes) : ProcedureReturn
  EndIf
  width=1 : If rank : width=dims(rank-1) : EndIf
  step=0
  If Dt(A)\Rank : step=Bool(DDims(A*8+Dt(A)\Rank-1)<>1) : EndIf
  For row=0 To Dt(Y)\Count/width-1
    source=Dt(A)\Data+DBroadcastIndex(row*width,Y,A)*size
    If step
      DCopyServiced(source,Dt(Y)\Data+row*width*size,width*size)
    Else
      For x=0 To width-1
        DCopyServiced(source,Dt(Y)\Data+(row*width+x)*size,size)
      Next
    EndIf
    PmKernelIdle()
  Next
EndProcedure


Procedure.i CheckExpand(kind.i,shape.i,alias.i,pattern.i)
 Protected Dim src.i(8)
 Protected Dim target.i(9)
 Protected sr.i=0,tr.i=0,i.i,y0.i=3,y1.i=4,refused.i,rc.i
 Select shape
  Case 0 : sr=0 : tr=0
  Case 1 : sr=0 : tr=1 : target(0)=0
  Case 2 : sr=0 : tr=2 : target(0)=3 : target(1)=5
  Case 3 : sr=2 : src(0)=2 : src(1)=1 : tr=2 : target(0)=2 : target(1)=65
  Case 4 : sr=3 : src(0)=1 : src(1)=3 : src(2)=1 : tr=3 : target(0)=4 : target(1)=3 : target(2)=17
  Case 5 : sr=3 : src(0)=2 : src(1)=1 : src(2)=4 : tr=3 : target(0)=2 : target(1)=7 : target(2)=4
  Case 6 : sr=2 : src(0)=1 : src(1)=1 : tr=2 : target(0)=5 : target(1)=1
  Case 7 : sr=1 : src(0)=3 : tr=2 : target(0)=4 : target(1)=3
  Case 8 : sr=2 : src(0)=0 : src(1)=1 : tr=2 : target(0)=0 : target(1)=19
  Case 9 : sr=1 : src(0)=1 : tr=1 : target(0)=65537
  Case 10 : sr=1 : src(0)=1 : tr=1 : target(0)=-1
  Case 11 : sr=1 : src(0)=2 : tr=1 : target(0)=3
  Case 12 : sr=0 : tr=9
  Case 13 : sr=2 : src(0)=2 : src(1)=3 : tr=1 : target(0)=3
 EndSelect
 DError=0 : DCancel=0
 If DAlloc(1,kind,sr,@src(0))=0 Or DAlloc(5,kind,sr,@src(0))=0 : ProcedureReturn 10 : EndIf
 For i=0 To Dt(1)\Bytes-1
  PokeA(Dt(1)\Data+i,(i*37+pattern*191) & 255)
  PokeA(Dt(5)\Data+i,(i*37+pattern*191) & 255)
 Next
 If DShape(2,7,1,tr,0,0,0)=0 : ProcedureReturn 11 : EndIf
 For i=0 To tr-1 : DWriteI64(Dt(2)\Data+i*8,target(i)) : Next
 If alias : y0=1 : y1=5 : EndIf
 RefDExpand(y0,1,2) : refused=Bool(DError<>0) : DError=0
 DExpand(y1,5,2)
 If Bool(DError<>0)<>refused : ProcedureReturn 12 : EndIf
 If refused=0
  If Dt(y0)\Kind<>Dt(y1)\Kind Or Dt(y0)\Rank<>Dt(y1)\Rank Or Dt(y0)\Count<>Dt(y1)\Count Or Dt(y0)\Bytes<>Dt(y1)\Bytes : ProcedureReturn 13 : EndIf
  For i=0 To 7 : If DDims(y0*8+i)<>DDims(y1*8+i) : ProcedureReturn 14 : EndIf : Next
  For i=0 To Dt(y0)\Bytes-1
   If PeekA(Dt(y0)\Data+i)<>PeekA(Dt(y1)\Data+i) : ProcedureReturn 15 : EndIf
  Next
 EndIf
 For i=1 To 5 : DRelease(i) : Next
 DError=0
 If DLive Or DHeapUsed : ProcedureReturn 16 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i Main(services.i)
 Protected Dim kinds.i(6)
 Protected ki.i,shape.i,alias.i,pattern.i,cases.i,rc.i,*pet
 MmuClearNc() : MmuAddNc($08A00000,$09200000) : MmuAddNc($08100000,$08180000)
 If MmuBuildTables($00800000) : ProcedureReturn 12 : EndIf
 MmuEnableCached() : PmSetAnvilServices(services) : *pet=pmAnvilSlot(6)
 DZero($E1C00000,8192) : PmTensorInt64Ok=1
 If DHeapBind($EA000000,$1000000)=0 : MmuDisableCachedFlushed() : ProcedureReturn 3 : EndIf
 kinds(0)=1 : kinds(1)=6 : kinds(2)=7 : kinds(3)=2 : kinds(4)=3 : kinds(5)=9
 For ki=0 To 5
 For shape=0 To 13
 For alias=0 To 1
 For pattern=0 To 1
  rc=CheckExpand(kinds(ki),shape,alias,pattern) : cases+1
  If *pet : pet() : EndIf
  If rc : Break : EndIf
 Next
 If rc : Break : EndIf
 Next
 If rc : Break : EndIf
 Next
 If rc : Break : EndIf
 Next
 PokeI($E1C01FD0,cases) : PokeI($E1C01FD8,DLive)
 MmuDisableCachedFlushed() : ProcedureReturn rc
EndProcedure
