; ======================================================================
; tensor_dynamic_ops.pmi - runtime-dimension wrappers for the kernels in
; tensor_ops.pmi
; ----------------------------------------------------------------------
; ONE SOURCE FOR EVERY TARGET, like tensor_ops.pmi. Include tensor_ops.pmi,
; then the dialect's adapter (tensor_dynamic_ops_windows.pbi or
; tensor_dynamic_ops_portable.pmi, which defines DOpDim), then this file.
; Each wrapper checks what the ONNX specification requires of the shapes and
; element types it meets at run time, allocates its outputs, fills the
; kernel's parameter arrays and runs the kernel. A form it cannot compute is
; refused with DFail naming the operator; nothing is approximated.
;
; The generated call writes the node's attributes into PmOpT before the
; call (lists and per-axis values); scalar attributes are arguments.
; ======================================================================

Global Dim PmOpT.i(96)

; Rank-aligned dims of tensor Id into PmOpDN(Slot*8 ...), leading ones.
Procedure DOpAlign(Slot.i, Id.i, Rank.i)
  Protected d.i
  Protected r.i
  r = Dt(Id)\Rank
  d = 0
  While d < Rank
    If d < Rank - r
      PmOpDN(Slot * 8 + d) = 1
    Else
      PmOpDN(Slot * 8 + d) = DOpDim(Id, d - (Rank - r))
    EndIf
    d = d + 1
  Wend
EndProcedure

Procedure.i DOpKindOk(Kind.i, Allowed.i)
  ; Allowed: bit 0 FLOAT, bit 1 INT32, bit 2 INT64, bit 3 BOOL
  If Kind = 1 And (Allowed & 1) <> 0
    ProcedureReturn 1
  EndIf
  If Kind = 6 And (Allowed & 2) <> 0
    ProcedureReturn 1
  EndIf
  If Kind = 7 And (Allowed & 4) <> 0
    ProcedureReturn 1
  EndIf
  If Kind = 9 And (Allowed & 8) <> 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i DOpStatus()
  If PmOpStatus = 4
    DFail("Mod: an integer divisor is zero.")
    ProcedureReturn 0
  EndIf
  If PmOpStatus <> 0
    DFail("An operator kernel was handed a form it does not compute; this is a runtime defect, report the model and the node.")
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

; ----------------------------------------------------------------------
; Elementwise functions: Op as in PmOpUnary. PmOpF and PmOpI(0), PmOpI(1)
; are set by the generated call.
; ----------------------------------------------------------------------
Procedure DOpUnary(Y.i, A.i, Op.i)
  Protected kind.i
  If A = 0
    DFail("An elementwise operator has no input tensor.")
    ProcedureReturn
  EndIf
  kind = Dt(A)\Kind
  If Op = 3
    If DOpKindOk(kind, 7) = 0
      DFail("Sign computes FLOAT, INT32 and INT64 tensors only.")
      ProcedureReturn
    EndIf
  ElseIf Op = 27
    If DOpKindOk(kind, 6) = 0
      DFail("BitwiseNot computes INT32 and INT64 tensors only.")
      ProcedureReturn
    EndIf
  ElseIf kind <> 1
    DFail("This elementwise operator computes FLOAT tensors only.")
    ProcedureReturn
  EndIf
  If Op = 16 Or Op = 17
    If DLike(Y, A, 9) = 0
      ProcedureReturn
    EndIf
  ElseIf DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  PmOpStatus = 0
  PmOpUnary(Dt(A)\Data, Dt(Y)\Data, Dt(A)\Count, Op, kind)
  DOpStatus()
EndProcedure

; ----------------------------------------------------------------------
; Min, Max, Sum, Mean (N inputs), Mod, PRelu, Or, Xor (two): the input
; tensor ids are in PmOpN(0 .. N-1). Allowed: the element kinds (as in
; DOpKindOk). Unidirectional: PRelu's slope must broadcast to X.
; ----------------------------------------------------------------------
Procedure DOpVariadic(Y.i, N.i, Op.i, Allowed.i)
  Protected Dim dims.i(8)
  Protected k.i
  Protected d.i
  Protected rank.i
  Protected kind.i
  Protected e.i
  Protected id.i
  If N < 1 Or N > 16
    DFail("A variadic operator takes one to sixteen inputs here.")
    ProcedureReturn
  EndIf
  rank = 0
  k = 0
  While k < N
    id = PmOpN(k)
    If id = 0
      DFail("A variadic operator input is missing.")
      ProcedureReturn
    EndIf
    If Dt(id)\Rank > rank
      rank = Dt(id)\Rank
    EndIf
    k = k + 1
  Wend
  kind = Dt(PmOpN(0))\Kind
  If DOpKindOk(kind, Allowed) = 0
    DFail("The operator does not compute this element type; see the refusal the compiler gives for its declared type.")
    ProcedureReturn
  EndIf
  k = 0
  While k < N
    If Dt(PmOpN(k))\Kind <> kind
      DFail("The inputs of an elementwise operator must share one element type.")
      ProcedureReturn
    EndIf
    DOpAlign(k, PmOpN(k), rank)
    k = k + 1
  Wend
  d = 0
  While d < rank
    e = 1
    k = 0
    While k < N
      If PmOpDN(k * 8 + d) <> 1
        If e <> 1 And PmOpDN(k * 8 + d) <> e
          DFail("Input dimensions do not broadcast.")
          ProcedureReturn
        EndIf
        e = PmOpDN(k * 8 + d)
      EndIf
      k = k + 1
    Wend
    If Op = 8 And PmOpDN(d) <> e
      DFail("PRelu slope must broadcast to X, not X to the slope.")
      ProcedureReturn
    EndIf
    ; a zero extent wins over one
    k = 0
    While k < N
      If PmOpDN(k * 8 + d) = 0
        e = 0
      EndIf
      k = k + 1
    Wend
    dims(d) = e
    PmOpDY(d) = e
    d = d + 1
  Wend
  If DAlloc(Y, kind, rank, @dims(0)) = 0
    ProcedureReturn
  EndIf
  k = 0
  While k < N
    PmOpAddr(k) = Dt(PmOpN(k))\Data
    k = k + 1
  Wend
  PmOpStatus = 0
  PmOpVariadic(Dt(Y)\Data, N, rank, Op, kind)
  DOpStatus()
EndProcedure

; ----------------------------------------------------------------------
; ReduceMin, ReduceL1, ReduceL2, ReduceSumSquare, ReduceLogSum,
; ReduceLogSumExp (Op as in PmOpReduce). Axes from the tensor Axes (opset 18
; and later) or, when Axes is 0, from the attribute list PmOpT(1 ..
; PmOpT(0)); PmOpT(0) = 0 means none. Keep: keepdims; NoopEmpty:
; noop_with_empty_axes.
; ----------------------------------------------------------------------
Procedure DOpReduce(Y.i, A.i, Axes.i, Keep.i, NoopEmpty.i, Op.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected count.i
  Protected i.i
  Protected axis.i
  Protected mask.i
  Protected j.i
  Protected kind.i
  If A = 0
    DFail("A reduction requires data.")
    ProcedureReturn
  EndIf
  kind = Dt(A)\Kind
  rank = Dt(A)\Rank
  If Op = 0 Or Op = 1 Or Op = 3
    If DOpKindOk(kind, 7) = 0
      DFail("ReduceMin, ReduceL1 and ReduceSumSquare compute FLOAT, INT32 and INT64 data only.")
      ProcedureReturn
    EndIf
  ElseIf kind <> 1
    DFail("ReduceL2, ReduceLogSum and ReduceLogSumExp compute FLOAT data only.")
    ProcedureReturn
  EndIf
  If Axes <> 0
    If Dt(Axes)\Kind <> 7 Or Dt(Axes)\Rank > 1
      DFail("Reduction axes must be a one-dimensional INT64 tensor.")
      ProcedureReturn
    EndIf
    count = Dt(Axes)\Count
  Else
    count = PmOpT(0)
  EndIf
  mask = 0
  i = 0
  While i < count
    If Axes <> 0
      axis = DInt(Axes, i)
    Else
      axis = PmOpT(1 + i)
    EndIf
    If axis < 0
      axis = axis + rank
    EndIf
    If axis < 0 Or axis >= rank
      DFail("A reduction axis is outside the data rank.")
      ProcedureReturn
    EndIf
    If ((mask >> axis) & 1) <> 0
      DFail("Reduction axes name the same axis twice.")
      ProcedureReturn
    EndIf
    mask = mask | (1 << axis)
    i = i + 1
  Wend
  If count = 0
    If NoopEmpty <> 0
      If DLike(Y, A, 0) <> 0
        PmOpCopyBytes(Dt(A)\Data, Dt(Y)\Data, Dt(A)\Bytes)
      EndIf
      ProcedureReturn
    EndIf
    mask = (1 << rank) - 1
  EndIf
  j = 0
  i = 0
  While i < rank
    PmOpDA(i) = DOpDim(A, i)
    If ((mask >> i) & 1) <> 0
      If Keep <> 0
        dims(j) = 1
        j = j + 1
      EndIf
    Else
      dims(j) = DOpDim(A, i)
      j = j + 1
    EndIf
    i = i + 1
  Wend
  If DAlloc(Y, kind, j, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpStatus = 0
  PmOpReduce(Dt(A)\Data, Dt(Y)\Data, rank, mask, Op, kind)
  DOpStatus()
EndProcedure

; ----------------------------------------------------------------------
; ArgMax (Op 0) and ArgMin (Op 1).
; ----------------------------------------------------------------------
Procedure DOpArg(Y.i, A.i, Axis.i, Keep.i, Last.i, Op.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected i.i
  Protected j.i
  If A = 0
    DFail("ArgMax and ArgMin require data.")
    ProcedureReturn
  EndIf
  If DOpKindOk(Dt(A)\Kind, 7) = 0
    DFail("ArgMax and ArgMin compute FLOAT, INT32 and INT64 data only.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If Axis < 0
    Axis = Axis + rank
  EndIf
  If Axis < 0 Or Axis >= rank
    DFail("ArgMax and ArgMin axis is outside the data rank.")
    ProcedureReturn
  EndIf
  If DOpDim(A, Axis) = 0
    DFail("ArgMax and ArgMin need at least one element along the axis.")
    ProcedureReturn
  EndIf
  j = 0
  i = 0
  While i < rank
    If i = Axis
      If Keep <> 0
        dims(j) = 1
        j = j + 1
      EndIf
    Else
      dims(j) = DOpDim(A, i)
      j = j + 1
    EndIf
    i = i + 1
  Wend
  If DAlloc(Y, 7, j, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpArg(Dt(A)\Data, Dt(Y)\Data, DProduct(A, 0, Axis - 1), DOpDim(A, Axis), DProduct(A, Axis + 1, rank - 1), Op, Last, Dt(A)\Kind)
EndProcedure

; ----------------------------------------------------------------------
; LogSoftmax-13 along Axis.
; ----------------------------------------------------------------------
Procedure DOpLogSoftmax(Y.i, A.i, Axis.i)
  Protected rank.i
  If A = 0
    DFail("LogSoftmax requires an input.")
    ProcedureReturn
  EndIf
  If Dt(A)\Kind <> 1
    DFail("LogSoftmax computes FLOAT tensors only.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If Axis < 0
    Axis = Axis + rank
  EndIf
  If Axis < 0 Or Axis >= rank
    DFail("LogSoftmax axis is outside the input rank.")
    ProcedureReturn
  EndIf
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  PmOpLogSoftmax(Dt(A)\Data, Dt(Y)\Data, DProduct(A, 0, Axis - 1), DOpDim(A, Axis), DProduct(A, Axis + 1, rank - 1))
EndProcedure

; ----------------------------------------------------------------------
; MaxPool, AveragePool, LpPool and the global forms. The generated call has
; written PmOpT: 0 spatial axes s of kernel_shape (0 for a global pool),
; 1 auto_pad (0 NOTSET, 1 SAME_UPPER, 2 SAME_LOWER, 3 VALID), 2 ceil_mode,
; 3 count_include_pad, 4 p, 5 storage_order, 6 mode (0 max, 1 average,
; 2 Lp); 8+d kernel, 12+d strides, 16+d dilations, 20+d begin pads,
; 24+d end pads. Output extent (ONNX's pooling shape rule):
;   floor or ceil of (in + begin + end - ((kernel-1)*dilation + 1)) / stride,
;   plus one, with ceil_mode; a last window that would start in the end
;   padding is dropped;
;   SAME_UPPER/SAME_LOWER: ceil(in / stride), the total padding
;   max(0, (out-1)*stride + (kernel-1)*dilation + 1 - in) split with the odd
;   unit at the end (UPPER) or the start (LOWER).
; ----------------------------------------------------------------------
Procedure DOpPool(Y.i, Ind.i, A.i)
  Protected Dim dims.i(8)
  Protected s.i
  Protected d.i
  Protected ext.i
  Protected k.i
  Protected st.i
  Protected dl.i
  Protected b.i
  Protected e.i
  Protected span.i
  Protected out.i
  Protected total.i
  If A = 0
    DFail("A pooling operator requires an input.")
    ProcedureReturn
  EndIf
  If Dt(A)\Kind <> 1
    DFail("The pooling operators compute FLOAT tensors only.")
    ProcedureReturn
  EndIf
  s = Dt(A)\Rank - 2
  If s < 1 Or s > 3
    DFail("The pooling operators take N x C x D1 ... Ds with one to three spatial axes.")
    ProcedureReturn
  EndIf
  If PmOpT(0) <> 0 And PmOpT(0) <> s
    DFail("kernel_shape does not have one extent per spatial axis of the input.")
    ProcedureReturn
  EndIf
  dims(0) = DOpDim(A, 0)
  dims(1) = DOpDim(A, 1)
  d = 0
  While d < s
    ext = DOpDim(A, 2 + d)
    If PmOpT(0) = 0
      k = ext
      st = 1
      dl = 1
      b = 0
      e = 0
    Else
      k = PmOpT(8 + d)
      st = PmOpT(12 + d)
      dl = PmOpT(16 + d)
      b = PmOpT(20 + d)
      e = PmOpT(24 + d)
    EndIf
    span = (k - 1) * dl + 1
    If PmOpT(1) = 1 Or PmOpT(1) = 2
      out = (ext + st - 1) / st
      total = (out - 1) * st + span - ext
      If total < 0
        total = 0
      EndIf
      If PmOpT(1) = 1
        b = total / 2
      Else
        b = total - total / 2
      EndIf
      e = total - b
    Else
      If PmOpT(1) = 3
        b = 0
        e = 0
      EndIf
      If ext + b + e < span
        DFail("A pooling window is larger than the padded input.")
        ProcedureReturn
      EndIf
      out = (ext + b + e - span) / st + 1
      If PmOpT(2) <> 0
        If (ext + b + e - span) % st <> 0
          out = out + 1
        EndIf
        If (out - 1) * st >= ext + b
          out = out - 1
        EndIf
      EndIf
    EndIf
    dims(2 + d) = out
    PmOpI(8 + d) = ext
    PmOpI(12 + d) = out
    PmOpI(16 + d) = k
    PmOpI(20 + d) = st
    PmOpI(24 + d) = dl
    PmOpI(28 + d) = b
    PmOpI(32 + d) = e
    d = d + 1
  Wend
  PmOpI(0) = s
  PmOpI(1) = dims(0)
  PmOpI(2) = dims(1)
  PmOpI(3) = PmOpT(6)
  PmOpI(4) = PmOpT(3)
  PmOpI(5) = PmOpT(4)
  PmOpI(6) = PmOpT(5)
  If DAlloc(Y, 1, s + 2, @dims(0)) = 0
    ProcedureReturn
  EndIf
  If Ind <> 0
    If DAlloc(Ind, 7, s + 2, @dims(0)) = 0
      ProcedureReturn
    EndIf
    PmOpPool(Dt(A)\Data, Dt(Y)\Data, Dt(Ind)\Data)
  Else
    PmOpPool(Dt(A)\Data, Dt(Y)\Data, 0)
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; Split: A split along Axis into the N outputs whose ids are in PmOpN.
; Sizes: Split (a tensor, Split-13 and later) when not 0; else PmOpT(1 ..
; N) when PmOpT(0) = 1 (the attribute, before 13); else equal parts
; (PmOpT(0) = 0), or with PmOpT(0) = 2 (num_outputs, Split-18) parts of
; ceil(extent / N) with a smaller last part.
; ----------------------------------------------------------------------
Procedure DOpSplit(A.i, Split.i, Axis.i, N.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected extent.i
  Protected k.i
  Protected d.i
  Protected size.i
  Protected offset.i
  Protected bytes.i
  Protected chunk.i
  If A = 0 Or N < 1 Or N > 16
    DFail("Split requires an input and one to sixteen outputs.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If Axis < 0
    Axis = Axis + rank
  EndIf
  If Axis < 0 Or Axis >= rank
    DFail("Split axis is outside the input rank.")
    ProcedureReturn
  EndIf
  extent = DOpDim(A, Axis)
  bytes = PmOpKindBytes(Dt(A)\Kind)
  If Split <> 0
    If Dt(Split)\Kind <> 7 Or Dt(Split)\Count <> N
      DFail("Split input split must be an INT64 tensor with one size per output.")
      ProcedureReturn
    EndIf
  EndIf
  ; the sizes first, checked against the extent
  size = 0
  k = 0
  While k < N
    If Split <> 0
      PmOpOffset(k) = DInt(Split, k)
    ElseIf PmOpT(0) = 1
      PmOpOffset(k) = PmOpT(1 + k)
    ElseIf PmOpT(0) = 2
      chunk = (extent + N - 1) / N
      PmOpOffset(k) = chunk
      If size + chunk > extent
        PmOpOffset(k) = extent - size
      EndIf
    Else
      If extent % N <> 0
        DFail("Split without sizes needs an extent that the number of outputs divides.")
        ProcedureReturn
      EndIf
      PmOpOffset(k) = extent / N
    EndIf
    If PmOpOffset(k) < 0
      DFail("Split sizes must not be negative.")
      ProcedureReturn
    EndIf
    size = size + PmOpOffset(k)
    k = k + 1
  Wend
  If size <> extent
    DFail("Split sizes must add up to the extent of the split axis.")
    ProcedureReturn
  EndIf
  d = 0
  While d < rank
    dims(d) = DOpDim(A, d)
    d = d + 1
  Wend
  offset = 0
  k = 0
  While k < N
    size = PmOpOffset(k)
    If PmOpN(k) <> 0
      dims(Axis) = size
      If DAlloc(PmOpN(k), Dt(A)\Kind, rank, @dims(0)) = 0
        ProcedureReturn
      EndIf
      PmOpSlab(Dt(A)\Data, Dt(PmOpN(k))\Data, DProduct(A, 0, Axis - 1), extent, offset, size, DProduct(A, Axis + 1, rank - 1), bytes)
    EndIf
    offset = offset + size
    k = k + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; Tile-13: Repeats an INT64 tensor with one count per axis.
; ----------------------------------------------------------------------
Procedure DOpTile(Y.i, A.i, Repeats.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected d.i
  Protected r.i
  If A = 0 Or Repeats = 0
    DFail("Tile requires input and repeats.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If Dt(Repeats)\Kind <> 7 Or Dt(Repeats)\Count <> rank
    DFail("Tile repeats must be an INT64 tensor with one count per input axis.")
    ProcedureReturn
  EndIf
  d = 0
  While d < rank
    r = DInt(Repeats, d)
    If r < 0
      DFail("Tile repeats must not be negative.")
      ProcedureReturn
    EndIf
    PmOpDA(d) = DOpDim(A, d)
    dims(d) = DOpDim(A, d) * r
    PmOpDY(d) = dims(d)
    d = d + 1
  Wend
  If DAlloc(Y, Dt(A)\Kind, rank, @dims(0)) = 0
    ProcedureReturn
  EndIf
  If Dt(A)\Count > 0
    PmOpTile(Dt(A)\Data, Dt(Y)\Data, rank, PmOpKindBytes(Dt(A)\Kind))
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; DepthToSpace-13 (ToSpace 1; Mode 0 DCR, 1 CRD) and SpaceToDepth-13
; (ToSpace 0) on N x C x H x W, as the specification's reshape, transpose,
; reshape.
; ----------------------------------------------------------------------
Procedure DOpDepthSpace(Y.i, A.i, Block.i, Mode.i, ToSpace.i)
  Protected Dim dims.i(8)
  Protected n.i
  Protected c.i
  Protected h.i
  Protected w.i
  If A = 0
    DFail("DepthToSpace and SpaceToDepth require an input.")
    ProcedureReturn
  EndIf
  If Dt(A)\Rank <> 4 Or Block < 1
    DFail("DepthToSpace and SpaceToDepth take an N x C x H x W input and a positive blocksize.")
    ProcedureReturn
  EndIf
  n = DOpDim(A, 0)
  c = DOpDim(A, 1)
  h = DOpDim(A, 2)
  w = DOpDim(A, 3)
  If ToSpace <> 0
    If c % (Block * Block) <> 0
      DFail("DepthToSpace needs channels divisible by blocksize squared.")
      ProcedureReturn
    EndIf
    c = c / (Block * Block)
    If Mode = 0
      PmOpDA(0) = n
      PmOpDA(1) = Block
      PmOpDA(2) = Block
      PmOpDA(3) = c
      PmOpDA(4) = h
      PmOpDA(5) = w
      PmOpI(40) = 0
      PmOpI(41) = 3
      PmOpI(42) = 4
      PmOpI(43) = 1
      PmOpI(44) = 5
      PmOpI(45) = 2
    Else
      PmOpDA(0) = n
      PmOpDA(1) = c
      PmOpDA(2) = Block
      PmOpDA(3) = Block
      PmOpDA(4) = h
      PmOpDA(5) = w
      PmOpI(40) = 0
      PmOpI(41) = 1
      PmOpI(42) = 4
      PmOpI(43) = 2
      PmOpI(44) = 5
      PmOpI(45) = 3
    EndIf
    dims(0) = n
    dims(1) = c
    dims(2) = h * Block
    dims(3) = w * Block
  Else
    If h % Block <> 0 Or w % Block <> 0
      DFail("SpaceToDepth needs height and width divisible by blocksize.")
      ProcedureReturn
    EndIf
    h = h / Block
    w = w / Block
    PmOpDA(0) = n
    PmOpDA(1) = c
    PmOpDA(2) = h
    PmOpDA(3) = Block
    PmOpDA(4) = w
    PmOpDA(5) = Block
    PmOpI(40) = 0
    PmOpI(41) = 3
    PmOpI(42) = 5
    PmOpI(43) = 1
    PmOpI(44) = 2
    PmOpI(45) = 4
    dims(0) = n
    dims(1) = c * Block * Block
    dims(2) = h
    dims(3) = w
  EndIf
  If DAlloc(Y, Dt(A)\Kind, 4, @dims(0)) = 0
    ProcedureReturn
  EndIf
  If Dt(A)\Count > 0
    PmOpPermute(Dt(A)\Data, Dt(Y)\Data, 6, PmOpKindBytes(Dt(A)\Kind))
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; Trilu-14: K an optional INT64 scalar (0 when absent).
; ----------------------------------------------------------------------
Procedure DOpTrilu(Y.i, A.i, K.i, Upper.i)
  Protected rank.i
  Protected shift.i
  If A = 0
    DFail("Trilu requires an input.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If rank < 2
    DFail("Trilu requires an input of rank two or more.")
    ProcedureReturn
  EndIf
  shift = 0
  If K <> 0
    If Dt(K)\Kind <> 7 Or Dt(K)\Count <> 1
      DFail("Trilu k must be a one-element INT64 tensor.")
      ProcedureReturn
    EndIf
    shift = DInt(K, 0)
  EndIf
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  PmOpTrilu(Dt(A)\Data, Dt(Y)\Data, DProduct(A, 0, rank - 3), DOpDim(A, rank - 2), DOpDim(A, rank - 1), shift, Upper, PmOpKindBytes(Dt(A)\Kind))
EndProcedure

; ----------------------------------------------------------------------
; GatherElements-13.
; ----------------------------------------------------------------------
Procedure DOpGatherElements(Y.i, A.i, Idx.i, Axis.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected d.i
  If A = 0 Or Idx = 0
    DFail("GatherElements requires data and indices.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If Dt(Idx)\Kind <> 6 And Dt(Idx)\Kind <> 7
    DFail("GatherElements indices must be INT32 or INT64.")
    ProcedureReturn
  EndIf
  If rank < 1 Or Dt(Idx)\Rank <> rank
    DFail("GatherElements data and indices must share one rank of at least one.")
    ProcedureReturn
  EndIf
  If Axis < 0
    Axis = Axis + rank
  EndIf
  If Axis < 0 Or Axis >= rank
    DFail("GatherElements axis is outside the data rank.")
    ProcedureReturn
  EndIf
  d = 0
  While d < rank
    PmOpDA(d) = DOpDim(A, d)
    PmOpDB(d) = DOpDim(Idx, d)
    dims(d) = PmOpDB(d)
    If d <> Axis And PmOpDB(d) > PmOpDA(d)
      DFail("GatherElements indices extend past the data on an axis other than the gather axis.")
      ProcedureReturn
    EndIf
    d = d + 1
  Wend
  If DAlloc(Y, Dt(A)\Kind, rank, @dims(0)) = 0
    ProcedureReturn
  EndIf
  If PmOpGatherElements(Dt(A)\Data, Dt(Idx)\Data, Dt(Y)\Data, rank, Axis, PmOpKindBytes(Dt(A)\Kind), Dt(Idx)\Kind) <> 0
    DFail("GatherElements index is outside [-s, s-1] for an axis of extent s.")
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; GatherND-13 with batch_dims.
; ----------------------------------------------------------------------
Procedure DOpGatherND(Y.i, A.i, Idx.i, BatchDims.i)
  Protected Dim dims.i(8)
  Protected r.i
  Protected q.i
  Protected k.i
  Protected d.i
  Protected j.i
  If A = 0 Or Idx = 0
    DFail("GatherND requires data and indices.")
    ProcedureReturn
  EndIf
  If Dt(Idx)\Kind <> 7
    DFail("GatherND indices must be INT64.")
    ProcedureReturn
  EndIf
  r = Dt(A)\Rank
  q = Dt(Idx)\Rank
  If r < 1 Or q < 1 Or BatchDims < 0 Or BatchDims >= q Or BatchDims >= r
    DFail("GatherND needs data and indices of rank one or more and batch_dims below both ranks.")
    ProcedureReturn
  EndIf
  k = DOpDim(Idx, q - 1)
  If k < 1 Or k > r - BatchDims
    DFail("GatherND index tuples must have one to rank(data) - batch_dims entries.")
    ProcedureReturn
  EndIf
  If q - 1 + r - k - BatchDims > 8
    DFail("GatherND output rank exceeds eight.")
    ProcedureReturn
  EndIf
  j = 0
  d = 0
  While d < q - 1
    If d < BatchDims And DOpDim(Idx, d) <> DOpDim(A, d)
      DFail("GatherND batch dimensions of data and indices differ.")
      ProcedureReturn
    EndIf
    dims(j) = DOpDim(Idx, d)
    j = j + 1
    d = d + 1
  Wend
  d = BatchDims + k
  While d < r
    dims(j) = DOpDim(A, d)
    j = j + 1
    d = d + 1
  Wend
  d = 0
  While d < 8
    If d < r
      PmOpDA(d) = DOpDim(A, d)
    EndIf
    If d < q
      PmOpDB(d) = DOpDim(Idx, d)
    EndIf
    d = d + 1
  Wend
  If DAlloc(Y, Dt(A)\Kind, j, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpI(0) = BatchDims
  PmOpI(1) = r
  PmOpI(2) = q
  If PmOpGatherND(Dt(A)\Data, Dt(Idx)\Data, Dt(Y)\Data, PmOpKindBytes(Dt(A)\Kind), 7) <> 0
    DFail("GatherND index is outside [-s, s-1] for an axis of extent s.")
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; OneHot-11: Depth a one-element tensor (FLOAT, INT32 or INT64, a FLOAT
; depth truncated), Values the two-element [off, on] tensor that gives the
; output type.
; ----------------------------------------------------------------------
Procedure DOpOneHot(Y.i, Idx.i, Depth.i, Values.i, Axis.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected depthValue.i
  Protected d.i
  Protected j.i
  If Idx = 0 Or Depth = 0 Or Values = 0
    DFail("OneHot requires indices, depth and values.")
    ProcedureReturn
  EndIf
  If DOpKindOk(Dt(Idx)\Kind, 7) = 0 Or DOpKindOk(Dt(Depth)\Kind, 7) = 0 Or Dt(Depth)\Count <> 1
    DFail("OneHot indices and depth must be FLOAT, INT32 or INT64, and depth one element.")
    ProcedureReturn
  EndIf
  If DOpKindOk(Dt(Values)\Kind, 15) = 0 Or Dt(Values)\Count <> 2
    DFail("OneHot values must be two elements, [off_value, on_value].")
    ProcedureReturn
  EndIf
  If Dt(Depth)\Kind = 1
    depthValue = PmOpTruncInt(PmTensorGet(Dt(Depth)\Data, 0))
  Else
    depthValue = DInt(Depth, 0)
  EndIf
  If depthValue < 1
    DFail("OneHot depth must be at least one.")
    ProcedureReturn
  EndIf
  rank = Dt(Idx)\Rank
  If Axis < 0
    Axis = Axis + rank + 1
  EndIf
  If Axis < 0 Or Axis > rank Or rank + 1 > 8
    DFail("OneHot axis is outside the output rank.")
    ProcedureReturn
  EndIf
  j = 0
  d = 0
  While d <= rank
    If d = Axis
      dims(d) = depthValue
    Else
      dims(d) = DOpDim(Idx, j)
      j = j + 1
    EndIf
    d = d + 1
  Wend
  If DAlloc(Y, Dt(Values)\Kind, rank + 1, @dims(0)) = 0
    ProcedureReturn
  EndIf
  If Dt(Values)\Kind = 1
    PmOpF(0) = PmTensorGet(Dt(Values)\Data, 0)
    PmOpF(1) = PmTensorGet(Dt(Values)\Data, 1)
  Else
    PmOpI(0) = PmOpReadInt(Dt(Values)\Data, 0, Dt(Values)\Kind)
    PmOpI(1) = PmOpReadInt(Dt(Values)\Data, 1, Dt(Values)\Kind)
  EndIf
  PmOpOneHot(Dt(Idx)\Data, Dt(Y)\Data, DProduct(Idx, 0, Axis - 1), depthValue, DProduct(Idx, Axis, rank - 1), Dt(Idx)\Kind, Dt(Values)\Kind)
EndProcedure

; ----------------------------------------------------------------------
; Einsum-12, FLOAT. The compiler parsed the equation: PmOpT(0) operands n
; (their ids in PmOpN), PmOpT(1) labels L, PmOpT(2) output labels Lo;
; PmOpT(4 + k) the rank of operand k and PmOpT(8 + k*8 + a) the label of its
; axis a. The extents and strides follow from the tensors.
; ----------------------------------------------------------------------
Procedure DOpEinsum(Y.i)
  Protected Dim dims.i(8)
  Protected n.i
  Protected labels.i
  Protected kept.i
  Protected k.i
  Protected a.i
  Protected l.i
  Protected id.i
  Protected s.i
  n = PmOpT(0)
  labels = PmOpT(1)
  kept = PmOpT(2)
  l = 0
  While l < 96
    PmOpI(l) = 0
    l = l + 1
  Wend
  l = 0
  While l < labels
    PmOpI(4 + l) = -1
    l = l + 1
  Wend
  k = 0
  While k < n
    id = PmOpN(k)
    If id = 0
      DFail("Einsum operand is missing.")
      ProcedureReturn
    EndIf
    If Dt(id)\Kind <> 1
      DFail("Einsum computes FLOAT operands only.")
      ProcedureReturn
    EndIf
    If Dt(id)\Rank <> PmOpT(4 + k)
      DFail("Einsum operand rank does not match its term in the equation.")
      ProcedureReturn
    EndIf
    s = 1
    a = Dt(id)\Rank - 1
    While a >= 0
      l = PmOpT(8 + k * 8 + a)
      If PmOpI(4 + l) >= 0 And PmOpI(4 + l) <> DOpDim(id, a)
        DFail("Einsum label extents disagree between operands.")
        ProcedureReturn
      EndIf
      PmOpI(4 + l) = DOpDim(id, a)
      PmOpI(20 + k * 16 + l) = PmOpI(20 + k * 16 + l) + s
      s = s * DOpDim(id, a)
      a = a - 1
    Wend
    PmOpAddr(k) = Dt(id)\Data
    k = k + 1
  Wend
  PmOpI(0) = n
  PmOpI(1) = labels
  PmOpI(2) = kept
  l = 0
  While l < kept
    dims(l) = PmOpI(4 + l)
    l = l + 1
  Wend
  If DAlloc(Y, 1, kept, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpEinsum(Dt(Y)\Data)
EndProcedure

; ----------------------------------------------------------------------
; Dropout in inference: Y a copy of A; Mask (when named) all true. Training
; (training_mode, when named) true with a nonzero Ratio would draw random
; masks, which is not implemented.
; ----------------------------------------------------------------------
Procedure DOpDropout(Y.i, Mask.i, A.i, Ratio.i, Training.i)
  Protected i.i
  Protected ratioZero.i
  If A = 0
    DFail("Dropout requires data.")
    ProcedureReturn
  EndIf
  If Training <> 0
    If Dt(Training)\Count <> 1
      DFail("Dropout training_mode must be one element.")
      ProcedureReturn
    EndIf
    If DInt(Training, 0) <> 0
      ratioZero = 0
      If Ratio <> 0
        If Dt(Ratio)\Kind = 1 And Dt(Ratio)\Count = 1
          If (PeekL(Dt(Ratio)\Data) & $7FFFFFFF) = 0
            ratioZero = 1
          EndIf
        EndIf
      EndIf
      If ratioZero = 0
        DFail("Dropout with training_mode true and a nonzero ratio draws random masks, which runtime-dimension emission does not implement.")
        ProcedureReturn
      EndIf
    EndIf
  EndIf
  If Y <> 0
    If DLike(Y, A, 0) = 0
      ProcedureReturn
    EndIf
    PmOpCopyBytes(Dt(A)\Data, Dt(Y)\Data, Dt(A)\Bytes)
  EndIf
  If Mask <> 0
    If DLike(Mask, A, 9) = 0
      ProcedureReturn
    EndIf
    i = 0
    While i < Dt(Mask)\Count
      PokeA(Dt(Mask)\Data + i, 1)
      i = i + 1
    Wend
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; Size: the element count of A as an INT64 scalar.
; ----------------------------------------------------------------------
Procedure DOpSize(Y.i, A.i)
  Protected Dim dims.i(8)
  If A = 0
    DFail("Size requires an input.")
    ProcedureReturn
  EndIf
  If DAlloc(Y, 7, 0, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmTensorPutI64(Dt(Y)\Data, 0, Dt(A)\Count)
EndProcedure

; The axis of a FLOAT input of rank one or more, inside its rank, or -1.
Procedure.i DOpFloatAxis(A.i, Axis.i)
  If A = 0
    ProcedureReturn -1
  EndIf
  If Dt(A)\Kind <> 1 Or Dt(A)\Rank < 1
    ProcedureReturn -1
  EndIf
  If Axis < 0
    Axis = Axis + Dt(A)\Rank
  EndIf
  If Axis < 0 Or Axis >= Dt(A)\Rank
    ProcedureReturn -1
  EndIf
  ProcedureReturn Axis
EndProcedure

; ----------------------------------------------------------------------
; Hardmax-13 and LpNormalization-1 (P 1 or 2) along Axis, FLOAT.
; ----------------------------------------------------------------------
Procedure DOpHardmax(Y.i, A.i, Axis.i)
  Protected rank.i
  Axis = DOpFloatAxis(A, Axis)
  If Axis < 0
    DFail("Hardmax takes a FLOAT input of rank one or more and an axis inside its rank.")
    ProcedureReturn
  EndIf
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If Dt(A)\Count > 0
    PmOpHardmax(Dt(A)\Data, Dt(Y)\Data, DProduct(A, 0, Axis - 1), DOpDim(A, Axis), DProduct(A, Axis + 1, rank - 1))
  EndIf
EndProcedure

Procedure DOpLpNorm(Y.i, A.i, Axis.i, P.i)
  Protected rank.i
  Axis = DOpFloatAxis(A, Axis)
  If Axis < 0
    DFail("LpNormalization takes a FLOAT input of rank one or more and an axis inside its rank.")
    ProcedureReturn
  EndIf
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  PmOpLpNorm(Dt(A)\Data, Dt(Y)\Data, DProduct(A, 0, Axis - 1), DOpDim(A, Axis), DProduct(A, Axis + 1, rank - 1), P)
EndProcedure

; ----------------------------------------------------------------------
; MeanVarianceNormalization-13: PmOpT(0) axes given (0: the default
; [0, 2, 3]), PmOpT(1 ..) the axes.
; ----------------------------------------------------------------------
Procedure DOpMvn(Y.i, A.i)
  Protected rank.i
  Protected mask.i
  Protected i.i
  Protected axis.i
  If A = 0
    DFail("MeanVarianceNormalization requires an input.")
    ProcedureReturn
  EndIf
  If Dt(A)\Kind <> 1
    DFail("MeanVarianceNormalization computes FLOAT tensors only.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  mask = 0
  If PmOpT(0) = 0
    If rank < 4
      DFail("MeanVarianceNormalization's default axes [0, 2, 3] need an input of rank four or more.")
      ProcedureReturn
    EndIf
    mask = 13
  EndIf
  i = 0
  While i < PmOpT(0)
    axis = PmOpT(1 + i)
    If axis < 0
      axis = axis + rank
    EndIf
    If axis < 0 Or axis >= rank
      DFail("A MeanVarianceNormalization axis is outside the input rank.")
      ProcedureReturn
    EndIf
    mask = mask | (1 << axis)
    i = i + 1
  Wend
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  i = 0
  While i < rank
    PmOpDA(i) = DOpDim(A, i)
    i = i + 1
  Wend
  PmOpMvn(Dt(A)\Data, Dt(Y)\Data, rank, mask)
EndProcedure

; ----------------------------------------------------------------------
; LRN-13 (PmOpF(0..2) alpha, beta, bias set by the call) and
; GroupNormalization-18 (PmOpF(0) epsilon).
; ----------------------------------------------------------------------
Procedure DOpLrn(Y.i, A.i, Size.i)
  If A = 0
    DFail("LRN requires an input.")
    ProcedureReturn
  EndIf
  If Dt(A)\Kind <> 1 Or Dt(A)\Rank < 3
    DFail("LRN takes a FLOAT input N x C x D1 ... Dk.")
    ProcedureReturn
  EndIf
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  PmOpLrn(Dt(A)\Data, Dt(Y)\Data, DOpDim(A, 0), DOpDim(A, 1), DProduct(A, 2, Dt(A)\Rank - 1), Size)
EndProcedure

Procedure DOpGroupNorm(Y.i, A.i, S.i, B.i, Groups.i)
  If A = 0 Or S = 0 Or B = 0
    DFail("GroupNormalization requires X, scale and bias.")
    ProcedureReturn
  EndIf
  If Dt(A)\Kind <> 1 Or Dt(S)\Kind <> 1 Or Dt(B)\Kind <> 1 Or Dt(A)\Rank < 3
    DFail("GroupNormalization takes FLOAT X (N x C x D1 ... Dn), scale and bias.")
    ProcedureReturn
  EndIf
  If Groups < 1 Or DOpDim(A, 1) % Groups <> 0 Or Dt(S)\Count <> Groups Or Dt(B)\Count <> Groups
    DFail("GroupNormalization num_groups must divide the channels, and scale and bias hold one value per group.")
    ProcedureReturn
  EndIf
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  PmOpGroupNorm(Dt(A)\Data, Dt(S)\Data, Dt(B)\Data, Dt(Y)\Data, DOpDim(A, 0), DOpDim(A, 1), DProduct(A, 2, Dt(A)\Rank - 1), Groups)
EndProcedure

; ----------------------------------------------------------------------
; EyeLike-9 (Kind 0: the input's element type), Det-11.
; ----------------------------------------------------------------------
Procedure DOpEyeLike(Y.i, A.i, Kind.i, K.i)
  If A = 0
    DFail("EyeLike requires an input.")
    ProcedureReturn
  EndIf
  If Dt(A)\Rank <> 2
    DFail("EyeLike takes a two-dimensional input.")
    ProcedureReturn
  EndIf
  If Kind = 0
    Kind = Dt(A)\Kind
  EndIf
  If DOpKindOk(Kind, 15) = 0
    DFail("EyeLike makes FLOAT, INT32, INT64 and BOOL tensors only.")
    ProcedureReturn
  EndIf
  If DLike(Y, A, Kind) = 0
    ProcedureReturn
  EndIf
  PmOpEyeLike(Dt(Y)\Data, DOpDim(A, 0), DOpDim(A, 1), K, Kind)
EndProcedure

Procedure DOpDet(Y.i, A.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected n.i
  Protected d.i
  Protected scratch.i
  If A = 0
    DFail("Det requires an input.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If Dt(A)\Kind <> 1 Or rank < 2
    DFail("Det takes FLOAT square matrices, [*, M, M].")
    ProcedureReturn
  EndIf
  n = DOpDim(A, rank - 1)
  If DOpDim(A, rank - 2) <> n
    DFail("Det takes FLOAT square matrices, [*, M, M].")
    ProcedureReturn
  EndIf
  d = 0
  While d < rank - 2
    dims(d) = DOpDim(A, d)
    d = d + 1
  Wend
  If DAlloc(Y, 1, rank - 2, @dims(0)) = 0
    ProcedureReturn
  EndIf
  If Dt(Y)\Count = 0
    ProcedureReturn
  EndIf
  scratch = DNsScratch(n * n * 4)
  If scratch = 0
    ProcedureReturn
  EndIf
  PmOpDet(Dt(A)\Data, Dt(Y)\Data, Dt(Y)\Count, n, scratch)
  DNsScratchFree(scratch, n * n * 4)
EndProcedure

; ----------------------------------------------------------------------
; Compress-11 (HasAxis 0: the flattened input) and ReverseSequence-10.
; ----------------------------------------------------------------------
Procedure DOpCompress(Y.i, A.i, Cond.i, Axis.i, HasAxis.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected outer.i
  Protected width.i
  Protected inner.i
  Protected kept.i
  Protected i.i
  If A = 0 Or Cond = 0
    DFail("Compress requires input and condition.")
    ProcedureReturn
  EndIf
  If Dt(Cond)\Kind <> 9 Or Dt(Cond)\Rank <> 1
    DFail("Compress condition must be a one-dimensional BOOL tensor.")
    ProcedureReturn
  EndIf
  If DOpKindOk(Dt(A)\Kind, 15) = 0
    DFail("Compress computes FLOAT, INT32, INT64 and BOOL tensors only.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If HasAxis = 0
    outer = 1
    width = Dt(A)\Count
    inner = 1
  Else
    If Axis < 0
      Axis = Axis + rank
    EndIf
    If Axis < 0 Or Axis >= rank
      DFail("Compress axis is outside the input rank.")
      ProcedureReturn
    EndIf
    outer = DProduct(A, 0, Axis - 1)
    width = DOpDim(A, Axis)
    inner = DProduct(A, Axis + 1, rank - 1)
  EndIf
  If Dt(Cond)\Count > width
    DFail("Compress condition is longer than the axis it selects from.")
    ProcedureReturn
  EndIf
  kept = 0
  i = 0
  While i < Dt(Cond)\Count
    If PeekA(Dt(Cond)\Data + i) <> 0
      kept = kept + 1
    EndIf
    i = i + 1
  Wend
  If HasAxis = 0
    dims(0) = kept
    If DAlloc(Y, Dt(A)\Kind, 1, @dims(0)) = 0
      ProcedureReturn
    EndIf
  Else
    i = 0
    While i < rank
      dims(i) = DOpDim(A, i)
      i = i + 1
    Wend
    dims(Axis) = kept
    If DAlloc(Y, Dt(A)\Kind, rank, @dims(0)) = 0
      ProcedureReturn
    EndIf
  EndIf
  If Dt(Y)\Count > 0
    PmOpCompress(Dt(A)\Data, Dt(Cond)\Data, Dt(Y)\Data, outer, width, inner, PmOpKindBytes(Dt(A)\Kind), Dt(Cond)\Count)
  EndIf
EndProcedure

Procedure DOpReverseSequence(Y.i, A.i, Lens.i, TimeAxis.i, BatchAxis.i)
  Protected rank.i
  If A = 0 Or Lens = 0
    DFail("ReverseSequence requires input and sequence_lens.")
    ProcedureReturn
  EndIf
  rank = Dt(A)\Rank
  If rank < 2 Or DOpKindOk(Dt(A)\Kind, 15) = 0 Or Dt(Lens)\Kind <> 7
    DFail("ReverseSequence takes a FLOAT, INT32, INT64 or BOOL input of rank two or more and INT64 sequence_lens.")
    ProcedureReturn
  EndIf
  If Dt(Lens)\Count <> DOpDim(A, BatchAxis)
    DFail("ReverseSequence sequence_lens must hold one length per batch.")
    ProcedureReturn
  EndIf
  If DLike(Y, A, 0) = 0
    ProcedureReturn
  EndIf
  If PmOpReverseSequence(Dt(A)\Data, Dt(Lens)\Data, Dt(Y)\Data, DOpDim(A, 0), DOpDim(A, 1), DProduct(A, 2, rank - 1), Bool(TimeAxis = 0), PmOpKindBytes(Dt(A)\Kind), 7) <> 0
    DFail("ReverseSequence sequence length is outside 0 .. the time extent.")
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; RNN-14 and GRU-14 (Gru 1), layout 0. The call has set PmOpI(5) direction,
; 7 linear_before_reset, 8 clip given, 10 .. 13 the activations and
; PmOpF(0) clip; the shapes are checked and set here.
; ----------------------------------------------------------------------
Procedure DOpRecurrent(Y.i, YH.i, X.i, W.i, R.i, B.i, L.i, H0.i, Gru.i)
  Protected Dim dims.i(8)
  Protected steps.i
  Protected batch.i
  Protected isz.i
  Protected hsz.i
  Protected dirs.i
  Protected gates.i
  Protected bytes.i
  Protected scratch.i
  Protected yAt.i
  Protected yhAt.i
  If X = 0 Or W = 0 Or R = 0
    DFail("RNN and GRU require X, W and R.")
    ProcedureReturn
  EndIf
  If Dt(X)\Kind <> 1 Or Dt(W)\Kind <> 1 Or Dt(R)\Kind <> 1 Or Dt(X)\Rank <> 3 Or Dt(W)\Rank <> 3 Or Dt(R)\Rank <> 3
    DFail("RNN and GRU take FLOAT X, W and R of rank three.")
    ProcedureReturn
  EndIf
  gates = 1
  If Gru <> 0
    gates = 3
  EndIf
  steps = DOpDim(X, 0)
  batch = DOpDim(X, 1)
  isz = DOpDim(X, 2)
  dirs = DOpDim(W, 0)
  hsz = DOpDim(R, 2)
  If dirs <> 1 + Bool(PmOpI(5) = 2) Or DOpDim(W, 1) <> gates * hsz Or DOpDim(W, 2) <> isz Or DOpDim(R, 0) <> dirs Or DOpDim(R, 1) <> gates * hsz
    DFail("RNN and GRU weights do not match the input, the hidden size and the direction.")
    ProcedureReturn
  EndIf
  If B <> 0
    If Dt(B)\Kind <> 1 Or Dt(B)\Count <> dirs * 2 * gates * hsz
      DFail("RNN and GRU B must be FLOAT [directions, 2 * gates * hidden].")
      ProcedureReturn
    EndIf
  EndIf
  If L <> 0
    If Dt(L)\Kind <> 6 Or Dt(L)\Count <> batch
      DFail("RNN and GRU sequence_lens must be INT32 with one length per batch.")
      ProcedureReturn
    EndIf
  EndIf
  If H0 <> 0
    If Dt(H0)\Kind <> 1 Or Dt(H0)\Count <> dirs * batch * hsz
      DFail("RNN and GRU initial_h must be FLOAT [directions, batch, hidden].")
      ProcedureReturn
    EndIf
  EndIf
  yAt = 0
  yhAt = 0
  If Y <> 0
    dims(0) = steps
    dims(1) = dirs
    dims(2) = batch
    dims(3) = hsz
    If DAlloc(Y, 1, 4, @dims(0)) = 0
      ProcedureReturn
    EndIf
    yAt = Dt(Y)\Data
  EndIf
  If YH <> 0
    dims(0) = dirs
    dims(1) = batch
    dims(2) = hsz
    If DAlloc(YH, 1, 3, @dims(0)) = 0
      ProcedureReturn
    EndIf
    yhAt = Dt(YH)\Data
  EndIf
  bytes = (dirs * batch * hsz + 3 * hsz) * 4
  scratch = DNsScratch(bytes)
  If scratch = 0
    ProcedureReturn
  EndIf
  PmOpI(0) = steps
  PmOpI(1) = batch
  PmOpI(2) = isz
  PmOpI(3) = hsz
  PmOpI(4) = dirs
  PmOpI(6) = Gru
  If B <> 0
    B = Dt(B)\Data
  EndIf
  If L <> 0
    L = Dt(L)\Data
  EndIf
  If H0 <> 0
    H0 = Dt(H0)\Data
  EndIf
  PmOpRecurrent(Dt(X)\Data, Dt(W)\Data, Dt(R)\Data, B, L, H0, yAt, yhAt, scratch)
  DNsScratchFree(scratch, bytes)
EndProcedure

; ----------------------------------------------------------------------
; NonMaxSuppression-11. The selected triples are gathered in scratch, then
; the INT64 output [selected, 3] is allocated and filled.
; ----------------------------------------------------------------------
Procedure DOpNms(Y.i, Boxes.i, Scores.i, MaxOut.i, Iou.i, ScoreThr.i, Center.i)
  Protected Dim dims.i(8)
  Protected nb.i
  Protected nc.i
  Protected n.i
  Protected limit.i
  Protected selBytes.i
  Protected orderBytes.i
  Protected sel.i
  Protected order.i
  Protected count.i
  If Boxes = 0 Or Scores = 0
    DFail("NonMaxSuppression requires boxes and scores.")
    ProcedureReturn
  EndIf
  If Dt(Boxes)\Kind <> 1 Or Dt(Scores)\Kind <> 1 Or Dt(Boxes)\Rank <> 3 Or Dt(Scores)\Rank <> 3
    DFail("NonMaxSuppression takes FLOAT boxes [B, N, 4] and scores [B, C, N].")
    ProcedureReturn
  EndIf
  nb = DOpDim(Boxes, 0)
  n = DOpDim(Boxes, 1)
  nc = DOpDim(Scores, 1)
  If DOpDim(Boxes, 2) <> 4 Or DOpDim(Scores, 0) <> nb Or DOpDim(Scores, 2) <> n
    DFail("NonMaxSuppression takes FLOAT boxes [B, N, 4] and scores [B, C, N].")
    ProcedureReturn
  EndIf
  limit = 0
  If MaxOut <> 0
    If Dt(MaxOut)\Kind <> 7 Or Dt(MaxOut)\Count <> 1
      DFail("NonMaxSuppression max_output_boxes_per_class must be one INT64 element.")
      ProcedureReturn
    EndIf
    limit = DInt(MaxOut, 0)
    If limit < 0
      limit = 0
    EndIf
  EndIf
  PmOpF(0) = 0.0
  PmOpF(1) = 0.0
  PmOpI(4) = 0
  If Iou <> 0
    If Dt(Iou)\Kind <> 1 Or Dt(Iou)\Count <> 1
      DFail("NonMaxSuppression iou_threshold must be one FLOAT element.")
      ProcedureReturn
    EndIf
    PmOpF(0) = PmTensorGet(Dt(Iou)\Data, 0)
  EndIf
  If ScoreThr <> 0
    If Dt(ScoreThr)\Kind <> 1 Or Dt(ScoreThr)\Count <> 1
      DFail("NonMaxSuppression score_threshold must be one FLOAT element.")
      ProcedureReturn
    EndIf
    PmOpF(1) = PmTensorGet(Dt(ScoreThr)\Data, 0)
    PmOpI(4) = 1
  EndIf
  PmOpI(0) = nb
  PmOpI(1) = nc
  PmOpI(2) = n
  PmOpI(3) = limit
  PmOpI(5) = Bool(Center <> 0)
  selBytes = nb * nc * n * 24 + 8
  orderBytes = 3 * n * 4 + 4
  sel = DNsScratch(selBytes)
  If sel = 0
    ProcedureReturn
  EndIf
  order = DNsScratch(orderBytes)
  If order = 0
    DNsScratchFree(sel, selBytes)
    ProcedureReturn
  EndIf
  count = PmOpNms(Dt(Boxes)\Data, Dt(Scores)\Data, sel, order)
  dims(0) = count
  dims(1) = 3
  If DAlloc(Y, 7, 2, @dims(0)) <> 0
    PmOpCopyBytes(sel, Dt(Y)\Data, count * 24)
  EndIf
  DNsScratchFree(order, orderBytes)
  DNsScratchFree(sel, selBytes)
EndProcedure

; ----------------------------------------------------------------------
; RoiAlign-16. The call has set PmOpI(5 .. 9) and PmOpF(0).
; ----------------------------------------------------------------------
Procedure DOpRoiAlign(Y.i, X.i, Rois.i, Idx.i)
  Protected Dim dims.i(8)
  If X = 0 Or Rois = 0 Or Idx = 0
    DFail("RoiAlign requires X, rois and batch_indices.")
    ProcedureReturn
  EndIf
  If Dt(X)\Kind <> 1 Or Dt(X)\Rank <> 4 Or Dt(Rois)\Kind <> 1 Or Dt(Rois)\Rank <> 2 Or Dt(Idx)\Kind <> 7
    DFail("RoiAlign takes FLOAT X [N, C, H, W], FLOAT rois [R, 4] and INT64 batch_indices [R].")
    ProcedureReturn
  EndIf
  If DOpDim(Rois, 1) <> 4 Or Dt(Idx)\Count <> DOpDim(Rois, 0)
    DFail("RoiAlign takes FLOAT X [N, C, H, W], FLOAT rois [R, 4] and INT64 batch_indices [R].")
    ProcedureReturn
  EndIf
  PmOpI(0) = DOpDim(X, 0)
  PmOpI(1) = DOpDim(X, 1)
  PmOpI(2) = DOpDim(X, 2)
  PmOpI(3) = DOpDim(X, 3)
  PmOpI(4) = DOpDim(Rois, 0)
  dims(0) = PmOpI(4)
  dims(1) = PmOpI(1)
  dims(2) = PmOpI(5)
  dims(3) = PmOpI(6)
  If DAlloc(Y, 1, 4, @dims(0)) = 0
    ProcedureReturn
  EndIf
  If PmOpRoiAlign(Dt(X)\Data, Dt(Rois)\Data, Dt(Idx)\Data, Dt(Y)\Data) <> 0
    DFail("RoiAlign batch index is outside the input's batch.")
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; GridSample-16 and -20: Mode and Pad as PmOpGridSample takes them; NDim is
; 1 for GridSample-20 (one to three spatial axes), 0 for -16 (two).
; ----------------------------------------------------------------------
Procedure DOpGridSample(Y.i, X.i, G.i, Mode.i, Pad.i, Align.i, NDim.i)
  Protected Dim dims.i(8)
  Protected r.i
  Protected k.i
  If X = 0 Or G = 0
    DFail("GridSample requires X and grid.")
    ProcedureReturn
  EndIf
  If Dt(X)\Kind <> 1 Or Dt(G)\Kind <> 1
    DFail("GridSample computes FLOAT X and grid only.")
    ProcedureReturn
  EndIf
  r = Dt(X)\Rank - 2
  k = 0
  If r < 1 Or r > 3
    k = 1
  EndIf
  If r <> 2
    If NDim = 0 Or Mode = 2
      k = 1
    EndIf
  EndIf
  If k <> 0
    DFail("GridSample takes X [N, C, H, W] (GridSample-20 also [N, C, W] and [N, C, D, H, W], not with cubic mode).")
    ProcedureReturn
  EndIf
  If Dt(G)\Rank <> r + 2
    DFail("GridSample grid must be [N, output extents ..., spatial rank].")
    ProcedureReturn
  EndIf
  If DOpDim(G, 0) <> DOpDim(X, 0) Or DOpDim(G, r + 1) <> r
    DFail("GridSample grid must be [N, output extents ..., spatial rank].")
    ProcedureReturn
  EndIf
  PmOpI(0) = DOpDim(X, 0)
  PmOpI(1) = DOpDim(X, 1)
  PmOpI(2) = r
  dims(0) = PmOpI(0)
  dims(1) = PmOpI(1)
  k = 0
  While k < r
    PmOpI(3 + k) = DOpDim(X, 2 + k)
    PmOpI(6 + k) = DOpDim(G, 1 + k)
    dims(2 + k) = PmOpI(6 + k)
    k = k + 1
  Wend
  PmOpI(9) = Mode
  PmOpI(10) = Pad
  PmOpI(11) = Align
  If DAlloc(Y, 1, r + 2, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpGridSample(Dt(X)\Data, Dt(G)\Data, Dt(Y)\Data)
EndProcedure

; ----------------------------------------------------------------------
; QuantizeLinear (Quant 1) and DequantizeLinear (0), opsets 10 to 20: a
; scale and zero point of one value, or (PerAxis 1, opset 13 on) one per
; element of Axis.
; ----------------------------------------------------------------------
Procedure DOpQuantize(Y.i, X.i, S.i, Z.i, Axis.i, Quant.i, PerAxis.i)
  Protected rank.i
  Protected per.i
  Protected kind.i
  Protected d.i
  Protected outer.i
  Protected inner.i
  Protected zAddr.i
  If X = 0 Or S = 0
    DFail("A quantize operator requires its input and scale.")
    ProcedureReturn
  EndIf
  kind = Dt(X)\Kind
  If Quant <> 0
    If kind <> 1
      DFail("QuantizeLinear quantizes FLOAT x only.")
      ProcedureReturn
    EndIf
  ElseIf kind <> 2 And kind <> 3 And kind <> 6
    DFail("DequantizeLinear takes UINT8, INT8 or INT32 x.")
    ProcedureReturn
  EndIf
  If Dt(S)\Kind <> 1 Or Dt(S)\Rank > 1
    DFail("The scale must be FLOAT, one value or a 1-D tensor.")
    ProcedureReturn
  EndIf
  rank = Dt(X)\Rank
  If Axis < 0
    Axis = Axis + rank
  EndIf
  per = 0
  If Dt(S)\Count <> 1
    If PerAxis = 0
      DFail("The scale holds more than one value; before opset 13 it is one value.")
      ProcedureReturn
    EndIf
    If Axis < 0 Or Axis >= rank
      DFail("The quantization axis is outside the input rank.")
      ProcedureReturn
    EndIf
    If Dt(S)\Count <> DOpDim(X, Axis)
      DFail("The scale must hold one value per element of the quantization axis.")
      ProcedureReturn
    EndIf
    per = 1
  EndIf
  zAddr = 0
  If Z <> 0
    If Dt(Z)\Count <> Dt(S)\Count
      DFail("The zero point must hold as many values as the scale.")
      ProcedureReturn
    EndIf
    If Quant <> 0
      If Dt(Z)\Kind <> 2 And Dt(Z)\Kind <> 3
        DFail("QuantizeLinear's zero point must be UINT8 or INT8.")
        ProcedureReturn
      EndIf
    ElseIf Dt(Z)\Kind <> kind
      DFail("DequantizeLinear's zero point must have the element type of x.")
      ProcedureReturn
    EndIf
    zAddr = Dt(Z)\Data
  EndIf
  outer = Dt(X)\Count
  inner = 1
  PmOpI(1) = 1
  If per <> 0
    outer = 1
    d = 0
    While d < Axis
      outer = outer * DOpDim(X, d)
      d = d + 1
    Wend
    d = Axis + 1
    While d < rank
      inner = inner * DOpDim(X, d)
      d = d + 1
    Wend
    PmOpI(1) = DOpDim(X, Axis)
  EndIf
  PmOpI(0) = outer
  PmOpI(2) = inner
  PmOpI(3) = per
  If Quant <> 0
    PmOpI(4) = 0
    PmOpI(5) = 2
    If Z <> 0
      PmOpI(4) = Dt(Z)\Kind
      PmOpI(5) = Dt(Z)\Kind
    EndIf
    If DLike(Y, X, PmOpI(5)) = 0
      ProcedureReturn
    EndIf
    PmOpQuantize(Dt(X)\Data, Dt(S)\Data, zAddr, Dt(Y)\Data)
  Else
    PmOpI(4) = kind
    PmOpI(5) = 0
    If Z <> 0
      PmOpI(5) = 1
    EndIf
    If DLike(Y, X, 1) = 0
      ProcedureReturn
    EndIf
    PmOpDequantize(Dt(X)\Data, Dt(S)\Data, zAddr, Dt(Y)\Data)
  EndIf
EndProcedure

; DynamicQuantizeLinear-11.
Procedure DOpDynQuantize(Y.i, YS.i, YZ.i, X.i)
  If X = 0 Or Y = 0 Or YS = 0 Or YZ = 0
    DFail("DynamicQuantizeLinear requires its input and all three outputs.")
    ProcedureReturn
  EndIf
  If Dt(X)\Kind <> 1
    DFail("DynamicQuantizeLinear quantizes FLOAT x only.")
    ProcedureReturn
  EndIf
  If DLike(Y, X, 2) = 0
    ProcedureReturn
  EndIf
  If DShape(YS, 1, 0, 0, 0, 0, 0) = 0
    ProcedureReturn
  EndIf
  If DShape(YZ, 2, 0, 0, 0, 0, 0) = 0
    ProcedureReturn
  EndIf
  If PmOpDynQuantize(Dt(X)\Data, Dt(Y)\Data, Dt(YS)\Data, Dt(YZ)\Data, Dt(X)\Count) <> 0
    DFail("DynamicQuantizeLinear input holds a NaN or an infinity; its scale is not defined then.")
  EndIf
EndProcedure

; One value (1), or one per element of Extent in a 1-D tensor (2); 0 otherwise.
Procedure.i DOpQCount(V.i, Extent.i)
  If Dt(V)\Count = 1 And Dt(V)\Rank <= 1
    ProcedureReturn 1
  EndIf
  If Dt(V)\Rank = 1 And Dt(V)\Count = Extent
    ProcedureReturn 2
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i DOpQKind(V.i)
  If Dt(V)\Kind = 2 Or Dt(V)\Kind = 3
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; MatMulInteger (Mode 0) and QLinearMatMul (1).
Procedure DOpQMatMul(Y.i, A.i, B.i, AZ.i, BZ.i, SA.i, SB.i, SY.i, YZ.i, Mode.i)
  Protected Dim dims.i(8)
  Protected ra.i
  Protected rb.i
  Protected r.i
  Protected d.i
  Protected ea.i
  Protected eb.i
  Protected m.i
  Protected k.i
  Protected n.i
  Protected kb.i
  Protected kind.i
  Protected bzMode.i
  Protected yr.i
  Protected azA.i
  Protected bzA.i
  If A = 0 Or B = 0
    DFail("A quantized matrix product requires both operands.")
    ProcedureReturn
  EndIf
  If DOpQKind(A) = 0 Or DOpQKind(B) = 0
    DFail("A quantized matrix product takes UINT8 or INT8 operands.")
    ProcedureReturn
  EndIf
  ra = Dt(A)\Rank
  rb = Dt(B)\Rank
  If ra < 1 Or rb < 1
    DFail("A quantized matrix product takes operands of rank one or more.")
    ProcedureReturn
  EndIf
  If ra = 1
    m = 1
    k = DOpDim(A, 0)
  Else
    m = DOpDim(A, ra - 2)
    k = DOpDim(A, ra - 1)
  EndIf
  If rb = 1
    kb = DOpDim(B, 0)
    n = 1
  Else
    kb = DOpDim(B, rb - 2)
    n = DOpDim(B, rb - 1)
  EndIf
  If k <> kb
    DFail("The operands' inner extents differ.")
    ProcedureReturn
  EndIf
  r = 0
  If ra > 2
    r = ra - 2
  EndIf
  If rb > 2
    If rb - 2 > r
      r = rb - 2
    EndIf
  EndIf
  If r > 6
    DFail("A quantized matrix product takes at most six batch axes.")
    ProcedureReturn
  EndIf
  d = 0
  While d < r
    ea = 1
    eb = 1
    If ra - 2 - r + d >= 0
      ea = DOpDim(A, ra - 2 - r + d)
    EndIf
    If rb - 2 - r + d >= 0
      eb = DOpDim(B, rb - 2 - r + d)
    EndIf
    If ea <> eb And ea <> 1 And eb <> 1
      DFail("The operands' batch axes do not broadcast.")
      ProcedureReturn
    EndIf
    PmOpDA(d) = ea
    PmOpDB(d) = eb
    PmOpDY(d) = ea
    If ea = 1
      PmOpDY(d) = eb
    EndIf
    dims(d) = PmOpDY(d)
    d = d + 1
  Wend
  yr = r
  If ra > 1
    dims(yr) = m
    yr = yr + 1
  EndIf
  If rb > 1
    dims(yr) = n
    yr = yr + 1
  EndIf
  azA = 0
  If AZ <> 0
    If Dt(AZ)\Kind <> Dt(A)\Kind Or DOpQCount(AZ, 1) <> 1
      DFail("The zero point of A must be one value of A's element type.")
      ProcedureReturn
    EndIf
    azA = Dt(AZ)\Data
  EndIf
  bzMode = 0
  bzA = 0
  If BZ <> 0
    bzMode = DOpQCount(BZ, n)
    If n = 1 And bzMode = 2
      bzMode = 1
    EndIf
    If Dt(BZ)\Kind <> Dt(B)\Kind Or bzMode = 0
      DFail("The zero point of B must be of B's element type, one value or one per column.")
      ProcedureReturn
    EndIf
    bzA = Dt(BZ)\Data
  EndIf
  kind = 6
  PmOpI(9) = 0
  PmOpI(10) = 0
  If Mode <> 0
    If SA = 0 Or SB = 0 Or SY = 0 Or YZ = 0 Or AZ = 0 Or BZ = 0
      DFail("QLinearMatMul requires all eight inputs.")
      ProcedureReturn
    EndIf
    If Dt(SA)\Kind <> 1 Or Dt(SB)\Kind <> 1 Or Dt(SY)\Kind <> 1
      DFail("QLinearMatMul's scales must be FLOAT.")
      ProcedureReturn
    EndIf
    If DOpQCount(SA, 1) <> 1 Or DOpQCount(SY, 1) <> 1 Or DOpQCount(SB, n) = 0
      DFail("QLinearMatMul's a_scale and y_scale must be one value, b_scale one value or one per column.")
      ProcedureReturn
    EndIf
    If DOpQKind(YZ) = 0 Or DOpQCount(YZ, 1) <> 1
      DFail("QLinearMatMul's y_zero_point must be one UINT8 or INT8 value.")
      ProcedureReturn
    EndIf
    kind = Dt(YZ)\Kind
    PmOpI(10) = kind
    If DOpQCount(SB, n) = 2 And n > 1
      PmOpI(9) = 1
    EndIf
  EndIf
  If DAlloc(Y, kind, yr, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpI(0) = r
  PmOpI(1) = m
  PmOpI(2) = k
  PmOpI(3) = n
  PmOpI(4) = Dt(A)\Kind
  PmOpI(5) = Dt(B)\Kind
  PmOpI(6) = 0
  If AZ <> 0
    PmOpI(6) = 1
  EndIf
  PmOpI(7) = bzMode
  PmOpI(8) = Mode
  If Mode <> 0
    PmOpQMatMul(Dt(A)\Data, Dt(B)\Data, azA, bzA, Dt(Y)\Data, Dt(SA)\Data, Dt(SB)\Data, Dt(SY)\Data, Dt(YZ)\Data)
  Else
    PmOpQMatMul(Dt(A)\Data, Dt(B)\Data, azA, bzA, Dt(Y)\Data, 0, 0, 0, 0)
  EndIf
EndProcedure

; ConvInteger (Mode 0) and QLinearConv (1). The call has set PmOpT: (1)
; auto_pad (0 NOTSET, 1 SAME_UPPER, 2 SAME_LOWER, 3 VALID), (2) group, (3 .. 6)
; the numbers of strides, dilations, pads and kernel_shape entries, (8 + d)
; strides, (12 + d) dilations, (16 ..) pads, (24 + d) kernel_shape.
Procedure DOpQConv(Y.i, X.i, W.i, XZ.i, WZ.i, Bias.i, XS.i, WS.i, YS.i, YZ.i, Mode.i)
  Protected Dim dims.i(8)
  Protected s.i
  Protected d.i
  Protected c.i
  Protected m.i
  Protected g.i
  Protected ext.i
  Protected k.i
  Protected st.i
  Protected dl.i
  Protected b.i
  Protected e.i
  Protected span.i
  Protected out.i
  Protected total.i
  Protected kind.i
  Protected wzMode.i
  Protected xzA.i
  Protected wzA.i
  Protected biasA.i
  Protected bad.i
  If X = 0 Or W = 0
    DFail("A quantized convolution requires x and w.")
    ProcedureReturn
  EndIf
  If DOpQKind(X) = 0 Or DOpQKind(W) = 0
    DFail("A quantized convolution takes UINT8 or INT8 x and w.")
    ProcedureReturn
  EndIf
  s = Dt(X)\Rank - 2
  If s < 1 Or s > 3 Or Dt(W)\Rank <> s + 2
    DFail("A quantized convolution takes N x C x D1 ... Ds with one to three spatial axes, and w of the same rank.")
    ProcedureReturn
  EndIf
  bad = 0
  If PmOpT(3) <> 0 And PmOpT(3) <> s
    bad = 1
  EndIf
  If PmOpT(4) <> 0 And PmOpT(4) <> s
    bad = 1
  EndIf
  If PmOpT(5) <> 0 And PmOpT(5) <> 2 * s
    bad = 1
  EndIf
  If PmOpT(6) <> 0 And PmOpT(6) <> s
    bad = 1
  EndIf
  If bad <> 0
    DFail("strides, dilations, pads or kernel_shape do not match the input's spatial rank.")
    ProcedureReturn
  EndIf
  g = PmOpT(2)
  c = DOpDim(X, 1)
  m = DOpDim(W, 0)
  If g < 1
    DFail("group must be positive.")
    ProcedureReturn
  EndIf
  If c <> g * DOpDim(W, 1) Or m % g <> 0
    DFail("group does not divide x's channels and w's filters as w's shape requires.")
    ProcedureReturn
  EndIf
  xzA = 0
  If XZ <> 0
    If Dt(XZ)\Kind <> Dt(X)\Kind Or DOpQCount(XZ, 1) <> 1
      DFail("The zero point of x must be one value of x's element type.")
      ProcedureReturn
    EndIf
    xzA = Dt(XZ)\Data
  EndIf
  wzMode = 0
  wzA = 0
  If WZ <> 0
    wzMode = DOpQCount(WZ, m)
    If m = 1 And wzMode = 2
      wzMode = 1
    EndIf
    If Dt(WZ)\Kind <> Dt(W)\Kind Or wzMode = 0
      DFail("The zero point of w must be of w's element type, one value or one per output channel.")
      ProcedureReturn
    EndIf
    wzA = Dt(WZ)\Data
  EndIf
  kind = 6
  biasA = 0
  PmOpI(46) = 0
  PmOpI(47) = 0
  If Mode <> 0
    If XS = 0 Or WS = 0 Or YS = 0 Or YZ = 0 Or XZ = 0 Or WZ = 0
      DFail("QLinearConv requires inputs 0 to 7.")
      ProcedureReturn
    EndIf
    If Dt(XS)\Kind <> 1 Or Dt(WS)\Kind <> 1 Or Dt(YS)\Kind <> 1
      DFail("QLinearConv's scales must be FLOAT.")
      ProcedureReturn
    EndIf
    If DOpQCount(XS, 1) <> 1 Or DOpQCount(YS, 1) <> 1 Or DOpQCount(WS, m) = 0
      DFail("QLinearConv's x_scale and y_scale must be one value, w_scale one value or one per output channel.")
      ProcedureReturn
    EndIf
    If DOpQKind(YZ) = 0 Or DOpQCount(YZ, 1) <> 1
      DFail("QLinearConv's y_zero_point must be one UINT8 or INT8 value.")
      ProcedureReturn
    EndIf
    If Bias <> 0
      If Dt(Bias)\Kind <> 6 Or Dt(Bias)\Rank <> 1 Or Dt(Bias)\Count <> m
        DFail("QLinearConv's B must be INT32 with one value per output channel.")
        ProcedureReturn
      EndIf
      biasA = Dt(Bias)\Data
    EndIf
    kind = Dt(YZ)\Kind
    PmOpI(47) = kind
    If DOpQCount(WS, m) = 2 And m > 1
      PmOpI(46) = 1
    EndIf
  EndIf
  dims(0) = DOpDim(X, 0)
  dims(1) = m
  d = 0
  While d < s
    ext = DOpDim(X, 2 + d)
    k = DOpDim(W, 2 + d)
    If PmOpT(6) <> 0 And PmOpT(24 + d) <> k
      DFail("kernel_shape does not match w's spatial extents.")
      ProcedureReturn
    EndIf
    st = 1
    dl = 1
    b = 0
    e = 0
    If PmOpT(3) <> 0
      st = PmOpT(8 + d)
    EndIf
    If PmOpT(4) <> 0
      dl = PmOpT(12 + d)
    EndIf
    If PmOpT(5) <> 0
      b = PmOpT(16 + d)
      e = PmOpT(16 + s + d)
    EndIf
    If st < 1 Or dl < 1 Or b < 0 Or e < 0
      DFail("strides and dilations must be positive and pads not negative.")
      ProcedureReturn
    EndIf
    span = (k - 1) * dl + 1
    If PmOpT(1) = 1 Or PmOpT(1) = 2
      out = (ext + st - 1) / st
      total = (out - 1) * st + span - ext
      If total < 0
        total = 0
      EndIf
      If PmOpT(1) = 1
        b = total / 2
      Else
        b = total - total / 2
      EndIf
    Else
      If PmOpT(1) = 3
        b = 0
        e = 0
      EndIf
      out = 0
      If ext + b + e >= span
        out = (ext + b + e - span) / st + 1
      EndIf
    EndIf
    If out < 1
      DFail("The kernel is larger than the padded input.")
      ProcedureReturn
    EndIf
    PmOpI(8 + d) = ext
    PmOpI(12 + d) = out
    PmOpI(16 + d) = k
    PmOpI(20 + d) = st
    PmOpI(24 + d) = dl
    PmOpI(28 + d) = b
    dims(2 + d) = out
    d = d + 1
  Wend
  If DAlloc(Y, kind, s + 2, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpI(0) = s
  PmOpI(1) = DOpDim(X, 0)
  PmOpI(2) = c
  PmOpI(3) = m
  PmOpI(4) = g
  PmOpI(40) = Dt(X)\Kind
  PmOpI(41) = Dt(W)\Kind
  PmOpI(42) = 0
  If XZ <> 0
    PmOpI(42) = 1
  EndIf
  PmOpI(43) = wzMode
  PmOpI(44) = 0
  If biasA <> 0
    PmOpI(44) = 1
  EndIf
  PmOpI(45) = Mode
  If Mode <> 0
    PmOpQConv(Dt(X)\Data, Dt(W)\Data, xzA, wzA, biasA, Dt(Y)\Data, Dt(XS)\Data, Dt(WS)\Data, Dt(YS)\Data, Dt(YZ)\Data)
  Else
    PmOpQConv(Dt(X)\Data, Dt(W)\Data, xzA, wzA, 0, Dt(Y)\Data, 0, 0, 0, 0)
  EndIf
EndProcedure

; ----------------------------------------------------------------------
; HannWindow, HammingWindow, BlackmanWindow (Kind 0, 1, 2), opset 17.
; ----------------------------------------------------------------------
Procedure DOpWindow(Y.i, S.i, Kind.i, Periodic.i)
  Protected Dim dims.i(8)
  Protected size.i
  If S = 0
    DFail("A window operator requires its size.")
    ProcedureReturn
  EndIf
  If (Dt(S)\Kind <> 6 And Dt(S)\Kind <> 7) Or Dt(S)\Count <> 1
    DFail("A window's size must be one INT32 or INT64 value.")
    ProcedureReturn
  EndIf
  size = DInt(S, 0)
  If size < 1
    DFail("A window's size must be positive.")
    ProcedureReturn
  EndIf
  dims(0) = size
  If DAlloc(Y, 1, 1, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpWindow(Dt(Y)\Data, size, Kind, Periodic)
EndProcedure

; ----------------------------------------------------------------------
; DFT-17 and -20. Len and AxisT are the optional dft_length and (DFT-20)
; axis tensors, 0 when absent; Axis is the attribute's axis or -2.
; ----------------------------------------------------------------------
Procedure DOpDft(Y.i, X.i, Len.i, AxisT.i, Axis.i, Inv.i, Ones.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected comp.i
  Protected n.i
  Protected L.i
  Protected d.i
  Protected outer.i
  Protected inner.i
  If X = 0
    DFail("DFT requires an input.")
    ProcedureReturn
  EndIf
  If Dt(X)\Kind <> 1 Or Dt(X)\Rank < 2
    DFail("DFT takes a FLOAT input of rank two or more.")
    ProcedureReturn
  EndIf
  rank = Dt(X)\Rank
  comp = DOpDim(X, rank - 1)
  If comp <> 1 And comp <> 2
    DFail("DFT's last axis must be 1 (real) or 2 (complex).")
    ProcedureReturn
  EndIf
  If AxisT <> 0
    If (Dt(AxisT)\Kind <> 6 And Dt(AxisT)\Kind <> 7) Or Dt(AxisT)\Count <> 1
      DFail("DFT's axis must be one INT32 or INT64 value.")
      ProcedureReturn
    EndIf
    Axis = DInt(AxisT, 0)
  EndIf
  If Axis < 0
    Axis = Axis + rank
  EndIf
  If Axis < 0 Or Axis >= rank - 1
    DFail("DFT's signal axis must be one of the axes before the last.")
    ProcedureReturn
  EndIf
  L = DOpDim(X, Axis)
  If Inv <> 0 And Ones <> 0 And comp <> 2
    DFail("An inverse one-sided DFT takes a complex spectrum.")
    ProcedureReturn
  EndIf
  If Len <> 0
    If (Dt(Len)\Kind <> 6 And Dt(Len)\Kind <> 7) Or Dt(Len)\Count <> 1
      DFail("DFT's dft_length must be one INT32 or INT64 value.")
      ProcedureReturn
    EndIf
    n = DInt(Len, 0)
  ElseIf Inv <> 0 And Ones <> 0
    n = 2 * (L - 1)
  Else
    n = L
  EndIf
  If n < 1
    DFail("DFT's length must be positive.")
    ProcedureReturn
  EndIf
  outer = 1
  inner = 1
  d = 0
  While d < rank
    dims(d) = DOpDim(X, d)
    If d < Axis
      outer = outer * dims(d)
    ElseIf d > Axis And d < rank - 1
      inner = inner * dims(d)
    EndIf
    d = d + 1
  Wend
  dims(Axis) = n
  If Ones <> 0 And Inv = 0
    dims(Axis) = n / 2 + 1
  EndIf
  dims(rank - 1) = 2
  If Ones <> 0 And Inv <> 0
    dims(rank - 1) = 1
  EndIf
  If DAlloc(Y, 1, rank, @dims(0)) = 0
    ProcedureReturn
  EndIf
  PmOpI(0) = outer
  PmOpI(1) = L
  PmOpI(2) = inner
  PmOpI(3) = comp
  PmOpI(4) = n
  PmOpI(5) = Inv
  PmOpI(6) = Ones
  PmOpDft(Dt(X)\Data, Dt(Y)\Data)
EndProcedure

; ----------------------------------------------------------------------
; NegativeLogLikelihoodLoss (Sce 0) and SoftmaxCrossEntropyLoss (1), opsets
; 12 to 20. Code: 0 none, 1 sum, 2 mean. LP the optional log_prob output.
; ----------------------------------------------------------------------
Procedure DOpLoss(Y.i, LP.i, X.i, T.i, W.i, Code.i, HasIgnore.i, Ignore.i, Sce.i)
  Protected Dim dims.i(8)
  Protected rank.i
  Protected n.i
  Protected c.i
  Protected dd.i
  Protected d.i
  Protected lpA.i
  Protected scratch.i
  Protected bytes.i
  If X = 0 Or T = 0
    DFail("A loss operator requires the scores and the target.")
    ProcedureReturn
  EndIf
  If Dt(X)\Kind <> 1 Or Dt(X)\Rank < 2
    DFail("A loss operator takes FLOAT scores [N, C, D1 ...].")
    ProcedureReturn
  EndIf
  If Dt(T)\Kind <> 6 And Dt(T)\Kind <> 7
    DFail("A loss operator's target must be INT32 or INT64.")
    ProcedureReturn
  EndIf
  rank = Dt(X)\Rank
  n = DOpDim(X, 0)
  c = DOpDim(X, 1)
  dd = 1
  d = 2
  While d < rank
    dd = dd * DOpDim(X, d)
    d = d + 1
  Wend
  If Dt(T)\Rank <> rank - 1 Or Dt(T)\Count <> n * dd
    DFail("A loss operator's target must be [N, D1 ...].")
    ProcedureReturn
  EndIf
  If W <> 0
    If Dt(W)\Kind <> 1 Or Dt(W)\Count <> c Or Dt(W)\Rank <> 1
      DFail("A loss operator's weight must be FLOAT [C].")
      ProcedureReturn
    EndIf
  EndIf
  scratch = 0
  bytes = 0
  lpA = Dt(X)\Data
  If Sce <> 0
    If LP <> 0
      If DLike(LP, X, 0) = 0
        ProcedureReturn
      EndIf
      lpA = Dt(LP)\Data
    Else
      bytes = Dt(X)\Count * 4
      scratch = DNsScratch(bytes)
      If scratch = 0
        ProcedureReturn
      EndIf
      lpA = scratch
    EndIf
    PmOpLogSoftmax(Dt(X)\Data, lpA, n, c, dd)
  EndIf
  If Code = 0
    d = 0
    While d < rank - 1
      dims(d) = DOpDim(T, d)
      d = d + 1
    Wend
    If DAlloc(Y, 1, rank - 1, @dims(0)) = 0
      If scratch <> 0
        DNsScratchFree(scratch, bytes)
      EndIf
      ProcedureReturn
    EndIf
  ElseIf DAlloc(Y, 1, 0, @dims(0)) = 0
    If scratch <> 0
      DNsScratchFree(scratch, bytes)
    EndIf
    ProcedureReturn
  EndIf
  PmOpI(0) = n
  PmOpI(1) = c
  PmOpI(2) = dd
  PmOpI(3) = Dt(T)\Kind
  PmOpI(4) = Code
  PmOpI(5) = HasIgnore
  PmOpI(6) = Ignore
  PmOpI(7) = 0
  If W <> 0
    PmOpI(7) = 1
    d = PmOpNllLoss(lpA, Dt(T)\Data, Dt(W)\Data, Dt(Y)\Data)
  Else
    d = PmOpNllLoss(lpA, Dt(T)\Data, 0, Dt(Y)\Data)
  EndIf
  If scratch <> 0
    DNsScratchFree(scratch, bytes)
  EndIf
  If d <> 0
    DFail("A loss target is outside the classes and is not ignore_index.")
  EndIf
EndProcedure
