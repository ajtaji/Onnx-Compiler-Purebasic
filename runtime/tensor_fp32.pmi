; Sin and Cos, correctly rounded (C6c-3), for a program that uses them
; (#PMO_USE_TRIG): the same bits as the Windows program on every target (whose
; own Sin and Cos are corrected at six arguments in tensor_fp32_windows.pbi).
; One exact integer method: 32-bit words on the Pico and the Pi 4, UMULL/UMAAL
; assembly on the Pico 2, run on every binary32 argument on each target.
; NaN is x86's: a NaN argument comes back quieted, an infinity gives FFC00000.
CompilerIf #PMO_USE_TRIG = 1
CompilerIf #PMO_INT8_BACKEND = 3
; sin (op 0) and cos (op 1), correctly rounded, on the Cortex-M33: the same
; exact integer method as the 32-bit procedure (every step and every
; truncation the same), written with UMULL/UMAAL; the quadrant as the sine's
; of |x| + pi/2 for a cosine. A register shift by 32 or
; more gives 0 on this core, which the window of 2/pi and the shifts of b rely
; on. The two CLZs are written as their encodings (.byte), which this
; assembler has no mnemonic for: clz r4, r3 = FAB3 F483; clz r1, r6 = FAB6 F186.
; Every binary32 argument was checked against a correctly rounded sin and cos.
Procedure.i PmTensorTrigBits(b.i, op.i)
  ASM
    push {r5, r6, r7}
    sub sp, #56
    lsls r2, r0, #1
    lsrs r2, r2, #1
    ldr r3, =0x7F800000
    cmp r2, r3
    bhi pmtrig_nan
    beq pmtrig_inf
    ldr r3, =0x39800000
    cmp r2, r3
    blo pmtrig_tiny
    str r1, [sp, #0]
    lsrs r3, r0, #31
    str r3, [sp, #4]
    lsrs r3, r2, #23
    lsls r2, r2, #9
    lsrs r2, r2, #9
    movs r4, #1
    lsls r4, r4, #23
    orrs r2, r4
    ldr r4, =334
    subs r4, r4, r3
    lsrs r6, r4, #5
    lsls r6, r6, #2
    ldr r5, =PmTensorTrigTable
    adds r6, r6, r5
    lsls r4, r4, #27
    lsrs r4, r4, #27
    movs r5, #32
    subs r5, r5, r4
    movs r7, #0
    ldr r0, [r6, #4]
    lsrs r0, r4
    ldr r1, [r6, #8]
    lsls r1, r5
    orrs r0, r1
    movs r1, #0
    umaal r7, r1, r2, r0
    str r7, [sp, #8]
    movs r7, r1
    ldr r0, [r6, #8]
    lsrs r0, r4
    ldr r1, [r6, #12]
    lsls r1, r5
    orrs r0, r1
    movs r1, #0
    umaal r7, r1, r2, r0
    str r7, [sp, #12]
    movs r7, r1
    ldr r0, [r6, #12]
    lsrs r0, r4
    ldr r1, [r6, #16]
    lsls r1, r5
    orrs r0, r1
    movs r1, #0
    umaal r7, r1, r2, r0
    str r7, [sp, #16]
    movs r7, r1
    ldr r0, [r6, #16]
    lsrs r0, r4
    ldr r1, [r6, #20]
    lsls r1, r5
    orrs r0, r1
    movs r1, #0
    umaal r7, r1, r2, r0
    ldr r0, [sp, #8]
    ldr r1, [sp, #12]
    ldr r3, [sp, #16]
    lsrs r4, r3, #31
    str r4, [sp, #20]
    adds r7, r7, r4
    lsls r7, r7, #22
    lsrs r7, r7, #22
    str r7, [sp, #24]
    negs r5, r4
    eors r0, r5
    eors r1, r5
    eors r3, r5
    movs r6, #0
    adds r0, r0, r4
    adcs r1, r6
    adcs r3, r6
    movs r7, #0
    cmp r3, #0
    bne pmtrig_n1
    movs r7, #32
    movs r3, r1
    movs r1, r0
    movs r0, #0
    cmp r3, #0
    bne pmtrig_n1
    movs r7, #64
    movs r3, r1
    movs r1, #0
    cmp r3, #0
    beq pmtrig_n2
  pmtrig_n1:
    .byte 179, 250, 131, 244
    adds r7, r7, r4
    movs r5, #32
    subs r5, r5, r4
    lsls r3, r4
    movs r6, r1
    lsrs r6, r5
    orrs r3, r6
    lsls r1, r4
    lsrs r0, r5
    orrs r1, r0
  pmtrig_n2:
    str r7, [sp, #28]
    ldr r4, =0x01921FB5
    ldr r5, =0x4442D184
    umull r6, r0, r3, r5
    umull r5, r2, r1, r4
    umull r6, r7, r3, r4
    movs r1, #0
    adds r6, r6, r0
    adcs r7, r1
    adds r6, r6, r2
    adcs r7, r1
    str r6, [sp, #32]
    str r7, [sp, #36]
    ldr r0, [sp, #28]
    movs r1, r6
    lsrs r1, r0
    movs r2, #32
    subs r2, r2, r0
    movs r3, r7
    lsls r3, r2
    orrs r1, r3
    movs r3, r0
    subs r3, #32
    movs r4, r7
    lsrs r4, r3
    orrs r1, r4
    movs r2, r7
    lsrs r2, r0
    str r1, [sp, #8]
    str r2, [sp, #12]
    umull r3, r4, r2, r2
    umull r5, r6, r2, r1
    lsls r5, r6, #1
    lsrs r6, r6, #31
    adds r3, r3, r5
    adcs r4, r6
    str r3, [sp, #40]
    str r4, [sp, #44]
    lsls r5, r4, #14
    lsrs r6, r3, #18
    orrs r5, r6
    umull r6, r5, r5, r5
    str r5, [sp, #48]
    ldr r0, [sp, #24]
