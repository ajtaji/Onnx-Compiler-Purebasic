; Atan, correctly rounded (C6c-3), for a program that uses it
; (#PMO_USE_ATAN), on the Pi 4 and the Pico: the same bits as the Windows
; program (whose own ATan is corrected at two arguments). The Pico 2 keeps its
; maths library's arctangent: a correctly rounded one costs it more than the
; speed rule allows (see VALIDATION), so its Atan is held to the tolerance.
CompilerIf #PMO_USE_ATAN = 1 And #PMO_INT8_BACKEND <> 3
; 1/x for atan: Y ~ 2^87/m (m the 24-bit significand, above 2^23) in two
; words, to within 3 units: a 256-entry start, two Newton steps in 32 bits and
; one in 64. The same steps on every target give the same Y.
Procedure.l PmTensorAtanRecip(m.l, *lo)
  Protected y.l
  Protected k.l
  Protected pl.l
  Protected ph.l
  Protected el.l
  Protected eh.l
  Protected tl.l
  Protected th.l
  Protected u.l
  Protected c.l
  k = (m >> 15) & 255
  y = PeekL(?PmTensorAtanTable + k * 4)
  k = 0
  While k < 2
    ; e = 2^55 - m y (64 bits, small), y = y + (y e) / 2^55
    pl = m * y
    ph = PmTensorMulHi32(m, y)
    el = 0 - pl
    c = 0
    If pl <> 0
      c = 1
    EndIf
    eh = $800000 - ph
    eh = eh - c
    tl = y * eh
    th = PmTensorMulHi32(y, eh)
    If eh < 0
      th = th - y
    EndIf
    u = PmTensorMulHi32(y, el)
    tl = tl + u
    th = th + PmTensorBelow32(tl, u)
    tl = (tl >> 23) & $1FF
    u = th << 9
    tl = tl | u
    y = y + tl
    k = k + 1
  Wend
  ; Y = y 2^32 + (y e) / 2^23, e = 2^55 - m y now below 2^25
  pl = m * y
  el = 0 - pl
  tl = y * el
  th = PmTensorMulHi32(y, el)
  If el < 0
    th = th - y
  EndIf
  u = (tl >> 23) & $1FF
  tl = th << 9
  u = u | tl
  PokeL(*lo, u)
  th = th >> 23
  ProcedureReturn y + th
EndProcedure

; atan on [2^-8, 1) from the table: x as xh xl in Q64, the result in Q63
; (hi returned, lo through *lo). a0 + u (a1 + u (a2 + ... + u a7)), u = x - c,
; c = j/256; the four inner steps in one word (Q31), the rest in two (Q63).
Procedure.l PmTensorAtanTab(xh.l, xl.l, *lo)
  Protected j.l
  Protected uh.l
  Protected uw.l
  Protected base.l
  Protected p.l
  Protected t.l
  Protected k.l
  Protected ph.l
  Protected pl.l
  Protected zl.l
  Protected zh.l
  Protected u.l
  j = (xh >> 24) & 255
  uh = xh & $FFFFFF
  base = j * 48
  base = base + 976
  uw = uh << 8
  t = (xl >> 24) & $FF
  uw = uw | t
  p = PeekL(?PmTensorAtanTable + base + 44)
  k = 40
  While k >= 32
    t = PmTensorMulHi32(p, uw)
    If p < 0
      t = t - uw
    EndIf
    t = t >> 8
    p = PeekL(?PmTensorAtanTable + base + k) + t
    k = k - 4
  Wend
  ; a3 + p u, p u = p uh + (p ul) / 2^32, signed
  zl = p * uh
  zh = PmTensorMulHi32(p, uh)
  If p < 0
    zh = zh - uh
  EndIf
  t = PmTensorMulHi32(p, xl)
  If p < 0
    t = t - xl
  EndIf
  zl = zl + t
  zh = zh + PmTensorBelow32(zl, t)
  If t < 0
    zh = zh - 1
  EndIf
  pl = PeekL(?PmTensorAtanTable + base + 24)
  ph = PeekL(?PmTensorAtanTable + base + 28)
  pl = pl + zl
  ph = ph + zh
  ph = ph + PmTensorBelow32(pl, zl)
  ; a2, a1, a0: P = a + (P u) / 2^64
  k = 16
  While k >= 0
    zl = ph * uh
    zh = PmTensorMulHi32(ph, uh)
    If ph < 0
      zh = zh - uh
    EndIf
    t = PmTensorMulHi32(ph, xl)
    If ph < 0
      t = t - xl
    EndIf
    zl = zl + t
    zh = zh + PmTensorBelow32(zl, t)
    If t < 0
      zh = zh - 1
    EndIf
    u = PmTensorMulHi32(pl, uh)
    zl = zl + u
    zh = zh + PmTensorBelow32(zl, u)
    pl = PeekL(?PmTensorAtanTable + base + k)
    ph = PeekL(?PmTensorAtanTable + base + k + 4)
    pl = pl + zl
    ph = ph + zh
    ph = ph + PmTensorBelow32(pl, zl)
    k = k - 8
  Wend
  PokeL(*lo, pl)
  ProcedureReturn ph
EndProcedure

; G = 1 - v^2/3 + v^4/5 - v^6/7 in Q64 (hi returned, lo through *lo), from
; v^2 in Q64 (below 2^48)
Procedure.l PmTensorAtanSeries(vh.l, vl.l, *lo)
  Protected w.l
  Protected th.l
  Protected tl.l
  Protected xl.l
  Protected xh.l
  Protected u.l
  Protected c.l
  ; w = v^2 (1/5 - v^2/7) in Q64, then 1/3 - w (th tl)
  w = PmTensorMulHi32(vh, 613566757)
  w = 858993459 - w
  tl = vh * w
  th = PmTensorMulHi32(vh, w)
  u = PmTensorMulHi32(vl, w)
  tl = tl + u
  th = th + PmTensorBelow32(tl, u)
  c = PmTensorBelow32($55555555, tl)
  tl = $55555555 - tl
  th = $55555555 - th
  th = th - c
  xl = vh * th
  xh = PmTensorMulHi32(vh, th)
  u = PmTensorMulHi32(vh, tl)
  xl = xl + u
  xh = xh + PmTensorBelow32(xl, u)
  u = PmTensorMulHi32(vl, th)
  xl = xl + u
  xh = xh + PmTensorBelow32(xl, u)
  c = 0
  If xl <> 0
    c = 1
  EndIf
  xl = 0 - xl
  PokeL(*lo, xl)
  xh = 0 - xh
  ProcedureReturn xh - c
EndProcedure

; atan, correctly rounded, in exact 32-bit integer arithmetic (the bits of x
; in, the bits of the result out). |x| < 2^-8: x (1 - x^2/3 + x^4/5 - x^6/7),
; kept relative to x. |x| <= 1: a 255-bucket table of atan's Taylor
; coefficients to degree 7 at c = j/256, in u = |x| - c (no division). |x| > 1:
; pi/2 - atan(1/|x|), 1/|x| from PmTensorAtanRecip, then as above. Rounded
; once, to nearest-even.
; Every binary32 argument was checked against a correctly rounded atan.
Procedure.l PmTensorAtanBits(b.l)
  Protected a.l
  Protected sg.l
  Protected e.l
  Protected m.l
  Protected sh.l
  Protected vl.l
  Protected vh.l
  Protected gl.l
  Protected gh.l
  Protected w0.l
  Protected w1.l
  Protected w2.l
  Protected u.l
  Protected t.l
  Protected c.l
  Protected rl.l
  Protected rh.l
  Protected ql.l
  Protected qh.l
  Protected k.l
  Protected eb.l
  a = b & $7FFFFFFF
  sg = b & $80000000
  If a > $7F800000
    ProcedureReturn b | $400000
  EndIf
  If a >= $4C800000
    ProcedureReturn sg | $3FC90FDB
  EndIf
  If a < $39800000
    ProcedureReturn b
  EndIf
  If a = $3F800000
    ProcedureReturn sg | $3F490FDB
  EndIf
  e = a >> 23
  m = a & $7FFFFF
  m = m | $800000
  If a < $3B800000
    ; x^2 in Q64 = m^2 / 2^(236 - 2e)
    vl = m * m
    vh = PmTensorMulHi32(m, m)
    sh = e + e
    sh = 236 - sh
    If sh > 0
      vl = (vl >> sh) & ((1 << (32 - sh)) - 1)
      u = vh << (32 - sh)
      vl = vl | u
      vh = vh >> sh
    EndIf
    gh = PmTensorAtanSeries(vh, vl, @gl)
    ; m G: three words
    w0 = m * gl
    w1 = PmTensorMulHi32(m, gl)
    u = m * gh
    w2 = PmTensorMulHi32(m, gh)
    w1 = w1 + u
    w2 = w2 + PmTensorBelow32(w1, u)
    ; top bit of w2 to bit 31
    k = 0
    While (w2 & $80000000) = 0
      w2 = w2 << 1
      u = (w1 >> 31) & 1
      w2 = w2 | u
      w1 = w1 << 1
      u = (w0 >> 31) & 1
      w1 = w1 | u
      w0 = w0 << 1
      k = k + 1
    Wend
    rh = w2
    rl = w1 | w0
    ; the value is w2.. 2^(e - 214 + 64 - k), its exponent e - 150 + 95 - 64 - k
    eb = e - 150
    eb = eb + 31
    eb = eb - k
  Else
    If a < $3F800000
      ; |x| in Q64: m 2^(e - 86), the high word only
      sh = e - 118
      qh = m << sh
      rh = PmTensorAtanTab(qh, 0, @rl)
    Else
      ; |x| > 1: y = 1/|x| in Q64 (qh ql) from Y 2^-(64 + s)
      If m = $800000
        rh = $80000000
        rl = 0
        sh = e - 128
      Else
        rh = PmTensorAtanRecip(m, @rl)
        sh = e - 127
      EndIf
      qh = rh
      ql = rl
      If sh > 0
        ql = (ql >> sh) & ((1 << (32 - sh)) - 1)
        u = qh << (32 - sh)
        ql = ql | u
        qh = (qh >> sh) & ((1 << (32 - sh)) - 1)
      EndIf
      If (qh & $FF000000) = 0
        ; y below 2^-8: atan y = Y G(y) 2^-(64 + s)
        vl = qh * qh
        vh = PmTensorMulHi32(qh, qh)
        u = PmTensorMulHi32(qh, ql)
        t = u << 1
        vl = vl + t
        vh = vh + PmTensorBelow32(vl, t)
        u = (u >> 31) & 1
        vh = vh + u
        gh = PmTensorAtanSeries(vh, vl, @gl)
        w1 = rh * gh
        w2 = PmTensorMulHi32(rh, gh)
        u = PmTensorMulHi32(rh, gl)
        w1 = w1 + u
        w2 = w2 + PmTensorBelow32(w1, u)
        u = PmTensorMulHi32(rl, gh)
        w1 = w1 + u
        w2 = w2 + PmTensorBelow32(w1, u)
        ; Q63: shift right s + 1
        sh = sh + 1
        w1 = (w1 >> sh) & ((1 << (32 - sh)) - 1)
        u = w2 << (32 - sh)
        w1 = w1 | u
        w2 = (w2 >> sh) & ((1 << (32 - sh)) - 1)
        rh = w2
        rl = w1
      Else
        rh = PmTensorAtanTab(qh, ql, @rl)
      EndIf
      ; pi/2 - atan y, Q63
      c = PmTensorBelow32($2168C235, rl)
      rl = $2168C235 - rl
      rh = $C90FDAA2 - rh
      rh = rh - c
    EndIf
    ; top bit to bit 63
    k = 0
    While (rh & $80000000) = 0
      rh = rh << 1
      u = (rl >> 31) & 1
      rh = rh | u
      rl = rl << 1
      k = k + 1
    Wend
    eb = 0 - k
  EndIf
  ; round rh (and the sticky rl) once: exponent eb (value in [2^eb, 2^(eb+1)))
  m = (rh >> 8) & $FFFFFF
  If (rh & $80) <> 0
    If (rh & $7F) <> 0 Or rl <> 0 Or (m & 1) <> 0
      m = m + 1
    EndIf
  EndIf
  e = eb + 126
  e = e << 23
  e = e + m
  ProcedureReturn e | sg
EndProcedure

; 2^55/m for the first Newton step (256 words), then for j = 1..255 atan's
