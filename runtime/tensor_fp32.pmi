CompilerElse
; sin (op 0) and cos (op 1), correctly rounded, in exact 32-bit integer
; arithmetic (the bits of x in, the bits of the result out). |x| is reduced
; against 2/pi taken to 320 bits (Payne and Hanek): Z = |x| 512/pi to 96
; fraction bits, j = the nearest integer (quadrant j/256, step j mod 256 of a
; 256-entry table of sin and cos of multiples of pi/512), b = (Z - j) pi/512,
; |b| <= pi/1024. sin b = b (1 - b^2/6 + b^4/120) and cos b = 1 - b^2/2 +
; b^4/24 in Q64, b^4 to 32 bits (without b^4/120, 186 arguments round the
; other way; b^6/720 changes none); sin(t + b) and cos(t + b) from the table
; in Q63.
; Where the result is sin b alone (x near a multiple of pi/2) it is kept to
; its own relative precision. Rounded once, to nearest-even.
; Every binary32 argument was checked against a correctly rounded sin and cos.
Procedure.l PmTensorTrigBits(b.l, op.l)
  Protected a.l
  Protected neg.l
  Protected e.l
  Protected m.l
  Protected s.l
  Protected w.l
  Protected bb.l
  Protected cb.l
  Protected k.l
  Protected p.l
  Protected u.l
  Protected v.l
  Protected c.l
  Protected z1.l
  Protected z2.l
  Protected z3.l
  Protected z4.l
  Protected sg.l
  Protected j.l
  Protected q.l
  Protected zz.l
  Protected fh.l
  Protected fl.l
  Protected bh.l
  Protected bl.l
  Protected qh.l
  Protected ql.l
  Protected b2h.l
  Protected b2l.l
  Protected th.l
  Protected tl.l
  Protected dh.l
  Protected dl.l
  Protected sh.l
  Protected sl.l
  Protected rh.l
  Protected rl.l
  Protected wantsin.l
  Protected minus.l
  Protected eb.l
  Protected x4.l
  a = b & $7FFFFFFF
  If a > $7F800000
    ProcedureReturn b | $400000
  EndIf
  If a = $7F800000
    ProcedureReturn $FFC00000
  EndIf
  If a < $39800000
    ; |x| < 2^-12: sin x rounds to x and cos x to 1
    If op = 0
      ProcedureReturn b
    EndIf
    ProcedureReturn $3F800000
  EndIf
  neg = 0
  If a <> b
    neg = 1
  EndIf
  e = a >> 23
  m = a & $7FFFFF
  m = m | $800000
  ; the 160 bits of 2/pi at 2^(e - 14): words w.. of the table, shifted bb
  s = 334 - e
  w = s >> 5
  w = w << 2
  bb = s & 31
  cb = 32 - bb
  ; Z 2^128 = m A modulo 2^138, words z4..z1 carried a word at a time (the
  ; lowest product word is left out: it changes no result)
  k = 1
  c = 0
  While k < 5
    u = PeekL(?PmTensorTrigTable + w + k * 4)
    If bb <> 0
      u = (u >> bb) & ((1 << cb) - 1)
      v = PeekL(?PmTensorTrigTable + w + k * 4 + 4)
      v = v << cb
      u = u | v
    EndIf
    p = m * u
    v = PmTensorMulHi32(m, u)
    p = p + c
    v = v + PmTensorBelow32(p, c)
    c = v
    If k = 1
      z1 = p
    ElseIf k = 2
      z2 = p
    ElseIf k = 3
      z3 = p
    Else
      z4 = p
    EndIf
    k = k + 1
  Wend
  ; the nearest j, and |Z - j| in Q96 (z3 z2 z1), sg its sign
  sg = (z3 >> 31) & 1
  j = z4 + sg
  j = j & 1023
  If sg = 1
    z1 = z1 ! $FFFFFFFF
    z2 = z2 ! $FFFFFFFF
    z3 = z3 ! $FFFFFFFF
    z1 = z1 + 1
    If z1 = 0
      z2 = z2 + 1
      If z2 = 0
        z3 = z3 + 1
      EndIf
    EndIf
  EndIf
  q = j >> 8
  j = j & 255
  ; |Z - j| as a 64-bit mantissa fh fl times 2^-zz
  zz = 0
  If z3 = 0
    zz = 32
    z3 = z2
    z2 = z1
    z1 = 0
    If z3 = 0
      zz = 64
      z3 = z2
      z2 = 0
    EndIf
  EndIf
  fh = z3
  fl = z2
  If fh <> 0
    k = 0
    While (fh & $80000000) = 0
      fh = fh << 1
      u = (fl >> 31) & 1
      fh = fh | u
      fl = fl << 1
      u = (z1 >> 31) & 1
      fl = fl | u
      z1 = z1 << 1
      k = k + 1
    Wend
    zz = zz + k
  EndIf
  ; b = |Z - j| pi/512: bh bl = b 2^(64 + zz)
  u = PmTensorMulHi32(fh, $4442D184)
  v = PmTensorMulHi32(fl, $01921FB5)
  bl = fh * $01921FB5
  bh = PmTensorMulHi32(fh, $01921FB5)
  bl = bl + u
  bh = bh + PmTensorBelow32(bl, u)
  bl = bl + v
  bh = bh + PmTensorBelow32(bl, v)
  ; b in Q64 (qh ql): the mantissa shifted right zz
  qh = bh
  ql = bl
  If zz >= 64
    qh = 0
    ql = 0
  ElseIf zz >= 32
    k = zz - 32
    ql = (qh >> k) & ((1 << (32 - k)) - 1)
    If k = 0
      ql = qh
    EndIf
    qh = 0
  ElseIf zz > 0
    k = 32 - zz
    ql = (ql >> zz) & ((1 << k) - 1)
    u = qh << k
    ql = ql | u
    qh = (qh >> zz) & ((1 << k) - 1)
  EndIf
  ; b^2 in Q64 (b2h b2l)
  b2l = qh * qh
  b2h = PmTensorMulHi32(qh, qh)
  u = PmTensorMulHi32(qh, ql)
  v = u << 1
  b2l = b2l + v
  b2h = b2h + PmTensorBelow32(b2l, v)
  u = (u >> 31) & 1
  b2h = b2h + u
  ; b^4 in Q60, one word, from b^2 in Q46
  u = b2h << 14
  v = (b2l >> 18) & $3FFF
  x4 = u | v
  x4 = PmTensorMulHi32(x4, x4)
  ; t = b^2/6 - b^4/120 in Q64 (th tl)
  tl = b2h * $2AAAAAAA
  th = PmTensorMulHi32(b2h, $2AAAAAAA)
  u = PmTensorMulHi32(b2h, $AAAAAAAB)
  tl = tl + u
  th = th + PmTensorBelow32(tl, u)
  u = PmTensorMulHi32(b2l, $2AAAAAAA)
  tl = tl + u
  th = th + PmTensorBelow32(tl, u)
  u = PmTensorMulHi32(x4, 35791394)
  u = u << 4
  c = PmTensorBelow32(tl, u)
  tl = tl - u
  th = th - c
  ; the result is sin or cos of t + b, t = j pi/512, per quadrant
  If op = 0
    wantsin = 1 - (q & 1)
    minus = (q >> 1) ! neg
  Else
    wantsin = q & 1
    minus = ((q + 1) >> 1) & 1
  EndIf
  If wantsin = 1 And j = 0
    ; sin b alone: b (1 - t), kept relative to b
    ; sin b 2^(64 + zz) = bm - bm t
    rl = bh * th
    rh = PmTensorMulHi32(bh, th)
    u = PmTensorMulHi32(bh, tl)
    rl = rl + u
    rh = rh + PmTensorBelow32(rl, u)
    u = PmTensorMulHi32(bl, th)
    rl = rl + u
    rh = rh + PmTensorBelow32(rl, u)
    c = PmTensorBelow32(bl, rl)
    rl = bl - rl
    rh = bh - rh
    rh = rh - c
    minus = minus ! sg
    eb = -64 - zz
  Else
    ; sin b = b - b t (Q64, sh sl)
    sl = qh * th
    sh = PmTensorMulHi32(qh, th)
    u = PmTensorMulHi32(qh, tl)
    sl = sl + u
    sh = sh + PmTensorBelow32(sl, u)
    u = PmTensorMulHi32(ql, th)
    sl = sl + u
    sh = sh + PmTensorBelow32(sl, u)
    c = PmTensorBelow32(ql, sl)
    sl = ql - sl
    sh = qh - sh
    sh = sh - c
    ; d = 1 - cos b = b^2/2 - b^4/24 (Q64, dh dl)
    dl = (b2l >> 1) & $7FFFFFFF
    u = b2h << 31
    dl = dl | u
    dh = b2h >> 1
    u = PmTensorMulHi32(x4, 178956971)
    u = u << 4
    c = PmTensorBelow32(dl, u)
    dl = dl - u
    dh = dh - c
    ; the table: sin t and cos t in Q63
    k = j << 4
    If wantsin = 1
      ; sin(t + b) = sin t - sin t d +- cos t sin b
      tl = PeekL(?PmTensorTrigTable + 48 + k)
      th = PeekL(?PmTensorTrigTable + 52 + k)
      w = PeekL(?PmTensorTrigTable + 56 + k)
      p = PeekL(?PmTensorTrigTable + 60 + k)
    Else
      ; cos(t + b) = cos t - cos t d -+ sin t sin b
      tl = PeekL(?PmTensorTrigTable + 56 + k)
      th = PeekL(?PmTensorTrigTable + 60 + k)
      w = PeekL(?PmTensorTrigTable + 48 + k)
      p = PeekL(?PmTensorTrigTable + 52 + k)
      sg = sg ! 1
    EndIf
    ; r = first - first d
    rl = th * dh
    rh = PmTensorMulHi32(th, dh)
    u = PmTensorMulHi32(th, dl)
    rl = rl + u
    rh = rh + PmTensorBelow32(rl, u)
    u = PmTensorMulHi32(tl, dh)
    rl = rl + u
    rh = rh + PmTensorBelow32(rl, u)
    c = PmTensorBelow32(tl, rl)
    rl = tl - rl
    rh = th - rh
    rh = rh - c
    ; second sin b (Q63)
    dl = p * sh
    dh = PmTensorMulHi32(p, sh)
    u = PmTensorMulHi32(p, sl)
    dl = dl + u
    dh = dh + PmTensorBelow32(dl, u)
    u = PmTensorMulHi32(w, sh)
    dl = dl + u
    dh = dh + PmTensorBelow32(dl, u)
    If sg = 0
      rl = rl + dl
      rh = rh + dh
      rh = rh + PmTensorBelow32(rl, dl)
    Else
      c = PmTensorBelow32(rl, dl)
      rl = rl - dl
      rh = rh - dh
      rh = rh - c
    EndIf
    eb = -63
  EndIf
  ; round rh rl 2^eb once: its top bit to bit 63, then 24 bits
  If rh = 0 And rl = 0
    If minus <> 0
      ProcedureReturn $80000000
    EndIf
    ProcedureReturn 0
  EndIf
  k = 0
  If rh = 0
    rh = rl
    rl = 0
    k = 32
  EndIf
  While (rh & $80000000) = 0
    rh = rh << 1
    u = (rl >> 31) & 1
    rh = rh | u
    rl = rl << 1
    k = k + 1
  Wend
  ; the value is rh rl 2^(eb - k): its exponent 63 + eb - k
  m = (rh >> 8) & $FFFFFF
  If (rh & $80) <> 0
    If (rh & $7F) <> 0 Or rl <> 0 Or (m & 1) <> 0
      m = m + 1
    EndIf
  EndIf
  e = 63 + eb
  e = e - k
  e = e + 126
  e = e << 23
  e = e + m
  If minus <> 0
    e = e | $80000000
  EndIf
  ProcedureReturn e
EndProcedure
CompilerEndIf

