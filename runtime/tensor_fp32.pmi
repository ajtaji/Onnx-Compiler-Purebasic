Procedure.i PmTensorIsNan(v.f)
  If (PeekL(@v) & $7FFFFFFF) > $7F800000
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; The element at index of a FLOAT tensor is a NaN.
Procedure.i PmTensorNanAt(*base.i, index.i)
  If (PeekL(*base + index * 4) & $7FFFFFFF) > $7F800000
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; ONNX INT64 slots always occupy eight bytes.  Pi 4 / UNO Q use their native
; signed 64-bit integer.  Pico / Pico 2 keep the representable signed 32-bit
; subset in the low word and verify/write the required sign-extension word.
; The native compiler rejects out-of-range constants before emission and the
; generated program validates every dynamic INT64 input before execution.
Global PmTensorInt64Ok.i

CompilerIf #PMO_INT64_SPLIT = 1
Procedure.i PmTensorGetI64(*base.i, index.i)
  Protected p.i
  Protected low.i
  Protected high.i
  p = *base + index * 8
  low = PeekL(p)
  high = PeekL(p + 4)
  If (low < 0 And high <> -1) Or (low >= 0 And high <> 0)
    PmTensorInt64Ok = 0
  EndIf
  ProcedureReturn low
EndProcedure

Procedure PmTensorPutI64(*base.i, index.i, value.i)
  Protected p.i
  p = *base + index * 8
  PokeL(p, value)
  If value < 0
    PokeL(p + 4, -1)
  Else
    PokeL(p + 4, 0)
  EndIf
EndProcedure
CompilerElse
Procedure.i PmTensorGetI64(*base.i, index.i)
  Protected p.i
  p = *base + index * 8
  ProcedureReturn *p.i
EndProcedure

Procedure PmTensorPutI64(*base.i, index.i, value.i)
  Protected p.i
  p = *base + index * 8
  *p.i = value
EndProcedure
CompilerEndIf

Procedure.i PmTensorGetBool(*base.i, index.i)
  ProcedureReturn PeekA(*base + index) & 255
EndProcedure

Procedure PmTensorPutBool(*base.i, index.i, value.i)
  If value <> 0 : value = 1 : EndIf
  PokeA(*base + index, value)
EndProcedure

Procedure PmTensorZero(*dst.i, count.i)
  Protected i.i
  Protected p.i
  i = 0
  p = *dst
  While i < count
    *p.f = 0.0
    p = p + 4
    i = i + 1
  Wend
EndProcedure

Procedure PmTensorCopy(*src.i, *dst.i, count.i)
  Protected i.i
  Protected ps.i
  Protected pd.i
  i = 0
  ps = *src
  pd = *dst
  While i < count
    *pd.f = *ps.f
    ps = ps + 4
    pd = pd + 4
    i = i + 1
  Wend
EndProcedure

Procedure PmTensorCopyI64(*src.i, *dst.i, count.i)
  Protected i.i
  i = 0
  While i < count
    PmTensorPutI64(*dst, i, PmTensorGetI64(*src, i))
    i = i + 1
  Wend
EndProcedure

Procedure PmTensorCopyBool(*src.i, *dst.i, count.i)
  Protected i.i
  i = 0
  While i < count
    PmTensorPutBool(*dst, i, PmTensorGetBool(*src, i))
    i = i + 1
  Wend
EndProcedure

Procedure PmTensorAdd(*a.i, *b.i, *dst.i, count.i)
  Protected i.i
  Protected pa.i
  Protected pb.i
  Protected pd.i
  i = 0 : pa = *a : pb = *b : pd = *dst
  While i < count
    *pd.f = *pa.f + *pb.f
    pa = pa + 4 : pb = pb + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorSub(*a.i, *b.i, *dst.i, count.i)
  Protected i.i
  Protected pa.i
  Protected pb.i
  Protected pd.i
  i = 0 : pa = *a : pb = *b : pd = *dst
  While i < count
    *pd.f = *pa.f - *pb.f
    pa = pa + 4 : pb = pb + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorMul(*a.i, *b.i, *dst.i, count.i)
  Protected i.i
  Protected pa.i
  Protected pb.i
  Protected pd.i
  i = 0 : pa = *a : pb = *b : pd = *dst
  While i < count
    *pd.f = *pa.f * *pb.f
    pa = pa + 4 : pb = pb + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorDiv(*a.i, *b.i, *dst.i, count.i)
  Protected i.i
  Protected pa.i
  Protected pb.i
  Protected pd.i
  i = 0 : pa = *a : pb = *b : pd = *dst
  While i < count
    *pd.f = *pa.f / *pb.f
    pa = pa + 4 : pb = pb + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

; op: 0 add, 1 subtract, 2 multiply, 3 divide. scalarSide is 0 when
; the scalar is the left operand and 1 when it is the right operand.
Procedure PmTensorBinaryScalar(*vec.i, scalar.f, *dst.i, count.i, op.i, scalarSide.i)
  Protected i.i
  Protected pv.i
  Protected pd.i
  Protected v.f
  i = 0 : pv = *vec : pd = *dst
  While i < count
    v = *pv.f
    If op = 0
      *pd.f = v + scalar
    ElseIf op = 1
      If scalarSide = 0 : *pd.f = scalar - v : Else : *pd.f = v - scalar : EndIf
    ElseIf op = 2
      *pd.f = v * scalar
    Else
      If scalarSide = 0 : *pd.f = scalar / v : Else : *pd.f = v / scalar : EndIf
    EndIf
    pv = pv + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorRelu(*src.i, *dst.i, count.i)
  Protected i.i
  Protected ps.i
  Protected pd.i
  Protected v.f
  i = 0 : ps = *src : pd = *dst
  While i < count
    v = *ps.f
    If v < 0.0 : v = 0.0 : EndIf
    *pd.f = v
    ps = ps + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorLeakyRelu(*src.i, *dst.i, count.i, alpha.f)
  Protected i.i
  Protected ps.i
  Protected pd.i
  Protected v.f
  i = 0 : ps = *src : pd = *dst
  While i < count
    v = *ps.f
    If v < 0.0 : v = v * alpha : EndIf
    *pd.f = v
    ps = ps + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure.f PmTensorSigmoidValue(value.f)
  Protected e.f
  If value >= 0.0
    e = Exp(0.0 - value)
    ProcedureReturn 1.0 / (1.0 + e)
  EndIf
  e = Exp(value)
  ProcedureReturn e / (1.0 + e)
EndProcedure

Procedure.f PmTensorTanhValue(value.f)
  Protected e.f
  If value > 10.0 : ProcedureReturn 1.0 : EndIf
  If value < -10.0 : ProcedureReturn -1.0 : EndIf
  e = Exp(value + value)
  ProcedureReturn (e - 1.0) / (e + 1.0)
EndProcedure

Procedure PmTensorSigmoid(*src.i, *dst.i, count.i)
  Protected i.i
  Protected ps.i
  Protected pd.i
  Protected v.f
  i = 0 : ps = *src : pd = *dst
  While i < count
    v = *ps.f
    *pd.f = PmTensorSigmoidValue(v)
    ps = ps + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorTanh(*src.i, *dst.i, count.i)
  Protected i.i
  Protected ps.i
  Protected pd.i
  Protected v.f
  i = 0 : ps = *src : pd = *dst
  While i < count
    v = *ps.f
    *pd.f = PmTensorTanhValue(v)
    ps = ps + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

; Refusal signal for PmTensorUnaryMath, the same convention as PmTensorInt64Ok
; above and PmTensorTrigOk below: this file sits UNDER both of its consumers and
; can name neither of their error variables, so the kernel only ever CLEARS a
; flag and whoever ran it reads it back and raises that layer's error.
;
; It is a second flag rather than a wider PmTensorTrigOk because the two kernels
; are reached by different dispatch paths - trig through PmFastTrig, unary math
; by a direct call - and each refusal has to name its own op set in the message.
; Nothing here ever sets it; the caller arms it per call, so a refusal on one
; node can never be read as a refusal on the next.
Global PmTensorUnaryMathOk.i

; Elementwise unary math.
;
; THE OP SET IS CLOSED AND EXPLICIT: 0 Exp, 1 Log, 2 Sqrt, 3 Abs, 4 Neg.  Those
; are the only codes any emitter produces - onnx_emit.pbi writes 0..4 from a
; Select over Exp/Log/Sqrt/Abs/Neg, and onnx_dynamic_emit.pbi writes the same
; 0..4 as DUnary codes, which DUnary passes through unchanged.
;
; This procedure used to end its chain with a bare Else that NEGATED, so op 5,
; op 99 or op -1 quietly returned -x and the graph ran on with wrong numbers in
; it - the same defect PmTensorTrig had with an arctangent.  Anything outside
; the set is now REFUSED: the destination is left exactly as the caller left it
; and PmTensorUnaryMathOk is cleared.  The op is decided once, before the loop,
; because a per-element test can only ever be a slower way to get the same
; answer.
Procedure PmTensorUnaryMath(*src.i, *dst.i, count.i, op.i)
  Protected i.i
  Protected ps.i
  Protected pd.i
  Protected v.f
  If op < 0 Or op > 4
    PmTensorUnaryMathOk = 0
    ProcedureReturn
  EndIf
  i = 0 : ps = *src : pd = *dst
  While i < count
    v = *ps.f
    If op = 0
      CompilerIf #PMO_USE_EXPLOG = 1
        PokeL(pd, PmTensorExpBits(PeekL(ps)))
      CompilerElse
        *pd.f = Exp(v)
      CompilerEndIf
    ElseIf op = 1
      CompilerIf #PMO_USE_EXPLOG = 1
        PokeL(pd, PmTensorLogBits(PeekL(ps)))
      CompilerElse
        *pd.f = Log(v)
      CompilerEndIf
    ElseIf op = 2
      *pd.f = PmTensorSqrtF(v)
    ElseIf op = 3
      ; IEEE 754 abs and negate: the sign bit alone (-0 has abs +0, a NaN
      ; keeps its payload), as numpy computes them
      PokeL(pd, PeekL(ps) & $7FFFFFFF)
    Else
      PokeL(pd, PeekL(ps) ! $80000000)
    EndIf
    ps = ps + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

; Refusal signal for PmTensorTrig, and the same shape as PmTensorInt64Ok
; above: this file sits UNDER both of its consumers and can name neither of
; their error variables.  The dynamic runtime has DError; a statically emitted
; program has PmOnnxRuntimeOk.  A kernel here therefore reports by clearing a
; flag that whoever ran it reads back, and never by guessing which one exists.
;
; Nothing here ever sets it.  The caller that runs the kernel arms it, exactly
; as the generated program arms PmTensorInt64Ok, so a value left over from an
; earlier call can never be mistaken for this call's verdict.
Global PmTensorTrigOk.i

; Transcendentals used by synthesis and signal-processing graphs.
;
; THE OP SET IS CLOSED AND EXPLICIT: 0 Sin, 1 Cos, 2 Atan.  Those are the only
; codes any emitter produces - onnx_emit.pbi writes them directly, and
; onnx_dynamic_emit.pbi writes DUnary 5/6/7 which PmFastTrig turns into 0/1/2.
; Any other code means the program calling this was generated wrongly, which
; is not something a kernel can guess its way out of, so it is REFUSED: the
; destination is left exactly as the caller left it and PmTensorTrigOk is
; cleared.  PmFastTrig turns that into a DError and the model stops on the
; node that did it.
;
; This procedure used to end its chain with a bare Else that computed MathATan,
; so op 3, op 7 or op -1 quietly returned an arctangent and the graph ran on
; with wrong numbers in it.  The op is decided once, before the loop, because
; a per-element test can only ever be a slower way to get the same answer.
Procedure PmTensorTrig(*src.i, *dst.i, count.i, op.i)
  Protected i.i
  Protected ps.i
  Protected pd.i
  Protected v.f
  If op < 0 Or op > 2
    PmTensorTrigOk = 0
    ProcedureReturn
  EndIf
  i = 0 : ps = *src : pd = *dst
  While i < count
    v = *ps.f
    If op = 0
      CompilerIf #PMO_USE_TRIG = 1
        PokeL(@v, PmTensorTrigBits(PeekL(ps), 0))
      CompilerElse
        v = Sin(v)
      CompilerEndIf
    ElseIf op = 1
      CompilerIf #PMO_USE_TRIG = 1
        PokeL(@v, PmTensorTrigBits(PeekL(ps), 1))
      CompilerElse
        v = Cos(v)
      CompilerEndIf
    Else
      CompilerIf #PMO_USE_ATAN = 1 And #PMO_INT8_BACKEND <> 3
        PokeL(@v, PmTensorAtanBits(PeekL(ps)))
      CompilerElse
        v = MathATan(v)
      CompilerEndIf
    EndIf
    *pd.f = v
    ps = ps + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorFloor(*src.i, *dst.i, count.i)
  Protected i.i
  Protected n.i
  Protected whole.f
  Protected value.f
  i = 0
  While i < count
    value = PmTensorGet(*src, i)
    If (PeekL(*src + i * 4) & $7FFFFFFF) >= $4B000000
      ; |value| >= 2^23, an infinity or a NaN: already its own floor
      PmTensorPut(*dst, i, value)
    Else
      n = Int(value)
      whole = n
      If value < 0.0 And whole <> value : n = n - 1 : EndIf
      whole = n
      PmTensorPut(*dst, i, whole)
    EndIf
    i = i + 1
  Wend
EndProcedure

; ONNX Round uses nearest integer with ties to even.
Procedure PmTensorRoundEven(*src.i, *dst.i, count.i)
  Protected i.i
  Protected base.i
  Protected result.i
  Protected fraction.f
  Protected whole.f
  Protected value.f
  i = 0
  While i < count
    value = PmTensorGet(*src, i)
    If (PeekL(*src + i * 4) & $7FFFFFFF) >= $4B000000
      ; |value| >= 2^23, an infinity or a NaN: already an integer
      PmTensorPut(*dst, i, value)
    Else
      base = Int(value)
      whole = base
      If value < 0.0 And whole <> value : base = base - 1 : EndIf
      whole = base
      fraction = value - whole
      result = base
      If fraction > 0.5
        result = base + 1
      ElseIf fraction = 0.5 And (base & 1) <> 0
        result = base + 1
      EndIf
      whole = result
      PmTensorPut(*dst, i, whole)
    EndIf
    i = i + 1
  Wend
EndProcedure

Procedure PmTensorPow(*a.i, *b.i, *dst.i, count.i)
  Protected i.i
  Protected pa.i
  Protected pb.i
  Protected pd.i
  i = 0 : pa = *a : pb = *b : pd = *dst
  While i < count
    *pd.f = Pow(*pa.f, *pb.f)
    pa = pa + 4 : pb = pb + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Procedure PmTensorPowScalar(*vec.i, scalar.f, *dst.i, count.i, scalarSide.i)
  Protected i.i
  Protected value.f
  i = 0
  While i < count
    value = PmTensorGet(*vec, i)
    If scalarSide = 0
      value = Pow(scalar, value)
    Else
      value = Pow(value, scalar)
    EndIf
    PmTensorPut(*dst, i, value)
    i = i + 1
  Wend
EndProcedure

Procedure PmTensorClip(*src.i, *dst.i, count.i, lo.f, hi.f)
  Protected i.i
  Protected ps.i
  Protected pd.i
  Protected v.f
  i = 0 : ps = *src : pd = *dst
  While i < count
    v = *ps.f
    If v < lo : v = lo : EndIf
    If v > hi : v = hi : EndIf
    *pd.f = v
    ps = ps + 4 : pd = pd + 4 : i = i + 1
  Wend
EndProcedure

Structure PmTensorInt8DotArgs
  A.i
  B.i
  Count.i
  StepA.i
  StepB.i
EndStructure

Structure PmTensorDotInt8Args
  A.i
  B.i
  Count.i
  AScale.f
  WeightScale.f
EndStructure

; ---------------------------------------------------------------------------
; INT8 execution (forum 671). One scheme on every target, and on every target
; the same bits:
;
;  * weights: symmetric INT8, one FP32 scale per output channel. A WIDE weight
;    (the compiler's precision plan) holds a second INT8 plane right after the
;    first: w ~= scale * (Q1 + Q2 / 254);
;  * activations: quantized at run time with ONE SCALE PER ROW of the
;    reduction - per token (MatMul, Gemm), per input position (Conv), per step
;    (LSTM). Narrow rows are INT8 (+-127), wide rows INT16 (+-32767). For a
;    row whose largest magnitude is m (taken as the bit pattern of |x|):
;    m below 1e-30 gives scale 0 and a row of zeros; otherwise scale = m / qmax
;    and q = round-half-even(x * (qmax / m)), each FP32 operation rounded once;
;  * products are exact integers summed in INT32. A wide sum is converted to
;    FP32 every 512 reduction elements (16-bit x 8-bit products; 512 of them
;    stay inside INT32). For each output, F starts at +0.0 and takes
;    F = F + float(acc) * rowScale once per tap and per chunk, taps outermost;
;    then y = F * wScale, or (F1 + F2 / 254) * wScale for a wide weight, and a
;    Conv adds its bias last as bias + y.
;
; The Windows runtime (tensor_fp32_windows.pbi) is the same definition; every
; value these kernels produce is bit-identical to it, which the desk gates
; check on every target.
;
; Working memory is PmTensorInt8Scratch: the quantized rows, then one scale
; and one reciprocal per row, then #PMI8_TILE_BYTES of per-core tiles, each
; region on a 16-byte boundary. PmI8ScratchBytes gives the size. A NaN or an
; infinity in the activations sets PmTensorInt8Fault = 1 and leaves the output
; unwritten; working memory smaller than the operator needs sets it to 2.
; ---------------------------------------------------------------------------
CompilerIf #PMO_USE_INT8 = 1
Global PmTensorInt8Scratch.i
Global PmTensorInt8ScratchBytes.i
Global PmTensorInt8Fault.i

; The bit pattern of the binary32 value nearest 1e-30. A row whose largest
; magnitude is below it is a row of zeros.
#PMI8_TINY_BITS = $0DA24260
; Per-core tile areas. The Advanced SIMD bodies use four of 1024 bytes (F1, F2,
; an epilogue row block and the row scales and pointers); the scalar bodies use
; 32 bytes of the first.
CompilerIf #PMO_INT8_BACKEND = 1
#PMI8_TILE_BYTES = 4096
CompilerElse
#PMI8_TILE_BYTES = 64
CompilerEndIf
#PMI8_TILE_STRIDE = 1024

; One FP32 value at an address.
Procedure.f PmI8GetF(address.i)
  Protected p.i
  p = address
  ProcedureReturn *p.f
EndProcedure

Procedure PmI8PutF(address.i, value.f)
  Protected p.i
  p = address
  *p.f = value
EndProcedure

; Nothing is kept between calls on these targets.
Procedure PmTensorInt8Release()
EndProcedure

Procedure.i PmI8Align(bytes.i)
  ProcedureReturn (bytes + 15) & -16
EndProcedure

; Working memory for `elements` quantized activations in `rows` rows.
Procedure.i PmI8ScratchBytes(elements.i, rows.i, wide.i)
  ProcedureReturn 16 + PmI8Align(elements * (1 + wide)) + PmI8Align(rows * 4) * 2 + #PMI8_TILE_BYTES
EndProcedure

; Working memory for an LSTM: one quantized input row, one hidden row, the
; 4*Hidden gate sums of W.x and of R.h, and the scales.
Procedure.i PmI8LstmScratchBytes(inputSize.i, hidden.i, wWide.i, rWide.i)
  ProcedureReturn 16 + PmI8Align(inputSize * (1 + wWide)) + PmI8Align(hidden * (1 + rWide)) + PmI8Align(hidden * 16) * 2 + 64 + #PMI8_TILE_BYTES
EndProcedure

; Exact signed-byte dot, with strides selected outside the reduction loop.
Procedure.i PmTensorInt8Dot(*g.PmTensorInt8DotArgs)
  CompilerIf #PMO_INT8_BACKEND = 1
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    movz x0, #0
    cbz x3, pmoInt8DotDone
    cmp x4, #1
    b.ne pmoInt8DotLoop
    cmp x5, #1
    b.ne pmoInt8DotLoop
    movi v0.4s, #0
pmoInt8DotVector:
    cmp x3, #8
    b.lt pmoInt8DotReduce
    ld1 {v1.8b}, [x1], #8
    ld1 {v2.8b}, [x2], #8
    smull v3.8h, v1.8b, v2.8b
    saddlp v4.4s, v3.8h
    add v0.4s, v0.4s, v4.4s
    sub x3, x3, #8
    b pmoInt8DotVector
pmoInt8DotReduce:
    addv s0, v0.4s
    umov w0, v0.s[0]
    cbz x3, pmoInt8DotDone
pmoInt8DotLoop:
    ldrb w6, [x1]
    ldrb w7, [x2]
    sxtb w6, w6
    sxtb w7, w7
    madd w0, w6, w7, w0
    add x1, x1, x4
    add x2, x2, x5
    subs x3, x3, #1
    b.ne pmoInt8DotLoop
pmoInt8DotDone:
    sxtw x0, w0
  EndASM
  CompilerElseIf #PMO_INT8_BACKEND = 2
  ASM
    push {r4, r5, r6, r7}
    ldr r1, [r0, #0]
    ldr r2, [r0, #4]
    ldr r3, [r0, #8]
    ldr r4, [r0, #12]
    ldr r5, [r0, #16]
    movs r6, #0
    cmp r3, #0
    beq pmoInt8ThumbDone
pmoInt8ThumbLoop:
    ldrb r0, [r1]
    ldrb r7, [r2]
    sxtb r0, r0
    sxtb r7, r7
    muls r0, r7
    adds r6, r6, r0
    adds r1, r1, r4
    adds r2, r2, r5
    subs r3, r3, #1
    bne pmoInt8ThumbLoop
pmoInt8ThumbDone:
    movs r0, r6
    pop {r4, r5, r6, r7}
  EndASM
  CompilerElseIf #PMO_INT8_BACKEND = 3
  ASM
    push {r4, r5, r6, r7}
    ldr r1, [r0, #0]
    ldr r2, [r0, #4]
    ldr r3, [r0, #8]
    ldr r4, [r0, #12]
    ldr r5, [r0, #16]
    movs r6, #0
    cmp r3, #0
    beq pmoInt8M33Done
    cmp r4, #1
    bne pmoInt8M33Loop
    cmp r5, #1
    bne pmoInt8M33Loop
    movs r0, r1
    orrs r0, r2
    movs r7, #3
    tst r0, r7
    bne pmoInt8M33Loop
pmoInt8M33Four:
    cmp r3, #4
    blt pmoInt8M33Tail
    ldr r0, [r1]
    ldr r7, [r2]
    ; Explicit zero rotation also works around the assembler X2 omission defect.
    sxtb16 r4, r0, ror #0
    sxtb16 r5, r7, ror #0
    smlad r6, r4, r5, r6
    sxtb16 r4, r0, ror #8
    sxtb16 r5, r7, ror #8
    smlad r6, r4, r5, r6
    adds r1, r1, #4
    adds r2, r2, #4
    subs r3, r3, #4
    b pmoInt8M33Four
pmoInt8M33Tail:
    movs r4, #1
    movs r5, #1
    cmp r3, #0
    beq pmoInt8M33Done
pmoInt8M33Loop:
    ldrb r0, [r1]
    ldrb r7, [r2]
    sxtb r0, r0
    sxtb r7, r7
    muls r0, r7
    adds r6, r6, r0
    adds r1, r1, r4
    adds r2, r2, r5
    subs r3, r3, #1
    bne pmoInt8M33Loop
pmoInt8M33Done:
    movs r0, r6
    pop {r4, r5, r6, r7}
  EndASM
  CompilerElse
  Protected pa.i
  Protected pb.i
  Protected left.i
  Protected sa.i
  Protected sb.i
  Protected total.i
  pa = *g\A : pb = *g\B : left = *g\Count
  sa = *g\StepA : sb = *g\StepB : total = 0
  While left >= 4
    total = total + PeekB(pa) * PeekB(pb)
    total = total + PeekB(pa + sa) * PeekB(pb + sb)
    total = total + PeekB(pa + sa * 2) * PeekB(pb + sb * 2)
    total = total + PeekB(pa + sa * 3) * PeekB(pb + sb * 3)
    pa = pa + sa * 4 : pb = pb + sb * 4 : left = left - 4
  Wend
  While left > 0
    total = total + PeekB(pa) * PeekB(pb)
    pa = pa + sa : pb = pb + sb : left = left - 1
  Wend
  ProcedureReturn total
  CompilerEndIf
EndProcedure

; Exact dot of `Count` signed 16-bit activations (StepA bytes apart) with
; signed INT8 weights (StepB bytes apart). The wide path's chunk is at most
; 512 elements, so the sum stays inside INT32.
Structure PmI8Dot16Args
  A.i
  B.i
  Count.i
  StepA.i
  StepB.i
EndStructure

Procedure.i PmI8Dot16(*g.PmI8Dot16Args)
  CompilerIf #PMO_INT8_BACKEND >= 2
  ASM
    push {r4, r5, r6, r7}
    ldr r1, [r0, #0]
    ldr r2, [r0, #4]
    ldr r3, [r0, #8]
    ldr r4, [r0, #12]
    ldr r5, [r0, #16]
    movs r6, #0
    cmp r3, #0
    beq pmoI8Dot16ThumbDone
pmoI8Dot16ThumbLoop:
    ldrh r0, [r1]
    ldrb r7, [r2]
    sxth r0, r0
    sxtb r7, r7
    muls r0, r7
    adds r6, r6, r0
    adds r1, r1, r4
    adds r2, r2, r5
    subs r3, r3, #1
    bne pmoI8Dot16ThumbLoop
pmoI8Dot16ThumbDone:
    movs r0, r6
    pop {r4, r5, r6, r7}
  EndASM
  CompilerElse
  Protected pa.i
  Protected pb.i
  Protected left.i
  Protected total.i
  pa = *g\A : pb = *g\B : left = *g\Count : total = 0
  While left > 0
    total = total + PeekW(pa) * PeekB(pb)
    pa = pa + *g\StepA : pb = pb + *g\StepB : left = left - 1
  Wend
  ProcedureReturn total
  CompilerEndIf
EndProcedure

CompilerIf #PMO_INT8_BACKEND = 1
; ---- Advanced SIMD bodies (Pi 4, UNO Q) ------------------------------------
; Each one is the scalar definition below computed several lanes at a time:
; integer products are exact, and every FP32 step is the same single
; operation on the same operands (no fused multiply-add, no reassociation).

; Largest |x| of `count` contiguous FP32 values, as its bit pattern.
Procedure.i PmI8MaxBitsNeon(*src.i, count.i)
  ASM
    mov x2, x0
    mvni v31.4s, #0x80, lsl #24
    movi v0.4s, #0
pmoI8MaxBits16:
    cmp x1, #16
    b.lt pmoI8MaxBits4
    ld1 {v2.4s, v3.4s, v4.4s, v5.4s}, [x2], #64
    and v2.16b, v2.16b, v31.16b
    and v3.16b, v3.16b, v31.16b
    and v4.16b, v4.16b, v31.16b
    and v5.16b, v5.16b, v31.16b
    umax v2.4s, v2.4s, v3.4s
    umax v4.4s, v4.4s, v5.4s
    umax v0.4s, v0.4s, v2.4s
    umax v0.4s, v0.4s, v4.4s
    sub x1, x1, #16
    b pmoI8MaxBits16
pmoI8MaxBits4:
    cmp x1, #4
    b.lt pmoI8MaxBits1
    ld1 {v2.4s}, [x2], #16
    and v2.16b, v2.16b, v31.16b
    umax v0.4s, v0.4s, v2.4s
    sub x1, x1, #4
    b pmoI8MaxBits4
pmoI8MaxBits1:
    cbz x1, pmoI8MaxBitsDone
    movi v2.4s, #0
    ld1 {v2.s}[0], [x2], #4
    and v2.16b, v2.16b, v31.16b
    umax v0.4s, v0.4s, v2.4s
    sub x1, x1, #1
    b pmoI8MaxBits1
pmoI8MaxBitsDone:
    umaxv s0, v0.4s
    umov w0, v0.s[0]
  EndASM
EndProcedure

; out[c] = largest |src[r*RowBytes + c*4]| over Rows rows, as bit patterns.
Structure PmI8ColumnArgs
  Src.i
  Rows.i
  RowBytes.i
  Cols.i
  Out.i
EndStructure

Procedure PmI8ColMaxNeon(*a.PmI8ColumnArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    mvni v31.4s, #0x80, lsl #24
pmoI8Col16:
    cmp x4, #16
    b.lt pmoI8Col4
    movi v16.4s, #0
    movi v17.4s, #0
    movi v18.4s, #0
    movi v19.4s, #0
    mov x6, x1
    mov x7, x2
    cbz x7, pmoI8Col16Store
pmoI8Col16Row:
    ld1 {v0.4s, v1.4s, v2.4s, v3.4s}, [x6], x3
    and v0.16b, v0.16b, v31.16b
    and v1.16b, v1.16b, v31.16b
    and v2.16b, v2.16b, v31.16b
    and v3.16b, v3.16b, v31.16b
    umax v16.4s, v16.4s, v0.4s
    umax v17.4s, v17.4s, v1.4s
    umax v18.4s, v18.4s, v2.4s
    umax v19.4s, v19.4s, v3.4s
    subs x7, x7, #1
    b.ne pmoI8Col16Row
pmoI8Col16Store:
    st1 {v16.4s, v17.4s, v18.4s, v19.4s}, [x5], #64
    add x1, x1, #64
    sub x4, x4, #16
    b pmoI8Col16
pmoI8Col4:
    cmp x4, #4
    b.lt pmoI8Col1
    movi v16.4s, #0
    mov x6, x1
    mov x7, x2
    cbz x7, pmoI8Col4Store
pmoI8Col4Row:
    ld1 {v0.4s}, [x6], x3
    and v0.16b, v0.16b, v31.16b
    umax v16.4s, v16.4s, v0.4s
    subs x7, x7, #1
    b.ne pmoI8Col4Row
pmoI8Col4Store:
    st1 {v16.4s}, [x5], #16
    add x1, x1, #16
    sub x4, x4, #4
    b pmoI8Col4
pmoI8Col1:
    cbz x4, pmoI8ColDone
    movi v16.4s, #0
    mov x6, x1
    mov x7, x2
    cbz x7, pmoI8Col1Store
pmoI8Col1Row:
    movi v0.4s, #0
    ld1 {v0.s}[0], [x6], x3
    and v0.16b, v0.16b, v31.16b
    umax v16.4s, v16.4s, v0.4s
    subs x7, x7, #1
    b.ne pmoI8Col1Row
pmoI8Col1Store:
    st1 {v16.s}[0], [x5], #4
    add x1, x1, #4
    sub x4, x4, #1
    b pmoI8Col1
pmoI8ColDone:
  EndASM
EndProcedure

; dst = saturate(round-half-even(src * inv)), Count values, INT8 or INT16.
; InvStep 0: one reciprocal for every value; 4: one per value.
Structure PmI8QuantArgs
  Src.i
  Inv.i
  InvStep.i
  Dst.i
  Count.i
  Wide.i
EndStructure

Procedure PmI8QuantNeon(*a.PmI8QuantArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    ldr x6, [x0, #40]
    ld1r {v7.4s}, [x2]
    mov v6.16b, v7.16b
pmoI8Quant8:
    cmp x5, #8
    b.lt pmoI8QuantTail
    ld1 {v0.4s, v1.4s}, [x1], #32
    cbz x3, pmoI8QuantMul
    ld1 {v6.4s, v7.4s}, [x2], #32
pmoI8QuantMul:
    fmul v0.4s, v0.4s, v6.4s
    fmul v1.4s, v1.4s, v7.4s
    fcvtns v0.4s, v0.4s
    fcvtns v1.4s, v1.4s
    sqxtn v0.4h, v0.4s
    sqxtn2 v0.8h, v1.4s
    cbnz x6, pmoI8QuantStore16
    sqxtn v0.8b, v0.8h
    st1 {v0.8b}, [x4], #8
    sub x5, x5, #8
    b pmoI8Quant8
pmoI8QuantStore16:
    st1 {v0.8h}, [x4], #16
    sub x5, x5, #8
    b pmoI8Quant8
pmoI8QuantTail:
    cbz x5, pmoI8QuantDone
    ld1 {v0.s}[0], [x1], #4
    ld1 {v1.s}[0], [x2], x3
    fmul v0.4s, v0.4s, v1.4s
    fcvtns v0.4s, v0.4s
    sqxtn v0.4h, v0.4s
    cbnz x6, pmoI8QuantTail16
    sqxtn v0.8b, v0.8h
    st1 {v0.b}[0], [x4], #1
    sub x5, x5, #1
    b pmoI8QuantTail
pmoI8QuantTail16:
    st1 {v0.h}[0], [x4], #2
    sub x5, x5, #1
    b pmoI8QuantTail
pmoI8QuantDone:
  EndASM
EndProcedure

; Four broadcast rows by sixteen lanes over `Count` reduction steps, then the
; flush F[r][l] = F[r][l] + float(acc[r][l]) * scale. Lane l of step c is the
; value at L + c*LStep + l*size; row r's value at step c is at Pr + c*PStep.
;   Kind 0: INT8 lanes x INT8 rows (narrow). Two steps share one 16-bit
;           partial sum - two products of +-127 values stay inside +-32258.
;   Kind 1: INT16 lanes x INT8 rows (wide Conv: activations in the lanes).
;   Kind 2: INT8 lanes x INT16 rows (wide MatMul: weights in the lanes).
; RowScale 0: sixteen per-lane scales at S; 1: four per-row scales at S.
; Zero 1: F starts at +0.0 instead of being read.
Structure PmI8TileArgs
  L.i
  LStep.i
  P0.i
  P1.i
  P2.i
  P3.i
  PStep.i
  Count.i
  F.i
  S.i
  RowScale.i
  Kind.i
  Zero.i
EndStructure

Procedure PmI8TileNeon(*a.PmI8TileArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x10, [x0, #16]
    ldr x11, [x0, #24]
    ldr x12, [x0, #32]
    ldr x13, [x0, #40]
    ldr x14, [x0, #48]
    ldr x3, [x0, #56]
    ldr x4, [x0, #88]
    movi v16.4s, #0
    movi v17.4s, #0
    movi v18.4s, #0
    movi v19.4s, #0
    movi v20.4s, #0
    movi v21.4s, #0
    movi v22.4s, #0
    movi v23.4s, #0
    movi v24.4s, #0
    movi v25.4s, #0
    movi v26.4s, #0
    movi v27.4s, #0
    movi v28.4s, #0
    movi v29.4s, #0
    movi v30.4s, #0
    movi v31.4s, #0
    cbz x3, pmoI8TileFlush
    cbz x4, pmoI8TileK0
    subs x4, x4, #1
    b.ne pmoI8TileK2
pmoI8TileK1:
    ld1 {v1.8h, v2.8h}, [x1], x2
    ld1r {v4.8b}, [x10], x14
    sxtl v4.8h, v4.8b
    smlal v16.4s, v1.4h, v4.4h
    smlal2 v17.4s, v1.8h, v4.8h
    smlal v18.4s, v2.4h, v4.4h
    smlal2 v19.4s, v2.8h, v4.8h
    ld1r {v4.8b}, [x11], x14
    sxtl v4.8h, v4.8b
    smlal v20.4s, v1.4h, v4.4h
    smlal2 v21.4s, v1.8h, v4.8h
    smlal v22.4s, v2.4h, v4.4h
    smlal2 v23.4s, v2.8h, v4.8h
    ld1r {v4.8b}, [x12], x14
    sxtl v4.8h, v4.8b
    smlal v24.4s, v1.4h, v4.4h
    smlal2 v25.4s, v1.8h, v4.8h
    smlal v26.4s, v2.4h, v4.4h
    smlal2 v27.4s, v2.8h, v4.8h
    ld1r {v4.8b}, [x13], x14
    sxtl v4.8h, v4.8b
    smlal v28.4s, v1.4h, v4.4h
    smlal2 v29.4s, v1.8h, v4.8h
    smlal v30.4s, v2.4h, v4.4h
    smlal2 v31.4s, v2.8h, v4.8h
    subs x3, x3, #1
    b.ne pmoI8TileK1
    b pmoI8TileFlush
pmoI8TileK2:
    ld1 {v0.16b}, [x1], x2
    sxtl v1.8h, v0.8b
    sxtl2 v2.8h, v0.16b
    ld1r {v4.8h}, [x10], x14
    smlal v16.4s, v1.4h, v4.4h
    smlal2 v17.4s, v1.8h, v4.8h
    smlal v18.4s, v2.4h, v4.4h
    smlal2 v19.4s, v2.8h, v4.8h
    ld1r {v4.8h}, [x11], x14
    smlal v20.4s, v1.4h, v4.4h
    smlal2 v21.4s, v1.8h, v4.8h
    smlal v22.4s, v2.4h, v4.4h
    smlal2 v23.4s, v2.8h, v4.8h
    ld1r {v4.8h}, [x12], x14
    smlal v24.4s, v1.4h, v4.4h
    smlal2 v25.4s, v1.8h, v4.8h
    smlal v26.4s, v2.4h, v4.4h
    smlal2 v27.4s, v2.8h, v4.8h
    ld1r {v4.8h}, [x13], x14
    smlal v28.4s, v1.4h, v4.4h
    smlal2 v29.4s, v1.8h, v4.8h
    smlal v30.4s, v2.4h, v4.4h
    smlal2 v31.4s, v2.8h, v4.8h
    subs x3, x3, #1
    b.ne pmoI8TileK2
    b pmoI8TileFlush
pmoI8TileK0:
    cmp x3, #2
    b.lt pmoI8TileK0One
    ld1 {v0.16b}, [x1], x2
    ld1 {v1.16b}, [x1], x2
    ld1r {v4.16b}, [x10], x14
    ld1r {v5.16b}, [x10], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    smlal v6.8h, v1.8b, v5.8b
    smlal2 v7.8h, v1.16b, v5.16b
    saddw v16.4s, v16.4s, v6.4h
    saddw2 v17.4s, v17.4s, v6.8h
    saddw v18.4s, v18.4s, v7.4h
    saddw2 v19.4s, v19.4s, v7.8h
    ld1r {v4.16b}, [x11], x14
    ld1r {v5.16b}, [x11], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    smlal v6.8h, v1.8b, v5.8b
    smlal2 v7.8h, v1.16b, v5.16b
    saddw v20.4s, v20.4s, v6.4h
    saddw2 v21.4s, v21.4s, v6.8h
    saddw v22.4s, v22.4s, v7.4h
    saddw2 v23.4s, v23.4s, v7.8h
    ld1r {v4.16b}, [x12], x14
    ld1r {v5.16b}, [x12], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    smlal v6.8h, v1.8b, v5.8b
    smlal2 v7.8h, v1.16b, v5.16b
    saddw v24.4s, v24.4s, v6.4h
    saddw2 v25.4s, v25.4s, v6.8h
    saddw v26.4s, v26.4s, v7.4h
    saddw2 v27.4s, v27.4s, v7.8h
    ld1r {v4.16b}, [x13], x14
    ld1r {v5.16b}, [x13], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    smlal v6.8h, v1.8b, v5.8b
    smlal2 v7.8h, v1.16b, v5.16b
    saddw v28.4s, v28.4s, v6.4h
    saddw2 v29.4s, v29.4s, v6.8h
    saddw v30.4s, v30.4s, v7.4h
    saddw2 v31.4s, v31.4s, v7.8h
    sub x3, x3, #2
    b pmoI8TileK0
pmoI8TileK0One:
    cbz x3, pmoI8TileFlush
    ld1 {v0.16b}, [x1], x2
    ld1r {v4.16b}, [x10], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    saddw v16.4s, v16.4s, v6.4h
    saddw2 v17.4s, v17.4s, v6.8h
    saddw v18.4s, v18.4s, v7.4h
    saddw2 v19.4s, v19.4s, v7.8h
    ld1r {v4.16b}, [x11], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    saddw v20.4s, v20.4s, v6.4h
    saddw2 v21.4s, v21.4s, v6.8h
    saddw v22.4s, v22.4s, v7.4h
    saddw2 v23.4s, v23.4s, v7.8h
    ld1r {v4.16b}, [x12], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    saddw v24.4s, v24.4s, v6.4h
    saddw2 v25.4s, v25.4s, v6.8h
    saddw v26.4s, v26.4s, v7.4h
    saddw2 v27.4s, v27.4s, v7.8h
    ld1r {v4.16b}, [x13], x14
    smull v6.8h, v0.8b, v4.8b
    smull2 v7.8h, v0.16b, v4.16b
    saddw v28.4s, v28.4s, v6.4h
    saddw2 v29.4s, v29.4s, v6.8h
    saddw v30.4s, v30.4s, v7.4h
    saddw2 v31.4s, v31.4s, v7.8h
pmoI8TileFlush:
    ldr x5, [x0, #64]
    ldr x6, [x0, #72]
    ldr x7, [x0, #80]
    ldr x8, [x0, #96]
    scvtf v16.4s, v16.4s
    scvtf v17.4s, v17.4s
    scvtf v18.4s, v18.4s
    scvtf v19.4s, v19.4s
    scvtf v20.4s, v20.4s
    scvtf v21.4s, v21.4s
    scvtf v22.4s, v22.4s
    scvtf v23.4s, v23.4s
    scvtf v24.4s, v24.4s
    scvtf v25.4s, v25.4s
    scvtf v26.4s, v26.4s
    scvtf v27.4s, v27.4s
    scvtf v28.4s, v28.4s
    scvtf v29.4s, v29.4s
    scvtf v30.4s, v30.4s
    scvtf v31.4s, v31.4s
    cbnz x7, pmoI8TileRowScale
    ld1 {v4.4s, v5.4s, v6.4s, v7.4s}, [x6]
    fmul v16.4s, v16.4s, v4.4s
    fmul v17.4s, v17.4s, v5.4s
    fmul v18.4s, v18.4s, v6.4s
    fmul v19.4s, v19.4s, v7.4s
    fmul v20.4s, v20.4s, v4.4s
    fmul v21.4s, v21.4s, v5.4s
    fmul v22.4s, v22.4s, v6.4s
    fmul v23.4s, v23.4s, v7.4s
    fmul v24.4s, v24.4s, v4.4s
    fmul v25.4s, v25.4s, v5.4s
    fmul v26.4s, v26.4s, v6.4s
    fmul v27.4s, v27.4s, v7.4s
    fmul v28.4s, v28.4s, v4.4s
    fmul v29.4s, v29.4s, v5.4s
    fmul v30.4s, v30.4s, v6.4s
    fmul v31.4s, v31.4s, v7.4s
    b pmoI8TileAdd
pmoI8TileRowScale:
    ld1r {v4.4s}, [x6], #4
    fmul v16.4s, v16.4s, v4.4s
    fmul v17.4s, v17.4s, v4.4s
    fmul v18.4s, v18.4s, v4.4s
    fmul v19.4s, v19.4s, v4.4s
    ld1r {v4.4s}, [x6], #4
    fmul v20.4s, v20.4s, v4.4s
    fmul v21.4s, v21.4s, v4.4s
    fmul v22.4s, v22.4s, v4.4s
    fmul v23.4s, v23.4s, v4.4s
    ld1r {v4.4s}, [x6], #4
    fmul v24.4s, v24.4s, v4.4s
    fmul v25.4s, v25.4s, v4.4s
    fmul v26.4s, v26.4s, v4.4s
    fmul v27.4s, v27.4s, v4.4s
    ld1r {v4.4s}, [x6], #4
    fmul v28.4s, v28.4s, v4.4s
    fmul v29.4s, v29.4s, v4.4s
    fmul v30.4s, v30.4s, v4.4s
    fmul v31.4s, v31.4s, v4.4s
pmoI8TileAdd:
    cbnz x8, pmoI8TileZero
    ld1 {v0.4s, v1.4s, v2.4s, v3.4s}, [x5]
    fadd v16.4s, v0.4s, v16.4s
    fadd v17.4s, v1.4s, v17.4s
    fadd v18.4s, v2.4s, v18.4s
    fadd v19.4s, v3.4s, v19.4s
    st1 {v16.4s, v17.4s, v18.4s, v19.4s}, [x5], #64
    ld1 {v0.4s, v1.4s, v2.4s, v3.4s}, [x5]
    fadd v20.4s, v0.4s, v20.4s
    fadd v21.4s, v1.4s, v21.4s
    fadd v22.4s, v2.4s, v22.4s
    fadd v23.4s, v3.4s, v23.4s
    st1 {v20.4s, v21.4s, v22.4s, v23.4s}, [x5], #64
    ld1 {v0.4s, v1.4s, v2.4s, v3.4s}, [x5]
    fadd v24.4s, v0.4s, v24.4s
    fadd v25.4s, v1.4s, v25.4s
    fadd v26.4s, v2.4s, v26.4s
    fadd v27.4s, v3.4s, v27.4s
    st1 {v24.4s, v25.4s, v26.4s, v27.4s}, [x5], #64
    ld1 {v0.4s, v1.4s, v2.4s, v3.4s}, [x5]
    fadd v28.4s, v0.4s, v28.4s
    fadd v29.4s, v1.4s, v29.4s
    fadd v30.4s, v2.4s, v30.4s
    fadd v31.4s, v3.4s, v31.4s
    st1 {v28.4s, v29.4s, v30.4s, v31.4s}, [x5]
    b pmoI8TileDone
pmoI8TileZero:
    movi v0.4s, #0
    fadd v16.4s, v0.4s, v16.4s
    fadd v17.4s, v0.4s, v17.4s
    fadd v18.4s, v0.4s, v18.4s
    fadd v19.4s, v0.4s, v19.4s
    fadd v20.4s, v0.4s, v20.4s
    fadd v21.4s, v0.4s, v21.4s
    fadd v22.4s, v0.4s, v22.4s
    fadd v23.4s, v0.4s, v23.4s
    fadd v24.4s, v0.4s, v24.4s
    fadd v25.4s, v0.4s, v25.4s
    fadd v26.4s, v0.4s, v26.4s
    fadd v27.4s, v0.4s, v27.4s
    fadd v28.4s, v0.4s, v28.4s
    fadd v29.4s, v0.4s, v29.4s
    fadd v30.4s, v0.4s, v30.4s
    fadd v31.4s, v0.4s, v31.4s
    st1 {v16.4s, v17.4s, v18.4s, v19.4s}, [x5], #64
    st1 {v20.4s, v21.4s, v22.4s, v23.4s}, [x5], #64
    st1 {v24.4s, v25.4s, v26.4s, v27.4s}, [x5], #64
    st1 {v28.4s, v29.4s, v30.4s, v31.4s}, [x5]
pmoI8TileDone:
  EndASM
EndProcedure

; Four contiguous INT8 weight rows dotted with one contiguous activation row
; (INT8, or INT16 when Wide), then F[r] = F[r] + float(acc[r]) * scale, the
; scale being the one float at S. Wide callers pass at most 512 elements.
Structure PmI8DotArgs
  X.i
  W0.i
  W1.i
  W2.i
  W3.i
  Count.i
  F.i
  S.i
  Wide.i
  Zero.i
EndStructure

Procedure PmI8DotNeon(*a.PmI8DotArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x10, [x0, #8]
    ldr x11, [x0, #16]
    ldr x12, [x0, #24]
    ldr x13, [x0, #32]
    ldr x3, [x0, #40]
    ldr x4, [x0, #64]
    movi v16.4s, #0
    movi v17.4s, #0
    movi v18.4s, #0
    movi v19.4s, #0
    movi v20.4s, #0
    movi v21.4s, #0
    movi v22.4s, #0
    movi v23.4s, #0
    mov w8, wzr
    mov w9, wzr
    mov w15, wzr
    mov w16, wzr
    cbnz x4, pmoI8DotW8
pmoI8DotN16:
    cmp x3, #16
    b.lt pmoI8DotNTail
    ld1 {v0.16b}, [x1], #16
    ld1 {v1.16b}, [x10], #16
    smull v2.8h, v0.8b, v1.8b
    smull2 v3.8h, v0.16b, v1.16b
    sadalp v16.4s, v2.8h
    sadalp v17.4s, v3.8h
    ld1 {v1.16b}, [x11], #16
    smull v2.8h, v0.8b, v1.8b
    smull2 v3.8h, v0.16b, v1.16b
    sadalp v18.4s, v2.8h
    sadalp v19.4s, v3.8h
    ld1 {v1.16b}, [x12], #16
    smull v2.8h, v0.8b, v1.8b
    smull2 v3.8h, v0.16b, v1.16b
    sadalp v20.4s, v2.8h
    sadalp v21.4s, v3.8h
    ld1 {v1.16b}, [x13], #16
    smull v2.8h, v0.8b, v1.8b
    smull2 v3.8h, v0.16b, v1.16b
    sadalp v22.4s, v2.8h
    sadalp v23.4s, v3.8h
    sub x3, x3, #16
    b pmoI8DotN16
pmoI8DotNTail:
    cbz x3, pmoI8DotSum
    ldrb w5, [x1]
    add x1, x1, #1
    sxtb w5, w5
    ldrb w6, [x10]
    add x10, x10, #1
    sxtb w6, w6
    madd w8, w5, w6, w8
    ldrb w6, [x11]
    add x11, x11, #1
    sxtb w6, w6
    madd w9, w5, w6, w9
    ldrb w6, [x12]
    add x12, x12, #1
    sxtb w6, w6
    madd w15, w5, w6, w15
    ldrb w6, [x13]
    add x13, x13, #1
    sxtb w6, w6
    madd w16, w5, w6, w16
    sub x3, x3, #1
    b pmoI8DotNTail
pmoI8DotW8:
    cmp x3, #8
    b.lt pmoI8DotWTail
    ld1 {v0.8h}, [x1], #16
    ld1 {v1.8b}, [x10], #8
    sxtl v1.8h, v1.8b
    smlal v16.4s, v0.4h, v1.4h
    smlal2 v17.4s, v0.8h, v1.8h
    ld1 {v1.8b}, [x11], #8
    sxtl v1.8h, v1.8b
    smlal v18.4s, v0.4h, v1.4h
    smlal2 v19.4s, v0.8h, v1.8h
    ld1 {v1.8b}, [x12], #8
    sxtl v1.8h, v1.8b
    smlal v20.4s, v0.4h, v1.4h
    smlal2 v21.4s, v0.8h, v1.8h
    ld1 {v1.8b}, [x13], #8
    sxtl v1.8h, v1.8b
    smlal v22.4s, v0.4h, v1.4h
    smlal2 v23.4s, v0.8h, v1.8h
    sub x3, x3, #8
    b pmoI8DotW8
pmoI8DotWTail:
    cbz x3, pmoI8DotSum
    ldrh w5, [x1]
    add x1, x1, #2
    sxth w5, w5
    ldrb w6, [x10]
    add x10, x10, #1
    sxtb w6, w6
    madd w8, w5, w6, w8
    ldrb w6, [x11]
    add x11, x11, #1
    sxtb w6, w6
    madd w9, w5, w6, w9
    ldrb w6, [x12]
    add x12, x12, #1
    sxtb w6, w6
    madd w15, w5, w6, w15
    ldrb w6, [x13]
    add x13, x13, #1
    sxtb w6, w6
    madd w16, w5, w6, w16
    sub x3, x3, #1
    b pmoI8DotWTail
pmoI8DotSum:
    add v16.4s, v16.4s, v17.4s
    add v18.4s, v18.4s, v19.4s
    add v20.4s, v20.4s, v21.4s
    add v22.4s, v22.4s, v23.4s
    addp v16.4s, v16.4s, v18.4s
    addp v20.4s, v20.4s, v22.4s
    addp v16.4s, v16.4s, v20.4s
    movi v0.4s, #0
    mov v0.s[0], w8
    mov v0.s[1], w9
    mov v0.s[2], w15
    mov v0.s[3], w16
    add v16.4s, v16.4s, v0.4s
    scvtf v16.4s, v16.4s
    ldr x6, [x0, #56]
    ld1r {v1.4s}, [x6]
    fmul v16.4s, v16.4s, v1.4s
    ldr x5, [x0, #48]
    ldr x7, [x0, #72]
    movi v2.4s, #0
    cbnz x7, pmoI8DotAdd
    ld1 {v2.4s}, [x5]
pmoI8DotAdd:
    fadd v16.4s, v2.4s, v16.4s
    st1 {v16.4s}, [x5]
  EndASM
EndProcedure

; y[r][l] = (F1 or F1 + F2 / 254) * wScale (+ bias), for Rows rows of sixteen
; lanes; row r lands at Dst + r*DStride. The weight scale is per row (the four
; floats at WS, one per row) or, with LaneScale, per lane (sixteen at WS). The
; bias, when present, is per row.
Structure PmI8EpiArgs
  F1.i
  F2.i
  WS.i
  Bias.i
  Dst.i
  DStride.i
  Rows.i
  LaneScale.i
EndStructure

Procedure PmI8EpiNeon(*a.PmI8EpiArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    ldr x6, [x0, #40]
    ldr x7, [x0, #48]
    ldr x8, [x0, #56]
    movz w9, #0x437e, lsl #16
    dup v31.4s, w9
    cbz x8, pmoI8EpiRow
    ld1 {v24.4s, v25.4s, v26.4s, v27.4s}, [x3]
pmoI8EpiRow:
    cbz x7, pmoI8EpiDone
    ld1 {v0.4s, v1.4s, v2.4s, v3.4s}, [x1], #64
    cbz x2, pmoI8EpiScale
    ld1 {v4.4s, v5.4s, v6.4s, v7.4s}, [x2], #64
    fdiv v4.4s, v4.4s, v31.4s
    fdiv v5.4s, v5.4s, v31.4s
    fdiv v6.4s, v6.4s, v31.4s
    fdiv v7.4s, v7.4s, v31.4s
    fadd v0.4s, v0.4s, v4.4s
    fadd v1.4s, v1.4s, v5.4s
    fadd v2.4s, v2.4s, v6.4s
    fadd v3.4s, v3.4s, v7.4s
pmoI8EpiScale:
    cbnz x8, pmoI8EpiLane
    ld1r {v4.4s}, [x3], #4
    fmul v0.4s, v0.4s, v4.4s
    fmul v1.4s, v1.4s, v4.4s
    fmul v2.4s, v2.4s, v4.4s
    fmul v3.4s, v3.4s, v4.4s
    b pmoI8EpiBias
pmoI8EpiLane:
    fmul v0.4s, v0.4s, v24.4s
    fmul v1.4s, v1.4s, v25.4s
    fmul v2.4s, v2.4s, v26.4s
    fmul v3.4s, v3.4s, v27.4s
pmoI8EpiBias:
    cbz x4, pmoI8EpiStore
    ld1r {v4.4s}, [x4], #4
    fadd v0.4s, v4.4s, v0.4s
    fadd v1.4s, v4.4s, v1.4s
    fadd v2.4s, v4.4s, v2.4s
    fadd v3.4s, v4.4s, v3.4s
pmoI8EpiStore:
    st1 {v0.4s, v1.4s, v2.4s, v3.4s}, [x5]
    add x5, x5, x6
    sub x7, x7, #1
    b pmoI8EpiRow
pmoI8EpiDone:
  EndASM
EndProcedure
CompilerEndIf

; ---- the scalar definition ---------------------------------------------------
; Round half to even of one FP32 value, from its bits, for |x| < 32768; any
; larger magnitude comes back as 65536 with its sign and the caller clamps.
Procedure.i PmI8RoundEven(x.f)
  Protected bits.i
  Protected a.i
  Protected e.i
  Protected m.i
  Protected sh.i
  Protected r.i
  Protected rem.i
  Protected half.i
  bits = PeekL(@x)
  a = bits & $7FFFFFFF
  e = a >> 23
  If e < 126
    ProcedureReturn 0
  EndIf
  If e > 141
    r = 65536
  Else
    m = (a & $7FFFFF) | $800000
    sh = 150 - e
    r = m >> sh
    rem = m & ((1 << sh) - 1)
    half = 1 << (sh - 1)
    If rem > half
      r = r + 1
    ElseIf rem = half And (r & 1) = 1
      r = r + 1
    EndIf
  EndIf
  If (bits & $80000000) <> 0
    r = 0 - r
  EndIf
  ProcedureReturn r
EndProcedure

; Largest |x| of `count` values `stride` bytes apart, as its bit pattern. Bit
; patterns of finite magnitudes order like the magnitudes; any pattern at or
; above $7F800000 is a NaN or an infinity.
Procedure.i PmI8MaxBits(*src.i, count.i, stride.i)
  Protected i.i
  Protected p.i
  Protected v.i
  Protected best.i
  CompilerIf #PMO_INT8_BACKEND = 1
  If stride = 4
    ProcedureReturn PmI8MaxBitsNeon(*src, count)
  EndIf
  CompilerEndIf
  i = 0 : p = *src : best = 0
  While i < count
    v = PeekL(p) & $7FFFFFFF
    If v > best : best = v : EndIf
    p = p + stride : i = i + 1
  Wend
  ProcedureReturn best
EndProcedure

; Scale and reciprocal of one row maximum. Returns 0 for a NaN or an infinity.
Procedure.i PmI8RowScale(bits.i, qmax.i, *scale.i, *inv.i)
  Protected m.f
  Protected q.f
  Protected s.f
  If bits >= $7F800000 Or bits < 0
    ProcedureReturn 0
  EndIf
  If bits < #PMI8_TINY_BITS
    PmI8PutF(*scale, 0.0) : PmI8PutF(*inv, 0.0)
    ProcedureReturn 1
  EndIf
  PokeL(@m, bits)
  q = qmax
  s = m / q : PmI8PutF(*scale, s)
  s = q / m : PmI8PutF(*inv, s)
  ProcedureReturn 1
EndProcedure

; Quantize `count` values `stride` bytes apart with one reciprocal into a
; contiguous row: one byte each when qmax is 127, two when it is 32767.
Procedure PmI8QuantWith(*src.i, count.i, stride.i, inv.f, qmax.i, *dst.i)
  Protected i.i
  Protected p.i
  Protected d.i
  Protected q.i
  Protected x.f
  CompilerIf #PMO_INT8_BACKEND = 1
  Protected qa.PmI8QuantArgs
  If stride = 4
    qa\Src = *src : qa\Inv = @inv : qa\InvStep = 0 : qa\Dst = *dst : qa\Count = count
    qa\Wide = Bool(qmax <> 127)
    PmI8QuantNeon(@qa)
    ProcedureReturn
  EndIf
  CompilerEndIf
  i = 0 : p = *src : d = *dst
  While i < count
    x = PmI8GetF(p)
    x = x * inv
    q = PmI8RoundEven(x)
    If q > qmax : q = qmax : EndIf
    If q < 0 - qmax : q = 0 - qmax : EndIf
    If qmax = 127
      PokeA(d, q & 255) : d = d + 1
    Else
      PokeW(d, q) : d = d + 2
    EndIf
    p = p + stride : i = i + 1
  Wend
EndProcedure

; Quantize `count` contiguous values, each with its own reciprocal.
Procedure PmI8QuantLanes(*src.i, *inv.i, count.i, qmax.i, *dst.i)
  Protected i.i
  Protected d.i
  Protected q.i
  Protected x.f
  Protected r.f
  CompilerIf #PMO_INT8_BACKEND = 1
  Protected qa.PmI8QuantArgs
  qa\Src = *src : qa\Inv = *inv : qa\InvStep = 4 : qa\Dst = *dst : qa\Count = count
  qa\Wide = Bool(qmax <> 127)
  PmI8QuantNeon(@qa)
  ProcedureReturn
  CompilerEndIf
  i = 0 : d = *dst
  While i < count
    x = PmI8GetF(*src + i * 4)
    r = PmI8GetF(*inv + i * 4)
    x = x * r
    q = PmI8RoundEven(x)
    If q > qmax : q = qmax : EndIf
    If q < 0 - qmax : q = 0 - qmax : EndIf
    If qmax = 127
      PokeA(d, q & 255) : d = d + 1
    Else
      PokeW(d, q) : d = d + 2
    EndIf
    i = i + 1
  Wend
EndProcedure

; One whole row: its scale at *scale, its reciprocal at *inv, its values at
; *dst. Returns 0 for a NaN or an infinity (nothing is written then).
Procedure.i PmI8QuantRow(*src.i, count.i, stride.i, qmax.i, *dst.i, *scale.i, *inv.i)
  Protected bits.i
  bits = PmI8MaxBits(*src, count, stride)
  If PmI8RowScale(bits, qmax, *scale, *inv) = 0
    ProcedureReturn 0
  EndIf
  PmI8QuantWith(*src, count, stride, PmI8GetF(*inv), qmax, *dst)
  ProcedureReturn 1
EndProcedure

; F + the scaled sums of one weight row against one quantized row: per chunk
; (the whole row narrow, 512 elements wide) F = F + float(acc) * scale.
; Activations are stepQ bytes apart, weights stepW bytes apart.
Procedure.f PmI8RowF(f.f, *q.i, stepQ.i, *w.i, stepW.i, count.i, wide.i, scale.f)
  Protected dot.PmTensorInt8DotArgs
  Protected d16.PmI8Dot16Args
  Protected k.i
  Protected n.i
  Protected acc.i
  Protected v.f
  If wide = 0
    dot\A = *q : dot\B = *w : dot\Count = count : dot\StepA = stepQ : dot\StepB = stepW
    acc = PmTensorInt8Dot(@dot)
    v = acc : v = v * scale : f = f + v
    ProcedureReturn f
  EndIf
  d16\StepA = stepQ : d16\StepB = stepW : k = 0
  While k < count
    n = count - k
    If n > 512 : n = 512 : EndIf
    d16\A = *q + k * stepQ : d16\B = *w + k * stepW : d16\Count = n
    acc = PmI8Dot16(@d16)
    v = acc : v = v * scale : f = f + v
    k = k + n
  Wend
  ProcedureReturn f
EndProcedure

; y = F1 * wScale, or (F1 + F2 / 254) * wScale for a wide weight.
Procedure.f PmI8Finish(f1.f, f2.f, wide.i, ws.f)
  Protected v.f
  Protected t.f
  v = f1
  If wide <> 0
    t = f2 / 254.0
    v = v + t
  EndIf
  v = v * ws
  ProcedureReturn v
EndProcedure

; F1/F2 of four consecutive weight rows (rowStride bytes apart, elements
; contiguous, plane 2 `plane` bytes after plane 1) against one quantized row.
Procedure PmI8Block4(*q.i, *w.i, rowStride.i, plane.i, count.i, wide.i, *scale.i, *f1.i, *f2.i)
  Protected r.i
  Protected f.f
  CompilerIf #PMO_INT8_BACKEND = 1
  Protected da.PmI8DotArgs
  Protected k.i
  Protected n.i
  Protected p.i
  p = 0
  While p <= wide
    k = 0
    da\Zero = 1 : da\Wide = wide : da\S = *scale
    da\F = *f1 : If p = 1 : da\F = *f2 : EndIf
    If count = 0
      da\X = *q : da\W0 = *w : da\W1 = *w : da\W2 = *w : da\W3 = *w : da\Count = 0
      PmI8DotNeon(@da)
    EndIf
    While k < count
      n = count - k
      If wide <> 0 And n > 512 : n = 512 : EndIf
      da\X = *q + k * (1 + wide)
      da\W0 = *w + p * plane + k : da\W1 = da\W0 + rowStride
      da\W2 = da\W1 + rowStride : da\W3 = da\W2 + rowStride
      da\Count = n
      PmI8DotNeon(@da)
      da\Zero = 0
      k = k + n
    Wend
    p = p + 1
  Wend
  ProcedureReturn
  CompilerEndIf
  r = 0
  While r < 4
    f = PmI8RowF(0.0, *q, 1 + wide, *w + r * rowStride, 1, count, wide, PmI8GetF(*scale))
    PmI8PutF(*f1 + r * 4, f)
    If wide <> 0
      f = PmI8RowF(0.0, *q, 2, *w + plane + r * rowStride, 1, count, wide, PmI8GetF(*scale))
      PmI8PutF(*f2 + r * 4, f)
    EndIf
    r = r + 1
  Wend
EndProcedure

; The start of the scratch's tile areas (16-byte aligned).
Procedure.i PmI8Base()
  ProcedureReturn PmI8Align(PmTensorInt8Scratch)
EndProcedure
CompilerEndIf

; A is MxK, B is KxN and dst is MxN, all row-major.
Procedure PmTensorMatMul2(*a.i, *b.i, *dst.i, m.i, k.i, n.i)
  Protected row.i
  Protected col.i
  Protected inner.i
  Protected pa.i
  Protected pb.i
  Protected pd.i
  Protected sum.f
  row = 0
  While row < m
    col = 0
    While col < n
      sum = 0.0
      inner = 0
      pa = *a + (row * k) * 4
      pb = *b + col * 4
      While inner < k
        sum = sum + *pa.f * *pb.f
        pa = pa + 4
        pb = pb + n * 4
        inner = inner + 1
      Wend
      pd = *dst + (row * n + col) * 4
      *pd.f = sum
      col = col + 1
    Wend
    row = row + 1
  Wend
EndProcedure

CompilerIf #PMO_USE_INT8 = 1
; MatMul with an INT8 B ([K][N], one batch slice): one scale per row of A.
Structure PmI8MatMulArgs
  A.i
  B.i
  Dst.i
  M.i
  K.i
  N.i
  Scales.i
  Wide.i
  Elements.i
EndStructure

CompilerIf #PMO_INT8_BACKEND = 1
; F1 (and F2) of rows at the four pointers stored at tile+784 against sixteen
; columns c0.. of a [K][N] INT8 weight: lanes are weight columns, the
; broadcast rows are quantized activations, one scale per row at tile+768.
Procedure PmI8ColumnTileNeon(*b.i, elements.i, n.i, c0.i, k.i, wide.i, tile.i)
  Protected ta.PmI8TileArgs
  Protected k0.i
  Protected cnt.i
  Protected p.i
  Protected es.i
  Protected more.i
  es = 1 + wide
  ta\LStep = n : ta\PStep = es : ta\RowScale = 1 : ta\S = tile + 768
  ta\Kind = 0 : If wide <> 0 : ta\Kind = 2 : EndIf
  p = 0
  While p <= wide
    ta\F = tile + p * 256 : ta\Zero = 1 : k0 = 0 : more = 1
    While more
      cnt = k - k0
      If wide <> 0 And cnt > 512 : cnt = 512 : EndIf
      ta\L = *b + p * elements + k0 * n + c0
      ta\P0 = PeekI(tile + 784) + k0 * es : ta\P1 = PeekI(tile + 792) + k0 * es
      ta\P2 = PeekI(tile + 800) + k0 * es : ta\P3 = PeekI(tile + 808) + k0 * es
      ta\Count = cnt
      PmI8TileNeon(@ta)
      ta\Zero = 0
      k0 = k0 + cnt
      If k0 >= k : more = 0 : EndIf
    Wend
    p = p + 1
  Wend
EndProcedure

; Row block r0 (up to four rows, the last one repeated to fill the tile):
; store its row pointers and scales in the tile.
Procedure.i PmI8RowBlock(q.i, s.i, m.i, k.i, es.i, r0.i, tile.i)
  Protected i.i
  Protected rr.i
  Protected rows.i
  rows = m - r0 : If rows > 4 : rows = 4 : EndIf
  i = 0
  While i < 4
    rr = r0 + i : If rr >= m : rr = m - 1 : EndIf
    PmI8PutF(tile + 768 + i * 4, PmI8GetF(s + rr * 4))
    PokeI(tile + 784 + i * 8, q + rr * k * es)
    i = i + 1
  Wend
  ProcedureReturn rows
EndProcedure

; Columns [0, N & -16) of every row. Returns the first column not written.
Procedure.i PmI8MatMulNeon(*g.PmI8MatMulArgs, q.i, s.i, tile.i)
  Protected ea.PmI8EpiArgs
  Protected n16.i
  Protected r0.i
  Protected rows.i
  Protected c0.i
  n16 = *g\N & -16
  If n16 = 0 : ProcedureReturn 0 : EndIf
  r0 = 0
  While r0 < *g\M
    rows = PmI8RowBlock(q, s, *g\M, *g\K, 1 + *g\Wide, r0, tile)
    c0 = 0
    While c0 < n16
      PmI8ColumnTileNeon(*g\B, *g\Elements, *g\N, c0, *g\K, *g\Wide, tile)
      ea\F1 = tile : ea\F2 = 0 : If *g\Wide <> 0 : ea\F2 = tile + 256 : EndIf
      ea\WS = *g\Scales + c0 * 4 : ea\Bias = 0
      ea\Dst = *g\Dst + (r0 * *g\N + c0) * 4 : ea\DStride = *g\N * 4
      ea\Rows = rows : ea\LaneScale = 1
      PmI8EpiNeon(@ea)
      c0 = c0 + 16
    Wend
    r0 = r0 + 4
  Wend
  ProcedureReturn n16
EndProcedure
CompilerEndIf

; Returns 0 on a fault (PmTensorInt8Fault says which), 1 otherwise.
Procedure.i PmI8MatMul(*g.PmI8MatMulArgs)
  Protected es.i
  Protected qmax.i
  Protected need.i
  Protected q.i
  Protected s.i
  Protected inv.i
  Protected tile.i
  Protected r.i
  Protected c.i
  Protected col0.i
  Protected f1.f
  Protected f2.f
  Protected v.f
  If *g\M <= 0 Or *g\N <= 0 : ProcedureReturn 1 : EndIf
  es = 1 + *g\Wide
  qmax = 127 : If *g\Wide <> 0 : qmax = 32767 : EndIf
  need = PmI8ScratchBytes(*g\M * *g\K, *g\M, *g\Wide)
  If PmTensorInt8Scratch = 0 Or need > PmTensorInt8ScratchBytes
    PmTensorInt8Fault = 2 : ProcedureReturn 0
  EndIf
  q = PmI8Base()
  s = q + PmI8Align(*g\M * *g\K * es)
  inv = s + PmI8Align(*g\M * 4)
  tile = inv + PmI8Align(*g\M * 4)
  r = 0
  While r < *g\M
    If PmI8QuantRow(*g\A + r * *g\K * 4, *g\K, 4, qmax, q + r * *g\K * es, s + r * 4, inv + r * 4) = 0
      PmTensorInt8Fault = 1 : ProcedureReturn 0
    EndIf
    r = r + 1
  Wend
  col0 = 0
  CompilerIf #PMO_INT8_BACKEND = 1
  col0 = PmI8MatMulNeon(*g, q, s, tile)
  CompilerEndIf
  r = 0
  While r < *g\M
    c = col0
    While c < *g\N
      f1 = PmI8RowF(0.0, q + r * *g\K * es, es, *g\B + c, *g\N, *g\K, *g\Wide, PmI8GetF(s + r * 4))
      f2 = 0.0
      If *g\Wide <> 0
        f2 = PmI8RowF(0.0, q + r * *g\K * es, es, *g\B + *g\Elements + c, *g\N, *g\K, 1, PmI8GetF(s + r * 4))
      EndIf
      v = PmI8Finish(f1, f2, *g\Wide, PmI8GetF(*g\Scales + c * 4))
      PmI8PutF(*g\Dst + (r * *g\N + c) * 4, v)
      c = c + 1
    Wend
    r = r + 1
  Wend
  ProcedureReturn 1
EndProcedure

; The fixed-shape entry: narrow weights.
Procedure PmTensorMatMul2Int8(*a.i, *b.i, *dst.i, m.i, k.i, n.i, *weightScales.i)
  Protected mm.PmI8MatMulArgs
  mm\A = *a : mm\B = *b : mm\Dst = *dst : mm\M = m : mm\K = k : mm\N = n
  mm\Scales = *weightScales : mm\Wide = 0 : mm\Elements = k * n
  If PmI8MatMul(@mm) = 0 And PmTensorInt8Fault = 0 : PmTensorInt8Fault = 2 : EndIf
EndProcedure
CompilerEndIf

CompilerIf #PMO_USE_INT8 = 1
Structure PmTensorGemmArgs
  A.i
  B.i
  C.i
  Dst.i
  M.i
  K.i
  N.i
  TransA.i
  TransB.i
  Alpha.f
  Beta.f
  CCount.i
  WeightScales.i
  Wide.i
EndStructure
CompilerElse
Structure PmTensorGemmArgs
  A.i
  B.i
  C.i
  Dst.i
  M.i
  K.i
  N.i
  TransA.i
  TransB.i
  Alpha.f
  Beta.f
  CCount.i
  WeightScales.i
EndStructure
CompilerEndIf

CompilerIf #PMO_USE_INT8 = 1
; y = alpha * (F1 or F1 + F2 / 254) * wScale + beta * C, one rounding per step.
Procedure PmI8GemmStore(*g.PmTensorGemmArgs, row.i, col.i, f1.f, f2.f)
  Protected v.f
  Protected t.f
  Protected ic.i
  v = f1
  If *g\Wide <> 0
    t = f2 / 254.0
    v = v + t
  EndIf
  v = v * PmI8GetF(*g\WeightScales + col * 4)
  v = v * *g\Alpha
  If *g\C <> 0 And *g\CCount > 0
    ic = row * *g\N + col
    If *g\CCount = 1
      ic = 0
    ElseIf *g\CCount = *g\N
      ic = col
    EndIf
    t = PmI8GetF(*g\C + ic * 4)
    t = *g\Beta * t
    v = v + t
  EndIf
  PmI8PutF(*g\Dst + (row * *g\N + col) * 4, v)
EndProcedure

; ONNX Gemm with an INT8 B: one scale per row of A' (per token).
Procedure.i PmI8Gemm(*g.PmTensorGemmArgs)
  Protected es.i
  Protected qmax.i
  Protected need.i
  Protected q.i
  Protected s.i
  Protected inv.i
  Protected tile.i
  Protected r.i
  Protected c.i
  Protected i.i
  Protected col0.i
  Protected elements.i
  Protected src.i
  Protected stride.i
  Protected rows.i
  Protected r0.i
  Protected f1.f
  Protected f2.f
  If *g\M <= 0 Or *g\N <= 0 : ProcedureReturn 1 : EndIf
  es = 1 + *g\Wide
  qmax = 127 : If *g\Wide <> 0 : qmax = 32767 : EndIf
  need = PmI8ScratchBytes(*g\M * *g\K, *g\M, *g\Wide)
  If PmTensorInt8Scratch = 0 Or need > PmTensorInt8ScratchBytes
    PmTensorInt8Fault = 2 : ProcedureReturn 0
  EndIf
  q = PmI8Base()
  s = q + PmI8Align(*g\M * *g\K * es)
  inv = s + PmI8Align(*g\M * 4)
  tile = inv + PmI8Align(*g\M * 4)
  elements = *g\K * *g\N
  r = 0
  While r < *g\M
    src = *g\A + r * *g\K * 4 : stride = 4
    If *g\TransA <> 0 : src = *g\A + r * 4 : stride = *g\M * 4 : EndIf
    If PmI8QuantRow(src, *g\K, stride, qmax, q + r * *g\K * es, s + r * 4, inv + r * 4) = 0
      PmTensorInt8Fault = 1 : ProcedureReturn 0
    EndIf
    r = r + 1
  Wend
  col0 = 0
  If *g\TransB <> 0
    ; Weight rows are contiguous: four columns at a time.
    col0 = *g\N & -4
    r = 0
    While r < *g\M
      c = 0
      While c < col0
        PmI8Block4(q + r * *g\K * es, *g\B + c * *g\K, *g\K, elements, *g\K, *g\Wide, s + r * 4, tile, tile + 16)
        i = 0
        While i < 4
          PmI8GemmStore(*g, r, c + i, PmI8GetF(tile + i * 4), PmI8GetF(tile + 16 + i * 4))
          i = i + 1
        Wend
        c = c + 4
      Wend
      r = r + 1
    Wend
  Else
    CompilerIf #PMO_INT8_BACKEND = 1
    col0 = *g\N & -16
    r0 = 0
    While r0 < *g\M And col0 > 0
      rows = PmI8RowBlock(q, s, *g\M, *g\K, es, r0, tile)
      c = 0
      While c < col0
        PmI8ColumnTileNeon(*g\B, elements, *g\N, c, *g\K, *g\Wide, tile)
        r = 0
        While r < rows
          i = 0
          While i < 16
            PmI8GemmStore(*g, r0 + r, c + i, PmI8GetF(tile + (r * 16 + i) * 4), PmI8GetF(tile + 256 + (r * 16 + i) * 4))
            i = i + 1
          Wend
          r = r + 1
        Wend
        c = c + 16
      Wend
      r0 = r0 + 4
    Wend
    CompilerEndIf
  EndIf
  r = 0
  While r < *g\M
    c = col0
    While c < *g\N
      If *g\TransB <> 0
        f1 = PmI8RowF(0.0, q + r * *g\K * es, es, *g\B + c * *g\K, 1, *g\K, *g\Wide, PmI8GetF(s + r * 4))
        f2 = 0.0
        If *g\Wide <> 0
          f2 = PmI8RowF(0.0, q + r * *g\K * es, es, *g\B + elements + c * *g\K, 1, *g\K, 1, PmI8GetF(s + r * 4))
        EndIf
      Else
        f1 = PmI8RowF(0.0, q + r * *g\K * es, es, *g\B + c, *g\N, *g\K, *g\Wide, PmI8GetF(s + r * 4))
        f2 = 0.0
        If *g\Wide <> 0
          f2 = PmI8RowF(0.0, q + r * *g\K * es, es, *g\B + elements + c, *g\N, *g\K, 1, PmI8GetF(s + r * 4))
        EndIf
      EndIf
      PmI8GemmStore(*g, r, c, f1, f2)
      c = c + 1
    Wend
    r = r + 1
  Wend
  ProcedureReturn 1
EndProcedure
CompilerEndIf

; ONNX Gemm: Y = alpha * A' * B' + beta * C. C may be absent (0), a
; scalar (cCount=1), one value per column (cCount=n), or a full MxN matrix.
; One argument block is used because the A64 calling convention implemented
; by Forge currently has eight register arguments and no stack arguments.
Procedure PmTensorGemm(*g.PmTensorGemmArgs)
  Protected dot.PmTensorInt8DotArgs
  Protected row.i
  Protected col.i
  Protected inner.i
  Protected ia.i
  Protected ib.i
  Protected ic.i
  Protected accumulator.i
  Protected aScale.f
  Protected converted.f
  Protected sum.f
  CompilerIf #PMO_USE_INT8 = 1
  If *g\WeightScales <> 0
    If PmI8Gemm(*g) = 0 And PmTensorInt8Fault = 0 : PmTensorInt8Fault = 2 : EndIf
    ProcedureReturn
  EndIf
  CompilerEndIf
  row = 0
  While row < *g\M
    col = 0
    While col < *g\N
      sum = 0.0 : accumulator = 0
      inner = 0
      While inner < *g\K
        If *g\TransA = 0 : ia = row * *g\K + inner : Else : ia = inner * *g\M + row : EndIf
        If *g\TransB = 0 : ib = inner * *g\N + col : Else : ib = col * *g\K + inner : EndIf
          sum = sum + PmTensorGet(*g\A, ia) * PmTensorGet(*g\B, ib)
        inner = inner + 1
      Wend
      sum = sum * *g\Alpha
      If *g\C <> 0 And *g\CCount > 0
        If *g\CCount = 1
          ic = 0
        ElseIf *g\CCount = *g\N
          ic = col
        Else
          ic = row * *g\N + col
        EndIf
        sum = sum + *g\Beta * PmTensorGet(*g\C, ic)
      EndIf
      PmTensorPut(*g\Dst, row * *g\N + col, sum)
      col = col + 1
    Wend
    row = row + 1
  Wend
EndProcedure

; Softmax over the final dimension. outer is the product of every earlier
; dimension and width is the final dimension.
Procedure PmTensorSoftmaxLast(*src.i, *dst.i, outer.i, width.i)
  Protected o.i
  Protected j.i
  Protected base.i
  Protected v.f
  Protected mx.f
  Protected sum.f
  o = 0
  While o < outer
    base = o * width
    mx = PmTensorGet(*src, base)
    j = 1
    While j < width
      v = PmTensorGet(*src, base + j)
      If v > mx : mx = v : EndIf
      j = j + 1
    Wend
    sum = 0.0
    j = 0
    While j < width
      v = Exp(PmTensorGet(*src, base + j) - mx)
      PmTensorPut(*dst, base + j, v)
      sum = sum + v
      j = j + 1
    Wend
    j = 0
    While j < width
      PmTensorPut(*dst, base + j, PmTensorGet(*dst, base + j) / sum)
      j = j + 1
    Wend
    o = o + 1
  Wend
EndProcedure

Procedure PmTensorReduceMeanLast(*src.i, *dst.i, outer.i, width.i)
  Protected o.i
  Protected j.i
  Protected base.i
  Protected sum.f
  Protected divisor.f
  divisor = width
  o = 0
  While o < outer
    base = o * width
    sum = 0.0
    j = 0
    While j < width
      sum = sum + PmTensorGet(*src, base + j)
      j = j + 1
    Wend
    PmTensorPut(*dst, o, sum / divisor)
    o = o + 1
  Wend
EndProcedure

Procedure PmTensorReduceSumLast(*src.i, *dst.i, outer.i, width.i)
  Protected row.i
  Protected col.i
  Protected sum.f
  row = 0
  While row < outer
    sum = 0.0
    col = 0
    While col < width
      sum = sum + PmTensorGet(*src, row * width + col)
      col = col + 1
    Wend
    PmTensorPut(*dst, row, sum)
    row = row + 1
  Wend
EndProcedure

; Prefix sum along one contiguous logical axis. Data before/after that axis
; is represented as outer and inner products, so this handles every rank.
Procedure PmTensorCumSumF32(*src.i, *dst.i, outer.i, width.i, inner.i, exclusive.i, reverse.i)
  Protected o.i
  Protected j.i
  Protected k.i
  Protected at.i
  Protected sum.f
  o = 0
  While o < outer
    k = 0
    While k < inner
      sum = 0.0
      j = 0
      While j < width
        If reverse <> 0 : at = width - 1 - j : Else : at = j : EndIf
        If exclusive <> 0
          PmTensorPut(*dst, (o * width + at) * inner + k, sum)
          sum = sum + PmTensorGet(*src, (o * width + at) * inner + k)
        Else
          sum = sum + PmTensorGet(*src, (o * width + at) * inner + k)
          PmTensorPut(*dst, (o * width + at) * inner + k, sum)
        EndIf
        j = j + 1
      Wend
      k = k + 1
    Wend
    o = o + 1
  Wend
EndProcedure

Procedure PmTensorCumSumI64(*src.i, *dst.i, outer.i, width.i, inner.i, exclusive.i, reverse.i)
  Protected o.i
  Protected j.i
  Protected k.i
  Protected at.i
  Protected sum.i
  o = 0
  While o < outer
    k = 0
    While k < inner
      sum = 0
      j = 0
      While j < width
        If reverse <> 0 : at = width - 1 - j : Else : at = j : EndIf
        If exclusive <> 0
          PmTensorPutI64(*dst, (o * width + at) * inner + k, sum)
          sum = sum + PmTensorGetI64(*src, (o * width + at) * inner + k)
        Else
          sum = sum + PmTensorGetI64(*src, (o * width + at) * inner + k)
          PmTensorPutI64(*dst, (o * width + at) * inner + k, sum)
        EndIf
        j = j + 1
      Wend
      k = k + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; LayerNormalization-17 (https://onnx.ai/onnx/operators/onnx__LayerNormalization.html)
; over outer blocks of width elements: the normalised axes [axis, rank - 1]
; flattened, so every axis is one width and one outer count. Scale and Bias
; each contain width elements; Bias may be 0. Mean and InvStdDev, when their
; addresses are not 0, receive one element per block: the mean and
; 1 / Sqr(variance + epsilon) that block was normalised with (stash_type 1).
Structure PmTensorLayerNormArgs
  Src.i
  Scale.i
  Bias.i
  Dst.i
  Mean.i
  InvStdDev.i
  Outer.i
  Width.i
  Epsilon.f
EndStructure

Procedure PmTensorLayerNorm(*g.PmTensorLayerNormArgs)
  Protected o.i
  Protected j.i
  Protected base.i
  Protected v.f
  Protected mean.f
  Protected variance.f
  Protected inv.f
  Protected divisor.f
  Protected *src.i
  Protected *scale.i
  Protected *bias.i
  Protected *dst.i
  Protected outer.i
  Protected width.i
  Protected epsilon.f
  *src = *g\Src
  *scale = *g\Scale
  *bias = *g\Bias
  *dst = *g\Dst
  outer = *g\Outer
  width = *g\Width
  epsilon = *g\Epsilon
  divisor = width
  o = 0
  While o < outer
    base = o * width
    mean = 0.0
    j = 0
    While j < width
      mean = mean + PmTensorGet(*src, base + j)
      j = j + 1
    Wend
    mean = mean / divisor
    variance = 0.0
    j = 0
    While j < width
      v = PmTensorGet(*src, base + j) - mean
      variance = variance + v * v
      j = j + 1
    Wend
    inv = 1.0 / PmTensorSqrtF(variance / divisor + epsilon)
    If *g\Mean <> 0 : PmTensorPut(*g\Mean, o, mean) : EndIf
    If *g\InvStdDev <> 0 : PmTensorPut(*g\InvStdDev, o, inv) : EndIf
    j = 0
    While j < width
      v = (PmTensorGet(*src, base + j) - mean) * inv
      v = v * PmTensorGet(*scale, j)
      If *bias <> 0 : v = v + PmTensorGet(*bias, j) : EndIf
      PmTensorPut(*dst, base + j, v)
      j = j + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; The same kernel without the Mean and InvStdDev outputs.
Procedure PmTensorLayerNormLast(*src.i, *scale.i, *bias.i, *dst.i, outer.i, width.i, epsilon.f)
  Protected g.PmTensorLayerNormArgs
  g\Src = *src
  g\Scale = *scale
  g\Bias = *bias
  g\Dst = *dst
  g\Mean = 0
  g\InvStdDev = 0
  g\Outer = outer
  g\Width = width
  g\Epsilon = epsilon
  PmTensorLayerNorm(@g)
EndProcedure

Structure PmTensorBatchNormArgs
  Src.i
  Scale.i
  Bias.i
  Mean.i
  Variance.i
  Dst.i
  N.i
  C.i
  Spatial.i
  RunningMean.i
  RunningVariance.i
  Epsilon.f
  Momentum.f
EndStructure

CompilerIf #PMO_USE_BATCHNORM = 1
Procedure PmTensorBatchNorm(*g.PmTensorBatchNormArgs)
  ; one binary32 operation per expression, the square root correctly rounded
  ; (C6c-1): the same bits on every target
  Protected bn.i
  Protected ch.i
  Protected s.i
  Protected idx.i
  Protected ps.i
  Protected pd.i
  Protected pe.i
  Protected mul.f
  Protected add.f
  Protected t.f
  Protected v.f
  bn = 0
  While bn < *g\N
    ch = 0
    While ch < *g\C
      t = PmTensorGet(*g\Variance, ch)
      t = t + *g\Epsilon
      t = PmTensorSqrtF(t)
      mul = PmTensorGet(*g\Scale, ch)
      mul = mul / t
      add = PmTensorGet(*g\Mean, ch)
      add = add * mul
      t = PmTensorGet(*g\Bias, ch)
      add = t - add
      idx = (bn * *g\C + ch) * *g\Spatial * 4
      ps = *g\Src + idx
      pd = *g\Dst + idx
      pe = ps + *g\Spatial * 4
      While ps < pe
        v = PmTensorGet(ps, 0) * mul
        PmTensorPut(pd, 0, v + add)
        ps = ps + 4
        pd = pd + 4
      Wend
      ch = ch + 1
    Wend
    bn = bn + 1
  Wend
EndProcedure

; BatchNormalization-15 with training_mode = 1
; (https://onnx.ai/onnx/operators/onnx__BatchNormalization.html): each channel
; is normalised with the batch's own statistics, current_mean and current_var
; (the population variance over every axis but the channel axis),
;   Y = (X - current_mean) / Sqrt(current_var + epsilon) * scale + B
; and, when their addresses are not 0,
;   running_mean = input_mean * momentum + current_mean * (1 - momentum)
;   running_var  = input_var * momentum + current_var * (1 - momentum).
; Mean and Variance hold input_mean and input_var.
Procedure PmTensorBatchNormTraining(*g.PmTensorBatchNormArgs)
  ; one binary32 operation per expression, the square root correctly rounded
  ; (C6c-1): the same bits on every target
  Protected bn.i
  Protected ch.i
  Protected s.i
  Protected idx.i
  Protected ps.i
  Protected pd.i
  Protected pe.i
  Protected mean.f
  Protected variance.f
  Protected v.f
  Protected mul.f
  Protected add.f
  Protected divisor.f
  Protected keep.f
  Protected t.f
  Protected u.f
  If *g\N * *g\Spatial <= 0
    ProcedureReturn
  EndIf
  divisor = *g\N * *g\Spatial
  keep = 1.0
  keep = keep - *g\Momentum
  ch = 0
  While ch < *g\C
    mean = 0.0
    bn = 0
    While bn < *g\N
      ps = *g\Src + (bn * *g\C + ch) * *g\Spatial * 4
      pe = ps + *g\Spatial * 4
      While ps < pe
        mean = mean + PmTensorGet(ps, 0)
        ps = ps + 4
      Wend
      bn = bn + 1
    Wend
    mean = mean / divisor
    variance = 0.0
    bn = 0
    While bn < *g\N
      ps = *g\Src + (bn * *g\C + ch) * *g\Spatial * 4
      pe = ps + *g\Spatial * 4
      While ps < pe
        v = PmTensorGet(ps, 0) - mean
        v = v * v
        variance = variance + v
        ps = ps + 4
      Wend
      bn = bn + 1
    Wend
    variance = variance / divisor
    t = variance + *g\Epsilon
    t = PmTensorSqrtF(t)
    mul = PmTensorGet(*g\Scale, ch)
    mul = mul / t
    add = PmTensorGet(*g\Bias, ch)
    If *g\RunningMean <> 0
      t = PmTensorGet(*g\Mean, ch)
      t = t * *g\Momentum
      u = mean * keep
      t = t + u
      PmTensorPut(*g\RunningMean, ch, t)
    EndIf
    If *g\RunningVariance <> 0
      t = PmTensorGet(*g\Variance, ch)
      t = t * *g\Momentum
      u = variance * keep
      t = t + u
      PmTensorPut(*g\RunningVariance, ch, t)
    EndIf
    bn = 0
    While bn < *g\N
      idx = (bn * *g\C + ch) * *g\Spatial * 4
      ps = *g\Src + idx
      pd = *g\Dst + idx
      pe = ps + *g\Spatial * 4
      While ps < pe
        v = PmTensorGet(ps, 0) - mean
        v = v * mul
        PmTensorPut(pd, 0, v + add)
        ps = ps + 4
        pd = pd + 4
      Wend
      bn = bn + 1
    Wend
    ch = ch + 1
  Wend
EndProcedure
CompilerEndIf

; ONNX STFT for a real-valued [batch,signal] input. Output is contiguous
; [batch,frames,bins,2] with real then imaginary components.
Structure PmTensorStftArgs
  Signal.i
  Window.i
  Dst.i
  Scratch.i
  Batches.i
  SignalLength.i
  FrameStep.i
  FrameLength.i
  Frames.i
  Bins.i
  ScratchComplex.i
EndStructure

CompilerIf #PMO_USE_STFT = 1
Procedure.i PmTensorStftBitReverse(Value.i, Bits.i)
  Protected Result.i=0
  Protected Bit.i=0
  While Bit < Bits
    Result = (Result << 1) | (Value & 1)
    Value = Value >> 1
    Bit = Bit + 1
  Wend
  ProcedureReturn Result
EndProcedure

; This is the same bit-reversed radix-2 butterfly order used by the ONNX
; Runtime CPU DFT.  Inverse calls deliberately reuse the forward roots and
; the Bluestein caller reverses nonzero bins when it extracts the result.
Procedure PmTensorStftFft(*srcR.i, *srcI.i, *dstR.i, *dstI.i, *rootsR.i, *rootsI.i, count.i, inverse.i)
  Protected bits.i=0
  Protected stageBits.i=0
  Protected span.i
  Protected midpoint.i
  Protected i.i
  Protected k.i
  Protected j.i
  Protected firstIndex.i
  Protected secondIndex.i
  Protected evenIndex.i
  Protected oddIndex.i
  Protected reversed.i
  Protected evenR.f
  Protected evenI.f
  Protected oddR.f
  Protected oddI.f
  Protected rootR.f
  Protected rootI.f
  Protected firstR.f
  Protected firstI.f
  Protected secondR.f
  Protected secondI.f
  Protected scale.f
  i = count
  While i > 1 : bits = bits + 1 : i = i >> 1 : Wend
  i = 0
  While i < count
    reversed = PmTensorStftBitReverse(i, bits)
    PmTensorPut(*dstR, i, PmTensorGet(*srcR, reversed))
    PmTensorPut(*dstI, i, PmTensorGet(*srcI, reversed))
    i = i + 1
  Wend
  span = 2
  While span <= count
    midpoint = span >> 1
    stageBits = stageBits + 1
    k = 0
    While k < midpoint
      firstIndex = PmTensorStftBitReverse(k, stageBits)
      secondIndex = PmTensorStftBitReverse(midpoint + k, stageBits)
      j = 0
      While j < count
        evenIndex = k + j
        oddIndex = evenIndex + midpoint
        evenR = PmTensorGet(*dstR, evenIndex)
        evenI = PmTensorGet(*dstI, evenIndex)
        oddR = PmTensorGet(*dstR, oddIndex)
        oddI = PmTensorGet(*dstI, oddIndex)
        rootR = PmTensorGet(*rootsR, firstIndex)
        rootI = PmTensorGet(*rootsI, firstIndex)
        firstR = evenR + (rootR * oddR - rootI * oddI)
        firstI = evenI + (rootR * oddI + rootI * oddR)
        rootR = PmTensorGet(*rootsR, secondIndex)
        rootI = PmTensorGet(*rootsI, secondIndex)
        secondR = evenR + (rootR * oddR - rootI * oddI)
        secondI = evenI + (rootR * oddI + rootI * oddR)
        PmTensorPut(*dstR, evenIndex, firstR)
        PmTensorPut(*dstI, evenIndex, firstI)
        PmTensorPut(*dstR, oddIndex, secondR)
        PmTensorPut(*dstI, oddIndex, secondI)
        j = j + span
      Wend
      k = k + 1
    Wend
    span = span << 1
  Wend
  If inverse
    scale = count
    i = 0
    While i < count
      PmTensorPut(*dstR, i, PmTensorGet(*dstR, i) / scale)
      PmTensorPut(*dstI, i, PmTensorGet(*dstI, i) / scale)
      i = i + 1
    Wend
  EndIf
EndProcedure

Procedure.i PmTensorStft(*g.PmTensorStftArgs)
  Protected bn.i
  Protected frame.i
  Protected bin.i
  Protected sample.i
  Protected signalIndex.i
  Protected outputIndex.i
  Protected complexCount.i
  Protected bits.i=0
  Protected reversed.i
  Protected mirror.i
  Protected *work1R.i
  Protected *work1I.i
  Protected *work2R.i
  Protected *work2I.i
  Protected *bR.i
  Protected *bI.i
  Protected *chirpR.i
  Protected *chirpI.i
  Protected *rootsR.i
  Protected *rootsI.i
  Protected value.f
  Protected sourceR.f
  Protected sourceI.f
  Protected weightR.f
  Protected weightI.f
  Protected resultR.f
  Protected resultI.f
  Protected pi.f
  Protected tau.f
  Protected angular.f
  Protected exponent.f
  Protected angle.f
  Protected complexFloat.f
  Protected sampleFloat.f
  Protected frameLengthFloat.f
  If *g = 0 Or *g\Signal = 0 Or *g\Dst = 0 Or *g\Scratch = 0
    ProcedureReturn 0
  EndIf
  If *g\Batches <= 0 Or *g\SignalLength < *g\FrameLength Or *g\FrameStep <= 0
    ProcedureReturn 0
  EndIf
  If *g\FrameLength <= 0 Or *g\Frames <= 0 Or *g\Bins <> (*g\FrameLength >> 1) + 1
    ProcedureReturn 0
  EndIf
  If *g\Frames > ((*g\SignalLength - *g\FrameLength) / *g\FrameStep) + 1
    ProcedureReturn 0
  EndIf
  complexCount = 1
  While complexCount < *g\FrameLength * 2 - 1 : complexCount = complexCount << 1 : Wend
  If complexCount > *g\ScratchComplex : ProcedureReturn 0 : EndIf
  *work1R = *g\Scratch
  *work1I = *work1R + complexCount * 4
  *work2R = *work1I + complexCount * 4
  *work2I = *work2R + complexCount * 4
  *bR = *work2I + complexCount * 4
  *bI = *bR + complexCount * 4
  *chirpR = *bI + complexCount * 4
  *chirpI = *chirpR + complexCount * 4
  *rootsR = *chirpI + complexCount * 4
  *rootsI = *rootsR + complexCount * 4

  pi = 3.141592653589793
  tau = 6.283185307179586
  complexFloat = complexCount
  frameLengthFloat = *g\FrameLength
  angular = (tau * -1.0) / complexFloat
  sample = complexCount
  While sample > 1 : bits = bits + 1 : sample = sample >> 1 : Wend
  sample = 0
  While sample < complexCount
    reversed = PmTensorStftBitReverse(sample, bits)
    sampleFloat = sample
    angle = sampleFloat * angular
    PmTensorPut(*rootsR, reversed, Cos(angle))
    PmTensorPut(*rootsI, reversed, Sin(angle))
    sample = sample + 1
  Wend

  PmTensorZero(*work1R, complexCount)
  PmTensorZero(*work1I, complexCount)
  PmTensorZero(*chirpR, complexCount)
  PmTensorZero(*chirpI, complexCount)
  sample = 0
  While sample < *g\FrameLength
    exponent = pi * -1.0
    sampleFloat = sample
    exponent = exponent * sampleFloat
    exponent = exponent * sampleFloat
    exponent = exponent / frameLengthFloat
    weightR = Cos(exponent)
    weightI = Sin(exponent)
    PmTensorPut(*chirpR, sample, weightR)
    PmTensorPut(*chirpI, sample, weightI)
    PmTensorPut(*work1R, sample, weightR)
    PmTensorPut(*work1I, sample, weightI * -1.0)
    sample = sample + 1
  Wend
  sample = complexCount - *g\FrameLength + 1
  While sample < complexCount
    mirror = complexCount - sample
    PmTensorPut(*work1R, sample, PmTensorGet(*work1R, mirror))
    PmTensorPut(*work1I, sample, PmTensorGet(*work1I, mirror))
    sample = sample + 1
  Wend
  PmTensorStftFft(*work1R, *work1I, *bR, *bI, *rootsR, *rootsI, complexCount, 0)

  bn = 0
  While bn < *g\Batches
    frame = 0
    While frame < *g\Frames
      PmTensorZero(*work1R, complexCount)
      PmTensorZero(*work1I, complexCount)
      sample = 0
      While sample < *g\FrameLength
        signalIndex = bn * *g\SignalLength + frame * *g\FrameStep + sample
        value = PmTensorGet(*g\Signal, signalIndex)
        If *g\Window <> 0 : value = value * PmTensorGet(*g\Window, sample) : EndIf
        weightR = PmTensorGet(*chirpR, sample)
        weightI = PmTensorGet(*chirpI, sample)
        PmTensorPut(*work1R, sample, value * weightR)
        PmTensorPut(*work1I, sample, value * weightI)
        sample = sample + 1
      Wend
      PmTensorStftFft(*work1R, *work1I, *work2R, *work2I, *rootsR, *rootsI, complexCount, 0)
      sample = 0
      While sample < complexCount
        sourceR = PmTensorGet(*work2R, sample)
        sourceI = PmTensorGet(*work2I, sample)
        weightR = PmTensorGet(*bR, sample)
        weightI = PmTensorGet(*bI, sample)
        resultR = sourceR * weightR - sourceI * weightI
        resultI = sourceR * weightI + sourceI * weightR
        PmTensorPut(*work2R, sample, resultR)
        PmTensorPut(*work2I, sample, resultI)
        sample = sample + 1
      Wend
      PmTensorStftFft(*work2R, *work2I, *work1R, *work1I, *rootsR, *rootsI, complexCount, 1)
      bin = 0
      While bin < *g\Bins
        mirror = bin
        If mirror > 0 : mirror = complexCount - mirror : EndIf
        sourceR = PmTensorGet(*work1R, mirror)
        sourceI = PmTensorGet(*work1I, mirror)
        weightR = PmTensorGet(*chirpR, bin)
        weightI = PmTensorGet(*chirpI, bin)
        resultR = sourceR * weightR - sourceI * weightI
        resultI = sourceR * weightI + sourceI * weightR
        outputIndex = ((bn * *g\Frames + frame) * *g\Bins + bin) * 2
        PmTensorPut(*g\Dst, outputIndex, resultR)
        PmTensorPut(*g\Dst, outputIndex + 1, resultI)
        bin = bin + 1
      Wend
      frame = frame + 1
    Wend
    bn = bn + 1
  Wend
  ProcedureReturn 1
EndProcedure
CompilerEndIf

; Resize the final axis of a contiguous FLOAT tensor. mode 0 is nearest/floor,
; mode 1 is linear. coordinateMode 0 is asymmetric, 1 is half_pixel.
CompilerIf #PMO_USE_RESIZE = 1
Procedure PmTensorResize1D(*src.i, *dst.i, outer.i, inWidth.i, outWidth.i, mode.i, coordinateMode.i, scale.f)
  Protected row.i
  Protected ox.i
  Protected ix0.i
  Protected ix1.i
  Protected source.f
  Protected base.i
  Protected low.f
  Protected high.f
  Protected fraction.f
  Protected whole.f
  row = 0
  While row < outer
    base = row * inWidth
    ox = 0
    While ox < outWidth
      If coordinateMode = 1
        source = ox
        source = (source + 0.5) / scale - 0.5
      Else
        source = ox
        source = source / scale
      EndIf
      ix0 = Int(source)
      whole = ix0
      If source < 0.0 And whole <> source : ix0 = ix0 - 1 : EndIf
      If mode = 0
        If ix0 < 0 : ix0 = 0 : EndIf
        If ix0 >= inWidth : ix0 = inWidth - 1 : EndIf
        PmTensorPut(*dst, row * outWidth + ox, PmTensorGet(*src, base + ix0))
      Else
        ix1 = ix0 + 1
        whole = ix0
        fraction = source - whole
        If ix0 < 0 : ix0 = 0 : EndIf
        If ix1 < 0 : ix1 = 0 : EndIf
        If ix0 >= inWidth : ix0 = inWidth - 1 : EndIf
        If ix1 >= inWidth : ix1 = inWidth - 1 : EndIf
        low = PmTensorGet(*src, base + ix0)
        high = PmTensorGet(*src, base + ix1)
        PmTensorPut(*dst, row * outWidth + ox, low + (high - low) * fraction)
      EndIf
      ox = ox + 1
    Wend
    row = row + 1
  Wend
EndProcedure
CompilerEndIf

; ONNX 1-D transposed convolution. W is [inChannels,
; outChannels/group, kernel]. The output is initialized with bias before the
; input contributions are scattered into it.
Structure PmTensorConvTranspose1DArgs
  Src.i
  Weight.i
  Bias.i
  Dst.i
  Batches.i
  InChannels.i
  InWidth.i
  OutChannels.i
  OutWidth.i
  Kernel.i
  PadLeft.i
  Stride.i
  Dilation.i
  Groups.i
EndStructure

CompilerIf #PMO_USE_CONVTRANSPOSE = 1
Procedure PmTensorConvTranspose1D(*g.PmTensorConvTranspose1DArgs)
  Protected bn.i
  Protected ic.i
  Protected ix.i
  Protected ocg.i
  Protected oc.i
  Protected ox.i
  Protected kx.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected dstIndex.i
  Protected value.f
  inPerGroup = *g\InChannels / *g\Groups
  outPerGroup = *g\OutChannels / *g\Groups
  bn = 0
  While bn < *g\Batches
    oc = 0
    While oc < *g\OutChannels
      ox = 0
      While ox < *g\OutWidth
        value = 0.0
        If *g\Bias <> 0 : value = PmTensorGet(*g\Bias, oc) : EndIf
        PmTensorPut(*g\Dst, (bn * *g\OutChannels + oc) * *g\OutWidth + ox, value)
        ox = ox + 1
      Wend
      oc = oc + 1
    Wend
    ic = 0
    While ic < *g\InChannels
      group = ic / inPerGroup
      ix = 0
      While ix < *g\InWidth
        srcIndex = (bn * *g\InChannels + ic) * *g\InWidth + ix
        value = PmTensorGet(*g\Src, srcIndex)
        ocg = 0
        While ocg < outPerGroup
          oc = group * outPerGroup + ocg
          kx = 0
          While kx < *g\Kernel
            ox = ix * *g\Stride - *g\PadLeft + kx * *g\Dilation
            If ox >= 0 And ox < *g\OutWidth
              weightIndex = (ic * outPerGroup + ocg) * *g\Kernel + kx
              dstIndex = (bn * *g\OutChannels + oc) * *g\OutWidth + ox
              PmTensorPut(*g\Dst, dstIndex, PmTensorGet(*g\Dst, dstIndex) + value * PmTensorGet(*g\Weight, weightIndex))
            EndIf
            kx = kx + 1
          Wend
          ocg = ocg + 1
        Wend
        ix = ix + 1
      Wend
      ic = ic + 1
    Wend
    bn = bn + 1
  Wend
EndProcedure
CompilerEndIf

; NCW 1-D convolution. W is [outChannels, inChannels/group, kernel].
CompilerIf #PMO_USE_INT8 = 1
Structure PmTensorConv1DArgs
  Src.i
  Weight.i
  Bias.i
  Dst.i
  Batches.i
  InChannels.i
  InWidth.i
  OutChannels.i
  OutWidth.i
  Kernel.i
  PadLeft.i
  Stride.i
  Dilation.i
  Groups.i
  WeightScales.i
  Wide.i
  QuantBatch.i
EndStructure
CompilerElse
Structure PmTensorConv1DArgs
  Src.i
  Weight.i
  Bias.i
  Dst.i
  Batches.i
  InChannels.i
  InWidth.i
  OutChannels.i
  OutWidth.i
  Kernel.i
  PadLeft.i
  Stride.i
  Dilation.i
  Groups.i
  WeightScales.i
EndStructure
CompilerEndIf

CompilerIf #PMO_USE_CONV = 1
CompilerIf #PMO_USE_INT8 = 1
; ---- INT8 Conv1D --------------------------------------------------------------
; The input of one batch is quantized once into a PADDED, PHASE-SPLIT layout.
; Padded position x' (input position x at x' = PadLeft + x; every other
; position is 0 with scale 0) lives in phase r = x' % Stride at index
; t = x' / Stride; channel c's row is Stride phases of `qps` positions each.
; Output p's tap j reads padded position p*Stride + j*Dilation, which is phase
; (j*Dilation) % Stride, index p + (j*Dilation) / Stride: sixteen neighbouring
; outputs read sixteen neighbouring values, whatever the stride, and no read
; needs a bounds test (a padded tap adds float(0) * 0 = +0, which leaves F as
; it was). With Stride 1 there is one phase and this is the padded row.
Procedure.i PmI8ConvPhase(*g.PmTensorConv1DArgs)
  Protected owt.i
  Protected qp.i
  Protected a.i
  Protected b.i
  owt = (*g\OutWidth + 15) & -16
  qp = *g\PadLeft + *g\InWidth
  a = (qp + *g\Stride - 1) / *g\Stride
  b = owt + ((*g\Kernel - 1) * *g\Dilation) / *g\Stride + 1
  If b > a : a = b : EndIf
  ProcedureReturn (a + 15) & -16
EndProcedure

; Positions in one channel's row (every phase).
Procedure.i PmI8ConvRow(*g.PmTensorConv1DArgs)
  ProcedureReturn PmI8ConvPhase(*g) * *g\Stride
EndProcedure

Procedure.i PmI8ConvScratchBytes(*g.PmTensorConv1DArgs)
  Protected qp.i
  qp = PmI8ConvRow(*g)
  ProcedureReturn PmI8ScratchBytes(*g\InChannels * qp, qp, *g\Wide)
EndProcedure

; Tile area `part` (0..3) of a Conv1D's working memory.
Procedure.i PmI8ConvTile(*g.PmTensorConv1DArgs, part.i)
  Protected qp.i
  qp = PmI8ConvRow(*g)
  ProcedureReturn PmI8Base() + PmI8Align(*g\InChannels * qp * (1 + *g\Wide)) + PmI8Align(qp * 4) * 2 + part * #PMI8_TILE_STRIDE
EndProcedure

; Quantize batch bn: one scale per input position over every channel.
; Returns 0 on a fault.
Procedure.i PmI8ConvQuantize(*g.PmTensorConv1DArgs, bn.i)
  Protected qp.i
  Protected qps.i
  Protected st.i
  Protected es.i
  Protected qmax.i
  Protected q.i
  Protected s.i
  Protected inv.i
  Protected src.i
  Protected c.i
  Protected x.i
  Protected at.i
  Protected row.i
  Protected bits.i
  Protected v.i
  Protected r.f
  Protected xv.f
  CompilerIf #PMO_INT8_BACKEND = 1
  Protected ca.PmI8ColumnArgs
  CompilerEndIf
  qps = PmI8ConvPhase(*g)
  st = *g\Stride
  qp = qps * st
  es = 1 + *g\Wide
  qmax = 127 : If *g\Wide <> 0 : qmax = 32767 : EndIf
  If PmTensorInt8Scratch = 0 Or PmI8ConvScratchBytes(*g) > PmTensorInt8ScratchBytes
    PmTensorInt8Fault = 2 : ProcedureReturn 0
  EndIf
  q = PmI8Base()
  s = q + PmI8Align(*g\InChannels * qp * es)
  inv = s + PmI8Align(qp * 4)
  src = *g\Src + bn * *g\InChannels * *g\InWidth * 4
  x = 0
  While x < qp
    PokeL(s + x * 4, 0) : PokeL(inv + x * 4, 0)
    x = x + 1
  Wend
  If st = 1
    ; One phase: the scales and each channel's row are contiguous.
    CompilerIf #PMO_INT8_BACKEND = 1
    ca\Src = src : ca\Rows = *g\InChannels : ca\RowBytes = *g\InWidth * 4
    ca\Cols = *g\InWidth : ca\Out = s + *g\PadLeft * 4
    PmI8ColMaxNeon(@ca)
    CompilerElse
    x = 0
    While x < *g\InWidth
      PokeL(s + (*g\PadLeft + x) * 4, PmI8MaxBits(src + x * 4, *g\InChannels, *g\InWidth * 4))
      x = x + 1
    Wend
    CompilerEndIf
    x = 0
    While x < *g\InWidth
      bits = PeekL(s + (*g\PadLeft + x) * 4)
      If PmI8RowScale(bits, qmax, s + (*g\PadLeft + x) * 4, inv + (*g\PadLeft + x) * 4) = 0
        PmTensorInt8Fault = 1 : ProcedureReturn 0
      EndIf
      x = x + 1
    Wend
    c = 0
    While c < *g\InChannels
      row = q + c * qp * es
      x = 0
      While x < *g\PadLeft * es
        PokeA(row + x, 0) : x = x + 1
      Wend
      x = (*g\PadLeft + *g\InWidth) * es
      While x < qp * es
        PokeA(row + x, 0) : x = x + 1
      Wend
      PmI8QuantLanes(src + c * *g\InWidth * 4, inv + *g\PadLeft * 4, *g\InWidth, qmax, row + *g\PadLeft * es)
      c = c + 1
    Wend
    ProcedureReturn 1
  EndIf
  ; Several phases: every value goes to its phase's position.
  x = 0
  While x < *g\InWidth
    at = ((*g\PadLeft + x) % st) * qps + (*g\PadLeft + x) / st
    If PmI8RowScale(PmI8MaxBits(src + x * 4, *g\InChannels, *g\InWidth * 4), qmax, s + at * 4, inv + at * 4) = 0
      PmTensorInt8Fault = 1 : ProcedureReturn 0
    EndIf
    x = x + 1
  Wend
  c = 0
  While c < *g\InChannels
    row = q + c * qp * es
    x = 0
    While x < qp * es
      PokeL(row + x, 0) : x = x + 4
    Wend
    x = 0
    While x < *g\InWidth
      at = ((*g\PadLeft + x) % st) * qps + (*g\PadLeft + x) / st
      xv = PmI8GetF(src + (c * *g\InWidth + x) * 4)
      r = PmI8GetF(inv + at * 4)
      xv = xv * r
      v = PmI8RoundEven(xv)
      If v > qmax : v = qmax : EndIf
      If v < 0 - qmax : v = 0 - qmax : EndIf
      If es = 1
        PokeA(row + at, v & 255)
      Else
        PokeW(row + at * 2, v)
      EndIf
      x = x + 1
    Wend
    c = c + 1
  Wend
  ProcedureReturn 1
EndProcedure

CompilerIf #PMO_INT8_BACKEND = 1
; Output channels [ocFirst, ocLast) of batch bn: four channels by sixteen
; positions per tile, any stride (the phase layout makes every tap's sixteen
; values neighbours); the last tile of a row is computed whole and stored as
; far as the row goes.
Procedure PmI8Conv1DNeonRange(*g.PmTensorConv1DArgs, bn.i, ocFirst.i, ocLast.i, tile.i)
  Protected ta.PmI8TileArgs
  Protected ea.PmI8EpiArgs
  Protected qp.i
  Protected es.i
  Protected cg.i
  Protected og.i
  Protected q.i
  Protected s.i
  Protected elements.i
  Protected oc.i
  Protected grp.i
  Protected rows.i
  Protected i.i
  Protected r.i
  Protected p0.i
  Protected p.i
  Protected j.i
  Protected c0.i
  Protected cnt.i
  Protected valid.i
  Protected qrow.i
  Protected w0.i
  Protected w1.i
  Protected w2.i
  Protected w3.i
  Protected wlast.i
  Protected qps.i
  Protected ph.i
  qps = PmI8ConvPhase(*g)
  qp = qps * *g\Stride
  es = 1 + *g\Wide
  cg = *g\InChannels / *g\Groups
  og = *g\OutChannels / *g\Groups
  q = PmI8Base()
  s = q + PmI8Align(*g\InChannels * qp * es)
  elements = *g\OutChannels * cg * *g\Kernel
  ta\LStep = qp * es : ta\PStep = *g\Kernel : ta\RowScale = 0 : ta\Kind = *g\Wide
  oc = ocFirst
  While oc < ocLast
    grp = oc / og
    rows = ocLast - oc
    If rows > 4 : rows = 4 : EndIf
    If rows > (grp + 1) * og - oc : rows = (grp + 1) * og - oc : EndIf
    wlast = *g\Weight + (oc + rows - 1) * cg * *g\Kernel
    w0 = *g\Weight + oc * cg * *g\Kernel
    w1 = wlast : If rows > 1 : w1 = w0 + cg * *g\Kernel : EndIf
    w2 = wlast : If rows > 2 : w2 = w1 + cg * *g\Kernel : EndIf
    w3 = wlast : If rows > 3 : w3 = w2 + cg * *g\Kernel : EndIf
    qrow = q + grp * cg * qp * es
    p0 = 0
    While p0 < *g\OutWidth
      p = 0
      While p <= *g\Wide
        ta\F = tile + p * 256 : ta\Zero = 1
        j = 0
        While j < *g\Kernel
          c0 = 0
          While c0 < cg
            cnt = cg - c0
            If *g\Wide <> 0 And cnt > 512 : cnt = 512 : EndIf
            ph = ((j * *g\Dilation) % *g\Stride) * qps + p0 + (j * *g\Dilation) / *g\Stride
            ta\L = qrow + (c0 * qp + ph) * es
            ta\P0 = w0 + p * elements + c0 * *g\Kernel + j
            ta\P1 = w1 + p * elements + c0 * *g\Kernel + j
            ta\P2 = w2 + p * elements + c0 * *g\Kernel + j
            ta\P3 = w3 + p * elements + c0 * *g\Kernel + j
            ta\Count = cnt : ta\S = s + ph * 4
            PmI8TileNeon(@ta)
            ta\Zero = 0
            c0 = c0 + cnt
          Wend
          j = j + 1
        Wend
        p = p + 1
      Wend
      ea\F1 = tile : ea\F2 = 0 : If *g\Wide <> 0 : ea\F2 = tile + 256 : EndIf
      ea\WS = *g\WeightScales + oc * 4
      ea\Bias = 0 : If *g\Bias <> 0 : ea\Bias = *g\Bias + oc * 4 : EndIf
      ea\Rows = rows : ea\LaneScale = 0
      valid = *g\OutWidth - p0
      If valid >= 16
        ea\Dst = *g\Dst + ((bn * *g\OutChannels + oc) * *g\OutWidth + p0) * 4
        ea\DStride = *g\OutWidth * 4
        PmI8EpiNeon(@ea)
      Else
        ea\Dst = tile + 512 : ea\DStride = 64
        PmI8EpiNeon(@ea)
        r = 0
        While r < rows
          i = 0
          While i < valid
            PokeL(*g\Dst + ((bn * *g\OutChannels + oc + r) * *g\OutWidth + p0 + i) * 4, PeekL(tile + 512 + (r * 16 + i) * 4))
            i = i + 1
          Wend
          r = r + 1
        Wend
      EndIf
      p0 = p0 + 16
    Wend
    oc = oc + rows
  Wend
EndProcedure
CompilerEndIf

; Output channels [ocFirst, ocLast) of batch bn, from the quantized batch.
Procedure PmI8Conv1DRange(*g.PmTensorConv1DArgs, bn.i, ocFirst.i, ocLast.i, tile.i)
  Protected qp.i
  Protected es.i
  Protected cg.i
  Protected og.i
  Protected q.i
  Protected s.i
  Protected elements.i
  Protected oc.i
  Protected ox.i
  Protected j.i
  Protected pos.i
  Protected wrow.i
  Protected qrow.i
  Protected f1.f
  Protected f2.f
  Protected sc.f
  Protected v.f
  Protected b.f
  Protected qps.i
  If ocFirst < 0 : ocFirst = 0 : EndIf
  If ocLast > *g\OutChannels : ocLast = *g\OutChannels : EndIf
  If ocFirst >= ocLast Or *g\OutWidth <= 0
    ProcedureReturn
  EndIf
  CompilerIf #PMO_INT8_BACKEND = 1
  PmI8Conv1DNeonRange(*g, bn, ocFirst, ocLast, tile)
  ProcedureReturn
  CompilerEndIf
  qps = PmI8ConvPhase(*g)
  qp = qps * *g\Stride
  es = 1 + *g\Wide
  cg = *g\InChannels / *g\Groups
  og = *g\OutChannels / *g\Groups
  q = PmI8Base()
  s = q + PmI8Align(*g\InChannels * qp * es)
  elements = *g\OutChannels * cg * *g\Kernel
  oc = ocFirst
  While oc < ocLast
    wrow = *g\Weight + oc * cg * *g\Kernel
    qrow = q + (oc / og) * cg * qp * es
    ox = 0
    While ox < *g\OutWidth
      f1 = 0.0 : f2 = 0.0
      j = 0
      While j < *g\Kernel
        pos = ((j * *g\Dilation) % *g\Stride) * qps + ox + (j * *g\Dilation) / *g\Stride
        sc = PmI8GetF(s + pos * 4)
        f1 = PmI8RowF(f1, qrow + pos * es, qp * es, wrow + j, *g\Kernel, cg, *g\Wide, sc)
        If *g\Wide <> 0
          f2 = PmI8RowF(f2, qrow + pos * es, qp * es, wrow + elements + j, *g\Kernel, cg, 1, sc)
        EndIf
        j = j + 1
      Wend
      v = PmI8Finish(f1, f2, *g\Wide, PmI8GetF(*g\WeightScales + oc * 4))
      If *g\Bias <> 0
        b = PmI8GetF(*g\Bias + oc * 4)
        v = b + v
      EndIf
      PmI8PutF(*g\Dst + ((bn * *g\OutChannels + oc) * *g\OutWidth + ox) * 4, v)
      ox = ox + 1
    Wend
    oc = oc + 1
  Wend
EndProcedure

; Every batch, on the calling core.
Procedure PmI8Conv1D(*g.PmTensorConv1DArgs)
  Protected bn.i
  bn = 0
  While bn < *g\Batches
    If PmI8ConvQuantize(*g, bn) = 0
      ProcedureReturn
    EndIf
    PmI8Conv1DRange(*g, bn, 0, *g\OutChannels, PmI8ConvTile(*g, 0))
    bn = bn + 1
  Wend
EndProcedure
CompilerEndIf
Procedure PmTensorConv1D(*g.PmTensorConv1DArgs)
  Protected bn.i
  Protected oc.i
  Protected ox.i
  Protected icg.i
  Protected kx.i
  Protected ix.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected ic.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected accumulator.i
  Protected aScale.f
  Protected converted.f
  Protected sum.f
  inPerGroup = *g\InChannels / *g\Groups
  outPerGroup = *g\OutChannels / *g\Groups
  CompilerIf #PMO_USE_INT8 = 1
  If *g\WeightScales <> 0
    PmI8Conv1D(*g)
    ProcedureReturn
  EndIf
  CompilerEndIf
  bn = 0
  While bn < *g\Batches
    oc = 0
    While oc < *g\OutChannels
      group = oc / outPerGroup
      ox = 0
      While ox < *g\OutWidth
        sum = 0.0 : accumulator = 0
        If *g\Bias <> 0 : sum = PmTensorGet(*g\Bias, oc) : EndIf
        icg = 0
        While icg < inPerGroup
          ic = group * inPerGroup + icg
          kx = 0
          While kx < *g\Kernel
            ix = ox * *g\Stride - *g\PadLeft + kx * *g\Dilation
            If ix >= 0 And ix < *g\InWidth
              srcIndex = (bn * *g\InChannels + ic) * *g\InWidth + ix
              weightIndex = (oc * inPerGroup + icg) * *g\Kernel + kx
                sum = sum + PmTensorGet(*g\Src, srcIndex) * PmTensorGet(*g\Weight, weightIndex)
            EndIf
            kx = kx + 1
          Wend
          icg = icg + 1
        Wend
        PmTensorPut(*g\Dst, (bn * *g\OutChannels + oc) * *g\OutWidth + ox, sum)
        ox = ox + 1
      Wend
      oc = oc + 1
    Wend
    bn = bn + 1
  Wend
EndProcedure
CompilerEndIf

; NCHW 2-D convolution. W is [outChannels, inChannels/group, kH, kW].
Structure PmTensorConv2DArgs
  Src.i
  Weight.i
  Bias.i
  Dst.i
  Batches.i
  InChannels.i
  InH.i
  InW.i
  OutChannels.i
  OutH.i
  OutW.i
  KernelH.i
  KernelW.i
  PadTop.i
  PadLeft.i
  StrideH.i
  StrideW.i
  DilationH.i
  DilationW.i
  Groups.i
  WeightScales.i
EndStructure

CompilerIf #PMO_USE_CONV = 1
CompilerIf #PMO_USE_INT8 = 1
; 2-D convolution with INT8 weights (the fixed-shape path; narrow only): one
; scale per input position (y, x) over every channel, one FP32 partial per
; tap, and the bias added last (0.0 when there is none).
Procedure PmI8Conv2D(*g.PmTensorConv2DArgs)
  Protected positions.i
  Protected cg.i
  Protected og.i
  Protected q.i
  Protected s.i
  Protected inv.i
  Protected src.i
  Protected bn.i
  Protected oc.i
  Protected oy.i
  Protected ox.i
  Protected ky.i
  Protected kx.i
  Protected iy.i
  Protected ix.i
  Protected c.i
  Protected pos.i
  Protected acc.i
  Protected dot.PmTensorInt8DotArgs
  Protected f.f
  Protected v.f
  Protected bias.f
  positions = *g\InH * *g\InW
  cg = *g\InChannels / *g\Groups
  og = *g\OutChannels / *g\Groups
  If PmTensorInt8Scratch = 0 Or PmI8ScratchBytes(*g\InChannels * positions, positions, 0) > PmTensorInt8ScratchBytes
    PmTensorInt8Fault = 2 : ProcedureReturn
  EndIf
  q = PmI8Base()
  s = q + PmI8Align(*g\InChannels * positions)
  inv = s + PmI8Align(positions * 4)
  dot\Count = cg : dot\StepA = positions : dot\StepB = *g\KernelH * *g\KernelW
  bn = 0
  While bn < *g\Batches
    src = *g\Src + bn * *g\InChannels * positions * 4
    pos = 0
    While pos < positions
      If PmI8RowScale(PmI8MaxBits(src + pos * 4, *g\InChannels, positions * 4), 127, s + pos * 4, inv + pos * 4) = 0
        PmTensorInt8Fault = 1 : ProcedureReturn
      EndIf
      pos = pos + 1
    Wend
    c = 0
    While c < *g\InChannels
      PmI8QuantLanes(src + c * positions * 4, inv, positions, 127, q + c * positions)
      c = c + 1
    Wend
    oc = 0
    While oc < *g\OutChannels
      bias = 0.0
      If *g\Bias <> 0 : bias = PmI8GetF(*g\Bias + oc * 4) : EndIf
      oy = 0
      While oy < *g\OutH
        ox = 0
        While ox < *g\OutW
          f = 0.0
          ky = 0
          While ky < *g\KernelH
            iy = oy * *g\StrideH - *g\PadTop + ky * *g\DilationH
            If iy >= 0 And iy < *g\InH
              kx = 0
              While kx < *g\KernelW
                ix = ox * *g\StrideW - *g\PadLeft + kx * *g\DilationW
                If ix >= 0 And ix < *g\InW
                  pos = iy * *g\InW + ix
                  dot\A = q + (oc / og) * cg * positions + pos
                  dot\B = *g\Weight + (oc * cg * *g\KernelH + ky) * *g\KernelW + kx
                  acc = PmTensorInt8Dot(@dot)
                  v = acc : v = v * PmI8GetF(s + pos * 4) : f = f + v
                EndIf
                kx = kx + 1
              Wend
            EndIf
            ky = ky + 1
          Wend
          v = f * PmI8GetF(*g\WeightScales + oc * 4)
          v = bias + v
          PmI8PutF(*g\Dst + (((bn * *g\OutChannels + oc) * *g\OutH + oy) * *g\OutW + ox) * 4, v)
          ox = ox + 1
        Wend
        oy = oy + 1
      Wend
      oc = oc + 1
    Wend
    bn = bn + 1
  Wend
EndProcedure
CompilerEndIf

Procedure PmTensorConv2D(*g.PmTensorConv2DArgs)
  Protected bn.i
  Protected oc.i
  Protected oy.i
  Protected ox.i
  Protected icg.i
  Protected ky.i
  Protected kx.i
  Protected iy.i
  Protected ix.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected ic.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected dstIndex.i
  Protected accumulator.i
  Protected aScale.f
  Protected converted.f
  Protected sum.f
  inPerGroup = *g\InChannels / *g\Groups
  outPerGroup = *g\OutChannels / *g\Groups
  CompilerIf #PMO_USE_INT8 = 1
  If *g\WeightScales <> 0
    PmI8Conv2D(*g)
    ProcedureReturn
  EndIf
  CompilerEndIf
  bn = 0
  While bn < *g\Batches
    oc = 0
    While oc < *g\OutChannels
      group = oc / outPerGroup
      oy = 0
      While oy < *g\OutH
        ox = 0
        While ox < *g\OutW
          sum = 0.0 : accumulator = 0
          If *g\Bias <> 0 : sum = PmTensorGet(*g\Bias, oc) : EndIf
          icg = 0
          While icg < inPerGroup
            ic = group * inPerGroup + icg
            ky = 0
            While ky < *g\KernelH
              iy = oy * *g\StrideH - *g\PadTop + ky * *g\DilationH
              If iy >= 0 And iy < *g\InH
                kx = 0
                While kx < *g\KernelW
                  ix = ox * *g\StrideW - *g\PadLeft + kx * *g\DilationW
                  If ix >= 0 And ix < *g\InW
                    srcIndex = ((bn * *g\InChannels + ic) * *g\InH + iy) * *g\InW + ix
                    weightIndex = ((oc * inPerGroup + icg) * *g\KernelH + ky) * *g\KernelW + kx
                      sum = sum + PmTensorGet(*g\Src, srcIndex) * PmTensorGet(*g\Weight, weightIndex)
                  EndIf
                  kx = kx + 1
                Wend
              EndIf
              ky = ky + 1
            Wend
            icg = icg + 1
          Wend
          dstIndex = ((bn * *g\OutChannels + oc) * *g\OutH + oy) * *g\OutW + ox
          PmTensorPut(*g\Dst, dstIndex, sum)
          ox = ox + 1
        Wend
        oy = oy + 1
      Wend
      oc = oc + 1
    Wend
    bn = bn + 1
  Wend
EndProcedure
CompilerEndIf

; ONNX LSTM, layout=0, default activation triplet, without peepholes.
; Gate order in ONNX weights is input, output, forget, cell (iofc).
CompilerIf #PMO_USE_INT8 = 1
Structure PmTensorLstmArgs
  X.i
  W.i
  R.i
  B.i
  SeqLens.i
  InitialH.i
  InitialC.i
  Y.i
  YH.i
  YC.i
  Sequence.i
  Batch.i
  InputSize.i
  Hidden.i
  Directions.i
  WScales.i
  RScales.i
  WWide.i
  RWide.i
EndStructure
CompilerElse
Structure PmTensorLstmArgs
  X.i
  W.i
  R.i
  B.i
  SeqLens.i
  InitialH.i
  InitialC.i
  Y.i
  YH.i
  YC.i
  Sequence.i
  Batch.i
  InputSize.i
  Hidden.i
  Directions.i
  WScales.i
  RScales.i
EndStructure
CompilerEndIf

CompilerIf #PMO_USE_LSTM = 1
Structure PmTensorLstmFloatFourArgs
  A.i
  B.i
  Count.i
  Hidden.i
  Unit.i
  IValue.f
  OValue.f
  FValue.f
  CValue.f
EndStructure

Procedure PmTensorLstmFloatFour(*g.PmTensorLstmFloatFourArgs)
  CompilerIf #PMO_INT8_BACKEND = 1
  ASM
    ; x0 remains the live entry pointer after the generated receiver homes
    ; it in this invocation's frame.  There is no process-wide parameter
    ; symbol in the automatic-storage ABI.
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    mul x6, x4, x3
    lsl x6, x6, #2
    mul x7, x5, x3
    lsl x7, x7, #2
    add x2, x2, x7
    movi v16.4s, #0
    cmp x3, #0
    b.le pmoLstmFloatFourStore
pmoLstmFloatFourLoop:
    ldr s0, [x1]
    dup v0.4s, v0.s[0]
    ldr s1, [x2]
    add x7, x2, x6
    ld1 {v1.s}[1], [x7]
    add x7, x7, x6
    ld1 {v1.s}[2], [x7]
    add x7, x7, x6
    ld1 {v1.s}[3], [x7]
    fmul v1.4s, v0.4s, v1.4s
    fadd v16.4s, v16.4s, v1.4s
    add x1, x1, #4
    add x2, x2, #4
    subs x3, x3, #1
    b.ne pmoLstmFloatFourLoop
pmoLstmFloatFourStore:
    add x7, x0, #40
    st1 {v16.s}[0], [x7]
    add x7, x0, #44
    st1 {v16.s}[1], [x7]
    add x7, x0, #48
    st1 {v16.s}[2], [x7]
    add x7, x0, #52
    st1 {v16.s}[3], [x7]
  EndASM
  CompilerElse
  Protected gate.i
  Protected index.i
  Protected offset.i
  Protected left.f
  Protected right.f
  Protected sum.f
  gate = 0
  While gate < 4
    offset = gate : offset = offset * *g\Hidden
    offset = offset + *g\Unit : offset = offset * *g\Count
    index = 0 : sum = 0.0
    While index < *g\Count
      left = PmTensorGet(*g\A, index)
      right = PmTensorGet(*g\B, offset + index)
      sum = sum + left * right
      index = index + 1
    Wend
    Select gate
      Case 0 : *g\IValue = sum
      Case 1 : *g\OValue = sum
      Case 2 : *g\FValue = sum
      Case 3 : *g\CValue = sum
    EndSelect
    gate = gate + 1
  Wend
  CompilerEndIf
EndProcedure

CompilerIf #PMO_USE_INT8 = 1
; ONNX LSTM with at least one INT8 weight. Per step: x(t) quantized with one
; scale, h(t-1) with one scale; every gate row of W.x and of R.h is the
; scheme's row value (y = F * wScale, or (F1 + F2/254) * wScale), and a gate's
; pre-activation is (bias sum) + W.x + R.h in that order. A weight left in
; FP32 contributes the float dot of the reference instead.
; Returns 0 on a fault (PmTensorInt8Fault says which).
Procedure.i PmI8Lstm(*g.PmTensorLstmArgs)
  Protected width.i
  Protected ww.i
  Protected rw.i
  Protected qx.i
  Protected qh.i
  Protected xq.i
  Protected hq.i
  Protected gw.i
  Protected gr.i
  Protected misc.i
  Protected tile.i
  Protected wElements.i
  Protected rElements.i
  Protected dir.i
  Protected stepIndex.i
  Protected bn.i
  Protected t.i
  Protected valid.i
  Protected unit.i
  Protected gate.i
  Protected row.i
  Protected i.i
  Protected state.i
  Protected inputRow.i
  Protected outRow.i
  Protected bbase.i
  Protected wbase.i
  Protected rbase.i
  Protected iv.f
  Protected ov.f
  Protected fv.f
  Protected cv.f
  Protected previousC.f
  Protected newC.f
  Protected f1.f
  Protected f2.f
  Protected floatFour.PmTensorLstmFloatFourArgs
  width = 4 * *g\Hidden
  ww = 0 : If *g\WScales <> 0 : ww = *g\WWide : EndIf
  rw = 0 : If *g\RScales <> 0 : rw = *g\RWide : EndIf
  If PmTensorInt8Scratch = 0 Or PmI8LstmScratchBytes(*g\InputSize, *g\Hidden, ww, rw) > PmTensorInt8ScratchBytes
    PmTensorInt8Fault = 2 : ProcedureReturn 0
  EndIf
  xq = PmI8Base()
  hq = xq + PmI8Align(*g\InputSize * (1 + ww))
  gw = hq + PmI8Align(*g\Hidden * (1 + rw))
  gr = gw + PmI8Align(width * 4)
  misc = gr + PmI8Align(width * 4)
  tile = misc + 64
  wElements = *g\Directions * width * *g\InputSize
  rElements = *g\Directions * width * *g\Hidden
  qx = 127 : If ww <> 0 : qx = 32767 : EndIf
  qh = 127 : If rw <> 0 : qh = 32767 : EndIf
  i = 0
  While i < *g\Directions * *g\Batch * *g\Hidden
    iv = 0.0 : cv = 0.0
    If *g\InitialH <> 0 : iv = PmI8GetF(*g\InitialH + i * 4) : EndIf
    If *g\InitialC <> 0 : cv = PmI8GetF(*g\InitialC + i * 4) : EndIf
    PmI8PutF(*g\YH + i * 4, iv) : PmI8PutF(*g\YC + i * 4, cv)
    i = i + 1
  Wend
  dir = 0
  While dir < *g\Directions
    stepIndex = 0
    While stepIndex < *g\Sequence
      bn = 0
      While bn < *g\Batch
        valid = *g\Sequence
        If *g\SeqLens <> 0 : valid = PmTensorGetI64(*g\SeqLens, bn) : EndIf
        If stepIndex < valid
          t = stepIndex
          If dir = 1 : t = valid - 1 - stepIndex : EndIf
          inputRow = *g\X + (t * *g\Batch + bn) * *g\InputSize * 4
          state = (dir * *g\Batch + bn) * *g\Hidden
          outRow = ((t * *g\Directions + dir) * *g\Batch + bn) * *g\Hidden
          ; W . x(t), every gate row, into gw
          If *g\WScales <> 0
            If PmI8QuantRow(inputRow, *g\InputSize, 4, qx, xq, misc, misc + 4) = 0
              PmTensorInt8Fault = 1 : ProcedureReturn 0
            EndIf
            wbase = *g\W + dir * width * *g\InputSize
            row = 0
            While row < width
              PmI8Block4(xq, wbase + row * *g\InputSize, *g\InputSize, wElements, *g\InputSize, ww, misc, tile, tile + 16)
              i = 0
              While i < 4
                f1 = PmI8GetF(tile + i * 4) : f2 = PmI8GetF(tile + 16 + i * 4)
                PmI8PutF(gw + (row + i) * 4, PmI8Finish(f1, f2, ww, PmI8GetF(*g\WScales + (dir * width + row + i) * 4)))
                i = i + 1
              Wend
              row = row + 4
            Wend
          Else
            unit = 0
            While unit < *g\Hidden
              floatFour\A = inputRow : floatFour\B = *g\W + dir * width * *g\InputSize * 4
              floatFour\Count = *g\InputSize : floatFour\Hidden = *g\Hidden : floatFour\Unit = unit
              PmTensorLstmFloatFour(@floatFour)
              PmI8PutF(gw + unit * 4, floatFour\IValue)
              PmI8PutF(gw + (*g\Hidden + unit) * 4, floatFour\OValue)
              PmI8PutF(gw + (2 * *g\Hidden + unit) * 4, floatFour\FValue)
              PmI8PutF(gw + (3 * *g\Hidden + unit) * 4, floatFour\CValue)
              unit = unit + 1
            Wend
          EndIf
          ; R . h(t-1), every gate row, into gr
          If *g\RScales <> 0
            If PmI8QuantRow(*g\YH + state * 4, *g\Hidden, 4, qh, hq, misc + 8, misc + 12) = 0
              PmTensorInt8Fault = 1 : ProcedureReturn 0
            EndIf
            rbase = *g\R + dir * width * *g\Hidden
            row = 0
            While row < width
              PmI8Block4(hq, rbase + row * *g\Hidden, *g\Hidden, rElements, *g\Hidden, rw, misc + 8, tile, tile + 16)
              i = 0
              While i < 4
                f1 = PmI8GetF(tile + i * 4) : f2 = PmI8GetF(tile + 16 + i * 4)
                PmI8PutF(gr + (row + i) * 4, PmI8Finish(f1, f2, rw, PmI8GetF(*g\RScales + (dir * width + row + i) * 4)))
                i = i + 1
              Wend
              row = row + 4
            Wend
          Else
            unit = 0
            While unit < *g\Hidden
              floatFour\A = *g\YH + state * 4 : floatFour\B = *g\R + dir * width * *g\Hidden * 4
              floatFour\Count = *g\Hidden : floatFour\Hidden = *g\Hidden : floatFour\Unit = unit
              PmTensorLstmFloatFour(@floatFour)
              PmI8PutF(gr + unit * 4, floatFour\IValue)
              PmI8PutF(gr + (*g\Hidden + unit) * 4, floatFour\OValue)
              PmI8PutF(gr + (2 * *g\Hidden + unit) * 4, floatFour\FValue)
              PmI8PutF(gr + (3 * *g\Hidden + unit) * 4, floatFour\CValue)
              unit = unit + 1
            Wend
          EndIf
          bbase = dir * 8 * *g\Hidden
          unit = 0
          While unit < *g\Hidden
            iv = 0.0 : ov = 0.0 : fv = 0.0 : cv = 0.0
            If *g\B <> 0
              iv = PmTensorGet(*g\B, bbase + unit) + PmTensorGet(*g\B, bbase + 4 * *g\Hidden + unit)
              ov = PmTensorGet(*g\B, bbase + *g\Hidden + unit) + PmTensorGet(*g\B, bbase + 5 * *g\Hidden + unit)
              fv = PmTensorGet(*g\B, bbase + 2 * *g\Hidden + unit) + PmTensorGet(*g\B, bbase + 6 * *g\Hidden + unit)
              cv = PmTensorGet(*g\B, bbase + 3 * *g\Hidden + unit) + PmTensorGet(*g\B, bbase + 7 * *g\Hidden + unit)
            EndIf
            iv = iv + PmI8GetF(gw + unit * 4)
            iv = iv + PmI8GetF(gr + unit * 4)
            ov = ov + PmI8GetF(gw + (*g\Hidden + unit) * 4)
            ov = ov + PmI8GetF(gr + (*g\Hidden + unit) * 4)
            fv = fv + PmI8GetF(gw + (2 * *g\Hidden + unit) * 4)
            fv = fv + PmI8GetF(gr + (2 * *g\Hidden + unit) * 4)
            cv = cv + PmI8GetF(gw + (3 * *g\Hidden + unit) * 4)
            cv = cv + PmI8GetF(gr + (3 * *g\Hidden + unit) * 4)
            previousC = PmI8GetF(*g\YC + (state + unit) * 4)
            iv = PmTensorSigmoidValue(iv)
            ov = PmTensorSigmoidValue(ov)
            fv = PmTensorSigmoidValue(fv)
            cv = PmTensorTanhValue(cv)
            newC = fv * previousC + iv * cv
            PmI8PutF(*g\YC + (state + unit) * 4, newC)
            PmI8PutF(*g\Y + (outRow + unit) * 4, ov * PmTensorTanhValue(newC))
            unit = unit + 1
          Wend
          ; The completed step becomes h only after every recurrent read used h(t-1).
          unit = 0
          While unit < *g\Hidden
            PmI8PutF(*g\YH + (state + unit) * 4, PmI8GetF(*g\Y + (outRow + unit) * 4))
            unit = unit + 1
          Wend
        EndIf
        bn = bn + 1
      Wend
      stepIndex = stepIndex + 1
    Wend
    dir = dir + 1
  Wend
  ProcedureReturn 1
EndProcedure
CompilerEndIf

Procedure PmTensorLstm(*g.PmTensorLstmArgs)
  Protected dir.i
  Protected step.i
  Protected t.i
  Protected bn.i
  Protected unit.i
  Protected k.i
  Protected stateIndex.i
  Protected xIndex.i
  Protected wBase.i
  Protected rBase.i
  Protected bBase.i
  Protected yIndex.i
  Protected valid.i
  Protected iv.f
  Protected ov.f
  Protected fv.f
  Protected cv.f
  Protected previousC.f
  Protected newC.f
  Protected xScale.f
  Protected hScale.f
  Protected leftPointer.i
  Protected rightPointer.i
  Protected scaleIndex.i
  Protected dotValue.f
  Protected dot.PmTensorDotInt8Args
  Protected floatFour.PmTensorLstmFloatFourArgs
  CompilerIf #PMO_USE_INT8 = 1
  If *g\WScales <> 0 Or *g\RScales <> 0
    If PmI8Lstm(*g) = 0 And PmTensorInt8Fault = 0 : PmTensorInt8Fault = 2 : EndIf
    ProcedureReturn
  EndIf
  CompilerEndIf

  ; Initial state becomes the mutable final-state buffers.
  dir = 0
  While dir < *g\Directions
    bn = 0
    While bn < *g\Batch
      unit = 0
      While unit < *g\Hidden
        stateIndex = (dir * *g\Batch + bn) * *g\Hidden + unit
        If *g\InitialH <> 0
          PmTensorPut(*g\YH, stateIndex, PmTensorGet(*g\InitialH, stateIndex))
        Else
          PmTensorPut(*g\YH, stateIndex, 0.0)
        EndIf
        If *g\InitialC <> 0
          PmTensorPut(*g\YC, stateIndex, PmTensorGet(*g\InitialC, stateIndex))
        Else
          PmTensorPut(*g\YC, stateIndex, 0.0)
        EndIf
        unit = unit + 1
      Wend
      bn = bn + 1
    Wend
    dir = dir + 1
  Wend

  dir = 0
  While dir < *g\Directions
    step = 0
    While step < *g\Sequence
      bn = 0
      While bn < *g\Batch
        valid = *g\Sequence
        If *g\SeqLens <> 0 : valid = PmTensorGetI64(*g\SeqLens, bn) : EndIf
        If dir = 0
          t = step
        Else
          t = valid - 1 - step
        EndIf
        If step < valid
          xIndex = (t * *g\Batch + bn) * *g\InputSize
          stateIndex = (dir * *g\Batch + bn) * *g\Hidden
          unit = 0
          While unit < *g\Hidden
            iv = 0.0 : ov = 0.0 : fv = 0.0 : cv = 0.0
            bBase = dir * 8 * *g\Hidden
            If *g\B <> 0
              iv = PmTensorGet(*g\B, bBase + unit) + PmTensorGet(*g\B, bBase + 4 * *g\Hidden + unit)
              ov = PmTensorGet(*g\B, bBase + *g\Hidden + unit) + PmTensorGet(*g\B, bBase + 5 * *g\Hidden + unit)
              fv = PmTensorGet(*g\B, bBase + 2 * *g\Hidden + unit) + PmTensorGet(*g\B, bBase + 6 * *g\Hidden + unit)
              cv = PmTensorGet(*g\B, bBase + 3 * *g\Hidden + unit) + PmTensorGet(*g\B, bBase + 7 * *g\Hidden + unit)
            EndIf
            wBase = (dir * 4 * *g\Hidden) * *g\InputSize
              leftPointer = *g\X : k = xIndex : k = k * 4 : leftPointer = leftPointer + k
              rightPointer = *g\W : k = wBase : k = k * 4 : rightPointer = rightPointer + k
              floatFour\A = leftPointer : floatFour\B = rightPointer
              floatFour\Count = *g\InputSize : floatFour\Hidden = *g\Hidden : floatFour\Unit = unit
              PmTensorLstmFloatFour(@floatFour)
              iv = iv + floatFour\IValue : ov = ov + floatFour\OValue
              fv = fv + floatFour\FValue : cv = cv + floatFour\CValue
            stateIndex = (dir * *g\Batch + bn) * *g\Hidden
            rBase = (dir * 4 * *g\Hidden) * *g\Hidden
              leftPointer = *g\YH : k = stateIndex : k = k * 4 : leftPointer = leftPointer + k
              rightPointer = *g\R : k = rBase : k = k * 4 : rightPointer = rightPointer + k
              floatFour\A = leftPointer : floatFour\B = rightPointer
              floatFour\Count = *g\Hidden : floatFour\Hidden = *g\Hidden : floatFour\Unit = unit
              PmTensorLstmFloatFour(@floatFour)
              iv = iv + floatFour\IValue : ov = ov + floatFour\OValue
              fv = fv + floatFour\FValue : cv = cv + floatFour\CValue
            stateIndex = (dir * *g\Batch + bn) * *g\Hidden + unit
            previousC = PmTensorGet(*g\YC, stateIndex)
            iv = PmTensorSigmoidValue(iv)
            ov = PmTensorSigmoidValue(ov)
            fv = PmTensorSigmoidValue(fv)
            cv = PmTensorTanhValue(cv)
            newC = fv * previousC + iv * cv
            PmTensorPut(*g\YC, stateIndex, newC)
            yIndex = ((t * *g\Directions + dir) * *g\Batch + bn) * *g\Hidden + unit
            PmTensorPut(*g\Y, yIndex, ov * PmTensorTanhValue(newC))
            unit = unit + 1
          Wend
          ; Copy the completed timestep only after all recurrent reads used H(t-1).
          unit = 0
          While unit < *g\Hidden
            stateIndex = (dir * *g\Batch + bn) * *g\Hidden + unit
            yIndex = ((t * *g\Directions + dir) * *g\Batch + bn) * *g\Hidden + unit
            PmTensorPut(*g\YH, stateIndex, PmTensorGet(*g\Y, yIndex))
            unit = unit + 1
          Wend
        EndIf
        bn = bn + 1
      Wend
      step = step + 1
    Wend
    dir = dir + 1
  Wend
EndProcedure
CompilerEndIf
