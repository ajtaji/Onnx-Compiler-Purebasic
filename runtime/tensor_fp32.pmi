pmoI8ColDone:
  EndASM
EndProcedure

; dst = saturate(round-half-even(src * inv)), Count values, INT8 or INT16.
; InvStep 0: one reciprocal for every value; 4: one per value.
Structure PmI8QuantArgs
  Src.i
  Inv.i
  InvStep.i
  Dst.i
  Count.i
  Wide.i
EndStructure

Procedure PmI8QuantNeon(*a.PmI8QuantArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    ldr x6, [x0, #40]
    ld1r {v7.4s}, [x2]
    mov v6.16b, v7.16b
pmoI8Quant8:
    cmp x5, #8
    b.lt pmoI8QuantTail
    ld1 {v0.4s, v1.4s}, [x1], #32
