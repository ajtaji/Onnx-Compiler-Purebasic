; ======================================================================
; tensor_fp32.pmi - portable FP32 tensor kernels used by generated ONNX programs.
; ----------------------------------------------------------------------
; The MAIN file must write EnableFloatingPoint before including this file.
; Procedures take byte addresses. Tensor elements are contiguous IEEE-754
; binary32 values unless a procedure's name says otherwise.
;
; This is deliberately an execution library, not a graph interpreter.
; The host compiler has already checked shapes and operator revisions,
; folded constants, selected kernels and planned memory before any of these
; procedures run. There are no operator names or dynamic tensor descriptors
; on the board.
;
; This file includes no other library. Generated programs that use Exp,
; Log, Pow or Sqr list RaspberryPi4/Lib/math.pi4 before this file.
; ======================================================================

Global Dim PmTensorCrcTable.i(256)
Global PmTensorCrcReady.i

Procedure PmTensorCrcInit()
  Protected i.i
  Protected bit.i
  Protected value.i
  If PmTensorCrcReady <> 0
    ProcedureReturn
  EndIf
  i = 0
  While i < 256
    value = i
    bit = 0
    While bit < 8
      If (value & 1) <> 0
        value = ((value >> 1) & $7FFFFFFF) ! $EDB88320
      Else
        value = (value >> 1) & $7FFFFFFF
      EndIf
      bit = bit + 1
    Wend
    PmTensorCrcTable(i) = value & $FFFFFFFF
    i = i + 1
  Wend
  PmTensorCrcReady = 1
EndProcedure

CompilerIf #PMO_INT8_BACKEND = 1
Procedure.i PmTensorCrc32A64(*data.i, bytes.i, *table.i)
  ASM
    ; The ordinary A64 receiver homes parameters before the body without
    ; changing x0-x2.  They remain the live entry ABI values here; automatic
    ; parameter slots have no absolute symbols to reload.
    movz w3, #0xffff
    movk w3, #0xffff, lsl #16
    cmp x1, #0
    b.le pmoCrc32A64Done
pmoCrc32A64Loop:
    ldrb w4, [x0]
    add x0, x0, #1
    eor w4, w4, w3
    uxtb w4, w4
    lsr w3, w3, #8
    lsl x6, x4, #3
    add x6, x2, x6
    ldr x5, [x6]
    eor w3, w3, w5
    subs x1, x1, #1
    b.ne pmoCrc32A64Loop
pmoCrc32A64Done:
    mvn w0, w3
  EndASM
EndProcedure
CompilerEndIf

Procedure.i PmTensorCrc32(*data.i, bytes.i)
  Protected i.i
  Protected index.i
  Protected crc.i
  PmTensorCrcInit()
  CompilerIf #PMO_INT8_BACKEND = 1
  ProcedureReturn PmTensorCrc32A64(*data,bytes,@PmTensorCrcTable(0))
  CompilerElse
  crc = $FFFFFFFF
  i = 0
  While i < bytes
    index = (crc ! (PeekA(*data + i) & 255)) & 255
    crc = ((crc >> 8) & $00FFFFFF) ! PmTensorCrcTable(index)
    i = i + 1
  Wend
  ProcedureReturn (crc ! $FFFFFFFF) & $FFFFFFFF
  CompilerEndIf
EndProcedure

Procedure.f PmTensorGet(*base.i, index.i)
  Protected p.i
  p = *base + index * 4
  ProcedureReturn *p.f
EndProcedure

Procedure PmTensorPut(*base.i, index.i, value.f)
  Protected p.i
  p = *base + index * 4
  *p.f = value
EndProcedure

; NaN (forums 995, 997, 998). PureMetal's float comparisons answer a NaN as
; IEEE 754 does, so no kernel here guards a comparison against the host
; compiler's old NaN answers (tensor_fp32_windows.pbi, #PMO_HOST_NAN_BUG); the
; operator-set lane reads the constant.
#PMO_HOST_NAN_BUG = 0

; Square root, correctly rounded (C6c-1), so every target gives the same bits
; as the Windows program, whose binary32 square root taken through binary64 is
; correctly rounded too. The Pi 4 and the UNO Q use the FPU's fsqrt and the
; Pico 2 its vsqrt.f32; the Pico, which has no FPU, takes the integer square
; root of the significand (fdlibm's e_sqrtf.c, as the operator-set lane's
; PmOpSqrt), in steps that fit 32-bit integers. The NaN of an invalid
; argument is x86's: a NaN argument comes back quieted (its payload and sign
; kept), a negative one gives FFC00000 - the Windows program's result, and
; numpy's on x86.
CompilerIf #PMO_INT8_BACKEND = 1
Procedure.i PmTensorSqrtBits(bits.i)
  ASM
    fmov s0, w0
    fsqrt s0, s0
    fmov w0, s0
  EndASM
EndProcedure
CompilerElseIf #PMO_INT8_BACKEND = 3
Procedure.i PmTensorSqrtBits(bits.i)
  ; the Cortex-M33's FPU: vsqrt.f32 is correctly rounded
  ASM
    vmov s0, r0
    vsqrt.f32 s0, s0
    vmov r0, s0
  EndASM
EndProcedure
CompilerElse
Procedure.i PmTensorSqrtBits(bits.i)
  Protected ix.i
  Protected m.i
  Protected i.i
  Protected q.i
  Protected s.i
  Protected r.i
  Protected t.i
  ; every test on the bits, so a 32-bit integer's sign never enters it
  ix = bits
  If (ix & $7FFFFFFF) = 0
    ProcedureReturn ix
  EndIf
  If (ix & $7FFFFFFF) > $7F800000
    ProcedureReturn $7FC00000
  EndIf
  If (ix & $80000000) <> 0
    ProcedureReturn $7FC00000
  EndIf
  If ix = $7F800000
    ProcedureReturn ix
  EndIf
  m = (ix >> 23) & $FF
  If m = 0
    i = 0
    While (ix & $800000) = 0
      ix = ix << 1
      i = i + 1
    Wend
    m = m - (i - 1)
  EndIf
  m = m - 127
  ix = (ix & $7FFFFF) | $800000
  If (m & 1) <> 0
    ix = ix + ix
  EndIf
  m = m >> 1
  ix = ix + ix
  q = 0
  s = 0
  r = $1000000
  While r <> 0
    t = s + r
    If t <= ix
      s = t + r
      ix = ix - t
      q = q + r
    EndIf
    ix = ix + ix
    r = r >> 1
  Wend
  If ix <> 0
    q = q + (q & 1)
  EndIf
  ix = (q >> 1) + $3F000000
  ProcedureReturn ix + (m << 23)
EndProcedure
CompilerEndIf

Procedure.f PmTensorSqrtF(x.f)
  Protected b.i
  Protected r.f
  b = PeekL(@x)
  If (b & $7FFFFFFF) > $7F800000
    b = b | $400000
  ElseIf (b & $80000000) <> 0 And (b & $7FFFFFFF) <> 0
    b = -4194304
  Else
    b = PmTensorSqrtBits(b)
  EndIf
  PokeL(@r, b)
  ProcedureReturn r
EndProcedure

; Exp and Log, correctly rounded (C6c-2). Compiled when the program uses them
; (#PMO_USE_EXPLOG, which a generated program sets from its graph): their
; tables are some 6 KB, and a program without Exp or Log keeps its image.
CompilerIf #PMO_USE_EXPLOG = 1
; The binary32 nearest the exact result, so every target gives the Windows
; program's bits. The Windows program's own Exp is correctly rounded for every
; argument, and its Log is except at five, which tensor_fp32_windows.pbi
; corrects. Each is one exact
; integer method in two spellings with the same steps and truncations: 32-bit
; words (the Pico, and the Pi 4's Log, whose .l arithmetic is the same) and
; UMULL/UMAAL assembly (the Pico 2), plus 64-bit integers for the Pi 4's Exp.
; Every spelling was run on every binary32 argument (the 32- and 64-bit ones
; by the Windows compiler, and each target's build in the emulator) against a
; correctly rounded result. NaN is x86's, as for the square root: a NaN
; argument comes back quieted (its payload and sign kept), and Log of a
; negative argument is FFC00000.
CompilerIf #PMO_INT8_BACKEND = 1
; The high word of the unsigned 64-bit product of two 32-bit words (a 64-bit
; multiply where .i is 64 bits).
Procedure.l PmTensorMulHi32(a.l, b.l)
  Protected x.i
  Protected y.i
  x = a & $FFFFFFFF
  y = b & $FFFFFFFF
  x = x * y
  x = x >> 32
  ProcedureReturn x
EndProcedure

; 1 when the unsigned word a is below the unsigned word b
Procedure.l PmTensorBelow32(a.l, b.l)
  Protected x.i
  Protected y.i
  x = a & $FFFFFFFF
  y = b & $FFFFFFFF
  If x < y
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; exp, correctly rounded, in exact 64-bit integer arithmetic (the bits of x in,
; the bits of the result out). x = (256 i + j) ln2/256 + r with 0 <= r < ln2/256
; (r to 2^-64, from ln2/256 to 2^-96); e^r - 1 = r + r^2/2 + r^3 (1/6 + r/24 +
; r^2/120) in Q64; the result 2^i * 2^(j/256) * e^r in Q62, rounded once to
; nearest-even at its own 24 bits (a subnormal result at its own position).
; Every binary32 argument was checked against a correctly rounded exp.
Procedure.i PmTensorExpBits(b.i)
  Protected a.i
  Protected neg.i
  Protected e.i
  Protected m.i
  Protected k.i
  Protected sh.i
  Protected xs.i
  Protected kl0.i
  Protected klh.i
  Protected r.i
  Protected rh.i
  Protected rl.i
  Protected r2.i
  Protected v.i
  Protected w.i
  Protected q.i
  Protected c.i
  Protected t.i
  Protected pp.i
  Protected j.i
  Protected i.i
  Protected tt.i
  Protected tl.i
  Protected ph.i
  Protected pl.i
  Protected y.i
  Protected p.i
  Protected biased.i
  Protected msk.i
  Protected rem.i
  Protected half.i
  Protected mm.i
  a = b & $7FFFFFFF
  If a > $7F800000
    ProcedureReturn (b | $400000) & $FFFFFFFF
  EndIf
  neg = 0
  If (b & $80000000) <> 0
    neg = 1
  EndIf
  If a = $7F800000
    If neg = 0
      ProcedureReturn $7F800000
    EndIf
    ProcedureReturn 0
  EndIf
  If a < $33000000
    ProcedureReturn $3F800000
  EndIf
  If neg = 0 And a >= $42B17218
    ProcedureReturn $7F800000
  EndIf
  If neg = 1 And a >= $42D00000
    ProcedureReturn 0
  EndIf
  e = a >> 23
  m = a & $7FFFFF
  m = m | $800000
  ; k = floor(|x| * 256/ln2), from 2^28/ln2 rounded down (up for a negative x,
  ; whose k is one more), so r is never negative
  If neg = 0
    t = m * 387270501
  Else
    t = m * 387270502
  EndIf
  sh = 170 - e
  k = 0
  If sh < 53
    k = t >> sh
  EndIf
  k = k + neg
  ; |x| * 2^64 modulo 2^64, and k * ln2/256 in Q96 without its lowest word
  sh = e - 86
  xs = m << sh
  kl0 = k * $ABC9E3B3
  t = kl0 >> 32
  kl0 = kl0 & $FFFFFFFF
  klh = k * $00B17217F7D1CF79
  klh = klh + t
  ; r in Q64
  If neg = 0
    r = xs - klh
    If kl0 <> 0
      r = r - 1
    EndIf
  Else
    r = klh - xs
  EndIf
  ; r^2/2 in Q64
  rh = r >> 32
  rl = r & $FFFFFFFF
  r2 = rh * rh
  r2 = r2 >> 1
  t = rh * rl
  t = t >> 32
  r2 = r2 + t
  ; v = r in Q40, w = r^2/2 in Q50, q = r^3 in Q57
  v = r >> 24
  w = r2 >> 14
  q = w * v
  q = q >> 32
  q = q & $FFFFFFFF
  ; c = 1/6 + r/24 + r^2/120 in Q32
  c = v * 178956971
  c = c >> 40
  t = r2 >> 32
  t = t * 71582788
  t = t >> 32
  c = c + t
  c = c + 715827883
  ; P = r + r^2/2 + r^3 c in Q64
  t = q * c
  t = t >> 25
  pp = r + r2
  pp = pp + t
  ; 2^(j/256) in Q62, k = 256 i + j
  If neg = 1
    k = 0 - k
  EndIf
  j = k & 255
  i = k >> 8
  j = j << 3
  tl = PeekL(?PmTensorExpTable + j)
  tl = tl & $FFFFFFFF
  tt = PeekL(?PmTensorExpTable + j + 4)
  ; y = T + T P in Q62
  ph = pp >> 32
  pl = pp & $FFFFFFFF
  y = tt << 32
  y = y | tl
  t = tt * ph
  y = y + t
  t = tt * pl
  t = t >> 32
  y = y + t
  t = tl * ph
  t = t >> 32
  y = y + t
  ; round once, at the result's own 24 bits
  p = 61
  If y >= $4000000000000000
    p = 62
  EndIf
  biased = i + p
  biased = biased + 65
  If biased >= 255
    ProcedureReturn $7F800000
  EndIf
  sh = p - 23
  If biased <= 0
    sh = sh + 1
    sh = sh - biased
  EndIf
  If sh >= 64
    ProcedureReturn 0
  EndIf
  mm = y >> sh
  msk = 1 << sh
  msk = msk - 1
  rem = y & msk
  t = sh - 1
  half = 1 << t
  If rem > half Or (rem = half And (mm & 1) <> 0)
    mm = mm + 1
  EndIf
  If biased <= 0
    ProcedureReturn mm
  EndIf
  t = biased << 23
  mm = mm - $800000
  ProcedureReturn t + mm
EndProcedure

; log, correctly rounded, in exact 32-bit integer arithmetic (the bits of x in,
; the bits of the result out). x = 2^E m; the top 8 bits of m's fraction pick
; c = C/1024 (C from a table), so r = c m - 1 = N/2^33 is EXACT, |r| <= 2^-8.
; log x = E' ln2 + T + log1p(r), where T = -log(c) (less ln2, and E' = E + 1,
; when m >= 1.414), and log1p(r) = r G, G = 1 - r/2 + r^2 (1/3 - r/4 + r^2/5),
; evaluated on |r| so every product is unsigned. (That degree is enough: every
; argument checks; without the r^2/5 term one argument, 41178FEB, rounds the
; other way.) The two
; buckets beside x = 1 have c = 1 and c = 1/2 exactly, so there T = 0 and the
; result is r G to its full relative precision. The sum is in Q88 (three
; words), rounded once to nearest-even at its own 24 bits.
; Every binary32 argument was checked against a correctly rounded log.
Procedure.l PmTensorLogBits(b.l)
  Protected a.l
  Protected e.l
  Protected mm.l
  Protected z.l
  Protected j.l
  Protected d.l
  Protected nn.l
  Protected neg.l
  Protected t.l
  Protected n2l.l
  Protected n2h.l
  Protected u.l
  Protected xl.l
  Protected xh.l
  Protected hl.l
  Protected hh.l
  Protected wl.l
  Protected wh.l
  Protected gl.l
  Protected gh.l
  Protected v0.l
  Protected v1.l
  Protected v2.l
  Protected c.l
  Protected p0.l
  Protected p1.l
  Protected p2.l
  Protected s0.l
  Protected s1.l
  Protected s2.l
  Protected k.l
  Protected sg.l
  a = b & $7FFFFFFF
  If a > $7F800000
    ProcedureReturn b | $400000
  EndIf
  If a = 0
    ProcedureReturn $FF800000
  EndIf
  If a <> b
    ProcedureReturn $FFC00000
  EndIf
  If a = $7F800000
    ProcedureReturn a
  EndIf
  If a = $3F800000
    ProcedureReturn 0
  EndIf
  e = a >> 23
  mm = a & $7FFFFF
  If e = 0
    ; a subnormal: its leading bit moved up to bit 23
    z = 1
    While (mm & $800000) = 0
      mm = mm << 1
      z = z - 1
    Wend
    e = z
  Else
    mm = mm | $800000
  EndIf
  e = e - 127
  j = mm >> 15
  j = j & 255
  d = 0
  If j >= 106
    d = 1
  EndIf
  e = e + d
  ; r = N/2^33 exactly: N is the low word of C m (C m - 2^33 is below 2^25)
  j = j << 2
  nn = PeekL(?PmTensorLogTable + j)
  nn = nn * mm
  neg = 0
  t = nn
  If nn < 0
    neg = 1
    t = 0 - nn
  EndIf
  ; t^2 (r^2 in Q66)
  n2l = t * t
  n2h = PmTensorMulHi32(t, t)
  ; r^2/5 in Q64: (t^2 (2^32/5)) / 2^66
  xl = n2h * 858993459
  xh = PmTensorMulHi32(n2h, 858993459)
  u = PmTensorMulHi32(n2l, 858993459)
  xl = xl + u
  xh = xh + PmTensorBelow32(xl, u)
  xl = (xl >> 2) & $3FFFFFFF
  u = xh << 30
  xl = xl | u
  xh = xh >> 2
  ; H = 1/3 -+ r/4 + r^2 H2 in Q64 (r/4 = t 2^29)
  hl = xl + $55555555
  hh = xh + $55555555
  hh = hh + PmTensorBelow32(hl, xl)
  u = t << 29
  v1 = t >> 3
  If neg = 0
    c = PmTensorBelow32(hl, u)
    hl = hl - u
    hh = hh - v1
    hh = hh - c
  Else
    hl = hl + u
    hh = hh + v1
    hh = hh + PmTensorBelow32(hl, u)
  EndIf
  ; W = r^2 H in Q64: (t^2 H) / 2^66
  wl = n2h * hh
  wh = PmTensorMulHi32(n2h, hh)
  u = PmTensorMulHi32(n2h, hl)
  wl = wl + u
  wh = wh + PmTensorBelow32(wl, u)
  u = PmTensorMulHi32(n2l, hh)
  wl = wl + u
  wh = wh + PmTensorBelow32(wl, u)
  wl = (wl >> 2) & $3FFFFFFF
  u = wh << 30
  wl = wl | u
  wh = wh >> 2
  ; |G - 1| = r/2 -+ W in Q64 (r/2 = t 2^30)
  gl = t << 30
  gh = t >> 2
  If neg = 0
    c = PmTensorBelow32(gl, wl)
    gl = gl - wl
    gh = gh - wh
    gh = gh - c
  Else
    gl = gl + wl
    gh = gh + wh
    gh = gh + PmTensorBelow32(gl, wl)
  EndIf
  ; t |G - 1| / 2^9 in Q88: v2 v1 v0
  v0 = t * gl
  v1 = PmTensorMulHi32(t, gl)
  u = t * gh
  v2 = PmTensorMulHi32(t, gh)
  v1 = v1 + u
  v2 = v2 + PmTensorBelow32(v1, u)
  v0 = (v0 >> 9) & $7FFFFF
  u = v1 << 23
  v0 = v0 | u
  v1 = (v1 >> 9) & $7FFFFF
  u = v2 << 23
  v1 = v1 | u
  v2 = v2 >> 9
  ; |log1p(r)| = |r| G in Q88: p2 p1 p0 (|r| = t 2^55)
  p1 = t << 23
  p2 = t >> 9
  If neg = 0
    p0 = 0 - v0
    c = 0
    If v0 <> 0
      c = 1
    EndIf
    u = PmTensorBelow32(p1, v1)
    p1 = p1 - v1
    If p1 = 0 And c = 1
      u = 1
    EndIf
    p1 = p1 - c
    p2 = p2 - v2
    p2 = p2 - u
  Else
    p0 = v0
    p1 = p1 + v1
    p2 = p2 + v2
    p2 = p2 + PmTensorBelow32(p1, v1)
  EndIf
  ; S = E' ln2 + T in Q88: s2 s1 s0 (ln2 = $B17217 F7D1CF79 ABC9E3B4)
  k = e
  If e < 0
    k = 0 - e
  EndIf
  s0 = k * $ABC9E3B4
  c = PmTensorMulHi32(k, $ABC9E3B4)
  s1 = k * $F7D1CF79
  u = PmTensorMulHi32(k, $F7D1CF79)
  s1 = s1 + c
  u = u + PmTensorBelow32(s1, c)
  s2 = k * $B17217
  s2 = s2 + u
  If e < 0
    ; negate the three words
    s0 = s0 ! $FFFFFFFF
    s1 = s1 ! $FFFFFFFF
    s2 = s2 ! $FFFFFFFF
    s0 = s0 + 1
    If s0 = 0
      s1 = s1 + 1
      If s1 = 0
        s2 = s2 + 1
      EndIf
    EndIf
  EndIf
  u = PeekL(?PmTensorLogTable + 1024 + j + j + j)
  s0 = s0 + u
  c = PmTensorBelow32(s0, u)
  u = PeekL(?PmTensorLogTable + 1028 + j + j + j)
  s1 = s1 + c
  c = PmTensorBelow32(s1, c)
  s1 = s1 + u
  c = c + PmTensorBelow32(s1, u)
  u = PeekL(?PmTensorLogTable + 1032 + j + j + j)
  s2 = s2 + c
  s2 = s2 + u
  ; S = S -+ |log1p(r)|
  If neg = 0
    s0 = s0 + p0
    c = PmTensorBelow32(s0, p0)
    s1 = s1 + c
    c = PmTensorBelow32(s1, c)
    s1 = s1 + p1
    c = c + PmTensorBelow32(s1, p1)
    s2 = s2 + c
    s2 = s2 + p2
  Else
    c = PmTensorBelow32(s0, p0)
    s0 = s0 - p0
    u = PmTensorBelow32(s1, p1)
    s1 = s1 - p1
    If s1 = 0 And c = 1
      u = 1
    EndIf
    s1 = s1 - c
    s2 = s2 - p2
    s2 = s2 - u
  EndIf
  ; the sign, then |S|
  sg = 0
  If s2 < 0
    sg = $80000000
    s0 = s0 ! $FFFFFFFF
    s1 = s1 ! $FFFFFFFF
    s2 = s2 ! $FFFFFFFF
    s0 = s0 + 1
    If s0 = 0
      s1 = s1 + 1
      If s1 = 0
        s2 = s2 + 1
      EndIf
    EndIf
  EndIf
  ; |S| is at least 2^64 (Q88), so its top bit is in s2: move it to bit 31
  k = 31
  If (s2 & $FFFF0000) = 0
    s2 = s2 << 16
    k = k - 16
  EndIf
  If (s2 & $FF000000) = 0
    s2 = s2 << 8
    k = k - 8
  EndIf
  If (s2 & $F0000000) = 0
    s2 = s2 << 4
    k = k - 4
  EndIf
  If (s2 & $C0000000) = 0
    s2 = s2 << 2
    k = k - 2
  EndIf
  If (s2 & $80000000) = 0
    s2 = s2 << 1
    k = k - 1
  EndIf
  ; the bits of s1 (and s0) that follow, by the same shift
  u = 31 - k
  If u > 0
    z = 32 - u
    c = (s1 >> z)
    t = 1 << u
    t = t - 1
    c = c & t
    s2 = s2 | c
    s1 = s1 << u
    c = s0 >> z
    c = c & t
    s1 = s1 | c
    s0 = s0 << u
  EndIf
  ; round once: s2 holds the 24 bits and the round bit
  mm = (s2 >> 8) & $FFFFFF
  If (s2 & $80) <> 0
    If (s2 & $7F) <> 0 Or s1 <> 0 Or s0 <> 0 Or (mm & 1) <> 0
      mm = mm + 1
    EndIf
  EndIf
  k = k + 102
  k = k << 23
  k = k + mm
  ProcedureReturn k | sg
EndProcedure
CompilerElseIf #PMO_INT8_BACKEND = 3
; exp, correctly rounded, on the Cortex-M33: the same exact integer method as
; the 32-bit procedure (every step and every truncation the same), written with
; UMULL/UMAAL. x = (256 i + j) ln2/256 + r with 0 <= r < ln2/256 (r to 2^-64,
; from ln2/256 to 2^-96); e^r - 1 = r + r^2/2 + r^3 (1/6 + r/24 + r^2/120) in
; Q64; 2^i * 2^(j/256) * e^r in Q62, rounded once to nearest-even at its own 24
; bits (a subnormal result at its own position). A register shift by 32 or
; more gives 0 on this core, which the k and |x| * 2^96 steps rely on.
; Every binary32 argument was checked against a correctly rounded exp.
Procedure.i PmTensorExpBits(b.i)
  ASM
    push {r5, r6, r7}
    lsls r1, r0, #1
    lsrs r1, r1, #1
    ldr r2, =0x7F800000
    cmp r1, r2
    bhi pmexp_nan
    beq pmexp_inf
    ldr r2, =0x33000000
    cmp r1, r2
    blo pmexp_one
    movs r7, #0
    cmp r0, #0
    blt pmexp_neg
    ldr r2, =0x42B17218
    cmp r1, r2
    bhs pmexp_huge
    b pmexp_go
  pmexp_neg:
    ldr r2, =0x42D00000
    cmp r1, r2
    bhs pmexp_zero
    movs r7, #1
  pmexp_go:
    lsrs r2, r1, #23
    lsls r3, r1, #9
    lsrs r3, r3, #9
    movs r4, #1
    lsls r4, r4, #23
    orrs r3, r4
    ldr r4, =387270501
    adds r4, r4, r7
    umull r5, r6, r3, r4
    movs r5, #138
    subs r5, r5, r2
    lsrs r6, r5
    adds r6, r6, r7
    subs r2, #86
    movs r4, r3
    lsls r4, r2
    movs r5, r2
    subs r5, #32
    movs r1, r3
    lsls r1, r5
    negs r5, r5
    lsrs r3, r5
    orrs r3, r1
    ldr r2, =0xABC9E3B3
    umull r0, r1, r6, r2
    ldr r2, =0xF7D1CF79
    movs r5, #0
    umaal r1, r5, r6, r2
    ldr r2, =0x00B17217
    muls r2, r6
    adds r2, r2, r5
    cmp r7, #0
    bne pmexp_dneg
    negs r0, r0
    sbcs r4, r1
    sbcs r3, r2
    b pmexp_dgo
  pmexp_dneg:
    subs r4, r1, r4
    sbcs r2, r3
    movs r3, r2
    negs r6, r6
  pmexp_dgo:
    mov r12, r6
    umull r0, r1, r3, r3
    umull r2, r5, r3, r4
    lsrs r0, r0, #1
    lsls r2, r1, #31
    orrs r0, r2
    lsrs r1, r1, #1
    movs r2, #0
    adds r0, r0, r5
    adcs r1, r2
    lsls r2, r3, #8
    lsrs r5, r4, #24
    orrs r2, r5
    lsls r5, r1, #18
    lsrs r6, r0, #14
    orrs r5, r6
    umull r6, r7, r5, r2
    ldr r5, =178956971
    umull r6, r5, r2, r5
    lsrs r5, r5, #8
    ldr r6, =71582788
    umull r2, r6, r1, r6
    adds r5, r5, r6
    ldr r6, =715827883
    adds r5, r5, r6
    umull r2, r6, r7, r5
    lsrs r2, r2, #25
    lsls r5, r6, #7
    orrs r2, r5
    lsrs r6, r6, #25
    adds r4, r4, r0
    adcs r3, r1
    adds r4, r4, r2
    adcs r3, r6
    mov r6, r12
    lsls r5, r6, #24
    lsrs r5, r5, #21
    ldr r0, =PmTensorExpTable
    adds r0, r0, r5
    ldr r1, [r0, #4]
    ldr r0, [r0, #0]
    asrs r6, r6, #8
    umull r2, r5, r1, r3
    adds r2, r2, r0
    adcs r5, r1
    umull r7, r4, r1, r4
    movs r7, #0
    adds r2, r2, r4
    adcs r5, r7
    umull r4, r1, r0, r3
    adds r2, r2, r1
    adcs r5, r7
    lsrs r1, r5, #30
    adds r0, r1, #6
    adds r6, r6, r1
    adds r6, #126
    cmp r6, #255
    bge pmexp_huge
    cmp r6, #0
    bgt pmexp_round
    adds r0, #1
    subs r0, r0, r6
    movs r6, #1
    cmp r0, #32
    bge pmexp_zero
  pmexp_round:
    subs r1, r0, #1
    movs r3, r5
    lsrs r3, r1
    movs r4, #33
    subs r4, r4, r0
    lsls r5, r4
    orrs r5, r2
    lsrs r3, r3, #1
    bcc pmexp_pack
    cmp r5, #0
    bne pmexp_up
    lsls r4, r3, #31
    beq pmexp_pack
  pmexp_up:
    adds r3, #1
  pmexp_pack:
    subs r6, #1
    lsls r6, r6, #23
    adds r0, r6, r3
    b pmexp_done
  pmexp_nan:
    ldr r1, =0x400000
    orrs r0, r1
    b pmexp_done
  pmexp_inf:
    cmp r0, #0
    blt pmexp_zero
  pmexp_huge:
    ldr r0, =0x7F800000
    b pmexp_done
  pmexp_zero:
    movs r0, #0
    b pmexp_done
  pmexp_one:
    ldr r0, =0x3F800000
  pmexp_done:
    pop {r5, r6, r7}
  EndASM
EndProcedure

; log, correctly rounded, on the Cortex-M33: the same exact integer method as
; the 32-bit procedure (every step and every truncation the same), written with
; UMULL/UMAAL. x = 2^E m; c = C/1024 from the table, r = c m - 1 = N/2^33
; exactly; log x = E' ln2 + T + r G with G = 1 - r/2 + r^2 (1/3 - r/4 + r^2/5)
; on |r|; the sum in Q88 (three words), rounded once to nearest-even.
; The one CLZ is written as its encoding (.byte), which this assembler has no
; mnemonic for: clz r1, r5 = FAB5 F185.
; Every binary32 argument was checked against a correctly rounded log.
Procedure.i PmTensorLogBits(b.i)
  ASM
    push {r5, r6, r7}
    lsls r1, r0, #1
    lsrs r1, r1, #1
    ldr r2, =0x7F800000
    cmp r1, r2
    bhi pmlog_nan
    cmp r1, #0
    beq pmlog_minf
    cmp r0, #0
    blt pmlog_invalid
    cmp r1, r2
    beq pmlog_done
    ldr r2, =0x3F800000
    cmp r1, r2
    beq pmlog_zero
    lsrs r2, r1, #23
    lsls r3, r1, #9
    lsrs r3, r3, #9
    cmp r2, #0
    bne pmlog_normal
    movs r2, #1
  pmlog_subloop:
    lsrs r4, r3, #23
    bne pmlog_subdone
    lsls r3, r3, #1
    subs r2, #1
    b pmlog_subloop
  pmlog_normal:
    movs r4, #1
    lsls r4, r4, #23
    orrs r3, r4
  pmlog_subdone:
    subs r2, #127
    lsrs r4, r3, #15
    uxtb r4, r4
    cmp r4, #106
    blo pmlog_lowj
    adds r2, #1
  pmlog_lowj:
    lsls r4, r4, #2
    ldr r5, =PmTensorLogTable
    ldr r6, [r5, r4]
    muls r6, r3
    adds r7, r4, r4
    adds r7, r7, r4
    adds r5, r5, r7
    movs r7, #1
    lsls r7, r7, #10
    adds r5, r5, r7
    push {r2, r5}
    asrs r7, r6, #31
    eors r6, r7
    subs r6, r6, r7
    umull r0, r1, r6, r6
    ldr r2, =858993459
    umull r3, r4, r1, r2
    umull r5, r2, r0, r2
    movs r5, #0
    adds r3, r3, r2
    adcs r4, r5
    lsrs r3, r3, #2
    lsls r2, r4, #30
    orrs r3, r2
    lsrs r4, r4, #2
    ldr r2, =0x55555555
    adds r3, r3, r2
    adcs r4, r2
    lsls r2, r6, #29
    lsrs r5, r6, #3
    cmp r7, #0
    bne pmlog_hneg
    subs r3, r3, r2
    sbcs r4, r5
    b pmlog_hdone
  pmlog_hneg:
    adds r3, r3, r2
    adcs r4, r5
  pmlog_hdone:
    umull r0, r2, r0, r4
    umull r3, r5, r1, r3
    umull r1, r4, r1, r4
    movs r0, #0
    adds r1, r1, r2
    adcs r4, r0
    adds r1, r1, r5
    adcs r4, r0
    lsrs r1, r1, #2
    lsls r2, r4, #30
    orrs r1, r2
    lsrs r4, r4, #2
    lsls r2, r6, #30
    lsrs r3, r6, #2
    cmp r7, #0
    bne pmlog_gneg
    subs r2, r2, r1
    sbcs r3, r4
    b pmlog_gdone
  pmlog_gneg:
    adds r2, r2, r1
    adcs r3, r4
  pmlog_gdone:
    umull r0, r1, r6, r2
    umull r2, r3, r6, r3
    movs r4, #0
    adds r1, r1, r2
    adcs r3, r4
    lsrs r0, r0, #9
    lsls r2, r1, #23
    orrs r0, r2
    lsrs r1, r1, #9
    lsls r2, r3, #23
    orrs r1, r2
    lsrs r3, r3, #9
    lsls r4, r6, #23
    lsrs r5, r6, #9
    cmp r7, #0
    bne pmlog_pneg
    negs r0, r0
    sbcs r4, r1
    sbcs r5, r3
    pop {r2, r6}
    ldr r1, [r6, #0]
    adds r0, r0, r1
    ldr r1, [r6, #4]
    adcs r4, r1
    ldr r1, [r6, #8]
    adcs r5, r1
    b pmlog_qdone
  pmlog_pneg:
    adds r4, r4, r1
    adcs r5, r3
    pop {r2, r6}
    ldr r1, [r6, #0]
    subs r1, r1, r0
    ldr r3, [r6, #4]
    sbcs r3, r4
    ldr r6, [r6, #8]
    sbcs r6, r5
    movs r0, r1
    movs r4, r3
    movs r5, r6
  pmlog_qdone:
    asrs r7, r2, #31
    eors r2, r7
    subs r2, r2, r7
    mov r12, r7
    ldr r3, =0xABC9E3B4
    umull r1, r3, r2, r3
    ldr r6, =0xF7D1CF79
    movs r7, #0
    umaal r3, r7, r2, r6
    ldr r6, =0xB17217
    muls r6, r2
    adds r6, r6, r7
    mov r7, r12
    eors r1, r7
    eors r3, r7
    eors r6, r7
    subs r1, r1, r7
    sbcs r3, r7
    sbcs r6, r7
    adds r0, r0, r1
    adcs r4, r3
    adcs r5, r6
    asrs r7, r5, #31
    eors r0, r7
    eors r4, r7
    eors r5, r7
    subs r0, r0, r7
    sbcs r4, r7
    sbcs r5, r7
    lsls r7, r7, #31
    mov r12, r7
    .byte 181, 250, 133, 241
    movs r2, #32
    subs r2, r2, r1
    lsls r5, r1
    movs r3, r4
    lsrs r3, r2
    orrs r5, r3
    lsls r4, r1
    movs r3, r0
    lsrs r3, r2
    orrs r4, r3
    lsls r0, r1
    lsrs r3, r5, #8
    lsls r2, r5, #24
    bpl pmlog_pack
    lsls r2, r2, #1
    orrs r2, r4
    orrs r2, r0
    bne pmlog_up
    lsls r2, r3, #31
    beq pmlog_pack
  pmlog_up:
    adds r3, #1
  pmlog_pack:
    movs r0, #133
    subs r0, r0, r1
    lsls r0, r0, #23
    adds r0, r0, r3
    mov r1, r12
    orrs r0, r1
    b pmlog_done
  pmlog_nan:
    ldr r1, =0x400000
    orrs r0, r1
    b pmlog_done
  pmlog_minf:
    ldr r0, =0xFF800000
    b pmlog_done
  pmlog_invalid:
    ldr r0, =0xFFC00000
    b pmlog_done
  pmlog_zero:
    movs r0, #0
  pmlog_done:
    pop {r5, r6, r7}
  EndASM
EndProcedure
CompilerElse
; The high word of the unsigned 64-bit product of two 32-bit words, from four
; 16 x 16 products. Every value is a 32-bit pattern; each statement stores one
; operation's result, so the bits are the same wherever .l is 32 bits.
Procedure.l PmTensorMulHi32(a.l, b.l)
  Protected alo.l
  Protected ahi.l
  Protected blo.l
  Protected bhi.l
  Protected p00.l
  Protected p01.l
  Protected p10.l
  Protected p11.l
  Protected mid.l
  Protected t.l
  Protected hi.l
  alo = a & $FFFF
  ahi = (a >> 16) & $FFFF
  blo = b & $FFFF
  bhi = (b >> 16) & $FFFF
  p00 = alo * blo
  p01 = alo * bhi
  p10 = ahi * blo
  p11 = ahi * bhi
  mid = (p00 >> 16) & $FFFF
  t = p01 & $FFFF
  mid = mid + t
  t = p10 & $FFFF
  mid = mid + t
  hi = (p01 >> 16) & $FFFF
  t = (p10 >> 16) & $FFFF
  hi = hi + t
  t = mid >> 16
  hi = hi + t
  hi = hi + p11
  ProcedureReturn hi
EndProcedure

; 1 when the unsigned word a is below the unsigned word b
Procedure.l PmTensorBelow32(a.l, b.l)
  Protected ua.l
  Protected ub.l
  ua = a ! $80000000
  ub = b ! $80000000
  If ua < ub
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; exp, correctly rounded, in exact 32-bit integer arithmetic (the bits of x in,
; the bits of the result out). x = (256 i + j) ln2/256 + r with 0 <= r < ln2/256
; (r to 2^-64, from ln2/256 to 2^-96); e^r - 1 = r + r^2/2 + r^3 (1/6 + r/24 +
; r^2/120) in Q64; the result 2^i * 2^(j/256) * e^r in Q62, rounded once to
; nearest-even at its own 24 bits (a subnormal result at its own position).
; Every binary32 argument was checked against a correctly rounded exp.
Procedure.l PmTensorExpBits(b.l)
  Protected a.l
  Protected neg.l
  Protected e.l
  Protected m.l
  Protected th.l
  Protected sh.l
  Protected k.l
  Protected s.l
  Protected x1.l
  Protected x2.l
  Protected kl0.l
  Protected kl1.l
  Protected kl2.l
  Protected c.l
  Protected c1.l
  Protected bw.l
  Protected rh.l
  Protected rl.l
  Protected al.l
  Protected ah.l
  Protected bh.l
  Protected r2l.l
  Protected r2h.l
  Protected v.l
  Protected w.l
  Protected q.l
  Protected t.l
  Protected cl.l
  Protected ch.l
  Protected pl.l
  Protected ph.l
  Protected j.l
  Protected i.l
  Protected tl.l
  Protected tt.l
  Protected yl.l
  Protected yh.l
  Protected p.l
  Protected biased.l
  Protected msk.l
  Protected remh.l
  Protected half.l
  Protected mm.l
  a = b & $7FFFFFFF
  If a > $7F800000
    ProcedureReturn b | $400000
  EndIf
  neg = 0
  If a <> b
    neg = 1
  EndIf
  If a = $7F800000
    If neg = 0
      ProcedureReturn $7F800000
    EndIf
    ProcedureReturn 0
  EndIf
  If a < $33000000
    ProcedureReturn $3F800000
  EndIf
  If neg = 0 And a >= $42B17218
    ProcedureReturn $7F800000
  EndIf
  If neg = 1 And a >= $42D00000
    ProcedureReturn 0
  EndIf
  e = a >> 23
  m = a & $7FFFFF
  m = m | $800000
  ; k = floor(|x| * 256/ln2), from 2^28/ln2 rounded down (up for a negative x,
  ; whose k is one more), so r is never negative
  If neg = 0
    th = PmTensorMulHi32(m, 387270501)
  Else
    th = PmTensorMulHi32(m, 387270502)
  EndIf
  sh = 138 - e
  k = 0
  If sh < 32
    k = th >> sh
  EndIf
  k = k + neg
  ; |x| * 2^96 modulo 2^96: words x2 x1 (the lowest is zero)
  s = e - 86
  If s >= 32
    s = s - 32
    x2 = m << s
    x1 = 0
  Else
    x1 = m << s
    s = 32 - s
    x2 = m >> s
  EndIf
  ; k * ln2/256 in Q96, modulo 2^96
  kl0 = k * $ABC9E3B3
  c = PmTensorMulHi32(k, $ABC9E3B3)
  kl1 = k * $F7D1CF79
  c1 = PmTensorMulHi32(k, $F7D1CF79)
  kl1 = kl1 + c
  c1 = c1 + PmTensorBelow32(kl1, c)
  kl2 = k * $00B17217
  kl2 = kl2 + c1
  ; r in Q64 (the Q96 difference without its lowest word)
  If neg = 0
    bw = 0
    If kl0 <> 0
      bw = 1
    EndIf
    rl = x1 - kl1
    c = PmTensorBelow32(x1, kl1)
    If rl = 0 And bw = 1
      c = 1
    EndIf
    rl = rl - bw
    rh = x2 - kl2
    rh = rh - c
  Else
    rl = kl1 - x1
    c = PmTensorBelow32(kl1, x1)
    rh = kl2 - x2
    rh = rh - c
  EndIf
  ; r^2/2 in Q64: r2h r2l
  al = rh * rh
  ah = PmTensorMulHi32(rh, rh)
  bh = PmTensorMulHi32(rh, rl)
  r2l = (al >> 1) & $7FFFFFFF
  t = ah << 31
  r2l = r2l | t
  r2h = ah >> 1
  r2l = r2l + bh
  r2h = r2h + PmTensorBelow32(r2l, bh)
  ; v = r in Q40, w = r^2/2 in Q50, q = r^3 in Q57
  v = rh << 8
  t = (rl >> 24) & $FF
  v = v | t
  w = r2h << 18
  t = (r2l >> 14) & $3FFFF
  w = w | t
  q = PmTensorMulHi32(w, v)
  ; c = 1/6 + r/24 + r^2/120 in Q32
  c = PmTensorMulHi32(v, 178956971)
  c = c >> 8
  t = PmTensorMulHi32(r2h, 71582788)
  c = c + t
  c = c + 715827883
  ; r^3 c in Q64: ch cl
  cl = q * c
  ch = PmTensorMulHi32(q, c)
  cl = (cl >> 25) & $7F
  t = ch << 7
  cl = cl | t
  ch = ch >> 25
  ; P = r + r^2/2 + r^3 c in Q64: ph pl
  pl = rl + r2l
  ph = rh + r2h
  ph = ph + PmTensorBelow32(pl, rl)
  t = pl
  pl = pl + cl
  ph = ph + ch
  ph = ph + PmTensorBelow32(pl, t)
  ; 2^(j/256) in Q62, k = 256 i + j
  If neg = 1
    k = 0 - k
  EndIf
  j = k & 255
  i = k >> 8
  j = j << 3
  tl = PeekL(?PmTensorExpTable + j)
  tt = PeekL(?PmTensorExpTable + j + 4)
  ; y = T + T P in Q62: yh yl
  yl = tt * ph
  yh = PmTensorMulHi32(tt, ph)
  t = yl
  yl = yl + tl
  yh = yh + tt
  yh = yh + PmTensorBelow32(yl, t)
  c = PmTensorMulHi32(tt, pl)
  t = yl
  yl = yl + c
  yh = yh + PmTensorBelow32(yl, t)
  c = PmTensorMulHi32(tl, ph)
  t = yl
  yl = yl + c
  yh = yh + PmTensorBelow32(yl, t)
  ; round once, at the result's own 24 bits
  p = 61
  If yh >= $40000000
    p = 62
  EndIf
  biased = i + p
  biased = biased + 65
  If biased >= 255
    ProcedureReturn $7F800000
  EndIf
  sh = p - 55
  If biased <= 0
    sh = sh + 1
    sh = sh - biased
  EndIf
  If sh >= 32
    ProcedureReturn 0
  EndIf
  mm = yh >> sh
  msk = 1 << sh
  msk = msk - 1
  remh = yh & msk
  t = sh - 1
  half = 1 << t
  If remh > half Or (remh = half And (yl <> 0 Or (mm & 1) <> 0))
    mm = mm + 1
  EndIf
  If biased <= 0
    ProcedureReturn mm
  EndIf
  t = biased << 23
  mm = mm - $800000
  ProcedureReturn t + mm
EndProcedure

; log, correctly rounded, in exact 32-bit integer arithmetic (the bits of x in,
; the bits of the result out). x = 2^E m; the top 8 bits of m's fraction pick
; c = C/1024 (C from a table), so r = c m - 1 = N/2^33 is EXACT, |r| <= 2^-8.
; log x = E' ln2 + T + log1p(r), where T = -log(c) (less ln2, and E' = E + 1,
; when m >= 1.414), and log1p(r) = r G, G = 1 - r/2 + r^2 (1/3 - r/4 + r^2/5),
; evaluated on |r| so every product is unsigned. (That degree is enough: every
; argument checks; without the r^2/5 term one argument, 41178FEB, rounds the
; other way.) The two
; buckets beside x = 1 have c = 1 and c = 1/2 exactly, so there T = 0 and the
; result is r G to its full relative precision. The sum is in Q88 (three
; words), rounded once to nearest-even at its own 24 bits.
; Every binary32 argument was checked against a correctly rounded log.
Procedure.l PmTensorLogBits(b.l)
  Protected a.l
  Protected e.l
  Protected mm.l
  Protected z.l
  Protected j.l
  Protected d.l
  Protected nn.l
  Protected neg.l
  Protected t.l
  Protected n2l.l
  Protected n2h.l
  Protected u.l
  Protected xl.l
  Protected xh.l
  Protected hl.l
  Protected hh.l
  Protected wl.l
  Protected wh.l
  Protected gl.l
  Protected gh.l
  Protected v0.l
  Protected v1.l
  Protected v2.l
  Protected c.l
  Protected p0.l
  Protected p1.l
  Protected p2.l
  Protected s0.l
  Protected s1.l
  Protected s2.l
  Protected k.l
  Protected sg.l
  a = b & $7FFFFFFF
  If a > $7F800000
    ProcedureReturn b | $400000
  EndIf
  If a = 0
    ProcedureReturn $FF800000
  EndIf
  If a <> b
    ProcedureReturn $FFC00000
  EndIf
  If a = $7F800000
    ProcedureReturn a
  EndIf
  If a = $3F800000
    ProcedureReturn 0
  EndIf
  e = a >> 23
  mm = a & $7FFFFF
  If e = 0
    ; a subnormal: its leading bit moved up to bit 23
    z = 1
    While (mm & $800000) = 0
      mm = mm << 1
      z = z - 1
    Wend
    e = z
  Else
    mm = mm | $800000
  EndIf
  e = e - 127
  j = mm >> 15
  j = j & 255
  d = 0
  If j >= 106
    d = 1
  EndIf
  e = e + d
  ; r = N/2^33 exactly: N is the low word of C m (C m - 2^33 is below 2^25)
  j = j << 2
  nn = PeekL(?PmTensorLogTable + j)
  nn = nn * mm
  neg = 0
  t = nn
  If nn < 0
    neg = 1
    t = 0 - nn
  EndIf
  ; t^2 (r^2 in Q66)
  n2l = t * t
  n2h = PmTensorMulHi32(t, t)
  ; r^2/5 in Q64: (t^2 (2^32/5)) / 2^66
  xl = n2h * 858993459
  xh = PmTensorMulHi32(n2h, 858993459)
  u = PmTensorMulHi32(n2l, 858993459)
  xl = xl + u
  xh = xh + PmTensorBelow32(xl, u)
  xl = (xl >> 2) & $3FFFFFFF
  u = xh << 30
  xl = xl | u
  xh = xh >> 2
  ; H = 1/3 -+ r/4 + r^2 H2 in Q64 (r/4 = t 2^29)
  hl = xl + $55555555
  hh = xh + $55555555
  hh = hh + PmTensorBelow32(hl, xl)
  u = t << 29
  v1 = t >> 3
  If neg = 0
    c = PmTensorBelow32(hl, u)
    hl = hl - u
    hh = hh - v1
    hh = hh - c
  Else
    hl = hl + u
    hh = hh + v1
    hh = hh + PmTensorBelow32(hl, u)
  EndIf
  ; W = r^2 H in Q64: (t^2 H) / 2^66
  wl = n2h * hh
  wh = PmTensorMulHi32(n2h, hh)
  u = PmTensorMulHi32(n2h, hl)
  wl = wl + u
  wh = wh + PmTensorBelow32(wl, u)
  u = PmTensorMulHi32(n2l, hh)
  wl = wl + u
  wh = wh + PmTensorBelow32(wl, u)
  wl = (wl >> 2) & $3FFFFFFF
  u = wh << 30
  wl = wl | u
  wh = wh >> 2
  ; |G - 1| = r/2 -+ W in Q64 (r/2 = t 2^30)
  gl = t << 30
  gh = t >> 2
  If neg = 0
    c = PmTensorBelow32(gl, wl)
    gl = gl - wl
    gh = gh - wh
    gh = gh - c
  Else
    gl = gl + wl
    gh = gh + wh
    gh = gh + PmTensorBelow32(gl, wl)
  EndIf
  ; t |G - 1| / 2^9 in Q88: v2 v1 v0
  v0 = t * gl
  v1 = PmTensorMulHi32(t, gl)
  u = t * gh
  v2 = PmTensorMulHi32(t, gh)
  v1 = v1 + u
  v2 = v2 + PmTensorBelow32(v1, u)
  v0 = (v0 >> 9) & $7FFFFF
  u = v1 << 23
  v0 = v0 | u
  v1 = (v1 >> 9) & $7FFFFF
  u = v2 << 23
  v1 = v1 | u
  v2 = v2 >> 9
  ; |log1p(r)| = |r| G in Q88: p2 p1 p0 (|r| = t 2^55)
  p1 = t << 23
  p2 = t >> 9
  If neg = 0
    p0 = 0 - v0
    c = 0
    If v0 <> 0
      c = 1
    EndIf
    u = PmTensorBelow32(p1, v1)
    p1 = p1 - v1
    If p1 = 0 And c = 1
      u = 1
    EndIf
    p1 = p1 - c
    p2 = p2 - v2
    p2 = p2 - u
  Else
    p0 = v0
    p1 = p1 + v1
    p2 = p2 + v2
    p2 = p2 + PmTensorBelow32(p1, v1)
  EndIf
  ; S = E' ln2 + T in Q88: s2 s1 s0 (ln2 = $B17217 F7D1CF79 ABC9E3B4)
  k = e
  If e < 0
    k = 0 - e
  EndIf
  s0 = k * $ABC9E3B4
  c = PmTensorMulHi32(k, $ABC9E3B4)
  s1 = k * $F7D1CF79
  u = PmTensorMulHi32(k, $F7D1CF79)
  s1 = s1 + c
  u = u + PmTensorBelow32(s1, c)
  s2 = k * $B17217
  s2 = s2 + u
  If e < 0
    ; negate the three words
    s0 = s0 ! $FFFFFFFF
    s1 = s1 ! $FFFFFFFF
    s2 = s2 ! $FFFFFFFF
    s0 = s0 + 1
    If s0 = 0
      s1 = s1 + 1
      If s1 = 0
        s2 = s2 + 1
      EndIf
    EndIf
  EndIf
  u = PeekL(?PmTensorLogTable + 1024 + j + j + j)
  s0 = s0 + u
  c = PmTensorBelow32(s0, u)
  u = PeekL(?PmTensorLogTable + 1028 + j + j + j)
  s1 = s1 + c
  c = PmTensorBelow32(s1, c)
  s1 = s1 + u
  c = c + PmTensorBelow32(s1, u)
  u = PeekL(?PmTensorLogTable + 1032 + j + j + j)
  s2 = s2 + c
  s2 = s2 + u
  ; S = S -+ |log1p(r)|
  If neg = 0
    s0 = s0 + p0
    c = PmTensorBelow32(s0, p0)
    s1 = s1 + c
    c = PmTensorBelow32(s1, c)
    s1 = s1 + p1
    c = c + PmTensorBelow32(s1, p1)
    s2 = s2 + c
    s2 = s2 + p2
  Else
    c = PmTensorBelow32(s0, p0)
    s0 = s0 - p0
    u = PmTensorBelow32(s1, p1)
    s1 = s1 - p1
    If s1 = 0 And c = 1
      u = 1
    EndIf
    s1 = s1 - c
    s2 = s2 - p2
    s2 = s2 - u
  EndIf
  ; the sign, then |S|
  sg = 0
  If s2 < 0
    sg = $80000000
    s0 = s0 ! $FFFFFFFF
    s1 = s1 ! $FFFFFFFF
    s2 = s2 ! $FFFFFFFF
    s0 = s0 + 1
    If s0 = 0
      s1 = s1 + 1
      If s1 = 0
        s2 = s2 + 1
      EndIf
    EndIf
  EndIf
  ; |S| is at least 2^64 (Q88), so its top bit is in s2: move it to bit 31
  k = 31
  If (s2 & $FFFF0000) = 0
    s2 = s2 << 16
    k = k - 16
  EndIf
  If (s2 & $FF000000) = 0
    s2 = s2 << 8
    k = k - 8
  EndIf
  If (s2 & $F0000000) = 0
    s2 = s2 << 4
    k = k - 4
  EndIf
  If (s2 & $C0000000) = 0
    s2 = s2 << 2
    k = k - 2
  EndIf
  If (s2 & $80000000) = 0
    s2 = s2 << 1
    k = k - 1
  EndIf
  ; the bits of s1 (and s0) that follow, by the same shift
  u = 31 - k
  If u > 0
    z = 32 - u
    c = (s1 >> z)
    t = 1 << u
    t = t - 1
    c = c & t
    s2 = s2 | c
    s1 = s1 << u
    c = s0 >> z
    c = c & t
    s1 = s1 | c
    s0 = s0 << u
  EndIf
  ; round once: s2 holds the 24 bits and the round bit
  mm = (s2 >> 8) & $FFFFFF
  If (s2 & $80) <> 0
    If (s2 & $7F) <> 0 Or s1 <> 0 Or s0 <> 0 Or (mm & 1) <> 0
      mm = mm + 1
    EndIf
  EndIf
  k = k + 102
  k = k << 23
  k = k + mm
  ProcedureReturn k | sg
EndProcedure
CompilerEndIf

