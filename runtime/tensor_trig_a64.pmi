; Correctly rounded AArch64 FP32 Sin/Cos, four/eight independent inputs.
; Each selected fdlibm polynomial keeps its reference binary64 Horner chain,
; three-part pi/2 reduction, final operations and 1024-ULP midpoint guard.
; Paired coefficient tables hold sine in bytes0..7 and cosine in bytes8..15;
; TBL selects the same coefficient bits independently for every lane.
; Eight-input scheduling interleaves four lane pairs to hide dependencies.
; Exceptional/large/near-midpoint groups and short suffixes use the four-input
; helper, which retains the original correctly rounded scalar fallback.
; Sin(-0) preserves its sign; unsupported operations still refuse, even empty.
; The eight-input body saves/restores full q8-q15 in128bytes. Its nested
; four-input helper uses caller-saved registers only. Worker stacks are4KiB.
; .word contains explicit FCVTL/FCVTN and single-table TBL encodings.
; FPCR=0 is established by EnableFloatingPoint: nearest-even, gradual underflow.

Procedure PmTensorTrigTableA64(*src.i, *dst.i, count.i, op.i)
  ASM
    ; The generated receiver homes these four parameters before entering
    ; the body and preserves x0-x3.  Consume the live entry ABI values.
    ;
    ; The op is decided BEFORE the count.  Every op this kernel does not own
    ; goes to PmTensorTrig, which owns the op set and refuses what is not in
    ; it; leaving early on an empty request would skip that refusal and let a
    ; wrongly generated program run on silently.
    cmp x3, #1
    b.hi pmoTrigTableFallback
    cmp x2, #0
    b.le pmoTrigTableDone

pmoTrigTableSetup:
    adrp x9, pmoTrigTabletwoopi
    add x9, x9, #:lo12:pmoTrigTabletwoopi
    ld1 {v16.2d}, [x9]
    adrp x9, pmoTrigTablep1
    add x9, x9, #:lo12:pmoTrigTablep1
    ld1 {v17.2d}, [x9]
    adrp x9, pmoTrigTablep2
    add x9, x9, #:lo12:pmoTrigTablep2
    ld1 {v27.2d}, [x9]
    adrp x9, pmoTrigTablep3
    add x9, x9, #:lo12:pmoTrigTablep3
    ld1 {v28.2d}, [x9]
    adrp x9, pmoTrigTablepair1
    add x9, x9, #:lo12:pmoTrigTablepair1
    ld1 {v20.2d}, [x9]
    adrp x9, pmoTrigTablepair2
    add x9, x9, #:lo12:pmoTrigTablepair2
    ld1 {v21.2d}, [x9]
    adrp x9, pmoTrigTablepair3
    add x9, x9, #:lo12:pmoTrigTablepair3
    ld1 {v22.2d}, [x9]
    adrp x9, pmoTrigTablepair4
    add x9, x9, #:lo12:pmoTrigTablepair4
    ld1 {v23.2d}, [x9]
    adrp x9, pmoTrigTablepair5
    add x9, x9, #:lo12:pmoTrigTablepair5
    ld1 {v24.2d}, [x9]
    adrp x9, pmoTrigTablecheck
    add x9, x9, #:lo12:pmoTrigTablecheck
    ld1 {v30.2d}, [x9]
    adrp x9, pmoTrigTables6c6
    add x9, x9, #:lo12:pmoTrigTables6c6
    ld1 {v31.2d}, [x9]
    adrp x9, pmoTrigTableindex
    add x9, x9, #:lo12:pmoTrigTableindex
    ld1 {v29.2d}, [x9]
    movz x11, #16352, lsl #48
    movz x12, #16368, lsl #48

pmoTrigTableLoop:
    cmp x2, #4
    b.lt pmoTrigTableFallback
    ld1 {v7.4s}, [x0]
    ; |x| <= 2^20, finite: (bits << 1) <= $93000000 unsigned (NaN and the
    ; infinities are above it)
    shl v6.4s, v7.4s, #1
    movi v5.4s, #0x93, lsl #24
    cmhi v6.4s, v6.4s, v5.4s
    umaxv s6, v6.4s
    fmov w9, s6
    cbnz w9, pmoTrigTableGroup
    .word 0x0E6178E0
    .word 0x4E6178E1
    fmul v2.2d, v0.2d, v16.2d
    fmul v3.2d, v1.2d, v16.2d
    frintn v2.2d, v2.2d
    frintn v3.2d, v3.2d
    fmls v0.2d, v2.2d, v17.2d
    fmls v1.2d, v3.2d, v17.2d
    fmls v0.2d, v2.2d, v27.2d
    fmls v1.2d, v3.2d, v27.2d
    fmls v0.2d, v2.2d, v28.2d
    fmls v1.2d, v3.2d, v28.2d
    fcvtzs v2.2d, v2.2d
    fcvtzs v3.2d, v3.2d
    dup v4.2d, x3
    add v2.2d, v2.2d, v4.2d
    add v3.2d, v3.2d, v4.2d
    mov v25.16b, v2.16b
    mov v26.16b, v3.16b
    fmul v4.2d, v0.2d, v0.2d
    fmul v5.2d, v1.2d, v1.2d
    shl v18.2d, v2.2d, #63
    sshr v18.2d, v18.2d, #63
    shl v19.2d, v3.2d, #63
    sshr v19.2d, v19.2d, #63
    movi v6.16b, #8
    and v18.16b, v18.16b, v6.16b
    and v19.16b, v19.16b, v6.16b
    orr v18.16b, v18.16b, v29.16b
    orr v19.16b, v19.16b, v29.16b
    .word 0x4E1203E6
    .word 0x4E1303E7
    .word 0x4E120302
    .word 0x4E130303
    fmla v2.2d, v6.2d, v4.2d
    fmla v3.2d, v7.2d, v5.2d
    .word 0x4E1202E6
    .word 0x4E1302E7
    fmla v6.2d, v2.2d, v4.2d
    fmla v7.2d, v3.2d, v5.2d
    .word 0x4E1202C2
    .word 0x4E1302C3
    fmla v2.2d, v6.2d, v4.2d
    fmla v3.2d, v7.2d, v5.2d
    .word 0x4E1202A6
    .word 0x4E1302A7
    fmla v6.2d, v2.2d, v4.2d
    fmla v7.2d, v3.2d, v5.2d
    .word 0x4E120282
    .word 0x4E130283
    fmla v2.2d, v6.2d, v4.2d
    fmla v3.2d, v7.2d, v5.2d
    fmul v2.2d, v2.2d, v4.2d
    fmul v3.2d, v3.2d, v5.2d
    fmul v6.2d, v2.2d, v0.2d
    fmul v7.2d, v3.2d, v1.2d
    fadd v0.2d, v6.2d, v0.2d
    fadd v1.2d, v7.2d, v1.2d
    fmul v2.2d, v2.2d, v4.2d
    fmul v3.2d, v3.2d, v5.2d
    dup v6.2d, x11
    dup v7.2d, x11
    fmul v6.2d, v6.2d, v4.2d
    fmul v7.2d, v7.2d, v5.2d
    fsub v2.2d, v2.2d, v6.2d
    fsub v3.2d, v3.2d, v7.2d
    dup v6.2d, x12
    fadd v2.2d, v2.2d, v6.2d
    fadd v3.2d, v3.2d, v6.2d
    mov v4.16b, v25.16b
    mov v5.16b, v26.16b
    shl v6.2d, v4.2d, #63
    sshr v6.2d, v6.2d, #63
    bsl v6.16b, v2.16b, v0.16b
    shl v7.2d, v5.2d, #63
    sshr v7.2d, v7.2d, #63
    bsl v7.16b, v3.16b, v1.16b
    shl v4.2d, v4.2d, #62
    ushr v4.2d, v4.2d, #63
    shl v4.2d, v4.2d, #63
    eor v6.16b, v6.16b, v4.16b
    shl v5.2d, v5.2d, #62
    ushr v5.2d, v5.2d, #63
    shl v5.2d, v5.2d, #63
    eor v7.16b, v7.16b, v5.16b
    shl v0.2d, v6.2d, #35
    shl v1.2d, v7.2d, #35
    fneg v0.2d, v0.2d
    fneg v1.2d, v1.2d
    abs v0.2d, v0.2d
    abs v1.2d, v1.2d
    cmhi v0.2d, v30.2d, v0.2d
    cmhi v1.2d, v30.2d, v1.2d
    orr v0.16b, v0.16b, v1.16b
    addp v0.2d, v0.2d, v0.2d
    fmov x9, d0
    cbnz x9, pmoTrigTableGroup
    .word 0x0E6168C0
    .word 0x4E6168E0
    mov v7.16b, v0.16b
    ; Sin(-0) is -0: r = -0 - 0 pi/2 is +0 in binary64
    cbnz x3, pmoTrigTableStore
    ld1 {v0.4s}, [x0]
    fcmeq v2.4s, v0.4s, #0.0
    bsl v2.16b, v0.16b, v7.16b
    mov v7.16b, v2.16b
pmoTrigTableStore:
    st1 {v7.4s}, [x1]
    add x0, x0, #16
    add x1, x1, #16
    sub x2, x2, #4
    b pmoTrigTableLoop

pmoTrigTableGroup:
    ; these four by the integer method; the call keeps nothing in the
    ; caller-saved registers, so the constants are loaded again after it
    stp x0, x1, [sp, #-32]!
    stp x2, x3, [sp, #16]
    movz x2, #4
    bl pmtensortrig
    ldp x2, x3, [sp, #16]
    ldp x0, x1, [sp], #32
    add x0, x0, #16
    add x1, x1, #16
    sub x2, x2, #4
    cmp x2, #0
    b.le pmoTrigTableDone
    b pmoTrigTableSetup

pmoTrigTableFallback:
    ; x0/x1/x2/x3 always describe the untouched remaining suffix.  The
    ; procedure prologue saved x30, so this call is safe from inside ASM.
    bl pmtensortrig
pmoTrigTableDone:
  EndASM
EndProcedure

