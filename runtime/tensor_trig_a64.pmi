; Independent binary64 lane pairs are interleaved. Each lane selects its
; sine or cosine Horner coefficients before evaluation, avoiding the unused
; polynomial. Its arithmetic order and the midpoint fallback are unchanged.
; x4/x5 preserve reduction constants while v18/v19 hold quadrant masks.
; AArch64 FP32 Sin/Cos tensor kernel, correctly rounded (C6c-3).
;
; Four arguments at a time, as two pairs of binary64 lanes: |x| 2/pi rounded to
; the nearest integer n, r = x - n pi/2 with pi/2 in three binary64 parts
; (fused multiply-subtract, so the first two are exact), then fdlibm's
; minimax polynomial selected for each lane on |r| <= pi/4,
; choosing sine or cosine coefficients by (n + op) mod 4. Each binary64 result is then tested: if the
; bits below binary32 precision lie within 1024 binary64 units of a rounding
; midpoint, the group is NOT rounded here. That group, and any group with an
; argument beyond 2^20 in magnitude, an infinity or a NaN, goes to
; PmTensorTrig - the correctly rounded integer method - so every result is the
; correctly rounded binary32, the same bits as the scalar path and as the
; Windows program. The original two-polynomial kernel was checked over every
; binary32 argument against correctly rounded sin and cos. The selected-chain
; version preserves that chain exactly; real-Pi boundary/random tests and full
; model waveform comparisons additionally check the implementation.
;
; This assembler has neither FCVTL/FCVTN nor FMOV with an immediate: the four
; conversions are written as their encodings (.word), and 0.5 and 1.0 are
; broadcast from x11 and x12.
;
; EnableFloatingPoint establishes FPCR=0 before generated code runs: nearest
; even, gradual underflow, and default-NaN disabled; FCVTN rounds to nearest
; even. Only caller-saved SIMD registers are touched - v0..v7 and v16..v31 -
; for the reason tensor_fp32_neon.pmi gives: an ordinary A64 procedure
; prologue here saves x30 and nothing else, so a kernel that wrote v8..v15
; would silently corrupt the low halves the moment Forge starts keeping
; language float values in FP/SIMD registers across a call.

Procedure PmTensorTrigA64(*src.i, *dst.i, count.i, op.i)
  ASM
    ; The generated receiver homes these four parameters before entering
    ; the body and preserves x0-x3.  Consume the live entry ABI values.
    ;
    ; The op is decided BEFORE the count.  Every op this kernel does not own
    ; goes to PmTensorTrig, which owns the op set and refuses what is not in
    ; it; leaving early on an empty request would skip that refusal and let a
    ; wrongly generated program run on silently.
    cmp x3, #1
    b.hi pmoTrigSelectedFallback
    cmp x2, #0
    b.le pmoTrigSelectedDone

pmoTrigSelectedSetup:
    adrp x9, pmoTrigSelectedtwoopi
    add x9, x9, #:lo12:pmoTrigSelectedtwoopi
    ld1 {v16.2d}, [x9]
    adrp x9, pmoTrigSelectedp1
    add x9, x9, #:lo12:pmoTrigSelectedp1
    ld1 {v17.2d}, [x9]
    adrp x9, pmoTrigSelectedp2
    add x9, x9, #:lo12:pmoTrigSelectedp2
    ld1 {v18.2d}, [x9]
    adrp x9, pmoTrigSelectedp3
    add x9, x9, #:lo12:pmoTrigSelectedp3
    ld1 {v19.2d}, [x9]
    adrp x9, pmoTrigSelecteds1
    add x9, x9, #:lo12:pmoTrigSelecteds1
    ld1 {v20.2d}, [x9]
    adrp x9, pmoTrigSelecteds2
    add x9, x9, #:lo12:pmoTrigSelecteds2
    ld1 {v21.2d}, [x9]
    adrp x9, pmoTrigSelecteds3
    add x9, x9, #:lo12:pmoTrigSelecteds3
    ld1 {v22.2d}, [x9]
    adrp x9, pmoTrigSelecteds4
    add x9, x9, #:lo12:pmoTrigSelecteds4
    ld1 {v23.2d}, [x9]
    adrp x9, pmoTrigSelecteds5
    add x9, x9, #:lo12:pmoTrigSelecteds5
    ld1 {v24.2d}, [x9]
    adrp x9, pmoTrigSelectedc1
    add x9, x9, #:lo12:pmoTrigSelectedc1
    ld1 {v25.2d}, [x9]
    adrp x9, pmoTrigSelectedc2
    add x9, x9, #:lo12:pmoTrigSelectedc2
    ld1 {v26.2d}, [x9]
    adrp x9, pmoTrigSelectedc3
    add x9, x9, #:lo12:pmoTrigSelectedc3
    ld1 {v27.2d}, [x9]
    adrp x9, pmoTrigSelectedc4
    add x9, x9, #:lo12:pmoTrigSelectedc4
    ld1 {v28.2d}, [x9]
    adrp x9, pmoTrigSelectedc5
    add x9, x9, #:lo12:pmoTrigSelectedc5
    ld1 {v29.2d}, [x9]
    adrp x9, pmoTrigSelectedcheck
    add x9, x9, #:lo12:pmoTrigSelectedcheck
    ld1 {v30.2d}, [x9]
    adrp x9, pmoTrigSelecteds6c6
    add x9, x9, #:lo12:pmoTrigSelecteds6c6
    ld1 {v31.2d}, [x9]
    umov x4, v18.d[0]
    umov x5, v19.d[0]
    movz x11, #16352, lsl #48
    movz x12, #16368, lsl #48

pmoTrigSelectedLoop:
    cmp x2, #4
    b.lt pmoTrigSelectedFallback
    ld1 {v7.4s}, [x0]
    ; |x| <= 2^20, finite: (bits << 1) <= $93000000 unsigned (NaN and the
    ; infinities are above it)
    shl v6.4s, v7.4s, #1
    movi v5.4s, #0x93, lsl #24
    cmhi v6.4s, v6.4s, v5.4s
    umaxv s6, v6.4s
    fmov w9, s6
    cbnz w9, pmoTrigSelectedGroup
    .word 0x0E6178E0
    .word 0x4E6178E1
    fmul v2.2d, v0.2d, v16.2d
    fmul v3.2d, v1.2d, v16.2d
    frintn v2.2d, v2.2d
    frintn v3.2d, v3.2d
    fmls v0.2d, v2.2d, v17.2d
    fmls v1.2d, v3.2d, v17.2d
    fmls v0.2d, v2.2d, v18.2d
    fmls v1.2d, v3.2d, v18.2d
    fmls v0.2d, v2.2d, v19.2d
    fmls v1.2d, v3.2d, v19.2d
    fcvtzs v2.2d, v2.2d
    fcvtzs v3.2d, v3.2d
    dup v4.2d, x3
    add v2.2d, v2.2d, v4.2d
    add v3.2d, v3.2d, v4.2d
    umov x13, v2.d[0]
    umov x14, v2.d[1]
    umov x15, v3.d[0]
    umov x16, v3.d[1]
    fmul v4.2d, v0.2d, v0.2d
    fmul v5.2d, v1.2d, v1.2d
    fmov d18, x13
    ins v18.d[1], x14
    fmov d19, x15
    ins v19.d[1], x16
    shl v18.2d, v18.2d, #63
    sshr v18.2d, v18.2d, #63
    shl v19.2d, v19.2d, #63
    sshr v19.2d, v19.2d, #63
    dup v2.2d, v31.d[0]
    dup v3.2d, v31.d[1]
    mov v6.16b, v18.16b
    mov v7.16b, v19.16b
    bsl v6.16b, v3.16b, v2.16b
    bsl v7.16b, v3.16b, v2.16b
    mov v2.16b, v18.16b
    bsl v2.16b, v29.16b, v24.16b
    mov v3.16b, v19.16b
    bsl v3.16b, v29.16b, v24.16b
    fmla v2.2d, v6.2d, v4.2d
    fmla v3.2d, v7.2d, v5.2d
    mov v6.16b, v18.16b
    bsl v6.16b, v28.16b, v23.16b
    mov v7.16b, v19.16b
    bsl v7.16b, v28.16b, v23.16b
    fmla v6.2d, v2.2d, v4.2d
    fmla v7.2d, v3.2d, v5.2d
    mov v2.16b, v18.16b
    bsl v2.16b, v27.16b, v22.16b
    mov v3.16b, v19.16b
    bsl v3.16b, v27.16b, v22.16b
    fmla v2.2d, v6.2d, v4.2d
    fmla v3.2d, v7.2d, v5.2d
    mov v6.16b, v18.16b
    bsl v6.16b, v26.16b, v21.16b
    mov v7.16b, v19.16b
    bsl v7.16b, v26.16b, v21.16b
    fmla v6.2d, v2.2d, v4.2d
    fmla v7.2d, v3.2d, v5.2d
    mov v2.16b, v18.16b
    bsl v2.16b, v25.16b, v20.16b
    mov v3.16b, v19.16b
    bsl v3.16b, v25.16b, v20.16b
    fmla v2.2d, v6.2d, v4.2d
    fmla v3.2d, v7.2d, v5.2d
    fmul v2.2d, v2.2d, v4.2d
    fmul v3.2d, v3.2d, v5.2d
    fmul v6.2d, v2.2d, v0.2d
    fmul v7.2d, v3.2d, v1.2d
    fadd v0.2d, v6.2d, v0.2d
    fadd v1.2d, v7.2d, v1.2d
    fmul v2.2d, v2.2d, v4.2d
    fmul v3.2d, v3.2d, v5.2d
    dup v6.2d, x11
    dup v7.2d, x11
    fmul v6.2d, v6.2d, v4.2d
    fmul v7.2d, v7.2d, v5.2d
    fsub v2.2d, v2.2d, v6.2d
    fsub v3.2d, v3.2d, v7.2d
    dup v6.2d, x12
    fadd v2.2d, v2.2d, v6.2d
    fadd v3.2d, v3.2d, v6.2d
    dup v18.2d, x4
    dup v19.2d, x5
    fmov d4, x13
    ins v4.d[1], x14
    fmov d5, x15
    ins v5.d[1], x16
    shl v6.2d, v4.2d, #63
    sshr v6.2d, v6.2d, #63
    bsl v6.16b, v2.16b, v0.16b
    shl v7.2d, v5.2d, #63
    sshr v7.2d, v7.2d, #63
    bsl v7.16b, v3.16b, v1.16b
    shl v4.2d, v4.2d, #62
    ushr v4.2d, v4.2d, #63
    shl v4.2d, v4.2d, #63
    eor v6.16b, v6.16b, v4.16b
    shl v5.2d, v5.2d, #62
    ushr v5.2d, v5.2d, #63
    shl v5.2d, v5.2d, #63
    eor v7.16b, v7.16b, v5.16b
    shl v0.2d, v6.2d, #35
    shl v1.2d, v7.2d, #35
    fneg v0.2d, v0.2d
    fneg v1.2d, v1.2d
    abs v0.2d, v0.2d
    abs v1.2d, v1.2d
    cmhi v0.2d, v30.2d, v0.2d
    cmhi v1.2d, v30.2d, v1.2d
    orr v0.16b, v0.16b, v1.16b
    addp v0.2d, v0.2d, v0.2d
    fmov x9, d0
    cbnz x9, pmoTrigSelectedGroup
    .word 0x0E6168C0
    .word 0x4E6168E0
    mov v7.16b, v0.16b
    ; Sin(-0) is -0: r = -0 - 0 pi/2 is +0 in binary64
    cbnz x3, pmoTrigSelectedStore
    ld1 {v0.4s}, [x0]
    fcmeq v2.4s, v0.4s, #0.0
    bsl v2.16b, v0.16b, v7.16b
    mov v7.16b, v2.16b
pmoTrigSelectedStore:
    st1 {v7.4s}, [x1]
    add x0, x0, #16
    add x1, x1, #16
    sub x2, x2, #4
    b pmoTrigSelectedLoop

pmoTrigSelectedGroup:
    ; these four by the integer method; the call keeps nothing in the
    ; caller-saved registers, so the constants are loaded again after it
    stp x0, x1, [sp, #-32]!
    stp x2, x3, [sp, #16]
    movz x2, #4
    bl pmtensortrig
    ldp x2, x3, [sp, #16]
    ldp x0, x1, [sp], #32
    add x0, x0, #16
    add x1, x1, #16
    sub x2, x2, #4
    cmp x2, #0
    b.le pmoTrigSelectedDone
    b pmoTrigSelectedSetup

pmoTrigSelectedFallback:
    ; x0/x1/x2/x3 always describe the untouched remaining suffix.  The
    ; procedure prologue saved x30, so this call is safe from inside ASM.
    bl pmtensortrig
pmoTrigSelectedDone:
  EndASM
EndProcedure

