; ======================================================================
; tensor_ops.pmi - kernels for the operators added to complete the ONNX
; operator set: elementwise functions, variadic and broadcasting binary
; operators, pooling, reductions, index and data-movement operators.
; ----------------------------------------------------------------------
; ONE SOURCE FOR EVERY TARGET. This file is written in the subset both
; dialects accept and is included, unchanged, by the Windows and the
; portable model programs (Pi 4, UNO Q, Pico, Pico 2), on both the
; fixed-shape and the runtime-dimension path. There is no second copy.
;
; THE NUMERICAL CONTRACT. Every floating-point step is ONE binary32
; operation (+, -, *, / with a correctly rounded result), an exact
; conversion of an integer below 2^24, an exact operation on the bits, or a
; comparison. No library function is called: the targets' Exp, Log and Sqr
; differ, and so would the answers. The functions a kernel needs (exp, log,
; log1p, expm1, tanh, erf, sqrt) are defined below as fixed sequences of
; those steps, so one input gives the same bits on every target. Accuracy
; against the true function, measured over the binary32 range the kernels
; use (docs/VALIDATION.md): exp 1.1, expm1 1.9, log 2.6, log1p 3.5, tanh
; 1.9, erf 0.8 units in the last place; sqrt is correctly rounded.
;
; Each kernel names the ONNX operator section it implements
; (https://onnx.ai/onnx/operators/). Kernels take byte addresses and do no
; shape inference: the fixed-shape emitter (onnx_emit_ops.pbi) and the
; runtime-dimension wrappers (tensor_dynamic_ops.pmi) have checked shapes,
; element types and attributes and filled the parameter arrays below.
;
; Element kinds are ONNX TensorProto codes: 1 FLOAT (4 bytes), 6 INT32 (4),
; 7 INT64 (8), 9 BOOL (1). INT64 goes through PmTensorGetI64 and
; PmTensorPutI64, so a 32-bit target clears PmTensorInt64Ok for a value
; outside its checked range instead of computing a different number.
;
; The program defines #PMO_OPS_INT32 before including this file: 1 where
; the native integer is 32 bits (Pico, Pico 2), 0 where it is 64.
; ======================================================================

; Parameter arrays, filled by the caller before a kernel runs. A kernel
; reads them and leaves them as they were; the scratch arrays after them
; belong to the kernels.
Global Dim PmOpDY.i(8)
Global Dim PmOpDA.i(8)
Global Dim PmOpDB.i(8)
Global Dim PmOpI.i(96)
Global Dim PmOpF.f(8)
Global Dim PmOpAddr.i(16)
Global Dim PmOpDN.i(136)
Global Dim PmOpN.i(16)
Global Dim PmOpStride.i(136)
Global Dim PmOpCoord.i(8)
Global Dim PmOpOffset.i(16)
Global PmOpStatus.i

; Constants, loaded from their bit patterns once.
Global PmOpReady.i
Global PmOpScratchF.f
Global PmOpOne.f
Global PmOpHalf.f
Global PmOpTwo.f
Global PmOpInvLn2.f
Global PmOpLn2Hi.f
Global PmOpLn2Lo.f
Global PmOpMagic.f
Global PmOpSqrt2.f
Global PmOpInfinity.f
Global PmOpExpHi.f
Global PmOpExpLo.f
Global PmOpExpm1Edge.f
Global PmOpNine.f
Global PmOpSixth.f
Global PmOpInvSqrt2.f
Global PmOpSqrt2OverPi.f
Global PmOpGeluCubic.f
Global Dim PmOpInvFact.f(12)
Global Dim PmOpLogC.f(8)
Global Dim PmOpErfPP.f(5)
Global Dim PmOpErfQQ.f(6)
Global Dim PmOpErfPA.f(7)
Global Dim PmOpErfQA.f(7)
Global Dim PmOpErfRA.f(8)
Global Dim PmOpErfSA.f(9)
Global Dim PmOpErfRB.f(7)
Global Dim PmOpErfSB.f(8)
Global PmOpErx.f
Global PmOpEfx.f
Global PmOpErfTiny.f
Global PmOpErfSmall.f
Global PmOpErfMid.f
Global PmOpErfBig.f
Global PmOpErfSplit.f
Global PmOpErfBias.f

Procedure PmOpSetBits(address.i, bits.i)
  PokeL(address, bits)
EndProcedure

Procedure PmOpInit()
  If PmOpReady <> 0
    ProcedureReturn
  EndIf
  PmOpSetBits(@PmOpOne, $3F800000)
  PmOpSetBits(@PmOpHalf, $3F000000)
  PmOpSetBits(@PmOpTwo, $40000000)
  PmOpSetBits(@PmOpInvLn2, $3FB8AA3B)
  PmOpSetBits(@PmOpLn2Hi, $3F317200)
  PmOpSetBits(@PmOpLn2Lo, $35BFBE8E)
  PmOpSetBits(@PmOpMagic, $4B400000)
  PmOpSetBits(@PmOpSqrt2, $3FB504F3)
  PmOpSetBits(@PmOpInfinity, $7F800000)
  PmOpSetBits(@PmOpExpHi, $42B17218)
  PmOpSetBits(@PmOpExpLo, $C2CFF1B5)
  PmOpSetBits(@PmOpExpm1Edge, $3F317218)
  PmOpSetBits(@PmOpNine, $41100000)
  PmOpSetBits(@PmOpSixth, $3E2AAAAB)
  PmOpSetBits(@PmOpInvSqrt2, $3F3504F3)
  PmOpSetBits(@PmOpSqrt2OverPi, $3F4C422A)
  PmOpSetBits(@PmOpGeluCubic, $3D372713)
  ; 1/k! for k = 0..11
  PmOpSetBits(@PmOpInvFact(0), $3F800000)
  PmOpSetBits(@PmOpInvFact(1), $3F800000)
  PmOpSetBits(@PmOpInvFact(2), $3F000000)
  PmOpSetBits(@PmOpInvFact(3), $3E2AAAAB)
  PmOpSetBits(@PmOpInvFact(4), $3D2AAAAB)
  PmOpSetBits(@PmOpInvFact(5), $3C088889)
  PmOpSetBits(@PmOpInvFact(6), $3AB60B61)
  PmOpSetBits(@PmOpInvFact(7), $39500D01)
  PmOpSetBits(@PmOpInvFact(8), $37D00D01)
  PmOpSetBits(@PmOpInvFact(9), $3638EF1D)
  PmOpSetBits(@PmOpInvFact(10), $3493F27E)
  PmOpSetBits(@PmOpInvFact(11), $32D7322B)
  ; 2/(2k+1) for k = 0..7, the atanh series of log
  PmOpSetBits(@PmOpLogC(0), $40000000)
  PmOpSetBits(@PmOpLogC(1), $3F2AAAAB)
  PmOpSetBits(@PmOpLogC(2), $3ECCCCCD)
  PmOpSetBits(@PmOpLogC(3), $3E924925)
  PmOpSetBits(@PmOpLogC(4), $3E638E39)
  PmOpSetBits(@PmOpLogC(5), $3E3A2E8C)
  PmOpSetBits(@PmOpLogC(6), $3E1D89D9)
  PmOpSetBits(@PmOpLogC(7), $3E088889)
  ; erf: the coefficients of fdlibm's s_erff.c (Sun Microsystems), in binary32
  PmOpSetBits(@PmOpErx, $3F58560B)
  PmOpSetBits(@PmOpEfx, $3E0375D4)
  PmOpSetBits(@PmOpErfPP(0), $3E0375D4)
  PmOpSetBits(@PmOpErfPP(1), $BEA66BEB)
  PmOpSetBits(@PmOpErfPP(2), $BCE9528F)
  PmOpSetBits(@PmOpErfPP(3), $BBBD1489)
  PmOpSetBits(@PmOpErfPP(4), $B7C756B1)
  PmOpSetBits(@PmOpErfQQ(0), $3F800000)
  PmOpSetBits(@PmOpErfQQ(1), $3ECBBBCE)
  PmOpSetBits(@PmOpErfQQ(2), $3D852A63)
  PmOpSetBits(@PmOpErfQQ(3), $3BA68116)
  PmOpSetBits(@PmOpErfQQ(4), $390AEE49)
  PmOpSetBits(@PmOpErfQQ(5), $B684E21A)
  PmOpSetBits(@PmOpErfPA(0), $BB1ACDC6)
  PmOpSetBits(@PmOpErfPA(1), $3ED46805)
  PmOpSetBits(@PmOpErfPA(2), $BEBE9208)
  PmOpSetBits(@PmOpErfPA(3), $3EA2FE54)
  PmOpSetBits(@PmOpErfPA(4), $BDE31CC2)
  PmOpSetBits(@PmOpErfPA(5), $3D1151B3)
  PmOpSetBits(@PmOpErfPA(6), $BB0DF9C0)
  PmOpSetBits(@PmOpErfQA(0), $3F800000)
  PmOpSetBits(@PmOpErfQA(1), $3DD9F331)
  PmOpSetBits(@PmOpErfQA(2), $3F0A5785)
  PmOpSetBits(@PmOpErfQA(3), $3D931AE7)
  PmOpSetBits(@PmOpErfQA(4), $3E013307)
  PmOpSetBits(@PmOpErfQA(5), $3C5F6E13)
  PmOpSetBits(@PmOpErfQA(6), $3C445AA3)
  PmOpSetBits(@PmOpErfRA(0), $BC21A093)
  PmOpSetBits(@PmOpErfRA(1), $BF31A0B7)
  PmOpSetBits(@PmOpErfRA(2), $C128F022)
  PmOpSetBits(@PmOpErfRA(3), $C2798057)
  PmOpSetBits(@PmOpErfRA(4), $C322658C)
  PmOpSetBits(@PmOpErfRA(5), $C3389AE7)
  PmOpSetBits(@PmOpErfRA(6), $C2A2932B)
  PmOpSetBits(@PmOpErfRA(7), $C11D077E)
  PmOpSetBits(@PmOpErfSA(0), $3F800000)
  PmOpSetBits(@PmOpErfSA(1), $419D35CE)
  PmOpSetBits(@PmOpErfSA(2), $4309A863)
  PmOpSetBits(@PmOpErfSA(3), $43D9486F)
  PmOpSetBits(@PmOpErfSA(4), $442158C9)
  PmOpSetBits(@PmOpErfSA(5), $43D6810B)
  PmOpSetBits(@PmOpErfSA(6), $42D9451F)
  PmOpSetBits(@PmOpErfSA(7), $40D23F7C)
  PmOpSetBits(@PmOpErfSA(8), $BD777F97)
  PmOpSetBits(@PmOpErfRB(0), $BC21A092)
  PmOpSetBits(@PmOpErfRB(1), $BF4C9DD4)
  PmOpSetBits(@PmOpErfRB(2), $C18E104B)
  PmOpSetBits(@PmOpErfRB(3), $C320A2EA)
  PmOpSetBits(@PmOpErfRB(4), $C41F6441)
  PmOpSetBits(@PmOpErfRB(5), $C480230B)
  PmOpSetBits(@PmOpErfRB(6), $C3F1C275)
  PmOpSetBits(@PmOpErfSB(0), $3F800000)
  PmOpSetBits(@PmOpErfSB(1), $41F2B459)
  PmOpSetBits(@PmOpErfSB(2), $43A2E571)
  PmOpSetBits(@PmOpErfSB(3), $44C01759)
  PmOpSetBits(@PmOpErfSB(4), $4547FDBB)
  PmOpSetBits(@PmOpErfSB(5), $451F90CE)
  PmOpSetBits(@PmOpErfSB(6), $43ED43A7)
  PmOpSetBits(@PmOpErfSB(7), $C1B38712)
  PmOpSetBits(@PmOpErfTiny, $31800000)
  PmOpSetBits(@PmOpErfSmall, $3F580000)
  PmOpSetBits(@PmOpErfMid, $3FA00000)
  PmOpSetBits(@PmOpErfBig, $40C00000)
  PmOpSetBits(@PmOpErfSplit, $4036DB6E)
  PmOpSetBits(@PmOpErfBias, $3F100000)
  PmOpReady = 1
EndProcedure

; ----------------------------------------------------------------------
; Bits and exact helpers. PmOpBits returns the 32 bits of a binary32 value
; masked to 32 bits; only masked fields and the sign bit (b & $80000000)
; are ever compared, so the width of the native integer does not matter.
; ----------------------------------------------------------------------
Procedure.i PmOpBits(x.f)
  PmOpScratchF = x
  ProcedureReturn PeekL(@PmOpScratchF) & $FFFFFFFF
EndProcedure

Procedure.f PmOpFromBits(b.i)
  PokeL(@PmOpScratchF, b)
  ProcedureReturn PmOpScratchF
EndProcedure

Procedure.i PmOpIsNan(x.f)
  If (PmOpBits(x) & $7FFFFFFF) > $7F800000
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.f PmOpNaN()
  ProcedureReturn PmOpFromBits($7FC00000)
EndProcedure

; -x by flipping the sign bit, so -(+0) is -0 and a NaN keeps its payload.
Procedure.f PmOpNeg(x.f)
  ProcedureReturn PmOpFromBits(PmOpBits(x) ! $80000000)
EndProcedure

Procedure.f PmOpAbs(x.f)
  ProcedureReturn PmOpFromBits(PmOpBits(x) & $7FFFFFFF)
EndProcedure

; y * 2^n, exactly where the result is normal; a subnormal result is
; rounded once (the first step is exact, the second rounds).
Procedure.f PmOpLdexp(y.f, n.i)
  Protected p.f
  If n > 127
    p = PmOpFromBits(n << 23)
    y = y * p
    p = PmOpFromBits($7F000000)
    y = y * p
    ProcedureReturn y
  EndIf
  If n < -126
    p = PmOpFromBits((n + 253) << 23)
    y = y * p
    p = PmOpFromBits($00800000)
    y = y * p
    ProcedureReturn y
  EndIf
  p = PmOpFromBits((n + 127) << 23)
  y = y * p
  ProcedureReturn y
EndProcedure

; The integer toward zero of x, for |x| < 2^31; PmOpStatus = 3 outside
; (and for a NaN or an infinity).
Procedure.i PmOpTruncInt(x.f)
  Protected b.i
  Protected e.i
  Protected m.i
  Protected v.i
  b = PmOpBits(x)
  e = ((b >> 23) & $FF) - 127
  If e < 0
    ProcedureReturn 0
  EndIf
  If e > 30
    PmOpStatus = 3
    ProcedureReturn 0
  EndIf
  m = (b & $7FFFFF) | $800000
  If e < 23
    v = m >> (23 - e)
  Else
    v = m << (e - 23)
  EndIf
  If (b & $80000000) <> 0
    v = 0 - v
  EndIf
  ProcedureReturn v
EndProcedure

; Ceil-13 on the bits: exact for every binary32 value.
Procedure.f PmOpCeil(x.f)
  Protected b.i
  Protected e.i
  Protected mask.i
  b = PmOpBits(x)
  e = ((b >> 23) & $FF) - 127
  If e >= 23
    ProcedureReturn x
  EndIf
  If e < 0
    If (b & $7FFFFFFF) = 0
      ProcedureReturn x
    EndIf
    If (b & $80000000) <> 0
      ProcedureReturn PmOpFromBits($80000000)
    EndIf
    ProcedureReturn PmOpOne
  EndIf
  mask = $7FFFFF >> e
  If (b & mask) = 0
    ProcedureReturn x
  EndIf
  If (b & $80000000) = 0
    b = b + ($800000 >> e)
  EndIf
  b = b - (b & mask)
  ProcedureReturn PmOpFromBits(b)
EndProcedure

; ----------------------------------------------------------------------
; sqrt, correctly rounded: the integer square root of fdlibm's e_sqrtf.c
; on the significand, in steps that fit 32-bit integers.
; ----------------------------------------------------------------------
Procedure.f PmOpSqrt(x.f)
  Protected ix.i
  Protected m.i
  Protected i.i
  Protected q.i
  Protected s.i
  Protected r.i
  Protected t.i
  ix = PmOpBits(x)
  If (ix & $7F800000) = $7F800000
    If (ix & $7FFFFF) <> 0
      ProcedureReturn x
    EndIf
    If (ix & $80000000) = 0
      ProcedureReturn x
    EndIf
    ProcedureReturn PmOpNaN()
  EndIf
  If (ix & $7FFFFFFF) = 0
    ProcedureReturn x
  EndIf
  If (ix & $80000000) <> 0
    ProcedureReturn PmOpNaN()
  EndIf
  m = (ix >> 23) & $FF
  If m = 0
    i = 0
    While (ix & $800000) = 0
      ix = ix << 1
      i = i + 1
    Wend
    m = m - (i - 1)
  EndIf
  m = m - 127
  ix = (ix & $7FFFFF) | $800000
  If (m & 1) <> 0
    ix = ix + ix
  EndIf
  m = m >> 1
  ix = ix + ix
  q = 0
  s = 0
  r = $1000000
  While r <> 0
    t = s + r
    If t <= ix
      s = t + r
      ix = ix - t
      q = q + r
    EndIf
    ix = ix + ix
    r = r >> 1
  Wend
  If ix <> 0
    q = q + (q & 1)
  EndIf
  ix = (q >> 1) + $3F000000
  ix = ix + (m << 23)
  ProcedureReturn PmOpFromBits(ix)
EndProcedure

; ----------------------------------------------------------------------
; exp: n = nearest integer to x/ln2 (added to 1.5*2^23 and read back from
; the bits), r = x - n*ln2 in two steps (ln2's high part has 16 bits, so
; n*ln2hi is exact), e^r by its Taylor polynomial of degree 7 in Horner
; form, scaled by 2^n.
; ----------------------------------------------------------------------
Procedure.f PmOpExp(x.f)
  Protected t.f
  Protected u.f
  Protected nf.f
  Protected p.f
  Protected r.f
  Protected q.f
  Protected y.f
  Protected n.i
  Protected k.i
  If (PmOpBits(x) & $7FFFFFFF) > $7F800000
    ProcedureReturn x
  EndIf
  If x > PmOpExpHi
    ProcedureReturn PmOpInfinity
  EndIf
  If x < PmOpExpLo
    ProcedureReturn 0.0
  EndIf
  t = x * PmOpInvLn2
  u = t + PmOpMagic
  n = (PmOpBits(u) & $7FFFFF) - $400000
  nf = n
  p = nf * PmOpLn2Hi
  r = x - p
  q = nf * PmOpLn2Lo
  r = r - q
  y = PmOpInvFact(7)
  k = 6
  While k >= 0
    y = y * r
    y = y + PmOpInvFact(k)
    k = k - 1
  Wend
  ProcedureReturn PmOpLdexp(y, n)
EndProcedure

; expm1: the Taylor polynomial of degree 11 for |x| <= ln2, exp(x) - 1
; outside it.
Procedure.f PmOpExpm1(x.f)
  Protected y.f
  Protected k.i
  If (PmOpBits(x) & $7FFFFFFF) > $7F800000
    ProcedureReturn x
  EndIf
  If PmOpAbs(x) > PmOpExpm1Edge
    y = PmOpExp(x)
    y = y - PmOpOne
    ProcedureReturn y
  EndIf
  y = PmOpInvFact(11)
  k = 10
  While k >= 2
    y = y * x
    y = y + PmOpInvFact(k)
    k = k - 1
  Wend
  y = y * x
  y = y * x
  y = y + x
  ProcedureReturn y
EndProcedure

; log: x = m * 2^e with m in [sqrt(1/2), sqrt(2)] (a subnormal is scaled
; by 2^23 first), s = (m - 1)/(m + 1), ln m = 2 atanh(s) by eight terms of
; its series in s^2, ln x = e*ln2hi + (e*ln2lo + ln m).
Procedure.f PmOpLog(x.f)
  Protected b.i
  Protected e.i
  Protected k.i
  Protected m.f
  Protected num.f
  Protected den.f
  Protected s.f
  Protected z.f
  Protected p.f
  Protected ef.f
  Protected a.f
  Protected c.f
  b = PmOpBits(x)
  If (b & $7FFFFFFF) > $7F800000
    ProcedureReturn x
  EndIf
  If (b & $7FFFFFFF) = 0
    ProcedureReturn PmOpNeg(PmOpInfinity)
  EndIf
  If (b & $80000000) <> 0
    ProcedureReturn PmOpNaN()
  EndIf
  If b = $7F800000
    ProcedureReturn x
  EndIf
  e = (b >> 23) & $FF
  If e = 0
    m = PmOpFromBits($4B000000)
    m = x * m
    b = PmOpBits(m)
    e = ((b >> 23) & $FF) - 23
  EndIf
  e = e - 127
  m = PmOpFromBits((b & $7FFFFF) | $3F800000)
  If m > PmOpSqrt2
    m = PmOpFromBits((b & $7FFFFF) | $3F000000)
    e = e + 1
  EndIf
  num = m - PmOpOne
  den = m + PmOpOne
  s = num / den
  z = s * s
  p = PmOpLogC(7)
  k = 6
  While k >= 0
    p = p * z
    p = p + PmOpLogC(k)
    k = k - 1
  Wend
  p = s * p
  ef = e
  a = ef * PmOpLn2Lo
  a = a + p
  c = ef * PmOpLn2Hi
  c = c + a
  ProcedureReturn c
EndProcedure

; log1p(t) = log(u) * (t / (u - 1)) with u = 1 + t, which cancels the
; rounding of u; t itself when u rounds to 1.
Procedure.f PmOpLog1p(t.f)
  Protected u.f
  Protected d.f
  Protected q.f
  Protected l.f
  If (PmOpBits(t) & $7FFFFFFF) > $7F800000
    ProcedureReturn t
  EndIf
  u = PmOpOne + t
  If u = PmOpOne
    ProcedureReturn t
  EndIf
  If u = PmOpInfinity
    ProcedureReturn u
  EndIf
  d = u - PmOpOne
  q = t / d
  l = PmOpLog(u)
  l = l * q
  ProcedureReturn l
EndProcedure

; tanh(|x|) = t / (t + 2) with t = expm1(2|x|), 1 above 9; the sign of x.
Procedure.f PmOpTanh(x.f)
  Protected a.f
  Protected t.f
  Protected d.f
  Protected y.f
  If (PmOpBits(x) & $7FFFFFFF) > $7F800000
    ProcedureReturn x
  EndIf
  a = PmOpAbs(x)
  If a > PmOpNine
    y = PmOpOne
  Else
    a = a + a
    t = PmOpExpm1(a)
    d = t + PmOpTwo
    y = t / d
  EndIf
  If (PmOpBits(x) & $80000000) <> 0
    ProcedureReturn PmOpNeg(y)
  EndIf
  ProcedureReturn y
EndProcedure

; A polynomial with count coefficients at address (lowest order first), in
; Horner form.
Procedure.f PmOpPoly(address.i, count.i, z.f)
  Protected y.f
  Protected c.f
  Protected k.i
  k = count - 1
  y = PmTensorGet(address, k)
  k = k - 1
  While k >= 0
    c = PmTensorGet(address, k)
    y = y * z
    y = y + c
    k = k - 1
  Wend
  ProcedureReturn y
EndProcedure

; erf: fdlibm's s_erff.c in binary32 steps. |x| < 0.84375: x + x*P/Q in
; x^2; below 1.25: erx + P/Q in |x| - 1; up to 6: 1 - exp(-z*z - 0.5625) *
; exp((z - |x|)(z + |x|) + R/S) / |x| with z = |x| cut to 12 significand
; bits (so z*z is exact) and R/S in 1/x^2; 1 from 6. Odd in x.
Procedure.f PmOpErf(x.f)
  Protected b.i
  Protected a.f
  Protected z.f
  Protected r.f
  Protected s.f
  Protected y.f
  Protected t.f
  Protected e1.f
  Protected e2.f
  Protected d.f
  b = PmOpBits(x)
  If (b & $7FFFFFFF) > $7F800000
    ProcedureReturn x
  EndIf
  If (b & $7FFFFFFF) = 0
    ProcedureReturn x
  EndIf
  a = PmOpAbs(x)
  If a < PmOpErfSmall
    If a < PmOpErfTiny
      t = PmOpEfx * x
      t = x + t
      ProcedureReturn t
    EndIf
    z = x * x
    r = PmOpPoly(@PmOpErfPP(0), 5, z)
    s = PmOpPoly(@PmOpErfQQ(0), 6, z)
    y = r / s
    t = x * y
    t = x + t
    ProcedureReturn t
  EndIf
  If a < PmOpErfMid
    s = a - PmOpOne
    r = PmOpPoly(@PmOpErfPA(0), 7, s)
    t = PmOpPoly(@PmOpErfQA(0), 7, s)
    y = r / t
    y = PmOpErx + y
  ElseIf a >= PmOpErfBig
    y = PmOpOne
  Else
    t = a * a
    s = PmOpOne / t
    If a < PmOpErfSplit
      r = PmOpPoly(@PmOpErfRA(0), 8, s)
      t = PmOpPoly(@PmOpErfSA(0), 9, s)
    Else
      r = PmOpPoly(@PmOpErfRB(0), 7, s)
      t = PmOpPoly(@PmOpErfSB(0), 8, s)
    EndIf
    z = PmOpFromBits(PmOpBits(a) & $FFFFF000)
    e1 = z * z
    e1 = 0.0 - e1
    e1 = e1 - PmOpErfBias
    e1 = PmOpExp(e1)
    d = z - a
    y = z + a
    d = d * y
    y = r / t
    d = d + y
    e2 = PmOpExp(d)
    e1 = e1 * e2
    e1 = e1 / a
    y = PmOpOne - e1
  EndIf
  If (b & $80000000) <> 0
    ProcedureReturn PmOpNeg(y)
  EndIf
  ProcedureReturn y
EndProcedure

; ----------------------------------------------------------------------
; Trigonometric and hyperbolic functions, from the same single binary32
; operations.
;
; ARGUMENT REDUCTION for tan (and the sin and cos it is made of): x = q*pi/2
; + r with |r| <= pi/4, for every binary32 x, by integer arithmetic on 12-bit
; digits (a Payne-Hanek reduction). x = m * 2^(e-23) with m the 24-bit
; significand; x*(2/pi) is formed exactly from m and a window of the bits
; of 2/pi (PmOpPio, 24 digits of 12 bits after the binary point) chosen by
; e, so the bits of the product that are multiples of 4 are never formed.
; Every intermediate is below 2^27, so 32-bit and 64-bit targets agree. The
; quadrant is the product's integer part mod 4; its fraction f (rounded to
; the nearest quadrant, so |f| <= 1/2) is rounded once, to nearest even, to
; binary32, and r = f*pi/2 in two parts. Accuracy measured against the true
; tangent over |x| up to 3.4e38: 3.5 units in the last place at most.
; ----------------------------------------------------------------------
Global Dim PmOpPio.i(24)
Global Dim PmOpDig.i(16)
Global Dim PmOpFrac.i(16)
Global PmOpQuadrant.i
Global PmOpPio2Hi.f
Global PmOpPio2Lo.f
Global PmOpPiHi.f
Global PmOpPiLo.f
Global PmOpPio4.f
Global PmOpLn2.f
Global PmOpTiny12.f
Global PmOp4096.f
Global Dim PmOpSinC.f(5)
Global Dim PmOpCosC.f(6)
Global Dim PmOpAsinR.f(7)
Global PmOpTrigReady.i

Procedure PmOpTrigInit()
  If PmOpTrigReady <> 0
    ProcedureReturn
  EndIf
  PmOpPio(0) = 2607
  PmOpPio(1) = 2435
  PmOpPio(2) = 1764
  PmOpPio(3) = 3652
  PmOpPio(4) = 338
  PmOpPio(5) = 2556
  PmOpPio(6) = 629
  PmOpPio(7) = 2001
  PmOpPio(8) = 3923
  PmOpPio(9) = 1245
  PmOpPio(10) = 3085
  PmOpPio(11) = 2914
  PmOpPio(12) = 2393
  PmOpPio(13) = 2364
  PmOpPio(14) = 1081
  PmOpPio(15) = 65
  PmOpPio(16) = 4069
  PmOpPio(17) = 355
  PmOpPio(18) = 2749
  PmOpPio(19) = 3771
  PmOpPio(20) = 3158
  PmOpPio(21) = 439
  PmOpPio(22) = 582
  PmOpPio(23) = 3642
  PmOpSetBits(@PmOpPio2Hi, $3FC90FDB)
  PmOpSetBits(@PmOpPio2Lo, $B33BBD2E)
  PmOpSetBits(@PmOpPiHi, $40490FDB)
  PmOpSetBits(@PmOpPiLo, $B3BBBD2E)
  PmOpSetBits(@PmOpPio4, $3F490FDB)
  PmOpSetBits(@PmOpLn2, $3F317218)
  PmOpSetBits(@PmOpTiny12, $39800000)
  PmOpSetBits(@PmOp4096, $45800000)
  ; sin: 1, -1/3!, 1/5!, -1/7!, 1/9!; cos: 1, -1/2!, 1/4!, -1/6!, 1/8!, -1/10!
  PmOpSetBits(@PmOpSinC(0), $3F800000)
  PmOpSetBits(@PmOpSinC(1), $BE2AAAAB)
  PmOpSetBits(@PmOpSinC(2), $3C088889)
  PmOpSetBits(@PmOpSinC(3), $B9500D01)
  PmOpSetBits(@PmOpSinC(4), $3638EF1D)
  PmOpSetBits(@PmOpCosC(0), $3F800000)
  PmOpSetBits(@PmOpCosC(1), $BF000000)
  PmOpSetBits(@PmOpCosC(2), $3D2AAAAB)
  PmOpSetBits(@PmOpCosC(3), $BAB60B61)
  PmOpSetBits(@PmOpCosC(4), $37D00D01)
  PmOpSetBits(@PmOpCosC(5), $B493F27E)
  ; R(z) = (asin(sqrt z) - sqrt z)/(z sqrt z) on [0, 1/4], degree 6
  PmOpSetBits(@PmOpAsinR(0), $3E2AAAAB)
  PmOpSetBits(@PmOpAsinR(1), $3D99998F)
  PmOpSetBits(@PmOpAsinR(2), $3D36E0AA)
  PmOpSetBits(@PmOpAsinR(3), $3CF7F060)
  PmOpSetBits(@PmOpAsinR(4), $3CC1A093)
  PmOpSetBits(@PmOpAsinR(5), $3C2BD527)
  PmOpSetBits(@PmOpAsinR(6), $3CFEB0D7)
  PmOpTrigReady = 1
EndProcedure

; x = PmOpQuadrant*pi/2 + r; returns r. For |x| < pi/4, r = x.
Procedure.f PmOpReducePio2(x.f)
  Protected b.i
  Protected a.i
  Protected e.i
  Protected m.i
  Protected mh.i
  Protected ml.i
  Protected t.i
  Protected k0.i
  Protected base.i
  Protected i.i
  Protected k.i
  Protected v.i
  Protected j.i
  Protected s.i
  Protected q.i
  Protected carry.i
  Protected tot.i
  Protected borrow.i
  Protected rneg.i
  Protected lead.i
  Protected bits.i
  Protected nb.i
  Protected jj.i
  Protected tt.i
  Protected bit.i
  Protected sticky.i
  Protected mant.i
  Protected fr.f
  Protected r.f
  Protected r2.f
  b = PmOpBits(x)
  a = b & $7FFFFFFF
  If a < $3F490FDB
    PmOpQuadrant = 0
    ProcedureReturn x
  EndIf
  e = ((a >> 23) & $FF) - 127
  m = (a & $7FFFFF) | $800000
  mh = m >> 12
  ml = m & $FFF
  t = e - 12
  If t >= 0
    k0 = t / 12
  Else
    k0 = 0 - ((11 - t) / 12)
  EndIf
  base = e - 23 - 12 * k0
  i = 0
  While i < 14
    PmOpDig(i) = 0
    i = i + 1
  Wend
  i = -2
  While i <= 9
    k = k0 + i
    v = 0
    If k >= 0 And k < 24
      v = PmOpPio(k)
    EndIf
    PmOpDig(i + 2) = PmOpDig(i + 2) + mh * v
    PmOpDig(i + 3) = PmOpDig(i + 3) + ml * v
    i = i + 1
  Wend
  j = 12
  While j >= 1
    PmOpDig(j - 1) = PmOpDig(j - 1) + (PmOpDig(j) >> 12)
    PmOpDig(j) = PmOpDig(j) & $FFF
    j = j - 1
  Wend
  s = 0 - base
  q = ((((PmOpDig(1) & $FFF) << 12) | PmOpDig(2)) >> s) & 3
  carry = PmOpDig(2) & ((1 << s) - 1)
  j = 1
  While j <= 10
    tot = (carry << 12) | PmOpDig(j + 2)
    PmOpFrac(j - 1) = (tot >> s) & $FFF
    carry = tot & ((1 << s) - 1)
    j = j + 1
  Wend
  ; a fraction of 1/2 or more belongs to the next quadrant: 1 - fraction
  rneg = 0
  If (PmOpFrac(0) & $800) <> 0
    q = (q + 1) & 3
    borrow = 0
    j = 9
    While j >= 0
      v = 0 - PmOpFrac(j) - borrow
      If v < 0
        v = v + 4096
        borrow = 1
      Else
        borrow = 0
      EndIf
      PmOpFrac(j) = v
      j = j - 1
    Wend
    rneg = 1
  EndIf
  ; the leading one, 26 bits from it, a sticky bit, round to nearest even
  j = 0
  While j < 10 And PmOpFrac(j) = 0
    j = j + 1
  Wend
  If j = 10
    fr = 0.0
  Else
    t = 11
    While ((PmOpFrac(j) >> t) & 1) = 0
      t = t - 1
    Wend
    lead = 0 - (12 * j + 12 - t)
    bits = 0
    nb = 0
    jj = j
    tt = t
    While nb < 26
      bit = 0
      If jj < 10
        bit = (PmOpFrac(jj) >> tt) & 1
      EndIf
      bits = (bits << 1) | bit
      nb = nb + 1
      tt = tt - 1
      If tt < 0
        tt = 11
        jj = jj + 1
      EndIf
    Wend
    sticky = 0
    If jj < 10
      If (PmOpFrac(jj) & ((1 << (tt + 1)) - 1)) <> 0
        sticky = 1
      EndIf
      jj = jj + 1
      While jj < 10
        If PmOpFrac(jj) <> 0
          sticky = 1
        EndIf
        jj = jj + 1
      Wend
    EndIf
    mant = bits >> 2
    If ((bits >> 1) & 1) <> 0
      If (bits & 1) <> 0 Or sticky <> 0 Or (mant & 1) <> 0
        mant = mant + 1
        If mant = $1000000
          mant = mant >> 1
          lead = lead + 1
        EndIf
      EndIf
    EndIf
    fr = PmOpFromBits(((lead + 127) << 23) | (mant & $7FFFFF))
  EndIf
  r = fr * PmOpPio2Hi
  r2 = fr * PmOpPio2Lo
  r = r + r2
  If rneg <> 0
    r = PmOpNeg(r)
  EndIf
  If (b & $80000000) <> 0
    r = PmOpNeg(r)
    q = (4 - q) & 3
  EndIf
  PmOpQuadrant = q
  ProcedureReturn r
EndProcedure

; sin and cos of |r| <= pi/4 by their Taylor polynomials.
Procedure.f PmOpKSin(r.f)
  Protected z.f
  Protected p.f
  z = r * r
  p = PmOpPoly(@PmOpSinC(1), 4, z)
  p = p * z
  p = p * r
  p = r + p
  ProcedureReturn p
EndProcedure

Procedure.f PmOpKCos(r.f)
  Protected z.f
  z = r * r
  ProcedureReturn PmOpPoly(@PmOpCosC(0), 6, z)
EndProcedure

; Tan-7: sin/cos of the reduced argument, -cos/sin in odd quadrants.
Procedure.f PmOpTan(x.f)
  Protected r.f
  Protected s.f
  Protected c.f
  Protected y.f
  If (PmOpBits(x) & $7FFFFFFF) >= $7F800000
    ProcedureReturn PmOpNaN()
  EndIf
  r = PmOpReducePio2(x)
  s = PmOpKSin(r)
  c = PmOpKCos(r)
  If (PmOpQuadrant & 1) = 0
    y = s / c
  Else
    c = PmOpNeg(c)
    y = c / s
  EndIf
  ProcedureReturn y
EndProcedure

; asin of |x| <= 1/2: x + x*z*R(z), z = x*x.
Procedure.f PmOpAsinSmall(x.f)
  Protected z.f
  Protected p.f
  If (PmOpBits(x) & $7FFFFFFF) = 0
    ProcedureReturn x
  EndIf
  z = x * x
  p = PmOpPoly(@PmOpAsinR(0), 7, z)
  p = z * p
  p = x * p
  p = x + p
  ProcedureReturn p
EndProcedure

; Asin-7 and Acos-7. Above 1/2 through asin(sqrt((1 - |x|)/2)).
Procedure.f PmOpAsin(x.f, wantCos.i)
  Protected a.f
  Protected w.f
  Protected s.f
  Protected t.f
  Protected y.f
  a = PmOpAbs(x)
  If a > PmOpOne
    ProcedureReturn PmOpNaN()
  EndIf
  If a <= PmOpHalf
    t = PmOpAsinSmall(x)
    If wantCos = 0
      ProcedureReturn t
    EndIf
    y = PmOpPio2Hi - t
    y = y + PmOpPio2Lo
    ProcedureReturn y
  EndIf
  If wantCos <> 0 And (PmOpBits(x) & $80000000) = 0
    w = PmOpOne - x
    w = w * PmOpHalf
    s = PmOpSqrt(w)
    t = PmOpAsinSmall(s)
    t = t + t
    ProcedureReturn t
  EndIf
  If wantCos <> 0
    w = PmOpOne + x
    w = w * PmOpHalf
    s = PmOpSqrt(w)
    t = PmOpAsinSmall(s)
    t = t + t
    y = PmOpPiHi - t
    y = y + PmOpPiLo
    ProcedureReturn y
  EndIf
  w = PmOpOne - a
  w = w * PmOpHalf
  s = PmOpSqrt(w)
  t = PmOpAsinSmall(s)
  t = t + t
  y = PmOpPio2Hi - t
  y = y + PmOpPio2Lo
  If (PmOpBits(x) & $80000000) <> 0
    ProcedureReturn PmOpNeg(y)
  EndIf
  ProcedureReturn y
EndProcedure

; exp(a)/2 without overflowing where the result is finite (a >= 0).
Procedure.f PmOpHalfExp(a.f)
  Protected w.f
  Protected t.f
  If a < PmOpExpHi
    w = PmOpExp(a)
    w = w * PmOpHalf
    ProcedureReturn w
  EndIf
  t = a * PmOpHalf
  w = PmOpExp(t)
  t = w * PmOpHalf
  t = t * w
  ProcedureReturn t
EndProcedure

; Sinh-9 and Cosh-9 through expm1 and exp.
Procedure.f PmOpSinh(x.f)
  Protected a.f
  Protected t.f
  Protected u.f
  Protected v.f
  Protected y.f
  a = PmOpAbs(x)
  If a < PmOpTiny12
    ProcedureReturn x
  EndIf
  If a < PmOpNine
    t = PmOpExpm1(a)
    u = t + PmOpOne
    v = t / u
    y = t + v
    y = y * PmOpHalf
  Else
    y = PmOpHalfExp(a)
  EndIf
  If (PmOpBits(x) & $80000000) <> 0
    ProcedureReturn PmOpNeg(y)
  EndIf
  ProcedureReturn y
EndProcedure

Procedure.f PmOpCosh(x.f)
  Protected a.f
  Protected t.f
  Protected w.f
  Protected u.f
  Protected h.f
  Protected g.f
  a = PmOpAbs(x)
  If a < PmOpFromBits($3EB17218)
    t = PmOpExpm1(a)
    w = PmOpOne + t
    u = t * t
    w = w + w
    u = u / w
    u = PmOpOne + u
    ProcedureReturn u
  EndIf
  If a < PmOpNine
    t = PmOpExp(a)
    h = t * PmOpHalf
    g = PmOpHalf / t
    h = h + g
    ProcedureReturn h
  EndIf
  ProcedureReturn PmOpHalfExp(a)
EndProcedure

; Asinh-9, Acosh-9 and Atanh-9 through log and log1p.
Procedure.f PmOpAsinh(x.f)
  Protected a.f
  Protected t.f
  Protected u.f
  Protected y.f
  a = PmOpAbs(x)
  If a < PmOpTiny12
    ProcedureReturn x
  EndIf
  If a > PmOp4096
    y = PmOpLog(a)
    y = y + PmOpLn2
  ElseIf a > PmOpTwo
    t = a * a
    t = t + PmOpOne
    t = PmOpSqrt(t)
    t = t + a
    t = PmOpOne / t
    u = a + a
    u = u + t
    y = PmOpLog(u)
  Else
    t = a * a
    u = t + PmOpOne
    u = PmOpSqrt(u)
    u = u + PmOpOne
    u = t / u
    u = a + u
    y = PmOpLog1p(u)
  EndIf
  If (PmOpBits(x) & $80000000) <> 0
    ProcedureReturn PmOpNeg(y)
  EndIf
  ProcedureReturn y
EndProcedure

Procedure.f PmOpAcosh(x.f)
  Protected t.f
  Protected u.f
  Protected v.f
  If x < PmOpOne
    ProcedureReturn PmOpNaN()
  EndIf
  If x > PmOp4096
    t = PmOpLog(x)
    t = t + PmOpLn2
    ProcedureReturn t
  EndIf
  If x > PmOpTwo
    t = x * x
    t = t - PmOpOne
    t = PmOpSqrt(t)
    t = t + x
    t = PmOpOne / t
    u = x + x
    u = u - t
    ProcedureReturn PmOpLog(u)
  EndIf
  t = x - PmOpOne
  u = t * t
  v = t + t
  u = v + u
  u = PmOpSqrt(u)
  u = t + u
  ProcedureReturn PmOpLog1p(u)
EndProcedure

Procedure.f PmOpAtanh(x.f)
  Protected a.f
  Protected t.f
  Protected u.f
  Protected d.f
  Protected y.f
  a = PmOpAbs(x)
  If a > PmOpOne
    ProcedureReturn PmOpNaN()
  EndIf
  If a = PmOpOne
    If (PmOpBits(x) & $80000000) <> 0
      ProcedureReturn PmOpNeg(PmOpInfinity)
    EndIf
    ProcedureReturn PmOpInfinity
  EndIf
  If a < PmOpHalf
    t = a + a
    u = t * a
    d = PmOpOne - a
    u = u / d
    u = t + u
  Else
    t = a + a
    d = PmOpOne - a
    u = t / d
  EndIf
  y = PmOpLog1p(u)
  y = PmOpHalf * y
  If (PmOpBits(x) & $80000000) <> 0
    ProcedureReturn PmOpNeg(y)
  EndIf
  ProcedureReturn y
EndProcedure

; ----------------------------------------------------------------------
; Integer arithmetic with the checked INT64 contract. On a 32-bit target an
; INT64 result outside the signed 32-bit range clears PmTensorInt64Ok
; instead of wrapping to a different number; INT32 keeps its low 32 bits
; (the store is 32 bits wide); a 64-bit target wraps INT64 in 64 bits, as
; the reference's numpy does.
; ----------------------------------------------------------------------
Procedure.i PmOpAddI(a.i, b.i, kind.i)
  Protected r.i
  r = a + b
  CompilerIf #PMO_OPS_INT32 = 1
    If kind = 7
      If (a >= 0 And b >= 0 And r < 0) Or (a < 0 And b < 0 And r >= 0)
        PmTensorInt64Ok = 0
      EndIf
    EndIf
  CompilerEndIf
  ProcedureReturn r
EndProcedure

Procedure.i PmOpMulI(a.i, b.i, kind.i)
  CompilerIf #PMO_OPS_INT32 = 1
    If kind = 7 And a <> 0 And b <> 0
      If (a > 0 And b > 0 And a > 2147483647 / b) Or (a < 0 And b < 0 And a < 2147483647 / b) Or (a > 0 And b < 0 And b < -2147483648 / a) Or (a < 0 And b > 0 And a < -2147483648 / b)
        PmTensorInt64Ok = 0
      EndIf
    EndIf
  CompilerEndIf
  ProcedureReturn a * b
EndProcedure

Procedure.i PmOpReadInt(address.i, index.i, kind.i)
  If kind = 7
    ProcedureReturn PmTensorGetI64(address, index)
  EndIf
  If kind = 6
    ProcedureReturn PeekL(address + index * 4)
  EndIf
  ProcedureReturn PeekA(address + index) & 255
EndProcedure

Procedure PmOpWriteInt(address.i, index.i, kind.i, value.i)
  If kind = 7
    PmTensorPutI64(address, index, value)
  ElseIf kind = 6
    PokeL(address + index * 4, value)
  ElseIf value <> 0
    PokeA(address + index, 1)
  Else
    PokeA(address + index, 0)
  EndIf
EndProcedure

Procedure.i PmOpKindBytes(kind.i)
  If kind = 7
    ProcedureReturn 8
  EndIf
  If kind = 9
    ProcedureReturn 1
  EndIf
  ProcedureReturn 4
EndProcedure

; Every FLOAT result an arithmetic kernel writes goes through here: a NaN is
; written as the one quiet NaN $7FC00000. The targets' own rules for the NaN
; an invalid operation makes (the host's x87 gives $FFC00000, the Arm cores
; $7FC00000) and for which operand's payload survives differ, so the kernels
; define it instead. Copies (Split, Tile, Gather...) move the bits unchanged.
Procedure PmOpStoreF(dst.i, index.i, v.f)
  If (PmOpBits(v) & $7FFFFFFF) > $7F800000
    PokeL(dst + index * 4, $7FC00000)
  Else
    PmTensorPut(dst, index, v)
  EndIf
EndProcedure

Procedure PmOpCopyBytes(src.i, dst.i, bytes.i)
  Protected i.i
  If src = dst
    ProcedureReturn
  EndIf
  i = 0
  While i + 4 <= bytes
    PokeL(dst + i, PeekL(src + i))
    i = i + 4
  Wend
  While i < bytes
    PokeA(dst + i, PeekA(src + i))
    i = i + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; Elementwise functions of one tensor, Count elements. FLOAT unless noted;
; PmOpF(0) and PmOpF(1) carry alpha/beta-style attributes, PmOpI(0) and
; PmOpI(1) IsInf's detect_positive and detect_negative. Each op states the
; ONNX definition and the order of its binary32 steps. A NaN element gives
; the same NaN back (0 for ThresholdedRelu and Shrink, whose comparisons are
; false for it), decided on the bits before any comparison: the host
; compiler's float comparisons do not order a NaN the way IEEE 754 does.
;   0 Erf-13                 erf(x)
;   1 Reciprocal-13          1 / x
;   2 Ceil-13                exact, on the bits
;   3 Sign-13                1, -1, or x for zeros and NaN; also INT32/INT64
;   4 Softplus-1             x > 0: x + log1p(exp(-x)), else log1p(exp(x))
;                            (the overflow-free form ONNX Runtime uses)
;   5 Softsign-1             x / (1 + |x|)
;   6 Elu-6                  x >= 0: x, else alpha * (exp(x) - 1)
;   7 Selu-6                 x > 0: gamma * x, else gamma*(alpha*exp(x) - alpha)
;   8 Celu-12                max(0,x) + min(0, alpha*(exp(x/alpha) - 1))
;   9 HardSigmoid-6          max(0, min(1, alpha*x + beta))
;  10 HardSwish-14           x * HardSigmoid(x) with alpha 1/6, beta 0.5
;  11 Mish-18                x * tanh(softplus(x))
;  12 Gelu-20 "none"         (0.5 * x) * (1 + erf(x * (1/sqrt 2)))
;  13 Gelu-20 "tanh"         (0.5 * x) * (1 + tanh(sqrt(2/pi) *
;                            (x + 0.044715 * x*x*x)))
;  14 ThresholdedRelu-10     x > alpha: x, else 0
;  15 Shrink-9               x < -lambd: x + bias; x > lambd: x - bias; else 0
;                            (F0 bias, F1 lambd)
;  16 IsNaN-20               BOOL
;  17 IsInf-20               BOOL
;  18 x / F0                 (Mean's division by the number of inputs)
;  19 Tan-7 ... 26 Atanh-9   Tan, Asin, Acos, Sinh, Cosh, Asinh, Acosh, Atanh
;                            (the functions above; NaN outside the domain)
;  27 BitwiseNot-18          INT32 and INT64
; ----------------------------------------------------------------------
Procedure.f PmOpSoftplus(x.f)
  Protected e.f
  Protected t.f
  If x > 0.0
    t = PmOpNeg(x)
    e = PmOpExp(t)
    e = PmOpLog1p(e)
    e = x + e
    ProcedureReturn e
  EndIf
  e = PmOpExp(x)
  ProcedureReturn PmOpLog1p(e)
EndProcedure

Procedure.f PmOpClamp01(t.f)
  If PmOpIsNan(t) <> 0
    ProcedureReturn t
  EndIf
  If t < 0.0
    ProcedureReturn 0.0
  EndIf
  If t > PmOpOne
    ProcedureReturn PmOpOne
  EndIf
  ProcedureReturn t
EndProcedure

Procedure.f PmOpUnaryValue(x.f, op.i)
  Protected t.f
  Protected u.f
  Protected h.f
  If PmOpIsNan(x) <> 0
    If op = 14 Or op = 15
      ProcedureReturn 0.0
    EndIf
    ProcedureReturn x
  EndIf
  Select op
    Case 0
      ProcedureReturn PmOpErf(x)
    Case 1
      t = PmOpOne / x
      ProcedureReturn t
    Case 2
      ProcedureReturn PmOpCeil(x)
    Case 3
      If x > 0.0
        ProcedureReturn PmOpOne
      EndIf
      If x < 0.0
        ProcedureReturn PmOpNeg(PmOpOne)
      EndIf
      ProcedureReturn x
    Case 4
      ProcedureReturn PmOpSoftplus(x)
    Case 5
      t = PmOpAbs(x)
      t = PmOpOne + t
      t = x / t
      ProcedureReturn t
    Case 6
      If x >= 0.0
        ProcedureReturn x
      EndIf
      t = PmOpExp(x)
      t = t - PmOpOne
      t = PmOpF(0) * t
      ProcedureReturn t
    Case 7
      If x > 0.0
        t = PmOpF(1) * x
        ProcedureReturn t
      EndIf
      t = PmOpExp(x)
      t = PmOpF(0) * t
      t = t - PmOpF(0)
      t = PmOpF(1) * t
      ProcedureReturn t
    Case 8
      t = x / PmOpF(0)
      t = PmOpExp(t)
      t = t - PmOpOne
      t = PmOpF(0) * t
      If t > 0.0
        t = 0.0
      EndIf
      u = x
      If u < 0.0
        u = 0.0
      EndIf
      t = u + t
      ProcedureReturn t
    Case 9
      t = PmOpF(0) * x
      t = t + PmOpF(1)
      ProcedureReturn PmOpClamp01(t)
    Case 10
      t = PmOpSixth * x
      t = t + PmOpHalf
      t = PmOpClamp01(t)
      t = x * t
      ProcedureReturn t
    Case 11
      t = PmOpSoftplus(x)
      t = PmOpTanh(t)
      t = x * t
      ProcedureReturn t
    Case 12
      t = x * PmOpInvSqrt2
      t = PmOpErf(t)
      t = PmOpOne + t
      h = PmOpHalf * x
      t = h * t
      ProcedureReturn t
    Case 13
      t = x * x
      t = t * x
      t = PmOpGeluCubic * t
      t = x + t
      t = PmOpSqrt2OverPi * t
      t = PmOpTanh(t)
      t = PmOpOne + t
      h = PmOpHalf * x
      t = h * t
      ProcedureReturn t
    Case 14
      If x > PmOpF(0)
        ProcedureReturn x
      EndIf
      ProcedureReturn 0.0
    Case 15
      t = PmOpNeg(PmOpF(1))
      If x < t
        t = x + PmOpF(0)
        ProcedureReturn t
      EndIf
      If x > PmOpF(1)
        t = x - PmOpF(0)
        ProcedureReturn t
      EndIf
      ProcedureReturn 0.0
    Case 18
      t = x / PmOpF(0)
      ProcedureReturn t
    Case 19
      ProcedureReturn PmOpTan(x)
    Case 20
      ProcedureReturn PmOpAsin(x, 0)
    Case 21
      ProcedureReturn PmOpAsin(x, 1)
    Case 22
      ProcedureReturn PmOpSinh(x)
    Case 23
      ProcedureReturn PmOpCosh(x)
    Case 24
      ProcedureReturn PmOpAsinh(x)
    Case 25
      ProcedureReturn PmOpAcosh(x)
    Case 26
      ProcedureReturn PmOpAtanh(x)
  EndSelect
  PmOpStatus = 2
  ProcedureReturn x
EndProcedure

Procedure PmOpUnary(src.i, dst.i, count.i, op.i, kind.i)
  Protected i.i
  Protected b.i
  Protected v.i
  Protected x.f
  PmOpInit()
  PmOpTrigInit()
  i = 0
  If op = 16 Or op = 17
    While i < count
      b = PeekL(src + i * 4) & $7FFFFFFF
      v = 0
      If op = 16
        If b > $7F800000
          v = 1
        EndIf
      ElseIf b = $7F800000
        If (PeekL(src + i * 4) & $80000000) = 0
          v = Bool(PmOpI(0) <> 0)
        Else
          v = Bool(PmOpI(1) <> 0)
        EndIf
      EndIf
      PokeA(dst + i, v)
      i = i + 1
    Wend
    ProcedureReturn
  EndIf
  If kind <> 1
    If op <> 3 And op <> 27
      PmOpStatus = 2
      ProcedureReturn
    EndIf
    While i < count
      If op = 27 And kind = 7
        ; the complement of both 32-bit halves: exact on every target
        PokeL(dst + i * 8, PeekL(src + i * 8) ! $FFFFFFFF)
        PokeL(dst + i * 8 + 4, PeekL(src + i * 8 + 4) ! $FFFFFFFF)
      ElseIf op = 27
        PokeL(dst + i * 4, PeekL(src + i * 4) ! $FFFFFFFF)
      Else
        v = PmOpReadInt(src, i, kind)
        If v > 0
          v = 1
        ElseIf v < 0
          v = -1
        EndIf
        PmOpWriteInt(dst, i, kind, v)
      EndIf
      i = i + 1
    Wend
    ProcedureReturn
  EndIf
  While i < count
    x = PmTensorGet(src, i)
    x = PmOpUnaryValue(x, op)
    PmOpStoreF(dst, i, x)
    i = i + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; fmod(a, b) exactly (C's fmod: the sign of a). |b| is doubled to t with
; t <= |a| < 2t, then halved back down to |b|, subtracting where it fits;
; every subtraction has x in [t, 2t), so it is exact (Sterbenz), and so is
; every doubling and halving of t. NaN for a NaN, an infinite a or a zero
; b; a for an infinite b.
; ----------------------------------------------------------------------
Procedure.f PmOpFmod(a.f, b.f)
  Protected x.f
  Protected y.f
  Protected t.f
  Protected u.f
  Protected ab.i
  Protected bb.i
  ab = PmOpBits(a)
  bb = PmOpBits(b)
  If (ab & $7FFFFFFF) > $7F800000 Or (bb & $7FFFFFFF) > $7F800000
    ProcedureReturn PmOpNaN()
  EndIf
  If (ab & $7FFFFFFF) = $7F800000 Or (bb & $7FFFFFFF) = 0
    ProcedureReturn PmOpNaN()
  EndIf
  If (bb & $7FFFFFFF) = $7F800000
    ProcedureReturn a
  EndIf
  x = PmOpAbs(a)
  y = PmOpAbs(b)
  If x < y
    ProcedureReturn a
  EndIf
  t = y
  u = t + t
  While u <= x
    t = u
    u = t + t
  Wend
  While t >= y
    If x >= t
      x = x - t
    EndIf
    If t = y
      t = 0.0
    Else
      t = t * PmOpHalf
    EndIf
  Wend
  If (ab & $80000000) <> 0
    ProcedureReturn PmOpNeg(x)
  EndIf
  ProcedureReturn x
EndProcedure

; ----------------------------------------------------------------------
; Min-13, Max-13, Sum-13, Mean-13 (any number of inputs), Mod-13 and
; PRelu-16 (two), Or-7 and Xor-7 (two), with numpy broadcasting. Inputs k
; = 0..n-1 are at PmOpAddr(k) with their dims, right-aligned to Rank with
; leading ones, in PmOpDN(k*8 + d); the output dims are in PmOpDY. Every
; output element folds the inputs in order, ((in0 op in1) op in2) ...
;   op 0 Min   FLOAT: a NaN from either side wins, as numpy.minimum
;   op 1 Max   the same with the larger value
;   op 2 Sum   FLOAT a + b; INT32/INT64 with the checked INT64 contract
;   op 3 Mean  the FLOAT sum, then one division by n
;   op 4 Mod   fmod=0, integers: the sign of the divisor (Python's %)
;   op 5 Mod   fmod=1: C's fmod, the sign of the dividend; FLOAT exact
;   op 6 Or    BOOL
;   op 7 Xor   BOOL
;   op 8 PRelu x > 0: x, else x * slope (ONNX Runtime's form); in0 is X
;   op 9, 10, 11  BitwiseAnd-18, BitwiseOr-18, BitwiseXor-18 (INT32, INT64)
; A zero divisor in an integer Mod sets PmOpStatus = 4.
; ----------------------------------------------------------------------
; a + b as IEEE 754 defines it where the host compiler does not: a NaN
; operand is returned as it is (the first one), and -0 + -0 is -0.
Procedure.f PmOpAddF(a.f, b.f)
  Protected t.f
  If PmOpIsNan(a) <> 0
    ProcedureReturn a
  EndIf
  If PmOpIsNan(b) <> 0
    ProcedureReturn b
  EndIf
  t = a + b
  If (PmOpBits(t) & $7FFFFFFF) = 0
    If (PmOpBits(a) & PmOpBits(b) & $80000000) <> 0
      ProcedureReturn PmOpFromBits($80000000)
    EndIf
  EndIf
  ProcedureReturn t
EndProcedure

Procedure.f PmOpFloatFold(a.f, b.f, op.i)
  Protected t.f
  Select op
    Case 0
      If PmOpIsNan(a) <> 0
        ProcedureReturn a
      EndIf
      If PmOpIsNan(b) <> 0 Or b < a
        ProcedureReturn b
      EndIf
      ProcedureReturn a
    Case 1
      If PmOpIsNan(a) <> 0
        ProcedureReturn a
      EndIf
      If PmOpIsNan(b) <> 0 Or b > a
        ProcedureReturn b
      EndIf
      ProcedureReturn a
    Case 2
      ProcedureReturn PmOpAddF(a, b)
    Case 3
      ProcedureReturn PmOpAddF(a, b)
    Case 5
      ProcedureReturn PmOpFmod(a, b)
    Case 8
      If PmOpIsNan(a) <> 0 Or a > 0.0
        ProcedureReturn a
      EndIf
      t = a * b
      ProcedureReturn t
  EndSelect
  PmOpStatus = 2
  ProcedureReturn a
EndProcedure

Procedure.i PmOpIntFold(a.i, b.i, op.i, kind.i)
  Protected r.i
  Select op
    Case 0
      If b < a
        ProcedureReturn b
      EndIf
      ProcedureReturn a
    Case 1
      If b > a
        ProcedureReturn b
      EndIf
      ProcedureReturn a
    Case 2
      ProcedureReturn PmOpAddI(a, b, kind)
    Case 4
      If b = 0
        PmOpStatus = 4
        ProcedureReturn 0
      EndIf
      r = a % b
      If r <> 0 And ((r < 0 And b > 0) Or (r > 0 And b < 0))
        r = r + b
      EndIf
      ProcedureReturn r
    Case 5
      If b = 0
        PmOpStatus = 4
        ProcedureReturn 0
      EndIf
      ProcedureReturn a % b
    Case 6
      ProcedureReturn Bool(a <> 0 Or b <> 0)
    Case 7
      r = Bool(a <> 0)
      If b <> 0
        r = 1 - r
      EndIf
      ProcedureReturn r
    Case 8
      If a > 0
        ProcedureReturn a
      EndIf
      ProcedureReturn PmOpMulI(a, b, kind)
    Case 9
      ProcedureReturn a & b
    Case 10
      ProcedureReturn a | b
    Case 11
      ProcedureReturn a ! b
  EndSelect
  PmOpStatus = 2
  ProcedureReturn a
EndProcedure

; Strides of input k over the output's axes: 0 where the input's extent is
; one and the output's is not.
Procedure PmOpBroadcastStrides(k.i, rank.i)
  Protected d.i
  Protected s.i
  s = 1
  d = rank - 1
  While d >= 0
    If PmOpDN(k * 8 + d) = 1 And PmOpDY(d) <> 1
      PmOpStride(k * 8 + d) = 0
    Else
      PmOpStride(k * 8 + d) = s
    EndIf
    s = s * PmOpDN(k * 8 + d)
    d = d - 1
  Wend
EndProcedure

Procedure PmOpVariadic(dst.i, n.i, rank.i, op.i, kind.i)
  Protected count.i
  Protected i.i
  Protected k.i
  Protected d.i
  Protected fa.f
  Protected fb.f
  Protected ia.i
  Protected ib.i
  Protected nf.f
  PmOpInit()
  count = 1
  d = 0
  While d < rank
    PmOpCoord(d) = 0
    count = count * PmOpDY(d)
    d = d + 1
  Wend
  k = 0
  While k < n
    PmOpBroadcastStrides(k, rank)
    PmOpOffset(k) = 0
    k = k + 1
  Wend
  nf = n
  i = 0
  While i < count
    If kind = 1
      fa = PmTensorGet(PmOpAddr(0), PmOpOffset(0))
      k = 1
      While k < n
        fb = PmTensorGet(PmOpAddr(k), PmOpOffset(k))
        fa = PmOpFloatFold(fa, fb, op)
        k = k + 1
      Wend
      If op = 3
        fa = fa / nf
      EndIf
      PmOpStoreF(dst, i, fa)
    Else
      ia = PmOpReadInt(PmOpAddr(0), PmOpOffset(0), kind)
      k = 1
      While k < n
        ib = PmOpReadInt(PmOpAddr(k), PmOpOffset(k), kind)
        ia = PmOpIntFold(ia, ib, op, kind)
        k = k + 1
      Wend
      PmOpWriteInt(dst, i, kind, ia)
    EndIf
    ; advance the output coordinate and every input offset
    d = rank - 1
    While d >= 0
      PmOpCoord(d) = PmOpCoord(d) + 1
      k = 0
      While k < n
        PmOpOffset(k) = PmOpOffset(k) + PmOpStride(k * 8 + d)
        k = k + 1
      Wend
      If PmOpCoord(d) < PmOpDY(d)
        d = -1
      Else
        k = 0
        While k < n
          PmOpOffset(k) = PmOpOffset(k) - PmOpStride(k * 8 + d) * PmOpDY(d)
          k = k + 1
        Wend
        PmOpCoord(d) = 0
        d = d - 1
      EndIf
    Wend
    i = i + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; ReduceMin-20, ReduceL1-18, ReduceL2-18, ReduceSumSquare-18,
; ReduceLogSum-18 and ReduceLogSumExp-18 (and their attribute forms before
; opset 18, which reduce the same way). The input dims are in PmOpDA;
; Mask has bit d set for every reduced axis. The output holds the kept
; extents in row-major order, whether or not keepdims kept the reduced
; axes as ones. Each output combines its input elements in row-major
; order, the order the reference's numpy visits them:
;   op 0 Min         +infinity (the type's maximum for integers) over the
;                    empty set; a FLOAT NaN wins
;   op 1 L1          sum of |x|, 0 over the empty set
;   op 2 L2          sqrt of the sum of x*x (FLOAT)
;   op 3 SumSquare   sum of x*x
;   op 4 LogSum      log of the sum (FLOAT), -infinity over the empty set
;   op 5 LogSumExp   m + log(sum exp(x - m)) with m the largest element, the
;                    overflow-free form ONNX Runtime uses; -infinity over the
;                    empty set
; INT32 and INT64 for Min, L1 and SumSquare, with the checked INT64
; contract.
; ----------------------------------------------------------------------
Procedure PmOpReduce(src.i, dst.i, rank.i, mask.i, op.i, kind.i)
  Protected d.i
  Protected s.i
  Protected outCount.i
  Protected inner.i
  Protected o.i
  Protected j.i
  Protected n.i
  Protected base.i
  Protected at.i
  Protected coord.i
  Protected pass.i
  Protected acc.f
  Protected m.f
  Protected x.f
  Protected t.f
  Protected ia.i
  Protected iv.i
  PmOpInit()
  ; strides of the input, the kept and the reduced counts
  s = 1
  outCount = 1
  inner = 1
  d = rank - 1
  While d >= 0
    PmOpStride(d) = s
    s = s * PmOpDA(d)
    If ((mask >> d) & 1) <> 0
      inner = inner * PmOpDA(d)
    Else
      outCount = outCount * PmOpDA(d)
    EndIf
    d = d - 1
  Wend
  o = 0
  While o < outCount
    ; the input offset of output o: its kept coordinates, reduced ones at 0
    base = 0
    n = o
    d = rank - 1
    While d >= 0
      If ((mask >> d) & 1) = 0
        coord = n % PmOpDA(d)
        n = n / PmOpDA(d)
        base = base + coord * PmOpStride(d)
      EndIf
      d = d - 1
    Wend
    If kind = 1
      m = PmOpNeg(PmOpInfinity)
      pass = 0
      If op = 5
        pass = 1
      EndIf
      While pass >= 0
        If op = 0
          acc = PmOpInfinity
        ElseIf op = 4 Or (op = 5 And pass = 0)
          acc = 0.0
        Else
          acc = 0.0
        EndIf
        j = 0
        While j < inner
          ; the offset of the j-th reduced element in row-major order
          at = base
          n = j
          d = rank - 1
          While d >= 0
            If ((mask >> d) & 1) <> 0
              coord = n % PmOpDA(d)
              n = n / PmOpDA(d)
              at = at + coord * PmOpStride(d)
            EndIf
            d = d - 1
          Wend
          x = PmTensorGet(src, at)
          Select op
            Case 0
              If PmOpIsNan(acc) = 0
                If PmOpIsNan(x) <> 0 Or x < acc
                  acc = x
                EndIf
              EndIf
            Case 1
              t = PmOpAbs(x)
              acc = acc + t
            Case 2
              t = x * x
              acc = acc + t
            Case 3
              t = x * x
              acc = acc + t
            Case 4
              acc = acc + x
            Case 5
              If pass = 1
                If PmOpIsNan(m) = 0
                  If PmOpIsNan(x) <> 0 Or x > m
                    m = x
                  EndIf
                EndIf
              Else
                t = x - m
                t = PmOpExp(t)
                acc = acc + t
              EndIf
          EndSelect
          j = j + 1
        Wend
        pass = pass - 1
      Wend
      Select op
        Case 2
          acc = PmOpSqrt(acc)
        Case 4
          acc = PmOpLog(acc)
        Case 5
          If inner = 0
            acc = PmOpNeg(PmOpInfinity)
          ElseIf PmOpIsNan(m) <> 0 Or (PmOpBits(m) & $7FFFFFFF) = $7F800000
            acc = m
          Else
            acc = PmOpLog(acc)
            acc = m + acc
          EndIf
      EndSelect
      PmOpStoreF(dst, o, acc)
    Else
      If op = 0
        If kind = 6
          ia = 2147483647
        Else
          CompilerIf #PMO_OPS_INT32 = 1
            ia = 2147483647
          CompilerElse
            ia = 9223372036854775807
          CompilerEndIf
        EndIf
      Else
        ia = 0
      EndIf
      j = 0
      While j < inner
        at = base
        n = j
        d = rank - 1
        While d >= 0
          If ((mask >> d) & 1) <> 0
            coord = n % PmOpDA(d)
            n = n / PmOpDA(d)
            at = at + coord * PmOpStride(d)
          EndIf
          d = d - 1
        Wend
        iv = PmOpReadInt(src, at, kind)
        Select op
          Case 0
            If iv < ia
              ia = iv
            EndIf
          Case 1
            If iv < 0
              iv = 0 - iv
            EndIf
            ia = PmOpAddI(ia, iv, kind)
          Default
            iv = PmOpMulI(iv, iv, kind)
            ia = PmOpAddI(ia, iv, kind)
        EndSelect
        j = j + 1
      Wend
      PmOpWriteInt(dst, o, kind, ia)
    EndIf
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; ArgMax-13 (op 0) and ArgMin-13 (op 1) along one axis of an
; (Outer, Width, Inner) view; INT64 indices. Ties give the first index, or
; the last with select_last_index = 1. FLOAT: the first NaN wins, as
; numpy.argmax does. Width must be at least 1.
; ----------------------------------------------------------------------
Procedure PmOpArg(src.i, dst.i, outer.i, width.i, inner.i, op.i, lastIndex.i, kind.i)
  Protected o.i
  Protected i.i
  Protected j.i
  Protected best.i
  Protected at.i
  Protected take.i
  Protected fb.f
  Protected fx.f
  Protected ib.i
  Protected ix.i
  PmOpInit()
  o = 0
  While o < outer
    i = 0
    While i < inner
      at = o * width * inner + i
      best = 0
      If kind = 1
        fb = PmTensorGet(src, at)
      Else
        ib = PmOpReadInt(src, at, kind)
      EndIf
      j = 1
      While j < width
        take = 0
        If kind = 1
          fx = PmTensorGet(src, at + j * inner)
          If PmOpIsNan(fb) = 0
            If PmOpIsNan(fx) <> 0
              take = 1
            ElseIf op = 0
              If fx > fb Or (lastIndex <> 0 And fx = fb)
                take = 1
              EndIf
            Else
              If fx < fb Or (lastIndex <> 0 And fx = fb)
                take = 1
              EndIf
            EndIf
          EndIf
          If take <> 0
            fb = fx
          EndIf
        Else
          ix = PmOpReadInt(src, at + j * inner, kind)
          If op = 0
            If ix > ib Or (lastIndex <> 0 And ix = ib)
              take = 1
            EndIf
          Else
            If ix < ib Or (lastIndex <> 0 And ix = ib)
              take = 1
            EndIf
          EndIf
          If take <> 0
            ib = ix
          EndIf
        EndIf
        If take <> 0
          best = j
        EndIf
        j = j + 1
      Wend
      PmTensorPutI64(dst, o * inner + i, best)
      i = i + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; LogSoftmax-13 along one axis of an (Outer, Width, Inner) view:
; y = (x - m) - log(sum exp(x - m)), m the largest element of the slice,
; the sum in index order.
; ----------------------------------------------------------------------
Procedure PmOpLogSoftmax(src.i, dst.i, outer.i, width.i, inner.i)
  Protected o.i
  Protected i.i
  Protected j.i
  Protected at.i
  Protected m.f
  Protected x.f
  Protected s.f
  Protected t.f
  Protected l.f
  PmOpInit()
  o = 0
  While o < outer
    i = 0
    While i < inner
      at = o * width * inner + i
      m = PmOpNeg(PmOpInfinity)
      j = 0
      While j < width
        x = PmTensorGet(src, at + j * inner)
        If PmOpIsNan(m) = 0
          If PmOpIsNan(x) <> 0 Or x > m
            m = x
          EndIf
        EndIf
        j = j + 1
      Wend
      s = 0.0
      j = 0
      While j < width
        x = PmTensorGet(src, at + j * inner)
        t = x - m
        t = PmOpExp(t)
        s = s + t
        j = j + 1
      Wend
      l = PmOpLog(s)
      j = 0
      While j < width
        x = PmTensorGet(src, at + j * inner)
        t = x - m
        t = t - l
        PmOpStoreF(dst, at + j * inner, t)
        j = j + 1
      Wend
      i = i + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; MaxPool-12, AveragePool-19, LpPool-18 and their global forms
; (GlobalMaxPool-1, GlobalAveragePool-1, GlobalLpPool-2), over an
; (N, C, D1 ... Ds) input with s = 1, 2 or 3 spatial axes. The caller has
; resolved auto_pad and ceil_mode into explicit output extents and begin
; and end pads, so the kernel only walks windows. Parameters in PmOpI:
;   0 s        1 N        2 C
;   3 mode: 0 max, 1 average, 2 Lp
;   4 count_include_pad (average)   5 p (Lp: 1, 2 or larger)
;   6 storage_order (MaxPool indices: 0 row-major, 1 column-major)
;   8+d input extent   12+d output extent   16+d kernel   20+d stride
;   24+d dilation      28+d begin pad       32+d end pad
; For output position o and kernel offset k on axis d the input coordinate
; is o*stride - begin + k*dilation. A window position outside the input is
; skipped; for average it still counts when count_include_pad = 1 and it
; lies inside the padded extent [-begin, input + end).
;   max       the largest element, ONNX Runtime's rule: an element replaces
;             the running maximum when it is greater, so the first of equal
;             elements is kept, and the Indices output (INT64, optional)
;             holds its offset in the flattened input, batch and channel
;             included; column-major over the spatial axes with
;             storage_order = 1. A window with no input element gives the
;             lowest finite value and index -1
;   average   the sum in window order, then one division by the count (NaN
;             for a window that counts nothing)
;   Lp        (sum |x|^p)^(1/p): p = 1 the sum of |x|, p = 2 the square
;             root of the sum of squares, otherwise exp(log(sum)/p) with
;             |x|^p = exp(p*log|x|)
; ----------------------------------------------------------------------
Procedure PmOpPool(src.i, dst.i, indices.i)
  Protected s.i
  Protected d.i
  Protected planes.i
  Protected plane.i
  Protected inPlane.i
  Protected outPlane.i
  Protected o.i
  Protected n.i
  Protected windows.i
  Protected w.i
  Protected q.i
  Protected valid.i
  Protected inside.i
  Protected counted.i
  Protected at.i
  Protected bestAt.i
  Protected c.i
  Protected colStride.i
  Protected rowStride.i
  Protected flat.i
  Protected acc.f
  Protected x.f
  Protected t.f
  Protected pf.f
  Protected cf.f
  PmOpInit()
  s = PmOpI(0)
  planes = PmOpI(1) * PmOpI(2)
  inPlane = 1
  outPlane = 1
  windows = 1
  d = 0
  While d < s
    inPlane = inPlane * PmOpI(8 + d)
    outPlane = outPlane * PmOpI(12 + d)
    windows = windows * PmOpI(16 + d)
    d = d + 1
  Wend
  pf = PmOpI(5)
  plane = 0
  While plane < planes
    o = 0
    While o < outPlane
      ; output coordinates of o, into PmOpCoord(0 .. s-1)
      n = o
      d = s - 1
      While d >= 0
        PmOpCoord(d) = n % PmOpI(12 + d)
        n = n / PmOpI(12 + d)
        d = d - 1
      Wend
      acc = 0.0
      If PmOpI(3) = 0
        acc = PmOpNeg(PmOpFromBits($7F7FFFFF))
      EndIf
      bestAt = -1
      counted = 0
      w = 0
      While w < windows
        ; window offset w into kernel coordinates, then input coordinates
        n = w
        valid = 1
        inside = 1
        at = 0
        d = s - 1
        While d >= 0
          q = n % PmOpI(16 + d)
          n = n / PmOpI(16 + d)
          q = PmOpCoord(d) * PmOpI(20 + d) - PmOpI(28 + d) + q * PmOpI(24 + d)
          If q < 0 Or q >= PmOpI(8 + d)
            valid = 0
            If q < 0 - PmOpI(28 + d) Or q >= PmOpI(8 + d) + PmOpI(32 + d)
              inside = 0
            EndIf
          EndIf
          PmOpOffset(d) = q
          d = d - 1
        Wend
        If valid <> 0
          ; row-major offset within the plane
          at = 0
          d = 0
          While d < s
            at = at * PmOpI(8 + d) + PmOpOffset(d)
            d = d + 1
          Wend
          x = PmTensorGet(src, plane * inPlane + at)
          Select PmOpI(3)
            Case 0
              If PmOpIsNan(x) = 0 And x > acc
                acc = x
                bestAt = at
              EndIf
            Case 1
              acc = acc + x
            Default
              x = PmOpAbs(x)
              If PmOpI(5) = 1
                acc = acc + x
              ElseIf PmOpI(5) = 2
                t = x * x
                acc = acc + t
              ElseIf (PmOpBits(x) & $7FFFFFFF) <> 0
                t = PmOpLog(x)
                t = pf * t
                t = PmOpExp(t)
                acc = acc + t
              EndIf
          EndSelect
          counted = counted + 1
        ElseIf inside <> 0 And PmOpI(4) <> 0
          counted = counted + 1
        EndIf
        w = w + 1
      Wend
      If PmOpI(3) = 1
        If counted > 0
          cf = counted
          acc = acc / cf
        Else
          acc = PmOpNaN()
        EndIf
      ElseIf PmOpI(3) = 2
        If PmOpI(5) = 2
          acc = PmOpSqrt(acc)
        ElseIf PmOpI(5) > 2 And (PmOpBits(acc) & $7FFFFFFF) <> 0
          t = PmOpLog(acc)
          t = t / pf
          acc = PmOpExp(t)
        EndIf
      EndIf
      PmOpStoreF(dst, plane * outPlane + o, acc)
      If indices <> 0
        flat = -1
        If bestAt >= 0
          If PmOpI(6) = 0
            flat = plane * inPlane + bestAt
          Else
            ; column-major over the spatial axes: the first axis varies fastest
            n = bestAt
            d = s - 1
            While d >= 0
              PmOpOffset(d) = n % PmOpI(8 + d)
              n = n / PmOpI(8 + d)
              d = d - 1
            Wend
            flat = 0
            d = s - 1
            While d >= 0
              flat = flat * PmOpI(8 + d) + PmOpOffset(d)
              d = d - 1
            Wend
            flat = plane * inPlane + flat
          EndIf
        EndIf
        PmTensorPutI64(indices, plane * outPlane + o, flat)
      EndIf
      o = o + 1
    Wend
    plane = plane + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; Data movement. Elements are copied as bytes of the given width, so these
; kernels serve every element type and change no value.
; ----------------------------------------------------------------------

; A copy of one element of Bytes (1, 4 or 8) from src to dst.
Procedure PmOpCopyElement(src.i, dst.i, bytes.i)
  If bytes = 4
    PokeL(dst, PeekL(src))
  ElseIf bytes = 8
    PokeL(dst, PeekL(src))
    PokeL(dst + 4, PeekL(src + 4))
  Else
    PokeA(dst, PeekA(src))
  EndIf
EndProcedure

; Transpose-style permutation: output axis d is input axis PmOpI(40 + d).
; Input dims in PmOpDA; the output dims follow. DepthToSpace-13 and
; SpaceToDepth-13 are this permutation of a rank-6 view of the input.
Procedure PmOpPermute(src.i, dst.i, rank.i, bytes.i)
  Protected d.i
  Protected s.i
  Protected count.i
  Protected i.i
  Protected at.i
  s = 1
  d = rank - 1
  While d >= 0
    PmOpStride(d) = s
    s = s * PmOpDA(d)
    d = d - 1
  Wend
  count = s
  d = 0
  While d < rank
    PmOpDY(d) = PmOpDA(PmOpI(40 + d))
    PmOpStride(16 + d) = PmOpStride(PmOpI(40 + d))
    PmOpCoord(d) = 0
    d = d + 1
  Wend
  at = 0
  i = 0
  While i < count
    PmOpCopyElement(src + at * bytes, dst + i * bytes, bytes)
    d = rank - 1
    While d >= 0
      PmOpCoord(d) = PmOpCoord(d) + 1
      at = at + PmOpStride(16 + d)
      If PmOpCoord(d) < PmOpDY(d)
        d = -1
      Else
        at = at - PmOpStride(16 + d) * PmOpDY(d)
        PmOpCoord(d) = 0
        d = d - 1
      EndIf
    Wend
    i = i + 1
  Wend
EndProcedure

; Tile-13: output dims in PmOpDY, input dims in PmOpDA; output coordinate
; c reads input coordinate c mod extent on every axis.
Procedure PmOpTile(src.i, dst.i, rank.i, bytes.i)
  Protected d.i
  Protected s.i
  Protected count.i
  Protected i.i
  Protected n.i
  Protected at.i
  s = 1
  count = 1
  d = rank - 1
  While d >= 0
    PmOpStride(d) = s
    s = s * PmOpDA(d)
    count = count * PmOpDY(d)
    d = d - 1
  Wend
  i = 0
  While i < count
    n = i
    at = 0
    d = rank - 1
    While d >= 0
      at = at + ((n % PmOpDY(d)) % PmOpDA(d)) * PmOpStride(d)
      n = n / PmOpDY(d)
      d = d - 1
    Wend
    PmOpCopyElement(src + at * bytes, dst + i * bytes, bytes)
    i = i + 1
  Wend
EndProcedure

; Split-18 (and -13, -11, -2): one output, the Width elements from Offset
; along the axis of an (Outer, SrcWidth, Inner) view.
Procedure PmOpSlab(src.i, dst.i, outer.i, srcWidth.i, offset.i, width.i, inner.i, bytes.i)
  Protected o.i
  Protected run.i
  run = width * inner * bytes
  o = 0
  While o < outer
    PmOpCopyBytes(src + ((o * srcWidth + offset) * inner) * bytes, dst + o * run, run)
    o = o + 1
  Wend
EndProcedure

; Trilu-14 over the last two axes of a (Batch, Rows, Cols) view: element
; (i, j) is kept when j - i >= K (Upper = 1) or j - i <= K (Upper = 0), and
; zero otherwise.
Procedure PmOpTrilu(src.i, dst.i, batch.i, rows.i, cols.i, k.i, upper.i, bytes.i)
  Protected b.i
  Protected i.i
  Protected j.i
  Protected at.i
  Protected keep.i
  b = 0
  While b < batch
    i = 0
    While i < rows
      j = 0
      While j < cols
        at = ((b * rows + i) * cols + j) * bytes
        If upper <> 0
          keep = Bool(j - i >= k)
        Else
          keep = Bool(j - i <= k)
        EndIf
        If keep <> 0
          PmOpCopyElement(src + at, dst + at, bytes)
        ElseIf bytes = 1
          PokeA(dst + at, 0)
        ElseIf bytes = 4
          PokeL(dst + at, 0)
        Else
          PokeL(dst + at, 0)
          PokeL(dst + at + 4, 0)
        EndIf
        j = j + 1
      Wend
      i = i + 1
    Wend
    b = b + 1
  Wend
EndProcedure

; GatherElements-13: data dims in PmOpDA, indices (and output) dims in
; PmOpDB. Output element c reads data at c with its Axis coordinate
; replaced by the index there (negative counts from the end). Returns 1 for
; an index outside [-s, s-1], 0 otherwise.
Procedure.i PmOpGatherElements(source.i, indices.i, dst.i, rank.i, axis.i, bytes.i, indexKind.i)
  Protected d.i
  Protected s.i
  Protected count.i
  Protected i.i
  Protected n.i
  Protected at.i
  Protected coord.i
  Protected v.i
  s = 1
  count = 1
  d = rank - 1
  While d >= 0
    PmOpStride(d) = s
    s = s * PmOpDA(d)
    count = count * PmOpDB(d)
    d = d - 1
  Wend
  i = 0
  While i < count
    n = i
    at = 0
    d = rank - 1
    While d >= 0
      coord = n % PmOpDB(d)
      n = n / PmOpDB(d)
      If d = axis
        v = PmOpReadInt(indices, i, indexKind)
        If v < 0
          v = v + PmOpDA(d)
        EndIf
        If v < 0 Or v >= PmOpDA(d)
          ProcedureReturn 1
        EndIf
        coord = v
      EndIf
      at = at + coord * PmOpStride(d)
      d = d - 1
    Wend
    PmOpCopyElement(source + at * bytes, dst + i * bytes, bytes)
    i = i + 1
  Wend
  ProcedureReturn 0
EndProcedure

; GatherND-13: PmOpI(0) batch_dims b, PmOpI(1) data rank r, PmOpI(2)
; indices rank q; data dims in PmOpDA, indices dims in PmOpDB, k =
; PmOpDB(q-1). Every index tuple picks a slice of the data's axes b+k .. r-1
; within its batch. Returns 1 for an index outside [-s, s-1].
Procedure.i PmOpGatherND(source.i, indices.i, dst.i, bytes.i, indexKind.i)
  Protected b.i
  Protected r.i
  Protected q.i
  Protected k.i
  Protected d.i
  Protected batches.i
  Protected tuples.i
  Protected slice.i
  Protected perBatch.i
  Protected bi.i
  Protected t.i
  Protected j.i
  Protected v.i
  Protected offset.i
  Protected row.i
  b = PmOpI(0)
  r = PmOpI(1)
  q = PmOpI(2)
  k = PmOpDB(q - 1)
  batches = 1
  d = 0
  While d < b
    batches = batches * PmOpDB(d)
    d = d + 1
  Wend
  tuples = 1
  d = b
  While d < q - 1
    tuples = tuples * PmOpDB(d)
    d = d + 1
  Wend
  slice = 1
  d = b + k
  While d < r
    slice = slice * PmOpDA(d)
    d = d + 1
  Wend
  perBatch = 1
  d = b
  While d < r
    perBatch = perBatch * PmOpDA(d)
    d = d + 1
  Wend
  bi = 0
  While bi < batches
    t = 0
    While t < tuples
      row = (bi * tuples + t) * k
      offset = 0
      j = 0
      While j < k
        v = PmOpReadInt(indices, row + j, indexKind)
        If v < 0
          v = v + PmOpDA(b + j)
        EndIf
        If v < 0 Or v >= PmOpDA(b + j)
          ProcedureReturn 1
        EndIf
        offset = offset * PmOpDA(b + j) + v
        j = j + 1
      Wend
      offset = offset * slice
      PmOpCopyBytes(source + (bi * perBatch + offset) * bytes, dst + ((bi * tuples + t) * slice) * bytes, slice * bytes)
      t = t + 1
    Wend
    bi = bi + 1
  Wend
  ProcedureReturn 0
EndProcedure

; OneHot-11 over an (Outer, Inner) view of the indices, the new axis of
; extent Depth between them. An index is truncated toward zero (FLOAT
; indices), a negative one counts from Depth; one outside [-depth,
; depth-1] gives a row of off values. Values: PmOpF(0)/PmOpF(1) (off, on)
; for FLOAT output, PmOpI(0)/PmOpI(1) for INT32/INT64/BOOL.
Procedure PmOpOneHot(indices.i, dst.i, outer.i, depth.i, inner.i, indexKind.i, outKind.i)
  Protected o.i
  Protected i.i
  Protected d.i
  Protected v.i
  Protected at.i
  PmOpInit()
  o = 0
  While o < outer
    i = 0
    While i < inner
      If indexKind = 1
        v = PmOpTruncInt(PmTensorGet(indices, o * inner + i))
      Else
        v = PmOpReadInt(indices, o * inner + i, indexKind)
      EndIf
      If v < 0
        v = v + depth
      EndIf
      d = 0
      While d < depth
        at = (o * depth + d) * inner + i
        If outKind = 1
          If d = v
            PmTensorPut(dst, at, PmOpF(1))
          Else
            PmTensorPut(dst, at, PmOpF(0))
          EndIf
        ElseIf d = v
          PmOpWriteInt(dst, at, outKind, PmOpI(1))
        Else
          PmOpWriteInt(dst, at, outKind, PmOpI(0))
        EndIf
        d = d + 1
      Wend
      i = i + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; Einsum-12, FLOAT, one to four operands. The caller has parsed the
; equation into labels: PmOpI(0) operands n, PmOpI(1) labels L (at most
; 16), PmOpI(2) output labels Lo. Labels 0 .. Lo-1 are the output's axes in
; order; Lo .. L-1 are summed over. PmOpI(4 + l) is label l's extent and
; PmOpI(20 + k*16 + l) operand k's element stride for it (the sum of the
; strides of every axis of operand k carrying the label, so a repeated
; label reads a diagonal; 0 when the operand lacks it). Operand k is at
; PmOpAddr(k). Every output element is the sum, over the summed labels in
; row-major order, of the product of the operands' elements in operand
; order; 0 for an empty sum.
; ----------------------------------------------------------------------
Procedure PmOpEinsum(dst.i)
  Protected n.i
  Protected labels.i
  Protected kept.i
  Protected outCount.i
  Protected sumCount.i
  Protected o.i
  Protected c.i
  Protected l.i
  Protected k.i
  Protected v.i
  Protected coord.i
  Protected acc.f
  Protected p.f
  Protected x.f
  PmOpInit()
  n = PmOpI(0)
  labels = PmOpI(1)
  kept = PmOpI(2)
  outCount = 1
  l = 0
  While l < kept
    outCount = outCount * PmOpI(4 + l)
    l = l + 1
  Wend
  sumCount = 1
  l = kept
  While l < labels
    sumCount = sumCount * PmOpI(4 + l)
    l = l + 1
  Wend
  o = 0
  While o < outCount
    ; operand offsets of the output labels' coordinates
    k = 0
    While k < n
      PmOpOffset(k) = 0
      k = k + 1
    Wend
    v = o
    l = kept - 1
    While l >= 0
      coord = v % PmOpI(4 + l)
      v = v / PmOpI(4 + l)
      k = 0
      While k < n
        PmOpOffset(k) = PmOpOffset(k) + coord * PmOpI(20 + k * 16 + l)
        k = k + 1
      Wend
      l = l - 1
    Wend
    acc = 0.0
    c = 0
    While c < sumCount
      k = 0
      While k < n
        PmOpOffset(8 + k) = PmOpOffset(k)
        k = k + 1
      Wend
      v = c
      l = labels - 1
      While l >= kept
        coord = v % PmOpI(4 + l)
        v = v / PmOpI(4 + l)
        k = 0
        While k < n
          PmOpOffset(8 + k) = PmOpOffset(8 + k) + coord * PmOpI(20 + k * 16 + l)
          k = k + 1
        Wend
        l = l - 1
      Wend
      p = PmTensorGet(PmOpAddr(0), PmOpOffset(8))
      k = 1
      While k < n
        x = PmTensorGet(PmOpAddr(k), PmOpOffset(8 + k))
        p = p * x
        k = k + 1
      Wend
      acc = acc + p
      c = c + 1
    Wend
    PmOpStoreF(dst, o, acc)
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; Hardmax-13 along one axis of an (Outer, Width, Inner) view: 1 at the first
; largest element (the first NaN, as numpy.argmax), 0 elsewhere.
; ----------------------------------------------------------------------
Procedure PmOpHardmax(src.i, dst.i, outer.i, width.i, inner.i)
  Protected o.i
  Protected i.i
  Protected j.i
  Protected at.i
  Protected best.i
  Protected fb.f
  Protected fx.f
  PmOpInit()
  o = 0
  While o < outer
    i = 0
    While i < inner
      at = o * width * inner + i
      best = 0
      fb = PmTensorGet(src, at)
      j = 1
      While j < width
        fx = PmTensorGet(src, at + j * inner)
        If PmOpIsNan(fb) = 0
          If PmOpIsNan(fx) <> 0 Or fx > fb
            fb = fx
            best = j
          EndIf
        EndIf
        j = j + 1
      Wend
      j = 0
      While j < width
        If j = best
          PmTensorPut(dst, at + j * inner, PmOpOne)
        Else
          PmTensorPut(dst, at + j * inner, 0.0)
        EndIf
        j = j + 1
      Wend
      i = i + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; LpNormalization-1, p 1 or 2, along one axis: x / norm with the norm
; sum |x| or sqrt(sum x*x) in index order; 0 where the norm is 0, as the
; reference does.
; ----------------------------------------------------------------------
Procedure PmOpLpNorm(src.i, dst.i, outer.i, width.i, inner.i, p.i)
  Protected o.i
  Protected i.i
  Protected j.i
  Protected at.i
  Protected acc.f
  Protected x.f
  Protected t.f
  PmOpInit()
  o = 0
  While o < outer
    i = 0
    While i < inner
      at = o * width * inner + i
      acc = 0.0
      j = 0
      While j < width
        x = PmTensorGet(src, at + j * inner)
        If p = 1
          t = PmOpAbs(x)
        Else
          t = x * x
        EndIf
        acc = acc + t
        j = j + 1
      Wend
      If p <> 1
        acc = PmOpSqrt(acc)
      EndIf
      j = 0
      While j < width
        x = PmTensorGet(src, at + j * inner)
        If (PmOpBits(acc) & $7FFFFFFF) = 0
          PmTensorPut(dst, at + j * inner, 0.0)
        Else
          t = x / acc
          PmOpStoreF(dst, at + j * inner, t)
        EndIf
        j = j + 1
      Wend
      i = i + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; MeanVarianceNormalization-13 over the axes in Mask (dims in PmOpDA), the
; specification's function body step by step: m = mean(x), v = mean(x*x) -
; m*m, y = (x - m) / (sqrt(v) + 1e-9); the means are sums in row-major order
; divided once by the count.
; ----------------------------------------------------------------------
Procedure PmOpMvn(src.i, dst.i, rank.i, mask.i)
  Protected d.i
  Protected s.i
  Protected outCount.i
  Protected inner.i
  Protected o.i
  Protected j.i
  Protected n.i
  Protected base.i
  Protected at.i
  Protected coord.i
  Protected pass.i
  Protected sum.f
  Protected sq.f
  Protected x.f
  Protected t.f
  Protected mean.f
  Protected cf.f
  Protected sd.f
  PmOpInit()
  s = 1
  outCount = 1
  inner = 1
  d = rank - 1
  While d >= 0
    PmOpStride(d) = s
    s = s * PmOpDA(d)
    If ((mask >> d) & 1) <> 0
      inner = inner * PmOpDA(d)
    Else
      outCount = outCount * PmOpDA(d)
    EndIf
    d = d - 1
  Wend
  cf = inner
  o = 0
  While o < outCount
    base = 0
    n = o
    d = rank - 1
    While d >= 0
      If ((mask >> d) & 1) = 0
        coord = n % PmOpDA(d)
        n = n / PmOpDA(d)
        base = base + coord * PmOpStride(d)
      EndIf
      d = d - 1
    Wend
    pass = 0
    While pass < 2
      sum = 0.0
      sq = 0.0
      j = 0
      While j < inner
        at = base
        n = j
        d = rank - 1
        While d >= 0
          If ((mask >> d) & 1) <> 0
            coord = n % PmOpDA(d)
            n = n / PmOpDA(d)
            at = at + coord * PmOpStride(d)
          EndIf
          d = d - 1
        Wend
        x = PmTensorGet(src, at)
        If pass = 0
          sum = sum + x
          t = x * x
          sq = sq + t
        Else
          t = x - mean
          t = t / sd
          PmOpStoreF(dst, at, t)
        EndIf
        j = j + 1
      Wend
      If pass = 0
        mean = sum / cf
        sq = sq / cf
        t = mean * mean
        sq = sq - t
        sd = PmOpSqrt(sq)
        sd = sd + PmOpFromBits($3089705F)
      EndIf
      pass = pass + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; LRN-13 over the channels of an (N, C, Spatial) view: square_sum over the
; channels c - floor((size-1)/2) .. c + ceil((size-1)/2) inside the tensor,
; in channel order; y = x / (bias + (alpha/size)*square_sum)^beta, the power
; as exp(beta * log(.)). F0 alpha, F1 beta, F2 bias.
; ----------------------------------------------------------------------
Procedure PmOpLrn(src.i, dst.i, batches.i, channels.i, spatial.i, size.i)
  Protected n.i
  Protected c.i
  Protected s.i
  Protected k.i
  Protected lo.i
  Protected hi.i
  Protected at.i
  Protected acc.f
  Protected x.f
  Protected t.f
  Protected scale.f
  Protected sf.f
  PmOpInit()
  sf = size
  scale = PmOpF(0) / sf
  n = 0
  While n < batches
    c = 0
    While c < channels
      lo = c - (size - 1) / 2
      hi = c + size / 2
      If lo < 0
        lo = 0
      EndIf
      If hi > channels - 1
        hi = channels - 1
      EndIf
      s = 0
      While s < spatial
        acc = 0.0
        k = lo
        While k <= hi
          x = PmTensorGet(src, (n * channels + k) * spatial + s)
          t = x * x
          acc = acc + t
          k = k + 1
        Wend
        t = scale * acc
        t = PmOpF(2) + t
        t = PmOpLog(t)
        t = PmOpF(1) * t
        t = PmOpExp(t)
        at = (n * channels + c) * spatial + s
        x = PmTensorGet(src, at)
        t = x / t
        PmOpStoreF(dst, at, t)
        s = s + 1
      Wend
      c = c + 1
    Wend
    n = n + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; GroupNormalization-18 (the definition through opset 20: scale and bias
; per group) over an (N, C, Spatial) view: per sample and group, mean and
; variance (the mean of (x - mean)^2) over the group's channels and the
; spatial extent in row-major order; y = ((x - mean) / sqrt(var + epsilon))
; * scale[g] + bias[g]. F0 epsilon.
; ----------------------------------------------------------------------
Procedure PmOpGroupNorm(src.i, scale.i, bias.i, dst.i, batches.i, channels.i, spatial.i, groups.i)
  Protected n.i
  Protected g.i
  Protected per.i
  Protected k.i
  Protected first.i
  Protected acc.f
  Protected x.f
  Protected t.f
  Protected mean.f
  Protected cf.f
  Protected den.f
  PmOpInit()
  per = (channels / groups) * spatial
  cf = per
  n = 0
  While n < batches
    g = 0
    While g < groups
      first = (n * channels + g * (channels / groups)) * spatial
      acc = 0.0
      k = 0
      While k < per
        x = PmTensorGet(src, first + k)
        acc = acc + x
        k = k + 1
      Wend
      mean = acc / cf
      acc = 0.0
      k = 0
      While k < per
        x = PmTensorGet(src, first + k)
        t = x - mean
        t = t * t
        acc = acc + t
        k = k + 1
      Wend
      t = acc / cf
      t = t + PmOpF(0)
      den = PmOpSqrt(t)
      k = 0
      While k < per
        x = PmTensorGet(src, first + k)
        t = x - mean
        t = t / den
        t = t * PmTensorGet(scale, g)
        t = t + PmTensorGet(bias, g)
        PmOpStoreF(dst, first + k, t)
        k = k + 1
      Wend
      g = g + 1
    Wend
    n = n + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; EyeLike-9: ones where column = row + K, zeros elsewhere, Rows x Cols.
; ----------------------------------------------------------------------
Procedure PmOpEyeLike(dst.i, rows.i, cols.i, k.i, kind.i)
  Protected i.i
  Protected j.i
  PmOpInit()
  i = 0
  While i < rows
    j = 0
    While j < cols
      If kind = 1
        If j - i = k
          PmTensorPut(dst, i * cols + j, PmOpOne)
        Else
          PmTensorPut(dst, i * cols + j, 0.0)
        EndIf
      Else
        PmOpWriteInt(dst, i * cols + j, kind, Bool(j - i = k))
      EndIf
      j = j + 1
    Wend
    i = i + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; Det-11 of Batch square matrices of order N: Gaussian elimination with
; partial pivoting (the first largest |pivot| of the column) on a copy in
; Scratch (N*N floats), the determinant the product of the pivots in order,
; negated per row exchange.
; ----------------------------------------------------------------------
Procedure PmOpDet(src.i, dst.i, batch.i, n.i, scratch.i)
  Protected b.i
  Protected i.i
  Protected j.i
  Protected k.i
  Protected p.i
  Protected swaps.i
  Protected det.f
  Protected a.f
  Protected m.f
  Protected t.f
  Protected pv.f
  PmOpInit()
  b = 0
  While b < batch
    i = 0
    While i < n * n
      PmTensorPut(scratch, i, PmTensorGet(src, b * n * n + i))
      i = i + 1
    Wend
    det = PmOpOne
    swaps = 0
    k = 0
    While k < n
      p = k
      a = PmOpAbs(PmTensorGet(scratch, k * n + k))
      i = k + 1
      While i < n
        t = PmOpAbs(PmTensorGet(scratch, i * n + k))
        If PmOpIsNan(t) = 0 And t > a
          a = t
          p = i
        EndIf
        i = i + 1
      Wend
      If p <> k
        j = 0
        While j < n
          t = PmTensorGet(scratch, k * n + j)
          PmTensorPut(scratch, k * n + j, PmTensorGet(scratch, p * n + j))
          PmTensorPut(scratch, p * n + j, t)
          j = j + 1
        Wend
        swaps = swaps + 1
      EndIf
      pv = PmTensorGet(scratch, k * n + k)
      det = det * pv
      If (PmOpBits(pv) & $7FFFFFFF) <> 0
        i = k + 1
        While i < n
          m = PmTensorGet(scratch, i * n + k)
          m = m / pv
          j = k + 1
          While j < n
            t = m * PmTensorGet(scratch, k * n + j)
            t = PmTensorGet(scratch, i * n + j) - t
            PmTensorPut(scratch, i * n + j, t)
            j = j + 1
          Wend
          i = i + 1
        Wend
      EndIf
      k = k + 1
    Wend
    If (swaps & 1) <> 0
      det = PmOpNeg(det)
    EndIf
    PmOpStoreF(dst, b, det)
    b = b + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; Compress-11: the slices i of an (Outer, Width, Inner) view with Cond[i]
; true, i below CondCount and Width, in order. Returns the number kept.
; ----------------------------------------------------------------------
Procedure.i PmOpCompress(src.i, cond.i, dst.i, outer.i, width.i, inner.i, bytes.i, condCount.i)
  Protected o.i
  Protected i.i
  Protected kept.i
  Protected run.i
  Protected at.i
  run = inner * bytes
  kept = 0
  i = 0
  While i < width And i < condCount
    If PeekA(cond + i) <> 0
      kept = kept + 1
    EndIf
    i = i + 1
  Wend
  at = 0
  o = 0
  While o < outer
    i = 0
    While i < width And i < condCount
      If PeekA(cond + i) <> 0
        PmOpCopyBytes(src + (o * width + i) * run, dst + at, run)
        at = at + run
      EndIf
      i = i + 1
    Wend
    o = o + 1
  Wend
  ProcedureReturn kept
EndProcedure

; ----------------------------------------------------------------------
; ReverseSequence-10 over a (D0, D1, Inner) view with the time axis 0 and the
; batch axis 1 (TimeFirst 1) or the other way round: for batch b the first
; lens[b] steps are reversed, the rest copied. Returns 1 for a length outside
; 0 .. the time extent.
; ----------------------------------------------------------------------
Procedure.i PmOpReverseSequence(src.i, lens.i, dst.i, d0.i, d1.i, inner.i, timeFirst.i, bytes.i, lensKind.i)
  Protected b.i
  Protected t.i
  Protected len.i
  Protected steps.i
  Protected batches.i
  Protected from.i
  Protected fromAt.i
  Protected toAt.i
  If timeFirst <> 0
    steps = d0
    batches = d1
  Else
    steps = d1
    batches = d0
  EndIf
  b = 0
  While b < batches
    len = PmOpReadInt(lens, b, lensKind)
    If len < 0 Or len > steps
      ProcedureReturn 1
    EndIf
    t = 0
    While t < steps
      from = t
      If t < len
        from = len - 1 - t
      EndIf
      If timeFirst <> 0
        fromAt = (from * d1 + b) * inner
        toAt = (t * d1 + b) * inner
      Else
        fromAt = (b * d1 + from) * inner
        toAt = (b * d1 + t) * inner
      EndIf
      PmOpCopyBytes(src + fromAt * bytes, dst + toAt * bytes, inner * bytes)
      t = t + 1
    Wend
    b = b + 1
  Wend
  ProcedureReturn 0
EndProcedure

; ----------------------------------------------------------------------
; RNN-14 and GRU-14, layout 0: X [T, B, I], W [D, G*H, I], R [D, G*H, H],
; B [D, 2*G*H] (0 when absent), sequence_lens [B] INT32 (0: all T),
; initial_h [D, B, H] (0: zeros), Y [T, D, B, H] and Y_h [D, B, H] (either
; may be 0). G is 1 (RNN) or 3 (GRU, gates z, r, h). Parameters in PmOpI:
;   0 T  1 B  2 I  3 H  4 D  5 direction (0 forward, 1 reverse, 2 both)
;   6 GRU  7 linear_before_reset  8 clip given
;   10 + 2*d + k   activation k of direction d: 0 Sigmoid, 1 Tanh, 2 Relu
; PmOpF(0) clip. A step past a batch's length leaves its state and writes
; zeros to Y. Every sum runs in index order; the step follows the
; reference implementation:
;   RNN  H = f(x.Wi + h.Ri + (Wbi + Rbi))
;   GRU  z = f(x.Wz + h.Rz + (Wbz + Rbz)), r likewise
;        default: hh = g(x.Wh + (r*h).Rh + Wbh + Rbh)
;        linear_before_reset: hh = g(x.Wh + r*(h.Rh + Rbh) + Wbh)
;        H = (1 - z)*hh + z*h
; with the activation inputs clamped to [-clip, clip] when clip is given.
; Scratch: D*B*H floats of state, then 3*H floats.
; ----------------------------------------------------------------------
Procedure.f PmOpActivate(t.f, code.i)
  Protected e.f
  If PmOpI(8) <> 0
    If PmOpIsNan(t) = 0
      If t > PmOpF(0)
        t = PmOpF(0)
      ElseIf t < PmOpNeg(PmOpF(0))
        t = PmOpNeg(PmOpF(0))
      EndIf
    EndIf
  EndIf
  If code = 0
    e = PmOpNeg(t)
    e = PmOpExp(e)
    e = PmOpOne + e
    e = PmOpOne / e
    ProcedureReturn e
  EndIf
  If code = 1
    ProcedureReturn PmOpTanh(t)
  EndIf
  If PmOpIsNan(t) = 0 And t < 0.0
    ProcedureReturn 0.0
  EndIf
  ProcedureReturn t
EndProcedure

Procedure.f PmOpDotRow(a.i, arow.i, b.i, brow.i, n.i)
  Protected k.i
  Protected acc.f
  Protected t.f
  acc = 0.0
  k = 0
  While k < n
    t = PmTensorGet(a, arow + k) * PmTensorGet(b, brow + k)
    acc = acc + t
    k = k + 1
  Wend
  ProcedureReturn acc
EndProcedure

Procedure PmOpRecurrent(x.i, w.i, r.i, bias.i, lens.i, initH.i, y.i, yh.i, scratch.i)
  Protected steps.i
  Protected batch.i
  Protected isz.i
  Protected hsz.i
  Protected dirs.i
  Protected gates.i
  Protected d.i
  Protected rev.i
  Protected s.i
  Protected t.i
  Protected b.i
  Protected j.i
  Protected k.i
  Protected len.i
  Protected state.i
  Protected tmp.i
  Protected wOff.i
  Protected rOff.i
  Protected bOff.i
  Protected xRow.i
  Protected hRow.i
  Protected a.f
  Protected c.f
  Protected z.f
  Protected rv.f
  Protected hh.f
  Protected hv.f
  Protected u.f
  Protected wb.f
  Protected rb.f
  PmOpInit()
  steps = PmOpI(0)
  batch = PmOpI(1)
  isz = PmOpI(2)
  hsz = PmOpI(3)
  dirs = PmOpI(4)
  gates = 1
  If PmOpI(6) <> 0
    gates = 3
  EndIf
  tmp = scratch + dirs * batch * hsz * 4
  d = 0
  While d < dirs
    rev = Bool(PmOpI(5) = 1 Or (PmOpI(5) = 2 And d = 1))
    wOff = d * gates * hsz * isz
    rOff = d * gates * hsz * hsz
    bOff = d * 2 * gates * hsz
    ; the initial state
    b = 0
    While b < batch
      j = 0
      While j < hsz
        If initH <> 0
          PmTensorPut(scratch, (d * batch + b) * hsz + j, PmTensorGet(initH, (d * batch + b) * hsz + j))
        Else
          PmTensorPut(scratch, (d * batch + b) * hsz + j, 0.0)
        EndIf
        j = j + 1
      Wend
      b = b + 1
    Wend
    s = 0
    While s < steps
      t = s
      If rev <> 0
        t = steps - 1 - s
      EndIf
      b = 0
      While b < batch
        len = steps
        If lens <> 0
          len = PeekL(lens + b * 4)
        EndIf
        state = (d * batch + b) * hsz
        xRow = (t * batch + b) * isz
        If t >= len
          If y <> 0
            j = 0
            While j < hsz
              PmTensorPut(y, ((t * dirs + d) * batch + b) * hsz + j, 0.0)
              j = j + 1
            Wend
          EndIf
        ElseIf gates = 1
          j = 0
          While j < hsz
            a = PmOpDotRow(x, xRow, w, wOff + j * isz, isz)
            c = PmOpDotRow(scratch, state, r, rOff + j * hsz, hsz)
            a = a + c
            If bias <> 0
              wb = PmTensorGet(bias, bOff + j)
              rb = PmTensorGet(bias, bOff + hsz + j)
              wb = wb + rb
              a = a + wb
            EndIf
            PmTensorPut(tmp, j, PmOpActivate(a, PmOpI(10 + 2 * d)))
            j = j + 1
          Wend
          j = 0
          While j < hsz
            PmTensorPut(scratch, state + j, PmTensorGet(tmp, j))
            j = j + 1
          Wend
        Else
          ; z and r of every unit first: the candidate needs r of all of them
          j = 0
          While j < hsz
            k = 0
            While k < 2
              a = PmOpDotRow(x, xRow, w, wOff + (k * hsz + j) * isz, isz)
              c = PmOpDotRow(scratch, state, r, rOff + (k * hsz + j) * hsz, hsz)
              a = a + c
              If bias <> 0
                wb = PmTensorGet(bias, bOff + k * hsz + j)
                rb = PmTensorGet(bias, bOff + (3 + k) * hsz + j)
                wb = wb + rb
                a = a + wb
              EndIf
              PmTensorPut(tmp, k * hsz + j, PmOpActivate(a, PmOpI(10 + 2 * d)))
              k = k + 1
            Wend
            j = j + 1
          Wend
          j = 0
          While j < hsz
            a = PmOpDotRow(x, xRow, w, wOff + (2 * hsz + j) * isz, isz)
            wb = 0.0
            rb = 0.0
            If bias <> 0
              wb = PmTensorGet(bias, bOff + 2 * hsz + j)
              rb = PmTensorGet(bias, bOff + 5 * hsz + j)
            EndIf
            rv = PmTensorGet(tmp, hsz + j)
            If PmOpI(7) <> 0
              c = PmOpDotRow(scratch, state, r, rOff + (2 * hsz + j) * hsz, hsz)
              c = c + rb
              c = rv * c
              a = a + c
              a = a + wb
            Else
              c = 0.0
              k = 0
              While k < hsz
                u = PmTensorGet(tmp, hsz + k) * PmTensorGet(scratch, state + k)
                u = u * PmTensorGet(r, rOff + (2 * hsz + j) * hsz + k)
                c = c + u
                k = k + 1
              Wend
              a = a + c
              a = a + wb
              a = a + rb
            EndIf
            PmTensorPut(tmp, 2 * hsz + j, PmOpActivate(a, PmOpI(11 + 2 * d)))
            j = j + 1
          Wend
          j = 0
          While j < hsz
            z = PmTensorGet(tmp, j)
            hh = PmTensorGet(tmp, 2 * hsz + j)
            hv = PmTensorGet(scratch, state + j)
            u = PmOpOne - z
            u = u * hh
            hv = z * hv
            u = u + hv
            PmTensorPut(scratch, state + j, u)
            j = j + 1
          Wend
        EndIf
        If t < len And y <> 0
          j = 0
          While j < hsz
            PmOpStoreF(y, ((t * dirs + d) * batch + b) * hsz + j, PmTensorGet(scratch, state + j))
            j = j + 1
          Wend
        EndIf
        b = b + 1
      Wend
      s = s + 1
    Wend
    If yh <> 0
      j = 0
      While j < batch * hsz
        PmOpStoreF(yh, d * batch * hsz + j, PmTensorGet(scratch, d * batch * hsz + j))
        j = j + 1
      Wend
    EndIf
    d = d + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; NonMaxSuppression-11, the reference implementation's rules: per batch and
; class the boxes above score_threshold (when given; strictly above), taken
; by descending score and then ascending index; a box is kept unless its
; IoU with a kept box of the class exceeds iou_threshold, until
; max_output_boxes_per_class are kept. Boxes [B, N, 4] (y1, x1, y2, x2, or
; with center_point_box = 1 x_center, y_center, width, height), scores
; [B, C, N]. Parameters: PmOpI(0) B, 1 C, 2 N, 3 max per class, 4 score
; threshold given, 5 center_point_box; PmOpF(0) iou threshold, PmOpF(1)
; score threshold. Out receives INT64 (batch, class, box) triples; Order
; needs 3*N words of scratch. Returns the number of triples.
; ----------------------------------------------------------------------
Procedure.i PmOpNmsSuppress(boxes.i, i1.i, i2.i, center.i)
  Protected ax1.f
  Protected ax2.f
  Protected ay1.f
  Protected ay2.f
  Protected bx1.f
  Protected bx2.f
  Protected by1.f
  Protected by2.f
  Protected t.f
  Protected ix1.f
  Protected ix2.f
  Protected iy1.f
  Protected iy2.f
  Protected inter.f
  Protected area1.f
  Protected area2.f
  Protected uni.f
  Protected iou.f
  If center = 0
    ax1 = PmTensorGet(boxes, i1 * 4 + 1)
    ax2 = PmTensorGet(boxes, i1 * 4 + 3)
    If ax1 > ax2
      t = ax1
      ax1 = ax2
      ax2 = t
    EndIf
    bx1 = PmTensorGet(boxes, i2 * 4 + 1)
    bx2 = PmTensorGet(boxes, i2 * 4 + 3)
    If bx1 > bx2
      t = bx1
      bx1 = bx2
      bx2 = t
    EndIf
    ay1 = PmTensorGet(boxes, i1 * 4)
    ay2 = PmTensorGet(boxes, i1 * 4 + 2)
    If ay1 > ay2
      t = ay1
      ay1 = ay2
      ay2 = t
    EndIf
    by1 = PmTensorGet(boxes, i2 * 4)
    by2 = PmTensorGet(boxes, i2 * 4 + 2)
    If by1 > by2
      t = by1
      by1 = by2
      by2 = t
    EndIf
  Else
    t = PmTensorGet(boxes, i1 * 4 + 2) / PmOpTwo
    ax1 = PmTensorGet(boxes, i1 * 4) - t
    ax2 = PmTensorGet(boxes, i1 * 4) + t
    t = PmTensorGet(boxes, i2 * 4 + 2) / PmOpTwo
    bx1 = PmTensorGet(boxes, i2 * 4) - t
    bx2 = PmTensorGet(boxes, i2 * 4) + t
    t = PmTensorGet(boxes, i1 * 4 + 3) / PmOpTwo
    ay1 = PmTensorGet(boxes, i1 * 4 + 1) - t
    ay2 = PmTensorGet(boxes, i1 * 4 + 1) + t
    t = PmTensorGet(boxes, i2 * 4 + 3) / PmOpTwo
    by1 = PmTensorGet(boxes, i2 * 4 + 1) - t
    by2 = PmTensorGet(boxes, i2 * 4 + 1) + t
  EndIf
  ix1 = ax1
  If bx1 > ix1
    ix1 = bx1
  EndIf
  ix2 = ax2
  If bx2 < ix2
    ix2 = bx2
  EndIf
  If ix2 <= ix1
    ProcedureReturn 0
  EndIf
  iy1 = ay1
  If by1 > iy1
    iy1 = by1
  EndIf
  iy2 = ay2
  If by2 < iy2
    iy2 = by2
  EndIf
  If iy2 <= iy1
    ProcedureReturn 0
  EndIf
  t = ix2 - ix1
  inter = iy2 - iy1
  inter = t * inter
  If inter <= 0.0
    ProcedureReturn 0
  EndIf
  t = ax2 - ax1
  area1 = ay2 - ay1
  area1 = t * area1
  t = bx2 - bx1
  area2 = by2 - by1
  area2 = t * area2
  uni = area1 + area2
  uni = uni - inter
  If area1 <= 0.0 Or area2 <= 0.0 Or uni <= 0.0
    ProcedureReturn 0
  EndIf
  iou = inter / uni
  If iou > PmOpF(0)
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i PmOpNms(boxes.i, scores.i, out.i, order.i)
  Protected nb.i
  Protected nc.i
  Protected n.i
  Protected maxOut.i
  Protected b.i
  Protected c.i
  Protected i.i
  Protected j.i
  Protected count.i
  Protected kept.i
  Protected keep.i
  Protected total.i
  Protected span.i
  Protected lo.i
  Protected mid.i
  Protected hi.i
  Protected pa.i
  Protected pb.i
  Protected at.i
  Protected ia.i
  Protected ib.i
  Protected fa.f
  Protected fb.f
  Protected sc.f
  Protected takeRight.i
  PmOpInit()
  nb = PmOpI(0)
  nc = PmOpI(1)
  n = PmOpI(2)
  maxOut = PmOpI(3)
  total = 0
  b = 0
  While b < nb
    c = 0
    While c < nc
      ; the candidates, in index order, then a stable merge sort by score
      count = 0
      i = 0
      While i < n
        sc = PmTensorGet(scores, (b * nc + c) * n + i)
        keep = 1
        If PmOpI(4) <> 0
          If PmOpIsNan(sc) <> 0
            keep = 0
          ElseIf sc <= PmOpF(1)
            keep = 0
          EndIf
        EndIf
        If keep <> 0
          PokeL(order + count * 4, i)
          count = count + 1
        EndIf
        i = i + 1
      Wend
      span = 1
      pa = order
      pb = order + n * 4
      While span < count
        lo = 0
        While lo < count
          mid = lo + span
          If mid > count
            mid = count
          EndIf
          hi = lo + 2 * span
          If hi > count
            hi = count
          EndIf
          i = lo
          j = mid
          at = lo
          While i < mid Or j < hi
            If i >= mid
              takeRight = 1
            ElseIf j >= hi
              takeRight = 0
            Else
              ia = PeekL(pa + i * 4)
              ib = PeekL(pa + j * 4)
              fa = PmTensorGet(scores, (b * nc + c) * n + ia)
              fb = PmTensorGet(scores, (b * nc + c) * n + ib)
              takeRight = 0
              If PmOpIsNan(fa) = 0 And PmOpIsNan(fb) = 0
                If fb > fa
                  takeRight = 1
                EndIf
              EndIf
            EndIf
            If takeRight <> 0
              PokeL(pb + at * 4, PeekL(pa + j * 4))
              j = j + 1
            Else
              PokeL(pb + at * 4, PeekL(pa + i * 4))
              i = i + 1
            EndIf
            at = at + 1
          Wend
          lo = hi
        Wend
        at = pa
        pa = pb
        pb = at
        span = span * 2
      Wend
      ; greedy selection
      kept = 0
      i = 0
      While i < count And kept < maxOut
        ia = PeekL(pa + i * 4)
        keep = 1
        j = 0
        While j < kept And keep <> 0
          ib = PeekL(order + 2 * n * 4 + j * 4)
          If PmOpNmsSuppress(boxes + b * n * 16, ia, ib, PmOpI(5)) <> 0
            keep = 0
          EndIf
          j = j + 1
        Wend
        If keep <> 0
          PokeL(order + 2 * n * 4 + kept * 4, ia)
          kept = kept + 1
          PmTensorPutI64(out, total * 3, b)
          PmTensorPutI64(out, total * 3 + 1, c)
          PmTensorPutI64(out, total * 3 + 2, ia)
          total = total + 1
        EndIf
        i = i + 1
      Wend
      c = c + 1
    Wend
    b = b + 1
  Wend
  ProcedureReturn total
EndProcedure

; ----------------------------------------------------------------------
; RoiAlign-16, the reference implementation's rules, over X [N, C, H, W]:
; rois [R, 4] (x1, y1, x2, y2), batch_indices [R] INT64, Y [R, C, OH, OW].
; PmOpI: 0 N, 1 C, 2 H, 3 W, 4 R, 5 OH, 6 OW, 7 sampling_ratio, 8 mode
; (0 avg, 1 max), 9 half_pixel; PmOpF(0) spatial_scale. Returns 1 for a
; batch index outside the input.
; ----------------------------------------------------------------------
Procedure.f PmOpRoiSample(plane.i, height.i, width.i, y.f, x.f, mode.i)
  Protected yl.i
  Protected xl.i
  Protected yh.i
  Protected xh.i
  Protected fy.f
  Protected fx.f
  Protected ly.f
  Protected lx.f
  Protected hy.f
  Protected hx.f
  Protected v1.f
  Protected v2.f
  Protected v3.f
  Protected v4.f
  Protected t.f
  fy = height
  fx = width
  If y < PmOpNeg(PmOpOne) Or y > fy Or x < PmOpNeg(PmOpOne) Or x > fx
    ProcedureReturn 0.0
  EndIf
  If y < 0.0
    y = 0.0
  EndIf
  If x < 0.0
    x = 0.0
  EndIf
  yl = PmOpTruncInt(y)
  xl = PmOpTruncInt(x)
  If yl >= height - 1
    yl = height - 1
    yh = yl
    y = yl
  Else
    yh = yl + 1
  EndIf
  If xl >= width - 1
    xl = width - 1
    xh = xl
    x = xl
  Else
    xh = xl + 1
  EndIf
  t = yl
  ly = y - t
  t = xl
  lx = x - t
  hy = PmOpOne - ly
  hx = PmOpOne - lx
  v1 = hy * hx
  v1 = v1 * PmTensorGet(plane, yl * width + xl)
  v2 = hy * lx
  v2 = v2 * PmTensorGet(plane, yl * width + xh)
  v3 = ly * hx
  v3 = v3 * PmTensorGet(plane, yh * width + xl)
  v4 = ly * lx
  v4 = v4 * PmTensorGet(plane, yh * width + xh)
  If mode = 0
    t = v1 + v2
    t = t + v3
    t = t + v4
    ProcedureReturn t
  EndIf
  t = v1
  If v2 > t
    t = v2
  EndIf
  If v3 > t
    t = v3
  EndIf
  If v4 > t
    t = v4
  EndIf
  ProcedureReturn t
EndProcedure

Procedure.i PmOpRoiAlign(x.i, rois.i, idx.i, y.i)
  Protected nroi.i
  Protected ch.i
  Protected height.i
  Protected width.i
  Protected oh.i
  Protected ow.i
  Protected n.i
  Protected c.i
  Protected ph.i
  Protected pw.i
  Protected iy.i
  Protected ix.i
  Protected gh.i
  Protected gw.i
  Protected bi.i
  Protected first.i
  Protected plane.i
  Protected rsw.f
  Protected rsh.f
  Protected rew.f
  Protected reh.f
  Protected rw.f
  Protected rh.f
  Protected bh.f
  Protected bw.f
  Protected off.f
  Protected yy.f
  Protected xx.f
  Protected t.f
  Protected u.f
  Protected acc.f
  Protected v.f
  Protected cnt.f
  Protected fgh.f
  Protected fgw.f
  PmOpInit()
  ch = PmOpI(1)
  height = PmOpI(2)
  width = PmOpI(3)
  nroi = PmOpI(4)
  oh = PmOpI(5)
  ow = PmOpI(6)
  off = 0.0
  If PmOpI(9) <> 0
    off = PmOpHalf
  EndIf
  n = 0
  While n < nroi
    bi = PmTensorGetI64(idx, n)
    If bi < 0 Or bi >= PmOpI(0)
      ProcedureReturn 1
    EndIf
    rsw = PmTensorGet(rois, n * 4) * PmOpF(0)
    rsw = rsw - off
    rsh = PmTensorGet(rois, n * 4 + 1) * PmOpF(0)
    rsh = rsh - off
    rew = PmTensorGet(rois, n * 4 + 2) * PmOpF(0)
    rew = rew - off
    reh = PmTensorGet(rois, n * 4 + 3) * PmOpF(0)
    reh = reh - off
    rw = rew - rsw
    rh = reh - rsh
    If PmOpI(9) = 0
      If rw < PmOpOne
        rw = PmOpOne
      EndIf
      If rh < PmOpOne
        rh = PmOpOne
      EndIf
    EndIf
    t = oh
    bh = rh / t
    t = ow
    bw = rw / t
    If PmOpI(7) > 0
      gh = PmOpI(7)
      gw = PmOpI(7)
    Else
      gh = PmOpTruncInt(PmOpCeil(bh))
      gw = PmOpTruncInt(PmOpCeil(bw))
    EndIf
    fgh = gh
    fgw = gw
    cnt = gh * gw
    If gh * gw < 1
      cnt = PmOpOne
    EndIf
    c = 0
    While c < ch
      plane = x + (bi * ch + c) * height * width * 4
      ph = 0
      While ph < oh
        pw = 0
        While pw < ow
          acc = 0.0
          first = 1
          iy = 0
          While iy < gh
            t = ph
            yy = t * bh
            yy = rsh + yy
            t = iy
            t = t + PmOpHalf
            t = t * bh
            t = t / fgh
            yy = yy + t
            ix = 0
            While ix < gw
              t = pw
              xx = t * bw
              xx = rsw + xx
              t = ix
              t = t + PmOpHalf
              t = t * bw
              t = t / fgw
              xx = xx + t
              v = PmOpRoiSample(plane, height, width, yy, xx, PmOpI(8))
              If PmOpI(8) = 0
                acc = acc + v
              ElseIf first <> 0 Or v > acc
                acc = v
              EndIf
              first = 0
              ix = ix + 1
            Wend
            iy = iy + 1
          Wend
          If PmOpI(8) = 0
            acc = acc / cnt
          EndIf
          PmOpStoreF(y, ((n * ch + c) * oh + ph) * ow + pw, acc)
          pw = pw + 1
        Wend
        ph = ph + 1
      Wend
      c = c + 1
    Wend
    n = n + 1
  Wend
  ProcedureReturn 0
EndProcedure

; ----------------------------------------------------------------------
; Upsample-7 and Upsample-9 (the operator of opsets 7 to 9). Input dims in
; PmOpDA, output dims in PmOpDY, the scale of axis d in PmOpF(d).
;   nearest  input coordinate = the integer part of (output coordinate /
;            scale), at most extent - 1; any element type (Bytes wide)
;   linear   bilinear over the last two axes (the others have scale 1), as
;            ONNX Runtime computes it: in = min(out / scale, extent - 1),
;            y1 = floor, y2 = min(y1 + 1, extent - 1), and the sum
;            dx2*dy2*x11 + dx1*dy2*x21 + dx2*dy1*x12 + dx1*dy1*x22; FLOAT
; ----------------------------------------------------------------------
Procedure PmOpUpsample(src.i, dst.i, rank.i, linear.i, bytes.i)
  Protected d.i
  Protected s.i
  Protected count.i
  Protected i.i
  Protected n.i
  Protected at.i
  Protected coord.i
  Protected k.i
  Protected y1.i
  Protected y2.i
  Protected x1.i
  Protected x2.i
  Protected plane.i
  Protected fo.f
  Protected fi.f
  Protected lim.f
  Protected iny.f
  Protected inx.f
  Protected dy1.f
  Protected dy2.f
  Protected dx1.f
  Protected dx2.f
  Protected t.f
  Protected u.f
  Protected acc.f
  PmOpInit()
  s = 1
  count = 1
  d = rank - 1
  While d >= 0
    PmOpStride(d) = s
    s = s * PmOpDA(d)
    count = count * PmOpDY(d)
    d = d - 1
  Wend
  i = 0
  While i < count
    n = i
    at = 0
    d = rank - 1
    While d >= 0
      coord = n % PmOpDY(d)
      n = n / PmOpDY(d)
      PmOpCoord(d) = coord
      If linear = 0 Or d < rank - 2
        fo = coord
        fi = fo / PmOpF(d)
        k = PmOpTruncInt(fi)
        If k > PmOpDA(d) - 1
          k = PmOpDA(d) - 1
        EndIf
        at = at + k * PmOpStride(d)
      EndIf
      d = d - 1
    Wend
    If linear = 0
      PmOpCopyElement(src + at * bytes, dst + i * bytes, bytes)
    Else
      fo = PmOpCoord(rank - 2)
      iny = fo / PmOpF(rank - 2)
      lim = PmOpDA(rank - 2) - 1
      If iny > lim
        iny = lim
      EndIf
      fo = PmOpCoord(rank - 1)
      inx = fo / PmOpF(rank - 1)
      lim = PmOpDA(rank - 1) - 1
      If inx > lim
        inx = lim
      EndIf
      y1 = PmOpTruncInt(iny)
      x1 = PmOpTruncInt(inx)
      y2 = y1 + 1
      If y2 > PmOpDA(rank - 2) - 1
        y2 = PmOpDA(rank - 2) - 1
      EndIf
      x2 = x1 + 1
      If x2 > PmOpDA(rank - 1) - 1
        x2 = PmOpDA(rank - 1) - 1
      EndIf
      t = y1
      dy1 = iny - t
      dy2 = PmOpOne - dy1
      t = x1
      dx1 = inx - t
      dx2 = PmOpOne - dx1
      plane = src + at * 4
      t = dx2 * dy2
      acc = t * PmTensorGet(plane, y1 * PmOpDA(rank - 1) + x1)
      t = dx1 * dy2
      u = t * PmTensorGet(plane, y1 * PmOpDA(rank - 1) + x2)
      acc = acc + u
      t = dx2 * dy1
      u = t * PmTensorGet(plane, y2 * PmOpDA(rank - 1) + x1)
      acc = acc + u
      t = dx1 * dy1
      u = t * PmTensorGet(plane, y2 * PmOpDA(rank - 1) + x2)
      acc = acc + u
      PmOpStoreF(dst, i, acc)
    EndIf
    i = i + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; GridSample-16 and GridSample-20. X is [N, C, D1 .. Dr], grid [N, O1 .. Or,
; r] with the LAST spatial axis's coordinate first (x, y, z), Y [N, C, O1 ..
; Or], r = 1 to 3. PmOpI(0) N, (1) C, (2) r, (3 ..) the input extents,
; (6 ..) the output extents, (9) mode (0 nearest, 1 linear, 2 cubic),
; (10) padding (0 zeros, 1 border, 2 reflection), (11) align_corners.
;   coordinate  align: (n + 1) / 2 * (D - 1); else ((n + 1) * D - 1) / 2
;   nearest     round half to even, then the padding rule, one tap
;   outside     [0, D-1] (align) or [-0.5, D-0.5]: border clamps, reflection
;               reflects; cubic with border clamps each tap instead, as ONNX
;               Runtime does (the reference evaluator clamps the coordinate)
;   taps        linear floor and floor + 1 with weights 1 - t and t; cubic
;               floor - 1 .. floor + 2 with Keys' coefficients, A = -0.75
;   sum         innermost axis first, each level w0*v0 + w1*v1 + ... in tap
;               order; an out-of-range tap (zeros) is +0
; A NaN coordinate is out of range under zeros padding and 0 under the
; others; a reflected infinity is the low border. Coordinates beyond 2^22
; are 2^22, where every tap is already outside (zeros) or on the border.
; ----------------------------------------------------------------------
Global Dim PmOpGsIdx.i(12)
Global Dim PmOpGsW.f(12)
Global Dim PmOpGsCnt.i(3)
Global PmOpGsA.f
Global PmOpGsA5.f
Global PmOpGsA8.f
Global PmOpGsA4.f
Global PmOpGsA2.f
Global PmOpGsA3.f
Global PmOpGsFar.f
Global PmOpGsTwo24.f

Procedure.f PmOpFloorF(x.f)
  ProcedureReturn PmOpNeg(PmOpCeil(PmOpNeg(x)))
EndProcedure

; Round half to even (numpy rint) of a non-NaN value.
Procedure.f PmOpRint(x.f)
  Protected r.f
  Protected d.f
  If (PmOpBits(x) & $7FFFFFFF) >= $4B000000
    ProcedureReturn x
  EndIf
  r = PmOpFloorF(x)
  d = x - r
  If d > PmOpHalf
    r = r + PmOpOne
  ElseIf d = PmOpHalf
    If (PmOpTruncInt(r) & 1) <> 0
      r = r + PmOpOne
    EndIf
  EndIf
  ProcedureReturn r
EndProcedure

Procedure.f PmOpGsReflect(x.f, lo.f, hi.f)
  Protected rng.f
  Protected dx.f
  Protected q.f
  Protected nf.f
  Protected r.f
  Protected t.f
  Protected odd.i
  rng = hi - lo
  If (PmOpBits(rng) & $7FFFFFFF) = 0 Or (PmOpBits(x) & $7FFFFFFF) >= $7F800000
    ProcedureReturn lo
  EndIf
  If x < lo
    dx = lo - x
  Else
    dx = x - hi
  EndIf
  q = dx / rng
  nf = PmOpFloorF(q)
  t = nf * rng
  r = dx - t
  If r < 0.0
    r = 0.0
  EndIf
  If r > rng
    r = rng
  EndIf
  odd = 0
  If nf < PmOpGsTwo24
    odd = PmOpTruncInt(nf) & 1
  EndIf
  If x < lo
    If odd <> 0
      ProcedureReturn hi - r
    EndIf
    ProcedureReturn lo + r
  EndIf
  If odd <> 0
    ProcedureReturn lo + r
  EndIf
  ProcedureReturn hi - r
EndProcedure

; The input index of tap i on an axis of extent d under the padding rule,
; -1 for a tap that reads zero.
Procedure.i PmOpGsIndex(i.i, d.i, pad.i, lo.f, hi.f)
  Protected fi.f
  If pad = 0
    If i >= 0 And i < d
      ProcedureReturn i
    EndIf
    ProcedureReturn -1
  EndIf
  If pad = 1
    If i < 0
      ProcedureReturn 0
    EndIf
    If i > d - 1
      ProcedureReturn d - 1
    EndIf
    ProcedureReturn i
  EndIf
  fi = i
  If fi < lo Or fi > hi
    ProcedureReturn PmOpTruncInt(PmOpGsReflect(fi, lo, hi))
  EndIf
  ProcedureReturn i
EndProcedure

; Keys' cubic coefficient for the tap at distance s (s = t + 1 or 2 - t for
; the outer taps, t or 1 - t for the inner ones).
Procedure.f PmOpGsOuter(s.f)
  Protected v.f
  v = PmOpGsA * s
  v = v - PmOpGsA5
  v = v * s
  v = v + PmOpGsA8
  v = v * s
  v = v - PmOpGsA4
  ProcedureReturn v
EndProcedure

Procedure.f PmOpGsInner(s.f)
  Protected v.f
  v = PmOpGsA2 * s
  v = v - PmOpGsA3
  v = v * s
  v = v * s
  v = v + PmOpOne
  ProcedureReturn v
EndProcedure

; The taps of spatial axis k (extent d) for normalized coordinate n.
Procedure PmOpGsTaps(k.i, n.f, d.i, mode.i, pad.i, align.i)
  Protected fd.f
  Protected x.f
  Protected lo.f
  Protected hi.f
  Protected t.f
  Protected s.f
  Protected x0f.f
  Protected x0.i
  Protected j.i
  fd = d
  x = n + PmOpOne
  If align <> 0
    x = x * PmOpHalf
    t = fd - PmOpOne
    x = x * t
    lo = 0.0
    hi = fd - PmOpOne
  Else
    x = x * fd
    x = x - PmOpOne
    x = x * PmOpHalf
    lo = PmOpNeg(PmOpHalf)
    hi = fd - PmOpHalf
  EndIf
  If PmOpIsNan(x) <> 0
    If pad = 0
      x = PmOpGsFar
    Else
      x = 0.0
    EndIf
  EndIf
  If mode = 0
    x = PmOpRint(x)
  EndIf
  If x < lo Or x > hi
    If pad = 1 And mode <> 2
      If x < 0.0
        x = 0.0
      EndIf
      t = fd - PmOpOne
      If x > t
        x = t
      EndIf
    ElseIf pad = 2
      x = PmOpGsReflect(x, lo, hi)
    EndIf
  EndIf
  If x < PmOpNeg(PmOpGsFar)
    x = PmOpNeg(PmOpGsFar)
  EndIf
  If x > PmOpGsFar
    x = PmOpGsFar
  EndIf
  j = k * 4
  If mode = 0
    PmOpGsCnt(k) = 1
    PmOpGsIdx(j) = PmOpGsIndex(PmOpTruncInt(x), d, pad, lo, hi)
    PmOpGsW(j) = PmOpOne
    ProcedureReturn
  EndIf
  x0f = PmOpFloorF(x)
  t = x - x0f
  x0 = PmOpTruncInt(x0f)
  If mode = 1
    PmOpGsCnt(k) = 2
    PmOpGsIdx(j) = PmOpGsIndex(x0, d, pad, lo, hi)
    PmOpGsW(j) = PmOpOne - t
    PmOpGsIdx(j + 1) = PmOpGsIndex(x0 + 1, d, pad, lo, hi)
    PmOpGsW(j + 1) = t
    ProcedureReturn
  EndIf
  PmOpGsCnt(k) = 4
  PmOpGsIdx(j) = PmOpGsIndex(x0 - 1, d, pad, lo, hi)
  s = t + PmOpOne
  PmOpGsW(j) = PmOpGsOuter(s)
  PmOpGsIdx(j + 1) = PmOpGsIndex(x0, d, pad, lo, hi)
  PmOpGsW(j + 1) = PmOpGsInner(t)
  PmOpGsIdx(j + 2) = PmOpGsIndex(x0 + 1, d, pad, lo, hi)
  s = PmOpOne - t
  PmOpGsW(j + 2) = PmOpGsInner(s)
  PmOpGsIdx(j + 3) = PmOpGsIndex(x0 + 2, d, pad, lo, hi)
  s = PmOpTwo - t
  PmOpGsW(j + 3) = PmOpGsOuter(s)
EndProcedure

; The weighted sum over the taps of axis k of the elements at plane + (base +
; index) * 4.
Procedure.f PmOpGsLine(plane.i, base.i, k.i)
  Protected j.i
  Protected v.f
  Protected t.f
  Protected acc.f
  j = 0
  While j < PmOpGsCnt(k)
    If PmOpGsIdx(k * 4 + j) < 0
      v = 0.0
    Else
      v = PmTensorGet(plane, base + PmOpGsIdx(k * 4 + j))
    EndIf
    t = PmOpGsW(k * 4 + j) * v
    If j = 0
      acc = t
    Else
      acc = PmOpAddF(acc, t)
    EndIf
    j = j + 1
  Wend
  ProcedureReturn acc
EndProcedure

; The same one level out: axis k's taps over lines of axis k + 1 (stride).
Procedure.f PmOpGsPlane(plane.i, base.i, k.i, stride.i)
  Protected j.i
  Protected v.f
  Protected t.f
  Protected acc.f
  j = 0
  While j < PmOpGsCnt(k)
    If PmOpGsIdx(k * 4 + j) < 0
      v = 0.0
    Else
      v = PmOpGsLine(plane, base + PmOpGsIdx(k * 4 + j) * stride, k + 1)
    EndIf
    t = PmOpGsW(k * 4 + j) * v
    If j = 0
      acc = t
    Else
      acc = PmOpAddF(acc, t)
    EndIf
    j = j + 1
  Wend
  ProcedureReturn acc
EndProcedure

Procedure PmOpGridSample(x.i, grid.i, y.i)
  Protected r.i
  Protected n.i
  Protected c.i
  Protected o.i
  Protected outCount.i
  Protected inCount.i
  Protected k.i
  Protected plane.i
  Protected at.i
  Protected j.i
  Protected t.f
  Protected v.f
  Protected acc.f
  Protected ok.i
  PmOpInit()
  PmOpSetBits(@PmOpGsA, $BF400000)
  PmOpSetBits(@PmOpGsA5, $C0700000)
  PmOpSetBits(@PmOpGsA8, $C0C00000)
  PmOpSetBits(@PmOpGsA4, $C0400000)
  PmOpSetBits(@PmOpGsA2, $3FA00000)
  PmOpSetBits(@PmOpGsA3, $40100000)
  PmOpSetBits(@PmOpGsFar, $4A800000)
  PmOpSetBits(@PmOpGsTwo24, $4B800000)
  r = PmOpI(2)
  outCount = 1
  inCount = 1
  k = 0
  While k < r
    outCount = outCount * PmOpI(6 + k)
    inCount = inCount * PmOpI(3 + k)
    k = k + 1
  Wend
  n = 0
  While n < PmOpI(0)
    o = 0
    While o < outCount
      k = 0
      While k < r
        t = PmTensorGet(grid, (n * outCount + o) * r + r - 1 - k)
        PmOpGsTaps(k, t, PmOpI(3 + k), PmOpI(9), PmOpI(10), PmOpI(11))
        k = k + 1
      Wend
      c = 0
      While c < PmOpI(1)
        plane = x + (n * PmOpI(1) + c) * inCount * 4
        at = (n * PmOpI(1) + c) * outCount + o
        If PmOpI(9) = 0
          ok = 1
          j = 0
          k = 0
          While k < r
            If PmOpGsIdx(k * 4) < 0
              ok = 0
            Else
              j = j * PmOpI(3 + k) + PmOpGsIdx(k * 4)
            EndIf
            k = k + 1
          Wend
          If ok = 0
            PmTensorPut(y, at, 0.0)
          Else
            PmOpStoreF(y, at, PmTensorGet(plane, j))
          EndIf
        Else
          If r = 1
            v = PmOpGsLine(plane, 0, 0)
          ElseIf r = 2
            v = PmOpGsPlane(plane, 0, 0, PmOpI(4))
          Else
            j = 0
            While j < PmOpGsCnt(0)
              If PmOpGsIdx(j) < 0
                acc = 0.0
              Else
                acc = PmOpGsPlane(plane, PmOpGsIdx(j) * PmOpI(4) * PmOpI(5), 1, PmOpI(5))
              EndIf
              t = PmOpGsW(j) * acc
              If j = 0
                v = t
              Else
                v = PmOpAddF(v, t)
              EndIf
              j = j + 1
            Wend
          EndIf
          PmOpStoreF(y, at, v)
        EndIf
        c = c + 1
      Wend
      o = o + 1
    Wend
    n = n + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; The quantized operators: QuantizeLinear, DequantizeLinear,
; DynamicQuantizeLinear, MatMulInteger, QLinearMatMul, ConvInteger and
; QLinearConv. Integer kinds 2 UINT8, 3 INT8, 6 INT32.
; ----------------------------------------------------------------------
Global Dim PmOpQd.i(8)
Global PmOpQ255.f

Procedure.i PmOpQRead(address.i, index.i, kind.i)
  Protected v.i
  If kind = 6
    ProcedureReturn PeekL(address + index * 4)
  EndIf
  v = PeekA(address + index) & 255
  If kind = 3
    If v > 127
      v = v - 256
    EndIf
  EndIf
  ProcedureReturn v
EndProcedure

Procedure PmOpQWrite(address.i, index.i, kind.i, value.i)
  If kind = 6
    PokeL(address + index * 4, value)
  Else
    PokeA(address + index, value & 255)
  EndIf
EndProcedure

Procedure.i PmOpQMin(kind.i)
  If kind = 3
    ProcedureReturn -128
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i PmOpQMax(kind.i)
  If kind = 3
    ProcedureReturn 127
  EndIf
  ProcedureReturn 255
EndProcedure

; A 32-bit signed integer as the nearest binary32 (ties to even), on the bits,
; so every target converts an INT32 above 2^24 the same way.
Procedure.f PmOpIntToF(v.i)
  Protected a.i
  Protected p.i
  Protected sign.i
  Protected m.i
  Protected rest.i
  Protected half.i
  Protected sh.i
  If v = 0
    ProcedureReturn 0.0
  EndIf
  If v = -2147483648
    ProcedureReturn PmOpFromBits($CF000000)
  EndIf
  sign = 0
  a = v
  If v < 0
    sign = $80000000
    a = 0 - v
  EndIf
  p = 0
  While (a >> p) > 1
    p = p + 1
  Wend
  If p <= 23
    m = a << (23 - p)
  Else
    sh = p - 23
    m = a >> sh
    rest = a & ((1 << sh) - 1)
    half = 1 << (sh - 1)
    If rest > half Or (rest = half And (m & 1) <> 0)
      m = m + 1
      If m = $1000000
        m = m >> 1
        p = p + 1
      EndIf
    EndIf
  EndIf
  ProcedureReturn PmOpFromBits(sign | ((p + 127) << 23) | (m & $7FFFFF))
EndProcedure

; QuantizeLinear of one element: rint(x / s) + zp saturated to the kind's
; range; a NaN quotient gives the low end (the reference's numpy on x86).
Procedure.i PmOpQuantizeValue(x.f, s.f, zp.i, kind.i)
  Protected q.f
  Protected lo.f
  Protected hi.f
  q = x / s
  If PmOpIsNan(q) <> 0
    ProcedureReturn PmOpQMin(kind)
  EndIf
  q = PmOpRint(q)
  lo = PmOpQMin(kind) - zp
  hi = PmOpQMax(kind) - zp
  If q < lo
    q = lo
  EndIf
  If q > hi
    q = hi
  EndIf
  ProcedureReturn PmOpTruncInt(q) + zp
EndProcedure

; QuantizeLinear-10/13/19. PmOpI(0) outer, (1) the axis extent, (2) inner,
; (3) 1 for per-axis scale and zero point, (4) the zero point's kind or 0
; when absent, (5) the output kind.
Procedure PmOpQuantize(x.i, scale.i, zp.i, y.i)
  Protected count.i
  Protected i.i
  Protected k.i
  Protected z.i
  PmOpInit()
  count = PmOpI(0) * PmOpI(1) * PmOpI(2)
  i = 0
  While i < count
    k = 0
    If PmOpI(3) <> 0
      k = (i / PmOpI(2)) % PmOpI(1)
    EndIf
    z = 0
    If PmOpI(4) <> 0
      z = PmOpQRead(zp, k, PmOpI(4))
    EndIf
    PmOpQWrite(y, i, PmOpI(5), PmOpQuantizeValue(PmTensorGet(x, i), PmTensorGet(scale, k), z, PmOpI(5)))
    i = i + 1
  Wend
EndProcedure

; DequantizeLinear-10/13/19: (x - zp) * scale. PmOpI(0 .. 3) as for
; PmOpQuantize, (4) the kind of x, (5) 1 when the zero point is present.
Procedure PmOpDequantize(x.i, scale.i, zp.i, y.i)
  Protected count.i
  Protected i.i
  Protected k.i
  Protected d.f
  Protected t.f
  PmOpInit()
  count = PmOpI(0) * PmOpI(1) * PmOpI(2)
  i = 0
  While i < count
    k = 0
    If PmOpI(3) <> 0
      k = (i / PmOpI(2)) % PmOpI(1)
    EndIf
    d = PmOpIntToF(PmOpQRead(x, i, PmOpI(4)))
    If PmOpI(5) <> 0
      t = PmOpIntToF(PmOpQRead(zp, k, PmOpI(4)))
      d = d - t
    EndIf
    d = d * PmTensorGet(scale, k)
    PmOpStoreF(y, i, d)
    i = i + 1
  Wend
EndProcedure

; DynamicQuantizeLinear-11 over count elements; 1 for a NaN or infinite
; input (the reference's answer for one is not defined), 0 otherwise.
Procedure.i PmOpDynQuantize(x.i, y.i, yScale.i, yZero.i, count.i)
  Protected i.i
  Protected v.f
  Protected mx.f
  Protected mn.f
  Protected s.f
  Protected zpf.f
  Protected t.f
  PmOpInit()
  PmOpSetBits(@PmOpQ255, $437F0000)
  mx = 0.0
  mn = 0.0
  i = 0
  While i < count
    v = PmTensorGet(x, i)
    If (PmOpBits(v) & $7FFFFFFF) >= $7F800000
      ProcedureReturn 1
    EndIf
    If v > mx
      mx = v
    EndIf
    If v < mn
      mn = v
    EndIf
    i = i + 1
  Wend
  If mx = mn
    s = PmOpOne / PmOpQ255
  Else
    s = mx - mn
    s = s / PmOpQ255
  EndIf
  t = mn / s
  zpf = 0.0 - t
  If zpf < 0.0
    zpf = 0.0
  EndIf
  If zpf > PmOpQ255
    zpf = PmOpQ255
  EndIf
  zpf = PmOpRint(zpf)
  i = 0
  While i < count
    t = PmTensorGet(x, i) / s
    t = PmOpRint(t)
    t = t + zpf
    If t < 0.0
      t = 0.0
    EndIf
    If t > PmOpQ255
      t = PmOpQ255
    EndIf
    PokeA(y + i, PmOpTruncInt(t) & 255)
    i = i + 1
  Wend
  PmTensorPut(yScale, 0, s)
  PokeA(yZero, PmOpTruncInt(zpf) & 255)
  ProcedureReturn 0
EndProcedure

; ---- exact requantization --------------------------------------------
; The reference multiplies an INT32 accumulator by a binary32 multiplier in
; binary64, adds the zero point in binary64 and rounds half to even. Here
; the product is formed exactly in 12-bit digits (PmOpQd), rounded to 53
; bits as binary64 would round it, and the sum's own rounding is applied
; where it can decide the final rounding: near a half.

Procedure.i PmOpQBit(pos.i)
  If pos < 0 Or pos >= 60
    ProcedureReturn 0
  EndIf
  ProcedureReturn (PmOpQd(pos / 12) >> (pos % 12)) & 1
EndProcedure

; 1 when a bit below pos is set.
Procedure.i PmOpQAnyBelow(pos.i)
  Protected j.i
  If pos > 60
    pos = 60
  EndIf
  j = 0
  While j < pos
    If PmOpQBit(j) <> 0
      ProcedureReturn 1
    EndIf
    j = j + 1
  Wend
  ProcedureReturn 0
EndProcedure

Procedure.i PmOpQLength()
  Protected j.i
  j = 59
  While j >= 0
    If PmOpQBit(j) <> 0
      ProcedureReturn j + 1
    EndIf
    j = j - 1
  Wend
  ProcedureReturn 0
EndProcedure

; The fraction F = (the digits' bits below s) * 2^-s against 1/2 + dir * 2^-t
; (dir +1 or -1): 1 above, 0 equal, -1 below.
Procedure.i PmOpQFracCmp(s.i, t.i, dir.i)
  Protected j.i
  Protected last.i
  Protected fb.i
  Protected cb.i
  last = s
  If t > last
    last = t
  EndIf
  j = 1
  While j <= last
    fb = 0
    If j <= s
      fb = PmOpQBit(s - j)
    EndIf
    If dir > 0
      cb = 0
      If j = 1 Or j = t
        cb = 1
      EndIf
    Else
      cb = 0
      If j >= 2 And j <= t
        cb = 1
      EndIf
    EndIf
    If fb <> cb
      If fb > cb
        ProcedureReturn 1
      EndIf
      ProcedureReturn -1
    EndIf
    j = j + 1
  Wend
  ProcedureReturn 0
EndProcedure

; rint(c * m + zp) saturated to [qmin, qmax], c * m and the sum in binary64.
Procedure.i PmOpRequant(c.i, m.f, zp.i, qmin.i, qmax.i)
  Protected mb.i
  Protected em.i
  Protected mant.i
  Protected e.i
  Protected neg.i
  Protected ca0.i
  Protected ca1.i
  Protected ca2.i
  Protected cm0.i
  Protected cm1.i
  Protected t.i
  Protected carry.i
  Protected i.i
  Protected L.i
  Protected k.i
  Protected s.i
  Protected iD.i
  Protected fz.i
  Protected j.i
  Protected flip.i
  Protected ia.i
  Protected sgn.i
  Protected li.i
  Protected q.i
  Protected up.i
  Protected r.i
  mb = PmOpBits(m)
  If (mb & $7FFFFFFF) > $7F800000
    ProcedureReturn qmin
  EndIf
  If (mb & $7FFFFFFF) = $7F800000
    If c = 0
      ProcedureReturn qmin
    EndIf
    neg = 0
    If c < 0
      neg = 1
    EndIf
    If (mb & $80000000) <> 0
      neg = 1 - neg
    EndIf
    If neg <> 0
      ProcedureReturn qmin
    EndIf
    ProcedureReturn qmax
  EndIf
  r = zp
  If c = 0 Or (mb & $7FFFFFFF) = 0
    If r < qmin
      r = qmin
    EndIf
    If r > qmax
      r = qmax
    EndIf
    ProcedureReturn r
  EndIf
  em = (mb >> 23) & 255
  If em = 0
    mant = mb & $7FFFFF
    e = -149
  Else
    mant = (mb & $7FFFFF) | $800000
    e = em - 150
  EndIf
  neg = 0
  If (mb & $80000000) <> 0
    neg = 1
  EndIf
  If c = -2147483648
    ca0 = 0
    ca1 = 0
    ca2 = 128
    neg = 1 - neg
  Else
    If c < 0
      c = 0 - c
      neg = 1 - neg
    EndIf
    ca0 = c & $FFF
    ca1 = (c >> 12) & $FFF
    ca2 = (c >> 24) & $FF
  EndIf
  cm0 = mant & $FFF
  cm1 = mant >> 12
  PmOpQd(0) = ca0 * cm0
  PmOpQd(1) = ca0 * cm1 + ca1 * cm0
  PmOpQd(2) = ca1 * cm1 + ca2 * cm0
  PmOpQd(3) = ca2 * cm1
  PmOpQd(4) = 0
  carry = 0
  i = 0
  While i < 5
    t = PmOpQd(i) + carry
    PmOpQd(i) = t & $FFF
    carry = t >> 12
    i = i + 1
  Wend
  ; round the product to 53 significant bits, ties to even
  L = PmOpQLength()
  If L > 53
    k = L - 53
    up = 0
    If PmOpQBit(k - 1) <> 0
      If PmOpQAnyBelow(k - 1) <> 0 Or PmOpQBit(k) <> 0
        up = 1
      EndIf
    EndIf
    j = 0
    While j < k
      PmOpQd(j / 12) = PmOpQd(j / 12) & ($FFF ! (1 << (j % 12)))
      j = j + 1
    Wend
    If up <> 0
      PmOpQd(k / 12) = PmOpQd(k / 12) + (1 << (k % 12))
      i = k / 12
      While i < 4
        If PmOpQd(i) > $FFF
          PmOpQd(i) = PmOpQd(i) - $1000
          PmOpQd(i + 1) = PmOpQd(i + 1) + 1
        EndIf
        i = i + 1
      Wend
    EndIf
    L = PmOpQLength()
  EndIf
  ; |product| = N * 2^e: saturate from 2^11, the zero point alone below 2^-60
  If L + e > 11
    If neg <> 0
      ProcedureReturn qmin
    EndIf
    ProcedureReturn qmax
  EndIf
  If L + e < -60
    r = zp
    If r < qmin
      r = qmin
    EndIf
    If r > qmax
      r = qmax
    EndIf
    ProcedureReturn r
  EndIf
  ; the integer part iD and whether a fraction is present (fz)
  iD = 0
  fz = 0
  If e >= 0
    j = L - 1
    While j >= 0
      iD = iD * 2 + PmOpQBit(j)
      j = j - 1
    Wend
    iD = iD << e
    s = 0
  Else
    s = 0 - e
    j = L - 1
    While j >= s
      iD = iD * 2 + PmOpQBit(j)
      j = j - 1
    Wend
    fz = PmOpQAnyBelow(s)
  EndIf
  ; the sum as J + G, G the fraction (flip: G = 1 - F)
  flip = 0
  If neg = 0
    j = zp + iD
  Else
    j = zp - iD
    If fz <> 0
      j = j - 1
      flip = 1
    EndIf
  EndIf
  sgn = 1
  ia = j
  If j < 0
    sgn = -1
    If fz = 0
      ia = 0 - j
    Else
      ia = 0 - j - 1
      flip = 1 - flip
    EndIf
  EndIf
  up = 0
  If fz <> 0
    li = 0
    While (ia >> li) > 0
      li = li + 1
    Wend
    q = 53 - li
    ; FA = F (flip 0) or 1 - F (flip 1): FA above 1/2 + 2^-(q+1) rounds up,
    ; below 1/2 - 2^-(q+1) (2^-(q+2) when ia = 0) rounds down, else a tie
    If flip = 0
      If PmOpQFracCmp(s, q + 1, 1) > 0
        up = 1
      ElseIf ia = 0 And PmOpQFracCmp(s, q + 2, -1) < 0
        up = 0
      ElseIf ia > 0 And PmOpQFracCmp(s, q + 1, -1) < 0
        up = 0
      Else
        up = 2
      EndIf
    Else
      ; 1 - F above 1/2 + d means F below 1/2 - d
      If PmOpQFracCmp(s, q + 1, -1) < 0
        up = 1
      ElseIf ia = 0 And PmOpQFracCmp(s, q + 2, 1) > 0
        up = 0
      ElseIf ia > 0 And PmOpQFracCmp(s, q + 1, 1) > 0
        up = 0
      Else
        up = 2
      EndIf
    EndIf
  EndIf
  If up = 2
    up = ia & 1
  EndIf
  r = sgn * (ia + up)
  If r < qmin
    r = qmin
  EndIf
  If r > qmax
    r = qmax
  EndIf
  ProcedureReturn r
EndProcedure

; An accumulator as INT32 (its low 32 bits, signed), as numpy's INT32
; matmul and the reference's conversion leave it.
Procedure.i PmOpWrap32(v.i)
  CompilerIf #PMO_OPS_INT32 = 0
    v = v & $FFFFFFFF
    If v >= $80000000
      v = v - $100000000
    EndIf
  CompilerEndIf
  ProcedureReturn v
EndProcedure

; MatMulInteger-10 (PmOpI(8) = 0, INT32 out) and QLinearMatMul-10 (1,
; requantized) with numpy matmul's batch broadcasting: PmOpI(0) the batch
; rank, PmOpDY / PmOpDA / PmOpDB the batch extents of Y, A and B (1 where
; one broadcasts), (1) M, (2) K, (3) N, (4) A's kind, (5) B's kind, (6) 1
; when a_zero_point is present (one value), (7) b_zero_point: 0 absent, 1
; one value, 2 one per column, (9) 1 for a b_scale per column, (10) Y's kind.
Procedure PmOpQMatMul(a.i, b.i, azp.i, bzp.i, y.i, aScale.i, bScale.i, yScale.i, yZp.i)
  Protected r.i
  Protected batches.i
  Protected bi.i
  Protected rest.i
  Protected d.i
  Protected coord.i
  Protected offA.i
  Protected offB.i
  Protected strideA.i
  Protected strideB.i
  Protected i.i
  Protected j.i
  Protected k.i
  Protected az.i
  Protected bz.i
  Protected acc.i
  Protected at.i
  Protected mm.f
  Protected yz.i
  Protected va.i
  Protected vb.i
  PmOpInit()
  r = PmOpI(0)
  batches = 1
  d = 0
  While d < r
    batches = batches * PmOpDY(d)
    d = d + 1
  Wend
  az = 0
  If PmOpI(6) <> 0
    az = PmOpQRead(azp, 0, PmOpI(4))
  EndIf
  yz = 0
  If PmOpI(8) <> 0
    yz = PmOpQRead(yZp, 0, PmOpI(10))
  EndIf
  bi = 0
  While bi < batches
    rest = bi
    offA = 0
    offB = 0
    strideA = 1
    strideB = 1
    d = r - 1
    While d >= 0
      coord = rest % PmOpDY(d)
      rest = rest / PmOpDY(d)
      If PmOpDA(d) <> 1
        offA = offA + coord * strideA
      EndIf
      If PmOpDB(d) <> 1
        offB = offB + coord * strideB
      EndIf
      strideA = strideA * PmOpDA(d)
      strideB = strideB * PmOpDB(d)
      d = d - 1
    Wend
    offA = offA * PmOpI(1) * PmOpI(2)
    offB = offB * PmOpI(2) * PmOpI(3)
    i = 0
    While i < PmOpI(1)
      j = 0
      While j < PmOpI(3)
        bz = 0
        If PmOpI(7) = 1
          bz = PmOpQRead(bzp, 0, PmOpI(5))
        ElseIf PmOpI(7) = 2
          bz = PmOpQRead(bzp, j, PmOpI(5))
        EndIf
        acc = 0
        k = 0
        While k < PmOpI(2)
          va = PmOpQRead(a, offA + i * PmOpI(2) + k, PmOpI(4))
          va = va - az
          vb = PmOpQRead(b, offB + k * PmOpI(3) + j, PmOpI(5))
          vb = vb - bz
          acc = acc + va * vb
          k = k + 1
        Wend
        acc = PmOpWrap32(acc)
        at = (bi * PmOpI(1) + i) * PmOpI(3) + j
        If PmOpI(8) = 0
          PokeL(y + at * 4, acc)
        Else
          If PmOpI(9) <> 0
            mm = PmTensorGet(aScale, 0) * PmTensorGet(bScale, j)
          Else
            mm = PmTensorGet(aScale, 0) * PmTensorGet(bScale, 0)
          EndIf
          mm = mm / PmTensorGet(yScale, 0)
          PmOpQWrite(y, at, PmOpI(10), PmOpRequant(acc, mm, yz, PmOpQMin(PmOpI(10)), PmOpQMax(PmOpI(10))))
        EndIf
        j = j + 1
      Wend
      i = i + 1
    Wend
    bi = bi + 1
  Wend
EndProcedure

; ConvInteger-10 (PmOpI(45) = 0, INT32 out) and QLinearConv-10 (1,
; requantized). PmOpI(0) the spatial rank s, (1) N, (2) C, (3) M, (4) group,
; (8 + d) input extents, (12 + d) output extents, (16 + d) kernel, (20 + d)
; strides, (24 + d) dilations, (28 + d) leading pads, (40) X's kind, (41)
; W's kind, (42) 1 when x_zero_point is present, (43) w_zero_point: 0 absent,
; 1 one value, 2 one per output channel, (44) 1 when the INT32 bias is
; present, (46) 1 for a w_scale per output channel, (47) Y's kind.
Procedure PmOpQConv(x.i, w.i, xzp.i, wzp.i, bias.i, y.i, xScale.i, wScale.i, yScale.i, yZp.i)
  Protected s.i
  Protected n.i
  Protected m.i
  Protected g.i
  Protected cg.i
  Protected mg.i
  Protected c.i
  Protected o.i
  Protected outCount.i
  Protected inCount.i
  Protected kCount.i
  Protected kk.i
  Protected d.i
  Protected rest.i
  Protected pos.i
  Protected inside.i
  Protected xi.i
  Protected acc.i
  Protected xz.i
  Protected wz.i
  Protected yz.i
  Protected at.i
  Protected mm.f
  Protected va.i
  Protected vb.i
  PmOpInit()
  s = PmOpI(0)
  outCount = 1
  inCount = 1
  kCount = 1
  d = 0
  While d < s
    outCount = outCount * PmOpI(12 + d)
    inCount = inCount * PmOpI(8 + d)
    kCount = kCount * PmOpI(16 + d)
    d = d + 1
  Wend
  cg = PmOpI(2) / PmOpI(4)
  mg = PmOpI(3) / PmOpI(4)
  xz = 0
  If PmOpI(42) <> 0
    xz = PmOpQRead(xzp, 0, PmOpI(40))
  EndIf
  yz = 0
  If PmOpI(45) <> 0
    yz = PmOpQRead(yZp, 0, PmOpI(47))
  EndIf
  n = 0
  While n < PmOpI(1)
    m = 0
    While m < PmOpI(3)
      g = m / mg
      wz = 0
      If PmOpI(43) = 1
        wz = PmOpQRead(wzp, 0, PmOpI(41))
      ElseIf PmOpI(43) = 2
        wz = PmOpQRead(wzp, m, PmOpI(41))
      EndIf
      o = 0
      While o < outCount
        rest = o
        d = s - 1
        While d >= 0
          PmOpCoord(d) = rest % PmOpI(12 + d)
          rest = rest / PmOpI(12 + d)
          d = d - 1
        Wend
        acc = 0
        c = 0
        While c < cg
          kk = 0
          While kk < kCount
            rest = kk
            d = s - 1
            While d >= 0
              PmOpOffset(d) = rest % PmOpI(16 + d)
              rest = rest / PmOpI(16 + d)
              d = d - 1
            Wend
            inside = 1
            xi = 0
            d = 0
            While d < s
              pos = PmOpCoord(d) * PmOpI(20 + d) + PmOpOffset(d) * PmOpI(24 + d) - PmOpI(28 + d)
              If pos < 0 Or pos >= PmOpI(8 + d)
                inside = 0
              EndIf
              xi = xi * PmOpI(8 + d) + pos
              d = d + 1
            Wend
            If inside <> 0
              va = PmOpQRead(x, (n * PmOpI(2) + g * cg + c) * inCount + xi, PmOpI(40))
              va = va - xz
              vb = PmOpQRead(w, (m * cg + c) * kCount + kk, PmOpI(41))
              vb = vb - wz
              acc = acc + va * vb
            EndIf
            kk = kk + 1
          Wend
          c = c + 1
        Wend
        If PmOpI(44) <> 0
          acc = acc + PeekL(bias + m * 4)
        EndIf
        acc = PmOpWrap32(acc)
        at = (n * PmOpI(3) + m) * outCount + o
        If PmOpI(45) = 0
          PokeL(y + at * 4, acc)
        Else
          If PmOpI(46) <> 0
            mm = PmTensorGet(xScale, 0) * PmTensorGet(wScale, m)
          Else
            mm = PmTensorGet(xScale, 0) * PmTensorGet(wScale, 0)
          EndIf
          mm = mm / PmTensorGet(yScale, 0)
          PmOpQWrite(y, at, PmOpI(47), PmOpRequant(acc, mm, yz, PmOpQMin(PmOpI(47)), PmOpQMax(PmOpI(47))))
        EndIf
        o = o + 1
      Wend
      m = m + 1
    Wend
    n = n + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; sin and cos over the binary32 range: the reduction by pi/2, then the
; kernels of Tan's file part. A NaN or an infinity gives the quiet NaN.
; ----------------------------------------------------------------------
Global PmOpPiF.f
Global PmOpTwoPiF.f
Global PmOpHamA.f
Global PmOpHamB.f
Global PmOpBlkA.f
Global PmOpBlkC.f
Global PmOpPio2F.f

Procedure.f PmOpSinF(x.f)
  Protected r.f
  If (PmOpBits(x) & $7FFFFFFF) >= $7F800000
    ProcedureReturn PmOpNaN()
  EndIf
  r = PmOpReducePio2(x)
  Select PmOpQuadrant
    Case 0
      ProcedureReturn PmOpKSin(r)
    Case 1
      ProcedureReturn PmOpKCos(r)
    Case 2
      ProcedureReturn PmOpNeg(PmOpKSin(r))
  EndSelect
  ProcedureReturn PmOpNeg(PmOpKCos(r))
EndProcedure

Procedure.f PmOpCosF(x.f)
  Protected r.f
  If (PmOpBits(x) & $7FFFFFFF) >= $7F800000
    ProcedureReturn PmOpNaN()
  EndIf
  r = PmOpReducePio2(x)
  Select PmOpQuadrant
    Case 0
      ProcedureReturn PmOpKCos(r)
    Case 1
      ProcedureReturn PmOpNeg(PmOpKSin(r))
    Case 2
      ProcedureReturn PmOpNeg(PmOpKCos(r))
  EndSelect
  ProcedureReturn PmOpKSin(r)
EndProcedure

Procedure PmOpSignalInit()
  PmOpInit()
  PmOpTrigInit()
  PmOpSetBits(@PmOpPiF, $40490FDB)
  PmOpSetBits(@PmOpTwoPiF, $40C90FDB)
  PmOpSetBits(@PmOpHamA, $3F0B2164)
  PmOpSetBits(@PmOpHamB, $3EE9BD38)
  PmOpSetBits(@PmOpBlkA, $3ED70A3D)
  PmOpSetBits(@PmOpBlkC, $3DA3D70A)
  PmOpSetBits(@PmOpPio2F, $3FC90FDB)
EndProcedure

; ----------------------------------------------------------------------
; HannWindow (kind 0), HammingWindow (1), BlackmanWindow (2), opset 17:
; a = n * pi / N' (N' = size, or size - 1 when not periodic);
;   Hann      sin(a)^2
;   Hamming   25/46 - cos(2a) * 21/46
;   Blackman  0.42 - 0.5 cos(2a) + 0.08 cos(4a)
; ----------------------------------------------------------------------
Procedure PmOpWindow(dst.i, size.i, kind.i, periodic.i)
  Protected n.i
  Protected n1.f
  Protected a.f
  Protected t.f
  Protected u.f
  PmOpSignalInit()
  If periodic <> 0
    n1 = size
  Else
    n1 = size - 1
  EndIf
  n = 0
  While n < size
    a = n
    a = a * PmOpPiF
    a = a / n1
    If kind = 0
      t = PmOpSinF(a)
      t = t * t
    ElseIf kind = 1
      a = a + a
      t = PmOpCosF(a)
      t = t * PmOpHamB
      t = PmOpHamA - t
    Else
      a = a + a
      t = PmOpCosF(a)
      t = PmOpHalf * t
      t = PmOpBlkA - t
      a = a + a
      u = PmOpCosF(a)
      u = PmOpBlkC * u
      t = t + u
    EndIf
    PmOpStoreF(dst, n, t)
    n = n + 1
  Wend
EndProcedure

; cos and sin of 2 pi r / n into PmOpDftC and PmOpDftS, r < n: the quarter
; turn from the integers (4r = q n + rem), the angle within it pi/2 * rem / n,
; so a multiple of a quarter turn gives exact 0 and 1.
Global PmOpDftC.f
Global PmOpDftS.f
Procedure PmOpTwiddle(r.i, n.i)
  Protected a.f
  Protected fn.f
  Protected c0.f
  Protected s0.f
  Protected q.i
  Protected rem.i
  q = (4 * r) / n
  rem = 4 * r - q * n
  a = rem
  fn = n
  a = a / fn
  a = a * PmOpPio2F
  c0 = PmOpCosF(a)
  s0 = PmOpSinF(a)
  Select q
    Case 0
      PmOpDftC = c0
      PmOpDftS = s0
    Case 1
      PmOpDftC = PmOpNeg(s0)
      PmOpDftS = c0
    Case 2
      PmOpDftC = PmOpNeg(c0)
      PmOpDftS = PmOpNeg(s0)
    Case 3
      PmOpDftC = s0
      PmOpDftS = PmOpNeg(c0)
  EndSelect
EndProcedure

; ----------------------------------------------------------------------
; DFT-17 and DFT-20 by the definition (n^2 products). The signal of length
; PmOpI(1) runs along the axis between PmOpI(0) outer and PmOpI(2) inner
; positions, each element PmOpI(3) wide (1 real, 2 complex). PmOpI(4) the
; transform length n, (5) inverse, (6) onesided. Forward: K = n / 2 + 1
; outputs when onesided, n otherwise, complex; inverse: n complex outputs
; scaled by 1 / n, or with onesided the real inverse of a one-sided
; spectrum (n real outputs). Each sum runs in index order.
; ----------------------------------------------------------------------
Procedure PmOpDft(src.i, dst.i)
  Protected outer.i
  Protected L.i
  Protected inner.i
  Protected comp.i
  Protected n.i
  Protected inv.i
  Protected ones.i
  Protected kc.i
  Protected o.i
  Protected p.i
  Protected k.i
  Protected t.i
  Protected at.i
  Protected lim.i
  Protected xr.f
  Protected xi.f
  Protected re.f
  Protected im.f
  Protected v.f
  Protected w.f
  Protected fn.f
  PmOpSignalInit()
  outer = PmOpI(0)
  L = PmOpI(1)
  inner = PmOpI(2)
  comp = PmOpI(3)
  n = PmOpI(4)
  inv = PmOpI(5)
  ones = PmOpI(6)
  fn = n
  If inv <> 0 And ones <> 0
    kc = n / 2 + 1
    lim = kc
    If L < lim
      lim = L
    EndIf
    o = 0
    While o < outer
      p = 0
      While p < inner
        t = 0
        While t < n
          re = 0.0
          k = 0
          While k < lim
            at = ((o * L + k) * inner + p) * comp
            xr = PmTensorGet(src, at)
            xi = 0.0
            If comp = 2
              xi = PmTensorGet(src, at + 1)
            EndIf
            PmOpTwiddle((k * t) % n, n)
            v = xr * PmOpDftC
            w = xi * PmOpDftS
            v = v - w
            If k <> 0 And 2 * k <> n
              v = v + v
            EndIf
            If k = 0
              re = v
            Else
              re = PmOpAddF(re, v)
            EndIf
            k = k + 1
          Wend
          re = re / fn
          PmOpStoreF(dst, (o * n + t) * inner + p, re)
          t = t + 1
        Wend
        p = p + 1
      Wend
      o = o + 1
    Wend
    ProcedureReturn
  EndIf
  kc = n
  If ones <> 0
    kc = n / 2 + 1
  EndIf
  lim = n
  If L < lim
    lim = L
  EndIf
  o = 0
  While o < outer
    p = 0
    While p < inner
      k = 0
      While k < kc
        re = 0.0
        im = 0.0
        t = 0
        While t < lim
          at = ((o * L + t) * inner + p) * comp
          xr = PmTensorGet(src, at)
          xi = 0.0
          If comp = 2
            xi = PmTensorGet(src, at + 1)
          EndIf
          PmOpTwiddle((k * t) % n, n)
          If inv <> 0
            v = xr * PmOpDftC
            w = xi * PmOpDftS
            v = v - w
            re = PmOpAddF(re, v)
            v = xi * PmOpDftC
            w = xr * PmOpDftS
            v = v + w
            im = PmOpAddF(im, v)
          Else
            v = xr * PmOpDftC
            w = xi * PmOpDftS
            v = v + w
            re = PmOpAddF(re, v)
            v = xi * PmOpDftC
            w = xr * PmOpDftS
            v = v - w
            im = PmOpAddF(im, v)
          EndIf
          t = t + 1
        Wend
        If inv <> 0
          re = re / fn
          im = im / fn
        EndIf
        at = ((o * kc + k) * inner + p) * 2
        PmOpStoreF(dst, at, re)
        PmOpStoreF(dst, at + 1, im)
        k = k + 1
      Wend
      p = p + 1
    Wend
    o = o + 1
  Wend
EndProcedure

; ----------------------------------------------------------------------
; NegativeLogLikelihoodLoss-13 on log-probabilities lp [N, C, D] (D the
; product of the trailing extents) and SoftmaxCrossEntropyLoss-13 (the
; caller has made lp the log-softmax of the scores over C). PmOpI(0) N,
; (1) C, (2) D, (3) the target's kind (6 or 7), (4) reduction (0 none,
; 1 sum, 2 mean: divided by the summed weights of the targets that count),
; (5) 1 when ignore_index is set, (6) ignore_index, (7) 1 for a weight.
; Returns 1 for a target outside [0, C) that is not ignore_index.
; ----------------------------------------------------------------------
Procedure.i PmOpNllLoss(lp.i, target.i, weight.i, y.i)
  Protected i.i
  Protected d.i
  Protected t.i
  Protected at.i
  Protected v.f
  Protected w.f
  Protected total.f
  Protected wsum.f
  PmOpInit()
  total = 0.0
  wsum = 0.0
  i = 0
  While i < PmOpI(0)
    d = 0
    While d < PmOpI(2)
      at = i * PmOpI(2) + d
      If PmOpI(3) = 7
        t = PmTensorGetI64(target, at)
      Else
        t = PeekL(target + at * 4)
      EndIf
      v = 0.0
      If PmOpI(5) <> 0 And t = PmOpI(6)
        v = 0.0
      Else
        If t < 0 Or t >= PmOpI(1)
          ProcedureReturn 1
        EndIf
        w = PmOpOne
        If PmOpI(7) <> 0
          w = PmTensorGet(weight, t)
        EndIf
        v = PmOpNeg(PmTensorGet(lp, (i * PmOpI(1) + t) * PmOpI(2) + d))
        v = w * v
        wsum = PmOpAddF(wsum, w)
      EndIf
      If PmOpI(4) = 0
        PmOpStoreF(y, at, v)
      EndIf
      total = PmOpAddF(total, v)
      d = d + 1
    Wend
    i = i + 1
  Wend
  If PmOpI(4) = 1
    PmOpStoreF(y, 0, total)
  ElseIf PmOpI(4) = 2
    total = total / wsum
    PmOpStoreF(y, 0, total)
  EndIf
  ProcedureReturn 0
EndProcedure
