; ======================================================================
; tensor_fp32_neon.pmi - AArch64 Advanced SIMD acceleration for ONNX.
; ----------------------------------------------------------------------
; Include tensor_fp32.pmi first. A target profile selects these procedures
; behind the ordinary PMTensor ABI; neither ONNX
; lowering nor a model knows that this implementation uses Advanced SIMD.
;
; Vector reduction and FMLA intentionally do not promise bit identity with
; the scalar FP32 reference. Floating-point addition is non-associative and
; FMLA rounds once. The board gate therefore retains exact scalar checks and
; gives optimized runs an explicit numerical contract.
;
; Only caller-saved vector registers are used (v0..v7, v16..v31), so this
; remains safe when Forge eventually keeps language float values in FP/SIMD
; registers across calls. General-purpose state uses caller-saved x0..x17.
; ======================================================================

; Final-axis reductions keep the portable kernel's exact FP32 evaluation
; order while owning their hot loop state in registers.  In particular,
; these are deliberately scalar reductions: a horizontal vector reduction
; or several partial accumulators would reassociate non-associative adds.
Procedure PmTensorReduceMeanLastNeon(*src.i, *dst.i, outer.i, width.i)
  ASM
    ; x0=src x1=dst x2=outer x3=width
    cmp  x2, #0
    b.le pmoNeonReduceMeanDone
    cmp  x3, #0
    b.le pmoNeonReduceMeanDone
    scvtf s2, x3
    mov  x4, x2
pmoNeonReduceMeanRow:
    fmov s0, wzr
    mov  x5, x3
pmoNeonReduceMeanInner:
    ldr  s1, [x0]
    add  x0, x0, #4
pmoNeonReduceMeanAdd:
    fadd s0, s0, s1
    subs x5, x5, #1
    b.ne pmoNeonReduceMeanInner
    fdiv s0, s0, s2
    str  s0, [x1]
    add  x1, x1, #4
    subs x4, x4, #1
    b.ne pmoNeonReduceMeanRow
pmoNeonReduceMeanDone:
  EndASM
EndProcedure

Procedure PmTensorReduceSumLastNeon(*src.i, *dst.i, outer.i, width.i)
  ASM
    ; x0=src x1=dst x2=outer x3=width
    cmp  x2, #0
    b.le pmoNeonReduceSumDone
    cmp  x3, #0
    b.le pmoNeonReduceSumDone
    mov  x4, x2
pmoNeonReduceSumRow:
    fmov s0, wzr
    mov  x5, x3
pmoNeonReduceSumInner:
    ldr  s1, [x0]
    add  x0, x0, #4
pmoNeonReduceSumAdd:
    fadd s0, s0, s1
    subs x5, x5, #1
    b.ne pmoNeonReduceSumInner
    str  s0, [x1]
    add  x1, x1, #4
    subs x4, x4, #1
    b.ne pmoNeonReduceSumRow
pmoNeonReduceSumDone:
  EndASM
EndProcedure

; ----------------------------------------------------------------------
; Elementwise FLOAT32 add/subtract/multiply/divide, four lanes at a time.
;
; NUMERICAL CONTRACT - this kernel IS bit-identical to the scalar body in
; PmFastBinary, and unlike the reductions above it is allowed to claim that.
; Each output element is one FADD/FSUB/FMUL/FDIV of the same two binary32
; operands in the same order, so it is the same single rounding; nothing is
; reassociated, contracted into an FMLA, or evaluated in a wider type.  The
; vector and scalar forms of those four instructions share one FPCR, and
; EnableFloatingPoint leaves it zero - nearest-even, gradual underflow,
; default-NaN DISABLED - so signed zeros, infinities, subnormals and the
; NaN PAYLOAD each op propagates (first source operand first, per
; FPProcessNaNs) come out the same bits per lane as they do one at a time.
;
; WHAT THE CALLER MUST HAVE ESTABLISHED, because this kernel checks none of
; it - DBinary does, and refuses everything else to the portable path:
;   *a, *b, *destination  FLOAT32, and *destination contiguous
;   aStride, bStride      1 for a contiguous operand, 0 for one broadcast
;                         element; nothing else
;   op                    0 add, 1 subtract, 2 multiply, 3 divide
;   destination           may be exactly *a or exactly *b when that operand
;                         is contiguous; it may NOT alias a BROADCAST
;                         operand, because the scalar body re-reads that one
;                         element after the store and this does not, and it
;                         may not partially overlap either operand.
; count <= 0 writes nothing.  A trailing one, two or three elements are
; finished one at a time by the same instructions in scalar form.
;
; Parameters arrive in x0..x6 and the prologue has already spilled them to
; their slots, so they are read here from the registers, the way the
; reductions above read theirs.  Only caller-saved registers are touched.
Procedure PmTensorBinaryFp32Neon(*a.i, *b.i, *destination.i, count.i, aStride.i, bStride.i, op.i)
  ASM
    ; x0=a x1=b x2=destination x3=count x4=aStride x5=bStride x6=op
    cmp  x3, #0
    b.le pmoNeonBinaryDone
pmoNeonBinaryFour:
    cmp  x3, #4
    b.lt pmoNeonBinaryTail
    cbz  x4, pmoNeonBinaryBroadcastA
    ld1  {v0.4s}, [x0]
    add  x0, x0, #16
    b    pmoNeonBinaryLoadB
pmoNeonBinaryBroadcastA:
    ld1r {v0.4s}, [x0]
pmoNeonBinaryLoadB:
    cbz  x5, pmoNeonBinaryBroadcastB
    ld1  {v1.4s}, [x1]
    add  x1, x1, #16
    b    pmoNeonBinaryApply
pmoNeonBinaryBroadcastB:
    ld1r {v1.4s}, [x1]
pmoNeonBinaryApply:
    cbz  x6, pmoNeonBinaryAdd
    cmp  x6, #1
    b.eq pmoNeonBinarySub
    cmp  x6, #2
    b.eq pmoNeonBinaryMul
    fdiv v2.4s, v0.4s, v1.4s
    b    pmoNeonBinaryStore
pmoNeonBinaryAdd:
    fadd v2.4s, v0.4s, v1.4s
    b    pmoNeonBinaryStore
pmoNeonBinarySub:
    fsub v2.4s, v0.4s, v1.4s
    b    pmoNeonBinaryStore
pmoNeonBinaryMul:
    fmul v2.4s, v0.4s, v1.4s
pmoNeonBinaryStore:
    st1  {v2.4s}, [x2]
    add  x2, x2, #16
    sub  x3, x3, #4
    b    pmoNeonBinaryFour
pmoNeonBinaryTail:
    cbz  x3, pmoNeonBinaryDone
    ldr  s0, [x0]
    ldr  s1, [x1]
    cbz  x6, pmoNeonBinaryTailAdd
    cmp  x6, #1
    b.eq pmoNeonBinaryTailSub
    cmp  x6, #2
    b.eq pmoNeonBinaryTailMul
    fdiv s2, s0, s1
    b    pmoNeonBinaryTailStore
pmoNeonBinaryTailAdd:
    fadd s2, s0, s1
    b    pmoNeonBinaryTailStore
pmoNeonBinaryTailSub:
    fsub s2, s0, s1
    b    pmoNeonBinaryTailStore
pmoNeonBinaryTailMul:
    fmul s2, s0, s1
pmoNeonBinaryTailStore:
    str  s2, [x2]
    add  x2, x2, #4
    cbz  x4, pmoNeonBinaryTailBStep
    add  x0, x0, #4
pmoNeonBinaryTailBStep:
    cbz  x5, pmoNeonBinaryTailNext
    add  x1, x1, #4
pmoNeonBinaryTailNext:
    sub  x3, x3, #1
    b    pmoNeonBinaryTail
pmoNeonBinaryDone:
  EndASM
EndProcedure

; A is MxK, B is KxN and dst is MxN, all row-major. Four adjacent columns
; are one vector. Every scalar A value is broadcast once and every matching
; run of four B values is fetched with one vector load.
Procedure PmTensorMatMul2Neon(*a.i, *b.i, *dst.i, m.i, k.i, n.i)
  ASM
    ; x0=a x1=b x2=dst x3=m x4=k x5=n
    cbz  x3, pmoNeonMatMulDone
    cbz  x5, pmoNeonMatMulDone
    lsl  x12, x5, #2                 ; bytes between B rows
    movz x6, #0                      ; row
pmoNeonMatMulRow:
    mul  x13, x6, x4
    lsl  x13, x13, #2
    add  x9, x0, x13                 ; A row base
    mul  x13, x6, x5
    lsl  x13, x13, #2
    add  x11, x2, x13                ; dst cursor
    movz x7, #0                      ; column
pmoNeonMatMulFourCheck:
    sub  x13, x5, x7
    cmp  x13, #4
    b.lt pmoNeonMatMulTailCheck
    movi v16.4s, #0
    lsl  x13, x7, #2
    add  x10, x1, x13                ; B row zero at this column
    mov  x14, x9                     ; A cursor
    mov  x8, x4                      ; remaining K
    cbz  x8, pmoNeonMatMulFourStore
pmoNeonMatMulFourInner:
    ldr  s0, [x14]
    dup  v0.4s, v0.s[0]
    ld1  { v1.4s }, [x10]
    fmla v16.4s, v1.4s, v0.4s
    add  x14, x14, #4
    add  x10, x10, x12
    subs x8, x8, #1
    b.ne pmoNeonMatMulFourInner
pmoNeonMatMulFourStore:
    st1  { v16.4s }, [x11], #16
    add  x7, x7, #4
    b    pmoNeonMatMulFourCheck

    ; One to three remaining columns keep the scalar left-to-right order.
pmoNeonMatMulTailCheck:
    cmp  x7, x5
    b.ge pmoNeonMatMulNextRow
    fmov s0, wzr
    lsl  x13, x7, #2
    add  x10, x1, x13
    mov  x14, x9
    mov  x8, x4
    cbz  x8, pmoNeonMatMulTailStore
pmoNeonMatMulTailInner:
    ldr  s4, [x14]
    ldr  s5, [x10]
    fmul s5, s5, s4
    fadd s0, s0, s5
    add  x14, x14, #4
    add  x10, x10, x12
    subs x8, x8, #1
    b.ne pmoNeonMatMulTailInner
pmoNeonMatMulTailStore:
    str  s0, [x11]
    add  x11, x11, #4
    add  x7, x7, #1
    b    pmoNeonMatMulTailCheck
pmoNeonMatMulNextRow:
    add  x6, x6, #1
    cmp  x6, x3
    b.lt pmoNeonMatMulRow
pmoNeonMatMulDone:
  EndASM
EndProcedure

CompilerIf #PMO_USE_CONV = 1
Structure PmTensorConv1DFp32FourArgs
  Src.i
  Weight.i
  Dst.i
  InWidth.i
  Kernel.i
  Stride.i
  Dilation.i
  InPerGroup.i
  InputChannelBase.i
  Batch.i
  InputChannels.i
  OutputChannel.i
  OutputX.i
  OutputWidth.i
  OutChannels.i
  PadLeft.i
  BiasValue.f
EndStructure

; One output position whose dilated kernel is only partly inside the input.
; The reference adds nothing at all for a tap outside [0, InWidth), and input x
; rises monotonically with the tap index, so the taps it keeps are always one
; contiguous run.  Both bodies below clamp that run once from the position and
; then reduce over it with no per-tap test, no accessor call and no static-slot
; traffic, in the same input-channel-major, tap-minor order with the same
; separate FMUL and FADD as PmTensorConv1D.
Structure PmTensorConv1DFp32EdgeArgs
  Src.i
  Weight.i
  Dst.i
  InWidth.i
  Kernel.i
  Stride.i
  Dilation.i
  InPerGroup.i
  InputChannelBase.i
  Batch.i
  InputChannels.i
  OutputChannel.i
  OutputX.i
  OutputWidth.i
  OutChannels.i
  PadLeft.i
  Bias0.f
  Bias1.f
  Bias2.f
  Bias3.f
EndStructure

Structure PmTensorConv1DFp32FourByFourArgs
  Src.i
  Weight.i
  Dst.i
  InWidth.i
  Kernel.i
  Dilation.i
  InPerGroup.i
  InputChannelBase.i
  Batch.i
  InputChannels.i
  OutputChannel.i
  OutputX.i
  OutputWidth.i
  OutChannels.i
  PadLeft.i
  Bias0.f
  Bias1.f
  Bias2.f
  Bias3.f
EndStructure

; Four adjacent output channels by four fully in-range positions. Kokoro's
; hot convolutions all have unit stride, so the same contiguous source vector
; feeds four independent output-channel accumulators. Each accumulator still
; visits icg then kx in the portable order and uses separate FMUL/FADD.
Procedure PmTensorConv1DFp32FourByFour(*a.PmTensorConv1DFp32FourByFourArgs)
  ASM
    ldr x1, [x0, #0]                 ; source base
    ldr x2, [x0, #8]                 ; weight base
    ldr x4, [x0, #24]                ; input width
    ldr x5, [x0, #32]                ; kernel
    ldr x6, [x0, #40]                ; dilation
    ldr x7, [x0, #48]                ; input channels per group
    ldr x8, [x0, #56]                ; first input channel in group
    ldr x9, [x0, #64]                ; batch
    ldr x10, [x0, #72]               ; all input channels
    mul x9, x9, x10
    add x9, x9, x8
    mul x9, x9, x4
    ldr x10, [x0, #88]               ; first output position
    add x9, x9, x10
    ldr x10, [x0, #112]              ; left padding
    sub x9, x9, x10
    lsl x9, x9, #2
    add x1, x1, x9                   ; source channel zero at output x

    ldr x11, [x0, #80]               ; first output channel
    mul x12, x7, x5                  ; weights per output channel
    mul x10, x11, x12
    lsl x10, x10, #2
    add x13, x2, x10                 ; four weight-row cursors
    lsl x12, x12, #2
    add x14, x13, x12
    add x15, x14, x12
    add x16, x15, x12

    ldr s16, [x0, #120]
    ldr s17, [x0, #124]
    ldr s18, [x0, #128]
    ldr s19, [x0, #132]
    dup v16.4s, v16.s[0]
    dup v17.4s, v17.s[0]
    dup v18.4s, v18.s[0]
    dup v19.4s, v19.s[0]
    lsl x4, x4, #2                  ; bytes between source channels
    lsl x6, x6, #2                  ; bytes between kernel samples
    ; Both reduction loops below are do-while, so an empty group or an empty
    ; kernel would run 2^64 times.  PmTensorConv1D leaves such an output at
    ; its bias, and so does this: branch straight to the store, where the
    ; accumulators still hold the broadcast bias.
    cmp x7, #1
    b.lt pmoNeonConvFpFourByFourEmpty
    cmp x5, #1
    b.lt pmoNeonConvFpFourByFourEmpty
    mov x8, x7
pmoNeonConvFpFourByFourChannel:
    mov x10, x1
    mov x9, x5
pmoNeonConvFpFourByFourKernel:
pmoNeonConvFpFourByFourSource:
    ld1 {v1.4s}, [x10]
    ldr s0, [x13]
    dup v0.4s, v0.s[0]
    fmul v2.4s, v1.4s, v0.4s
pmoNeonConvFpFourByFourAdd0:
    fadd v16.4s, v16.4s, v2.4s
    ldr s0, [x14]
    dup v0.4s, v0.s[0]
    fmul v2.4s, v1.4s, v0.4s
    fadd v17.4s, v17.4s, v2.4s
    ldr s0, [x15]
    dup v0.4s, v0.s[0]
    fmul v2.4s, v1.4s, v0.4s
    fadd v18.4s, v18.4s, v2.4s
    ldr s0, [x16]
    dup v0.4s, v0.s[0]
    fmul v2.4s, v1.4s, v0.4s
    fadd v19.4s, v19.4s, v2.4s
    add x10, x10, x6
    add x13, x13, #4
    add x14, x14, #4
    add x15, x15, #4
    add x16, x16, #4
    subs x9, x9, #1
    b.ne pmoNeonConvFpFourByFourKernel
    add x1, x1, x4
    subs x8, x8, #1
    b.ne pmoNeonConvFpFourByFourChannel

pmoNeonConvFpFourByFourEmpty:
    ldr x3, [x0, #16]
    ldr x9, [x0, #64]
    ldr x10, [x0, #104]
    mul x9, x9, x10
    ldr x11, [x0, #80]
    add x9, x9, x11
    ldr x12, [x0, #96]
    mul x9, x9, x12
    ldr x11, [x0, #88]
    add x9, x9, x11
    lsl x9, x9, #2
    add x3, x3, x9
    lsl x12, x12, #2
pmoNeonConvFpFourByFourStore0:
    st1 {v16.4s}, [x3]
    add x3, x3, x12
    st1 {v17.4s}, [x3]
    add x3, x3, x12
    st1 {v18.4s}, [x3]
    add x3, x3, x12
    st1 {v19.4s}, [x3]
  EndASM
EndProcedure

; Four fully in-range output positions.  Reduction remains icg-major then
; kx-major, and FMUL/FADD remain separate, so every lane follows the scalar
; FP32 operation order.  Strided outputs use lane loads because A64 NEON has
; no gather instruction.
Procedure PmTensorConv1DFp32Four(*a.PmTensorConv1DFp32FourArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    ldr x6, [x0, #40]
    ldr x7, [x0, #48]
    ldr x8, [x0, #56]
    ldr x9, [x0, #64]
    ldr x10, [x0, #72]
    ldr x11, [x0, #80]
    mul x10, x10, x11
    add x10, x10, x9
    mul x10, x10, x4
    ldr x11, [x0, #96]
    mul x11, x11, x6
    ldr x13, [x0, #120]
    sub x11, x11, x13
    add x10, x10, x11
    lsl x10, x10, #2
    add x1, x1, x10
    ldr x10, [x0, #88]
    mul x10, x10, x8
    mul x10, x10, x5
    lsl x10, x10, #2
    add x2, x2, x10
    ldr s16, [x0, #128]
    dup v16.4s, v16.s[0]
    lsl x6, x6, #2
    lsl x7, x7, #2
    lsl x4, x4, #2
    ; Both loops below are do-while.  An empty group ran one spurious channel
    ; and read weight word zero of a zero-length weight buffer; an empty kernel
    ; iterated 2^64 times.  PmTensorConv1D leaves both at the bias, so branch
    ; to the store, where v16 already holds the broadcast bias.
    cmp x8, #1
    b.lt pmoNeonConvFpFourStore
    cmp x5, #1
    b.lt pmoNeonConvFpFourStore
    movz x9, #0
pmoNeonConvFpFourChannel:
    mov x10, x1
    mov x11, x2
    mov x12, x5
pmoNeonConvFpFourKernel:
    ldr s0, [x11]
    dup v0.4s, v0.s[0]
    ldr s1, [x10]
    add x13, x10, x6
    ld1 {v1.s}[1], [x13]
    add x13, x13, x6
    ld1 {v1.s}[2], [x13]
    add x13, x13, x6
    ld1 {v1.s}[3], [x13]
    fmul v1.4s, v1.4s, v0.4s
    fadd v16.4s, v16.4s, v1.4s
    add x10, x10, x7
    add x11, x11, #4
    subs x12, x12, #1
    b.ne pmoNeonConvFpFourKernel
    add x1, x1, x4
    lsl x10, x5, #2
    add x2, x2, x10
    add x9, x9, #1
    cmp x9, x8
    b.lt pmoNeonConvFpFourChannel
pmoNeonConvFpFourStore:
    ldr x10, [x0, #72]
    ldr x11, [x0, #112]
    mul x10, x10, x11
    ldr x11, [x0, #88]
    add x10, x10, x11
    ldr x11, [x0, #104]
    mul x10, x10, x11
    ldr x11, [x0, #96]
    add x10, x10, x11
    lsl x10, x10, #2
    add x3, x3, x10
    st1 {v16.4s}, [x3]
  EndASM
EndProcedure

; Four adjacent output channels at ONE partly padded position.  The four
; channels share every source sample, so one broadcast feeds four independent
; lane accumulators; lanes are never combined and there is no horizontal
; reduction, so lane n performs exactly the adds PmTensorConv1D performs for
; output channel oc+n.  The caller guarantees all four channels are in one
; group and that Dilation >= 1.
Procedure PmTensorConv1DFp32EdgeFour(*a.PmTensorConv1DFp32EdgeArgs)
  ASM
    ldr x4, [x0, #24]                ; input width
    ldr x6, [x0, #48]                ; dilation
    ldr x9, [x0, #96]                ; output position
    ldr x10, [x0, #40]               ; stride
    mul x9, x9, x10
    ldr x10, [x0, #120]              ; left padding
    sub x9, x9, x10                  ; input x of tap zero, unclamped
    ; First kept tap: the smallest kx with ox*Stride-PadLeft+kx*Dilation >= 0.
    ; Computed only when tap zero is left of the input, so the division always
    ; has two positive operands.
    movz x11, #0
    cmp x9, #0
    b.ge pmoNeonConvFpEdgeFourLow
    sub x10, xzr, x9
    add x10, x10, x6
    sub x10, x10, #1
    udiv x11, x10, x6
pmoNeonConvFpEdgeFourLow:
    ; One past the last kept tap, clamped to Kernel.  A negative numerator is
    ; branched out rather than divided: this divide is unsigned.
    ldr x8, [x0, #32]                ; kernel
    mov x12, x8
    sub x10, x4, #1
    subs x10, x10, x9
    b.lt pmoNeonConvFpEdgeFourNone
    udiv x10, x10, x6
    add x10, x10, #1
    cmp x10, x12
    b.ge pmoNeonConvFpEdgeFourHigh
    mov x12, x10
    b pmoNeonConvFpEdgeFourHigh
pmoNeonConvFpEdgeFourNone:
    movz x12, #0
pmoNeonConvFpEdgeFourHigh:
    ; A position whose whole kernel misses the input leaves the low bound above
    ; the high one; it keeps no taps and stores the bias, as the reference does.
    cmp x11, x12
    b.lt pmoNeonConvFpEdgeFourCount
    mov x11, x12
pmoNeonConvFpEdgeFourCount:
    sub x5, x12, x11                 ; taps kept at this position
    mul x10, x11, x6
    add x9, x9, x10                  ; input x of the first kept tap

    ldr x10, [x0, #80]               ; all input channels
    ldr x17, [x0, #72]               ; batch
    mul x10, x10, x17
    ldr x17, [x0, #64]               ; first input channel in group
    add x10, x10, x17
    mul x10, x10, x4
    add x10, x10, x9
    lsl x10, x10, #2
    ldr x1, [x0, #0]
    add x1, x1, x10                  ; source, channel zero, first kept tap

    ldr x7, [x0, #56]                ; input channels per group
    mul x17, x7, x8                  ; weights per output channel
    ldr x10, [x0, #88]               ; first output channel
    mul x10, x10, x17
    add x10, x10, x11
    lsl x10, x10, #2
    ldr x2, [x0, #8]
    add x13, x2, x10                 ; four weight cursors
    lsl x17, x17, #2
    add x14, x13, x17
    add x15, x14, x17
    add x16, x15, x17

    sub x12, x8, x5                  ; taps skipped, per input channel
    lsl x12, x12, #2
    lsl x4, x4, #2                   ; bytes between source channels
    lsl x6, x6, #2                   ; bytes between kept taps
    add x17, x0, #128
    ld1 { v16.4s }, [x17]            ; one accumulator lane per output channel
    ; Both loops below are do-while, so an empty group or a position that keeps
    ; no tap would run 2^64 times.  Branch to the store, where the accumulators
    ; still hold the bias.
    cmp x7, #1
    b.lt pmoNeonConvFpEdgeFourStore
    cmp x5, #1
    b.lt pmoNeonConvFpEdgeFourStore
    mov x8, x7
pmoNeonConvFpEdgeFourChannel:
    mov x10, x1
    mov x9, x5
pmoNeonConvFpEdgeFourKernel:
pmoNeonConvFpEdgeFourSource:
    ldr s1, [x10]
    dup v1.4s, v1.s[0]
    ld1 { v0.s }[0], [x13]
    ld1 { v0.s }[1], [x14]
    ld1 { v0.s }[2], [x15]
    ld1 { v0.s }[3], [x16]
    fmul v2.4s, v1.4s, v0.4s
pmoNeonConvFpEdgeFourAdd:
    fadd v16.4s, v16.4s, v2.4s
    add x10, x10, x6
    add x13, x13, #4
    add x14, x14, #4
    add x15, x15, #4
    add x16, x16, #4
    subs x9, x9, #1
    b.ne pmoNeonConvFpEdgeFourKernel
    add x1, x1, x4
    add x13, x13, x12
    add x14, x14, x12
    add x15, x15, x12
    add x16, x16, x12
    subs x8, x8, #1
    b.ne pmoNeonConvFpEdgeFourChannel
pmoNeonConvFpEdgeFourStore:
    ldr x3, [x0, #16]
    ldr x9, [x0, #72]                ; batch
    ldr x10, [x0, #112]              ; all output channels
    mul x9, x9, x10
    ldr x11, [x0, #88]
    add x9, x9, x11
    ldr x12, [x0, #104]              ; output width
    mul x9, x9, x12
    ldr x11, [x0, #96]
    add x9, x9, x11
    lsl x9, x9, #2
    add x3, x3, x9
    lsl x12, x12, #2
pmoNeonConvFpEdgeFourStore0:
    st1 { v16.s }[0], [x3]
    add x3, x3, x12
    st1 { v16.s }[1], [x3]
    add x3, x3, x12
    st1 { v16.s }[2], [x3]
    add x3, x3, x12
    st1 { v16.s }[3], [x3]
  EndASM
EndProcedure

; One output channel at one partly padded position.  Same clamp, same order,
; one scalar accumulator.  This is what a group with fewer than four remaining
; output channels, and every strided convolution, use for their edges.
Procedure PmTensorConv1DFp32EdgeOne(*a.PmTensorConv1DFp32EdgeArgs)
  ASM
    ldr x4, [x0, #24]                ; input width
    ldr x6, [x0, #48]                ; dilation
    ldr x9, [x0, #96]                ; output position
    ldr x10, [x0, #40]               ; stride
    mul x9, x9, x10
    ldr x10, [x0, #120]              ; left padding
    sub x9, x9, x10                  ; input x of tap zero, unclamped
    movz x11, #0
    cmp x9, #0
    b.ge pmoNeonConvFpEdgeOneLow
    sub x10, xzr, x9
    add x10, x10, x6
    sub x10, x10, #1
    udiv x11, x10, x6
pmoNeonConvFpEdgeOneLow:
    ldr x8, [x0, #32]                ; kernel
    mov x12, x8
    sub x10, x4, #1
    subs x10, x10, x9
    b.lt pmoNeonConvFpEdgeOneNone
    udiv x10, x10, x6
    add x10, x10, #1
    cmp x10, x12
    b.ge pmoNeonConvFpEdgeOneHigh
    mov x12, x10
    b pmoNeonConvFpEdgeOneHigh
pmoNeonConvFpEdgeOneNone:
    movz x12, #0
pmoNeonConvFpEdgeOneHigh:
    cmp x11, x12
    b.lt pmoNeonConvFpEdgeOneCount
    mov x11, x12
pmoNeonConvFpEdgeOneCount:
    sub x5, x12, x11                 ; taps kept at this position
    mul x10, x11, x6
    add x9, x9, x10                  ; input x of the first kept tap

    ldr x10, [x0, #80]               ; all input channels
    ldr x17, [x0, #72]               ; batch
    mul x10, x10, x17
    ldr x17, [x0, #64]               ; first input channel in group
    add x10, x10, x17
    mul x10, x10, x4
    add x10, x10, x9
    lsl x10, x10, #2
    ldr x1, [x0, #0]
    add x1, x1, x10                  ; source, channel zero, first kept tap

    ldr x7, [x0, #56]                ; input channels per group
    mul x17, x7, x8                  ; weights per output channel
    ldr x10, [x0, #88]               ; output channel
    mul x10, x10, x17
    add x10, x10, x11
    lsl x10, x10, #2
    ldr x2, [x0, #8]
    add x13, x2, x10                 ; weight cursor

    sub x12, x8, x5                  ; taps skipped, per input channel
    lsl x12, x12, #2
    lsl x4, x4, #2                   ; bytes between source channels
    lsl x6, x6, #2                   ; bytes between kept taps
    ldr s16, [x0, #128]              ; bias
    cmp x7, #1
    b.lt pmoNeonConvFpEdgeOneStore
    cmp x5, #1
    b.lt pmoNeonConvFpEdgeOneStore
    mov x8, x7
pmoNeonConvFpEdgeOneChannel:
    mov x10, x1
    mov x9, x5
pmoNeonConvFpEdgeOneKernel:
pmoNeonConvFpEdgeOneSource:
    ldr s1, [x10]
    ldr s0, [x13]
    fmul s2, s1, s0
pmoNeonConvFpEdgeOneAdd:
    fadd s16, s16, s2
    add x10, x10, x6
    add x13, x13, #4
    subs x9, x9, #1
    b.ne pmoNeonConvFpEdgeOneKernel
    add x1, x1, x4
    add x13, x13, x12
    subs x8, x8, #1
    b.ne pmoNeonConvFpEdgeOneChannel
pmoNeonConvFpEdgeOneStore:
    ldr x3, [x0, #16]
    ldr x9, [x0, #72]                ; batch
    ldr x10, [x0, #112]              ; all output channels
    mul x9, x9, x10
    ldr x11, [x0, #88]
    add x9, x9, x11
    ldr x12, [x0, #104]              ; output width
    mul x9, x9, x12
    ldr x11, [x0, #96]
    add x9, x9, x11
    lsl x9, x9, #2
    add x3, x3, x9
pmoNeonConvFpEdgeOneStore0:
    str s16, [x3]
  EndASM
EndProcedure

; One padded or tail output through the scalar tensor accessors, testing every
; tap the way the reference does.  The clamped edge bodies above need a
; positive dilation to clamp with; this is what covers anything else.
Procedure PmTensorConv1DFp32One(*g.PmTensorConv1DArgs, bn.i, oc.i, ox.i)
  Protected icg.i
  Protected kx.i
  Protected ix.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected ic.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected sum.f
  inPerGroup=*g\InChannels / *g\Groups : outPerGroup=*g\OutChannels / *g\Groups
  group=oc/outPerGroup : sum=0.0
  If *g\Bias<>0 : sum=PmTensorGet(*g\Bias,oc) : EndIf
  icg=0
  While icg<inPerGroup
    ic=group*inPerGroup+icg : kx=0
    While kx<*g\Kernel
      ix=ox* *g\Stride-*g\PadLeft+kx* *g\Dilation
      If ix>=0 And ix<*g\InWidth
        srcIndex=(bn* *g\InChannels+ic)* *g\InWidth+ix
        weightIndex=(oc*inPerGroup+icg)* *g\Kernel+kx
        sum=sum+PmTensorGet(*g\Src,srcIndex)*PmTensorGet(*g\Weight,weightIndex)
      EndIf
      kx+1
    Wend
    icg+1
  Wend
  PmTensorPut(*g\Dst,(bn* *g\OutChannels+oc)* *g\OutWidth+ox,sum)
EndProcedure

Procedure PmTensorConv1DFp32Neon(*g.PmTensorConv1DArgs)
  Protected bn.i
  Protected oc.i
  Protected ox.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected first.i
  Protected last.i
  Protected lastNumerator.i
  Protected groupEnd.i
  Protected lane.i
  Protected useEdge.i
  Protected four.PmTensorConv1DFp32FourArgs
  Protected tile.PmTensorConv1DFp32FourByFourArgs
  Protected edge.PmTensorConv1DFp32EdgeArgs
  If *g=0 Or *g\Batches<=0 Or *g\OutChannels<=0 Or *g\OutWidth<=0
    ProcedureReturn
  EndIf
  ; The clamped-tap edge bodies divide by Dilation, so they need it positive;
  ; ONNX requires that.  Anything else keeps PmTensorConv1DFp32One, which tests
  ; every tap individually and therefore does not care what Dilation is.
  useEdge=1
  If *g\Dilation<1 : useEdge=0 : EndIf
  inPerGroup=*g\InChannels / *g\Groups : outPerGroup=*g\OutChannels / *g\Groups
  four\Src=*g\Src : four\Weight=*g\Weight : four\Dst=*g\Dst
  four\InWidth=*g\InWidth : four\Kernel=*g\Kernel : four\Stride=*g\Stride
  four\Dilation=*g\Dilation : four\InPerGroup=inPerGroup
  four\InputChannels=*g\InChannels : four\OutputWidth=*g\OutWidth
  four\OutChannels=*g\OutChannels : four\PadLeft=*g\PadLeft
  tile\Src=*g\Src : tile\Weight=*g\Weight : tile\Dst=*g\Dst
  tile\InWidth=*g\InWidth : tile\Kernel=*g\Kernel : tile\Dilation=*g\Dilation
  tile\InPerGroup=inPerGroup : tile\InputChannels=*g\InChannels
  tile\OutputWidth=*g\OutWidth : tile\OutChannels=*g\OutChannels : tile\PadLeft=*g\PadLeft
  edge\Src=*g\Src : edge\Weight=*g\Weight : edge\Dst=*g\Dst
  edge\InWidth=*g\InWidth : edge\Kernel=*g\Kernel : edge\Stride=*g\Stride
  edge\Dilation=*g\Dilation : edge\InPerGroup=inPerGroup
  edge\InputChannels=*g\InChannels : edge\OutputWidth=*g\OutWidth
  edge\OutChannels=*g\OutChannels : edge\PadLeft=*g\PadLeft
  first=(*g\PadLeft+*g\Stride-1)/ *g\Stride
  If first<0 : first=0 : EndIf
  lastNumerator=*g\InWidth-1+*g\PadLeft-(*g\Kernel-1)* *g\Dilation
  If lastNumerator<0
    last=-1
  Else
    last=lastNumerator/ *g\Stride
  EndIf
  If last>=*g\OutWidth : last=*g\OutWidth-1 : EndIf
  bn=0
  While bn<*g\Batches
    four\Batch=bn : tile\Batch=bn : edge\Batch=bn : oc=0
    While oc<*g\OutChannels
      group=oc/outPerGroup : groupEnd=(group+1)*outPerGroup
      edge\InputChannelBase=group*inPerGroup : edge\OutputChannel=oc
      If *g\Stride=1 And oc+3<groupEnd
        tile\InputChannelBase=group*inPerGroup : tile\OutputChannel=oc
        tile\Bias0=0.0 : tile\Bias1=0.0 : tile\Bias2=0.0 : tile\Bias3=0.0
        If *g\Bias<>0
          tile\Bias0=PmTensorGet(*g\Bias,oc) : tile\Bias1=PmTensorGet(*g\Bias,oc+1)
          tile\Bias2=PmTensorGet(*g\Bias,oc+2) : tile\Bias3=PmTensorGet(*g\Bias,oc+3)
        EndIf
        edge\Bias0=tile\Bias0 : edge\Bias1=tile\Bias1
        edge\Bias2=tile\Bias2 : edge\Bias3=tile\Bias3
        ox=0
        While ox<first And ox<*g\OutWidth
          If useEdge
            edge\OutputX=ox : PmTensorConv1DFp32EdgeFour(@edge)
          Else
            lane=0 : While lane<4 : PmTensorConv1DFp32One(*g,bn,oc+lane,ox) : lane+1 : Wend
          EndIf
          ox+1
        Wend
        While ox+3<=last
          tile\OutputX=ox : PmTensorConv1DFp32FourByFour(@tile) : ox+4
        Wend
        While ox<*g\OutWidth
          If useEdge
            edge\OutputX=ox : PmTensorConv1DFp32EdgeFour(@edge)
          Else
            lane=0 : While lane<4 : PmTensorConv1DFp32One(*g,bn,oc+lane,ox) : lane+1 : Wend
          EndIf
          ox+1
        Wend
        oc+4
      Else
        four\InputChannelBase=group*inPerGroup
        four\OutputChannel=oc : four\BiasValue=0.0
        If *g\Bias<>0 : four\BiasValue=PmTensorGet(*g\Bias,oc) : EndIf
        edge\Bias0=four\BiasValue
        ox=0
        While ox<first And ox<*g\OutWidth
          If useEdge
            edge\OutputX=ox : PmTensorConv1DFp32EdgeOne(@edge)
          Else
            PmTensorConv1DFp32One(*g,bn,oc,ox)
          EndIf
          ox+1
        Wend
        While ox+3<=last
          four\OutputX=ox : PmTensorConv1DFp32Four(@four) : ox+4
        Wend
        While ox<*g\OutWidth
          If useEdge
            edge\OutputX=ox : PmTensorConv1DFp32EdgeOne(@edge)
          Else
            PmTensorConv1DFp32One(*g,bn,oc,ox)
          EndIf
          ox+1
        Wend
        oc+1
      EndIf
    Wend
    bn+1
  Wend
EndProcedure
CompilerEndIf

CompilerIf #PMO_USE_CONVTRANSPOSE = 1
; Fill one output row with the exact FLOAT32 bias bits (or +0).  Direct stores
; avoid accessor overhead without changing the reference initialization.
Procedure PmTensorConvTransposeFp32Fill(*dst.i,count.i,bits.i)
  ASM
    cbz x1, pmoNeonConvTransposeFillDone
pmoNeonConvTransposeFillLoop:
    str w2, [x0]
    add x0, x0, #4
    subs x1, x1, #1
    b.ne pmoNeonConvTransposeFillLoop
pmoNeonConvTransposeFillDone:
  EndASM
EndProcedure

; Scatter one valid contiguous run of kernel taps.  FMUL and FADD are kept
; separate and taps advance in increasing kx order, matching the reference.
Procedure PmTensorConvTransposeFp32Row(*weight.i,*dst.i,valueBits.i,count.i,dstStepBytes.i)
  ASM
    cbz x3, pmoNeonConvTransposeRowDone
    fmov s0, w2
    cmp x4, #4
    b.ne pmoNeonConvTransposeRowLoop
    dup v0.4s, v0.s[0]
pmoNeonConvTransposeRowFourCheck:
    cmp x3, #4
    b.lt pmoNeonConvTransposeRowScalarSetup
    ld1 {v1.4s}, [x0], #16
    ld1 {v2.4s}, [x1]
    fmul v1.4s, v0.4s, v1.4s
    fadd v2.4s, v2.4s, v1.4s
    st1 {v2.4s}, [x1], #16
    sub x3, x3, #4
    b pmoNeonConvTransposeRowFourCheck
pmoNeonConvTransposeRowScalarSetup:
    cbz x3, pmoNeonConvTransposeRowDone
pmoNeonConvTransposeRowLoop:
    ldr s1, [x0]
    add x0, x0, #4
    ldr s2, [x1]
    fmul s1, s0, s1
    fadd s2, s2, s1
    str s2, [x1]
    add x1, x1, x4
    subs x3, x3, #1
    b.ne pmoNeonConvTransposeRowLoop
pmoNeonConvTransposeRowDone:
  EndASM
EndProcedure

Procedure PmTensorConvTranspose1DFp32Neon(*g.PmTensorConvTranspose1DArgs)
  Protected bn.i
  Protected ic.i
  Protected ix.i
  Protected ocg.i
  Protected oc.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected baseOx.i
  Protected firstK.i
  Protected lastK.i
  Protected limit.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected dstIndex.i
  Protected bits.i
  If *g=0 Or *g\Batches<=0 Or *g\Groups<=0 Or *g\InChannels<=0 Or *g\OutChannels<=0 Or *g\OutWidth<=0 Or *g\Kernel<=0 Or *g\Dilation<=0
    ProcedureReturn
  EndIf
  inPerGroup=*g\InChannels / *g\Groups
  outPerGroup=*g\OutChannels / *g\Groups
  bn=0
  While bn<*g\Batches
    oc=0
    While oc<*g\OutChannels
      bits=0
      If *g\Bias<>0 : bits=PeekL(*g\Bias+oc*4) : EndIf
      dstIndex=(bn* *g\OutChannels+oc)* *g\OutWidth
      PmTensorConvTransposeFp32Fill(*g\Dst+dstIndex*4,*g\OutWidth,bits)
      oc+1
    Wend
    ic=0
    While ic<*g\InChannels
      group=ic/inPerGroup
      ix=0
      While ix<*g\InWidth
        srcIndex=(bn* *g\InChannels+ic)* *g\InWidth+ix
        bits=PeekL(*g\Src+srcIndex*4)
        baseOx=ix* *g\Stride-*g\PadLeft
        firstK=0
        If baseOx<0 : firstK=(-baseOx+*g\Dilation-1)/ *g\Dilation : EndIf
        lastK=*g\Kernel
        limit=*g\OutWidth-1-baseOx
        If limit<0
          lastK=0
        ElseIf limit/ *g\Dilation+1<lastK
          lastK=limit/ *g\Dilation+1
        EndIf
        If firstK<0 : firstK=0 : EndIf
        If lastK>*g\Kernel : lastK=*g\Kernel : EndIf
        If firstK<lastK
          ocg=0
          While ocg<outPerGroup
            oc=group*outPerGroup+ocg
            weightIndex=(ic*outPerGroup+ocg)* *g\Kernel+firstK
            dstIndex=(bn* *g\OutChannels+oc)* *g\OutWidth+baseOx+firstK* *g\Dilation
            PmTensorConvTransposeFp32Row(*g\Weight+weightIndex*4,*g\Dst+dstIndex*4,bits,lastK-firstK,*g\Dilation*4)
            ocg+1
          Wend
        EndIf
        ix+1
      Wend
      ic+1
    Wend
    bn+1
  Wend
EndProcedure
CompilerEndIf

CompilerIf #PMO_USE_INT8 = 1
CompilerIf #PMO_USE_CONV = 1
Structure PmTensorConv1DNeonEightArgs
  Src.i
  Weight.i
  Dst.i
  InChannels.i
  InWidth.i
  OutChannels.i
  OutWidth.i
  Kernel.i
  PadLeft.i
  Dilation.i
  InPerGroup.i
  InputChannelBase.i
  Batch.i
  OutputChannel.i
  OutputX.i
  Scale.f
  BiasValue.f
EndStructure

Procedure PmTensorConv1DInt8One(*g.PmTensorConv1DArgs, bn.i, oc.i, ox.i, aScale.f)
  Protected icg.i
  Protected kx.i
  Protected ix.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected ic.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected accumulator.i
  Protected converted.f
  Protected sum.f
  inPerGroup = *g\InChannels / *g\Groups
  outPerGroup = *g\OutChannels / *g\Groups
  group = oc / outPerGroup : sum = 0.0 : accumulator = 0
  If *g\Bias <> 0 : sum = PmTensorGet(*g\Bias, oc) : EndIf
  icg = 0
  While icg < inPerGroup
    ic = group * inPerGroup + icg : kx = 0
    While kx < *g\Kernel
      ix = ox - *g\PadLeft + kx * *g\Dilation
      If ix >= 0 And ix < *g\InWidth
        srcIndex = (bn * *g\InChannels + ic) * *g\InWidth + ix
        weightIndex = (oc * inPerGroup + icg) * *g\Kernel + kx
        accumulator = accumulator + PeekB(PmTensorInt8Scratch + srcIndex) * PeekB(*g\Weight + weightIndex)
      EndIf
      kx = kx + 1
    Wend
    icg = icg + 1
  Wend
  converted = accumulator
  sum = sum + converted * aScale * PmTensorGet(*g\WeightScales, oc)
  PmTensorPut(*g\Dst, (bn * *g\OutChannels + oc) * *g\OutWidth + ox, sum)
EndProcedure

; Eight adjacent output positions share each signed INT8 weight.  The kernel
; widens products to signed 16-bit and accumulates in signed 32-bit lanes.
; The caller admits only positions whose complete dilated kernel is in range.
Procedure PmTensorConv1DInt8Eight(*g.PmTensorConv1DNeonEightArgs)
  ASM
    ; x0=args; structure offsets are eight-byte A64 integers through OutputX.
    ldr  x1, [x0, #0]               ; quantized source
    ldr  x2, [x0, #8]               ; signed INT8 weights
    ldr  x3, [x0, #16]              ; FP32 destination
    ldr  x4, [x0, #32]              ; input width
    ldr  x5, [x0, #56]              ; kernel width
    ldr  x6, [x0, #72]              ; dilation
    ldr  x7, [x0, #80]              ; input channels per group

    ldr  x8, [x0, #96]              ; batch
    ldr  x9, [x0, #24]              ; all input channels
    mul  x8, x8, x9
    ldr  x9, [x0, #88]              ; first input channel for this group
    add  x8, x8, x9
    mul  x8, x8, x4
    ldr  x9, [x0, #112]             ; output x
    add  x8, x8, x9
    ldr  x9, [x0, #64]              ; left pad
    sub  x8, x8, x9
    add  x1, x1, x8                 ; channel-zero source cursor

    ldr  x8, [x0, #104]             ; output channel
    mul  x8, x8, x7
    mul  x8, x8, x5
    add  x2, x2, x8                 ; channel-zero weight cursor

    movi v16.4s, #0
    movi v17.4s, #0
    movz x8, #0                     ; input-channel index
pmoNeonConv1EightChannel:
    mov  x9, x1
    mov  x10, x2
    mov  x11, x5
pmoNeonConv1EightKernel:
    ld1  { v1.8b }, [x9]
    ld1  { v0.b }[0], [x10]
    dup  v0.8b, v0.b[0]
    smull v2.8h, v1.8b, v0.8b
    sxtl v3.4s, v2.4h
    sxtl2 v4.4s, v2.8h
    add  v16.4s, v16.4s, v3.4s
    add  v17.4s, v17.4s, v4.4s
    add  x9, x9, x6
    add  x10, x10, #1
    subs x11, x11, #1
    b.ne pmoNeonConv1EightKernel
    add  x1, x1, x4
    add  x2, x2, x5
    add  x8, x8, #1
    cmp  x8, x7
    b.lt pmoNeonConv1EightChannel

    scvtf v16.4s, v16.4s
    scvtf v17.4s, v17.4s
    ldr  s0, [x0, #120]
    dup  v0.4s, v0.s[0]
    fmul v16.4s, v16.4s, v0.4s
    fmul v17.4s, v17.4s, v0.4s
    ldr  s1, [x0, #124]
    dup  v1.4s, v1.s[0]
    fadd v16.4s, v16.4s, v1.4s
    fadd v17.4s, v17.4s, v1.4s

    ldr  x8, [x0, #96]
    ldr  x9, [x0, #40]
    mul  x8, x8, x9
    ldr  x9, [x0, #104]
    add  x8, x8, x9
    ldr  x9, [x0, #48]
    mul  x8, x8, x9
    ldr  x9, [x0, #112]
    add  x8, x8, x9
    lsl  x8, x8, #2
    add  x3, x3, x8
    st1  { v16.4s }, [x3], #16
    st1  { v17.4s }, [x3]
  EndASM
EndProcedure

Procedure PmTensorConv1DNeon(*g.PmTensorConv1DArgs)
  Protected bn.i
  Protected oc.i
  Protected ox.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected aScale.f
  Protected eight.PmTensorConv1DNeonEightArgs
  If *g\WeightScales = 0
    PmTensorConv1DFp32Neon(*g)
    ProcedureReturn
  EndIf
  If *g\Stride <> 1
    PmTensorConv1D(*g)
    ProcedureReturn
  EndIf
  aScale = PmTensorDynamicScale(*g\Src, *g\Batches * *g\InChannels * *g\InWidth)
  PmTensorQuantizeBuffer(*g\Src, PmTensorInt8Scratch, *g\Batches * *g\InChannels * *g\InWidth, aScale)
  inPerGroup = *g\InChannels / *g\Groups
  outPerGroup = *g\OutChannels / *g\Groups
  eight\Src = PmTensorInt8Scratch : eight\Weight = *g\Weight : eight\Dst = *g\Dst
  eight\InChannels = *g\InChannels : eight\InWidth = *g\InWidth
  eight\OutChannels = *g\OutChannels : eight\OutWidth = *g\OutWidth
  eight\Kernel = *g\Kernel : eight\PadLeft = *g\PadLeft : eight\Dilation = *g\Dilation
  eight\InPerGroup = inPerGroup
  bn = 0
  While bn < *g\Batches
    eight\Batch = bn : oc = 0
    While oc < *g\OutChannels
      group = oc / outPerGroup
      eight\InputChannelBase = group * inPerGroup : eight\OutputChannel = oc
      eight\Scale = aScale * PmTensorGet(*g\WeightScales, oc)
      eight\BiasValue = 0.0 : If *g\Bias <> 0 : eight\BiasValue = PmTensorGet(*g\Bias, oc) : EndIf
      ox = 0
      While ox < *g\OutWidth And ox - *g\PadLeft < 0
        PmTensorConv1DInt8One(*g, bn, oc, ox, aScale) : ox = ox + 1
      Wend
      While ox + 7 < *g\OutWidth And ox + 7 - *g\PadLeft + (*g\Kernel - 1) * *g\Dilation < *g\InWidth
        eight\OutputX = ox : PmTensorConv1DInt8Eight(@eight) : ox = ox + 8
      Wend
      While ox < *g\OutWidth
        PmTensorConv1DInt8One(*g, bn, oc, ox, aScale) : ox = ox + 1
      Wend
      oc = oc + 1
    Wend
    bn = bn + 1
  Wend
EndProcedure
CompilerEndIf
CompilerEndIf

; Dominant Gemm contract: A and output are not transposed, B is N contiguous
; K-element rows (transB=1), alpha=beta=1, and C is one bias per output.
; Four output dots share each A vector. Other legal forms use the portable
; kernel, preserving the complete ONNX contract instead of approximating it.
Procedure PmTensorGemmNeon(*g.PmTensorGemmArgs)
  ASM
    ldr  x8, [x0, #56]               ; TransA
    cbnz x8, pmoNeonGemmFallback
    ldr  x8, [x0, #64]               ; TransB
    cmp  x8, #1
    b.ne pmoNeonGemmFallback
    ldr  w8, [x0, #72]               ; Alpha bits
    movz w9, #0x3f80, lsl #16        ; 1.0f
    cmp  w8, w9
    b.ne pmoNeonGemmFallback
    ldr  w8, [x0, #76]               ; Beta bits
    cmp  w8, w9
    b.ne pmoNeonGemmFallback
    ldr  x7, [x0, #48]               ; N
    ldr  x8, [x0, #80]               ; CCount
    cmp  x8, x7
    b.ne pmoNeonGemmFallback
    ldr  x3, [x0, #16]               ; C
    cbz  x3, pmoNeonGemmFallback

    ldr  x1, [x0]                    ; A
    ldr  x2, [x0, #8]                ; B
    ldr  x4, [x0, #24]               ; Dst
    ldr  x5, [x0, #32]               ; M
    ldr  x6, [x0, #40]               ; K
    cbz  x5, pmoNeonGemmDone
    cbz  x7, pmoNeonGemmDone
    movz x10, #0                     ; row
pmoNeonGemmRow:
    mul  x8, x10, x6
    lsl  x8, x8, #2
    add  x12, x1, x8                 ; A row base
    mul  x8, x10, x7
    lsl  x8, x8, #2
    add  x11, x4, x8                 ; dst cursor
    movz x9, #0                      ; column
pmoNeonGemmFourCheck:
    sub  x8, x7, x9
    cmp  x8, #4
    b.lt pmoNeonGemmTailCheck
    movi v16.4s, #0
    movi v17.4s, #0
    movi v18.4s, #0
    movi v19.4s, #0
    mul  x8, x9, x6
    lsl  x8, x8, #2
    add  x13, x2, x8                 ; four transposed-B row cursors
    lsl  x8, x6, #2
    add  x14, x13, x8
    add  x15, x14, x8
    add  x16, x15, x8
    mov  x17, x12                    ; A cursor
    mov  x0, x6                      ; remaining K
pmoNeonGemmFourVector:
    cmp  x0, #4
    b.lo pmoNeonGemmFourScalar
    ld1  { v0.4s }, [x17], #16
    ld1  { v1.4s }, [x13], #16
    ld1  { v2.4s }, [x14], #16
    ld1  { v3.4s }, [x15], #16
    ld1  { v4.4s }, [x16], #16
    fmla v16.4s, v0.4s, v1.4s
    fmla v17.4s, v0.4s, v2.4s
    fmla v18.4s, v0.4s, v3.4s
    fmla v19.4s, v0.4s, v4.4s
    sub  x0, x0, #4
    b    pmoNeonGemmFourVector
pmoNeonGemmFourScalar:
    cbz  x0, pmoNeonGemmFourReduce
    movi v0.4s, #0
    movi v1.4s, #0
    movi v2.4s, #0
    movi v3.4s, #0
    movi v4.4s, #0
    ld1  { v0.s }[0], [x17], #4
    ld1  { v1.s }[0], [x13], #4
    ld1  { v2.s }[0], [x14], #4
    ld1  { v3.s }[0], [x15], #4
    ld1  { v4.s }[0], [x16], #4
    fmla v16.4s, v0.4s, v1.4s
    fmla v17.4s, v0.4s, v2.4s
    fmla v18.4s, v0.4s, v3.4s
    fmla v19.4s, v0.4s, v4.4s
    sub  x0, x0, #1
    b    pmoNeonGemmFourScalar
pmoNeonGemmFourReduce:
    faddp v20.4s, v16.4s, v16.4s
    faddp v20.4s, v20.4s, v20.4s
    faddp v21.4s, v17.4s, v17.4s
    faddp v21.4s, v21.4s, v21.4s
    faddp v22.4s, v18.4s, v18.4s
    faddp v22.4s, v22.4s, v22.4s
    faddp v23.4s, v19.4s, v19.4s
    faddp v23.4s, v23.4s, v23.4s
    lsl  x8, x9, #2
    add  x17, x3, x8
    ldr  s0, [x17]
    fadd s20, s20, s0
    ldr  s0, [x17, #4]
    fadd s21, s21, s0
    ldr  s0, [x17, #8]
    fadd s22, s22, s0
    ldr  s0, [x17, #12]
    fadd s23, s23, s0
    str  s20, [x11]
    str  s21, [x11, #4]
    str  s22, [x11, #8]
    str  s23, [x11, #12]
    add  x11, x11, #16
    add  x9, x9, #4
    b    pmoNeonGemmFourCheck

    ; One to three output columns still vectorize the K reduction.
pmoNeonGemmTailCheck:
    cmp  x9, x7
    b.ge pmoNeonGemmNextRow
    movi v16.4s, #0
    mul  x8, x9, x6
    lsl  x8, x8, #2
    add  x13, x2, x8
    mov  x17, x12
    mov  x0, x6
pmoNeonGemmTailVector:
    cmp  x0, #4
    b.lo pmoNeonGemmTailScalar
    ld1  { v0.4s }, [x17], #16
    ld1  { v1.4s }, [x13], #16
    fmla v16.4s, v0.4s, v1.4s
    sub  x0, x0, #4
    b    pmoNeonGemmTailVector
pmoNeonGemmTailScalar:
    cbz  x0, pmoNeonGemmTailReduce
    movi v0.4s, #0
    movi v1.4s, #0
    ld1  { v0.s }[0], [x17], #4
    ld1  { v1.s }[0], [x13], #4
    fmla v16.4s, v0.4s, v1.4s
    sub  x0, x0, #1
    b    pmoNeonGemmTailScalar
pmoNeonGemmTailReduce:
    faddp v20.4s, v16.4s, v16.4s
    faddp v20.4s, v20.4s, v20.4s
    lsl  x8, x9, #2
    add  x17, x3, x8
    ldr  s0, [x17]
    fadd s20, s20, s0
    str  s20, [x11]
    add  x11, x11, #4
    add  x9, x9, #1
    b    pmoNeonGemmTailCheck
pmoNeonGemmNextRow:
    add  x10, x10, #1
    cmp  x10, x5
    b.lt pmoNeonGemmRow
pmoNeonGemmDone:
    b    pmoNeonGemmEnd
pmoNeonGemmFallback:
    bl   pmtensorgemm
pmoNeonGemmEnd:
  EndASM
EndProcedure

; ======================================================================
; Exact FP32 MatMul.  Appended 2026-09-11.
; ----------------------------------------------------------------------
; PmTensorMatMul2 is the reference:
;
;     sum = 0.0
;     inner = 0 .. k-1:  sum = sum + a[row][inner] * b[inner][col]
;     dst[row][col] = sum
;
; a sequential left-to-right chain from +0.0 with the multiply and the add
; ROUNDED SEPARATELY.  The bodies below reproduce that chain exactly, so this
; kernel is bit-identical to the reference and not merely close to it.  Every
; vector lane is a DIFFERENT OUTPUT COLUMN, never a slice of one column's
; reduction, so no lane is ever combined with another and nothing is
; reassociated.  fmla, fmadd and the horizontal reductions are therefore
; absent by construction and the gate refuses them by name.
;
; The multiply keeps the reference's operand ORDER, a then b, because the two
; orders differ when both operands are NaNs with different payloads.
;
; Why this exists beside PmTensorMatMul2Neon: that body contracts the multiply
; and the add into one fmla, which rounds once where the reference rounds
; twice, and it walks B down a column, one strided 16-byte read per inner
; index.  On the measured Kokoro request the n=2048 shapes cost 8.6 ns per
; multiply-accumulate against 0.95 for the convolution tile; a stride of
; n*4 = 8192 bytes puts every inner index on the same handful of L1 sets.
; These bodies read B along its rows instead: one 64-byte line per inner index
; feeds sixteen columns, and four output rows share it.
; ----------------------------------------------------------------------
Structure PmTensorMatMul2ExactArgs
  A.i                                ; first row of A, at inner = 0
  B.i                                ; column block of B, at inner = 0
  Dst.i                              ; first output of the block
  Count.i                            ; k, the length of the reduction
  ARowBytes.i                        ; k * 4
  BRowBytes.i                        ; n * 4
  DstRowBytes.i                      ; n * 4
EndStructure

; Four output rows by sixteen adjacent output columns, the whole reduction in
; registers.  v16..v31 are the sixteen accumulators, v0..v3 hold the sixteen B
; values for this inner index, v4 the broadcast A value and v5 one product.
; Only caller-saved vector registers are used.
Procedure PmTensorMatMul2ExactFourBySixteen(*t.PmTensorMatMul2ExactArgs)
  ASM
    ldr  x1, [x0, #0]                ; A row 0 cursor
    ldr  x2, [x0, #8]                ; B cursor
    ldr  x4, [x0, #24]               ; k
    ldr  x5, [x0, #32]               ; bytes between A rows
    ldr  x6, [x0, #40]               ; bytes between B rows
    movi v16.4s, #0
    movi v17.4s, #0
    movi v18.4s, #0
    movi v19.4s, #0
    movi v20.4s, #0
    movi v21.4s, #0
    movi v22.4s, #0
    movi v23.4s, #0
    movi v24.4s, #0
    movi v25.4s, #0
    movi v26.4s, #0
    movi v27.4s, #0
    movi v28.4s, #0
    movi v29.4s, #0
    movi v30.4s, #0
    movi v31.4s, #0
    add  x9, x1, x5                  ; A row 1
    add  x10, x9, x5                 ; A row 2
    add  x11, x10, x5                ; A row 3
    ; An empty reduction leaves every output at +0.0, which is what the
    ; reference stores, and must not enter a bottom-tested loop.
    cmp  x4, #1
    b.lt pmoMatMulExactFourStore
pmoMatMulExactFourLoop:
pmoMatMulExactFourSource:
    ld1  {v0.4s-v3.4s}, [x2]
    ldr  s4, [x1]
    dup  v4.4s, v4.s[0]
    fmul v5.4s, v4.4s, v0.4s
pmoMatMulExactFourAdd0:
    fadd v16.4s, v16.4s, v5.4s
    fmul v5.4s, v4.4s, v1.4s
    fadd v17.4s, v17.4s, v5.4s
    fmul v5.4s, v4.4s, v2.4s
    fadd v18.4s, v18.4s, v5.4s
    fmul v5.4s, v4.4s, v3.4s
    fadd v19.4s, v19.4s, v5.4s
    ldr  s4, [x9]
    dup  v4.4s, v4.s[0]
    fmul v5.4s, v4.4s, v0.4s
    fadd v20.4s, v20.4s, v5.4s
    fmul v5.4s, v4.4s, v1.4s
    fadd v21.4s, v21.4s, v5.4s
    fmul v5.4s, v4.4s, v2.4s
    fadd v22.4s, v22.4s, v5.4s
    fmul v5.4s, v4.4s, v3.4s
    fadd v23.4s, v23.4s, v5.4s
    ldr  s4, [x10]
    dup  v4.4s, v4.s[0]
    fmul v5.4s, v4.4s, v0.4s
    fadd v24.4s, v24.4s, v5.4s
    fmul v5.4s, v4.4s, v1.4s
    fadd v25.4s, v25.4s, v5.4s
    fmul v5.4s, v4.4s, v2.4s
    fadd v26.4s, v26.4s, v5.4s
    fmul v5.4s, v4.4s, v3.4s
    fadd v27.4s, v27.4s, v5.4s
    ldr  s4, [x11]
    dup  v4.4s, v4.s[0]
    fmul v5.4s, v4.4s, v0.4s
    fadd v28.4s, v28.4s, v5.4s
    fmul v5.4s, v4.4s, v1.4s
    fadd v29.4s, v29.4s, v5.4s
    fmul v5.4s, v4.4s, v2.4s
    fadd v30.4s, v30.4s, v5.4s
    fmul v5.4s, v4.4s, v3.4s
    fadd v31.4s, v31.4s, v5.4s
    add  x1, x1, #4
    add  x9, x9, #4
    add  x10, x10, #4
    add  x11, x11, #4
    add  x2, x2, x6
    subs x4, x4, #1
    b.ne pmoMatMulExactFourLoop
pmoMatMulExactFourStore:
    ldr  x3, [x0, #16]
    ldr  x7, [x0, #48]
pmoMatMulExactFourStore0:
    st1  {v16.4s-v19.4s}, [x3]
    add  x3, x3, x7
    st1  {v20.4s-v23.4s}, [x3]
    add  x3, x3, x7
    st1  {v24.4s-v27.4s}, [x3]
    add  x3, x3, x7
    st1  {v28.4s-v31.4s}, [x3]
  EndASM
EndProcedure

; One output row by sixteen adjacent output columns.  This is what a row block
; with fewer than four rows left uses, so a leftover row keeps the same
; row-wise B traffic instead of falling back to the scalar body.
Procedure PmTensorMatMul2ExactOneBySixteen(*t.PmTensorMatMul2ExactArgs)
  ASM
    ldr  x1, [x0, #0]
    ldr  x2, [x0, #8]
    ldr  x4, [x0, #24]
    ldr  x6, [x0, #40]
    movi v16.4s, #0
    movi v17.4s, #0
    movi v18.4s, #0
    movi v19.4s, #0
    cmp  x4, #1
    b.lt pmoMatMulExactRowStore
pmoMatMulExactRowLoop:
pmoMatMulExactRowSource:
    ld1  {v0.4s-v3.4s}, [x2]
    ldr  s4, [x1]
    dup  v4.4s, v4.s[0]
    fmul v5.4s, v4.4s, v0.4s
pmoMatMulExactRowAdd0:
    fadd v16.4s, v16.4s, v5.4s
    fmul v5.4s, v4.4s, v1.4s
    fadd v17.4s, v17.4s, v5.4s
    fmul v5.4s, v4.4s, v2.4s
    fadd v18.4s, v18.4s, v5.4s
    fmul v5.4s, v4.4s, v3.4s
    fadd v19.4s, v19.4s, v5.4s
    add  x1, x1, #4
    add  x2, x2, x6
    subs x4, x4, #1
    b.ne pmoMatMulExactRowLoop
pmoMatMulExactRowStore:
    ldr  x3, [x0, #16]
pmoMatMulExactRowStore0:
    st1  {v16.4s-v19.4s}, [x3]
  EndASM
EndProcedure

; One output.  Fewer than sixteen columns remain, so there is nothing to put
; in the other lanes; the chain is the reference's, one scalar at a time.
Procedure PmTensorMatMul2ExactOneByOne(*t.PmTensorMatMul2ExactArgs)
  ASM
    ldr  x1, [x0, #0]
    ldr  x2, [x0, #8]
    ldr  x4, [x0, #24]
    ldr  x6, [x0, #40]
    fmov s16, wzr
    cmp  x4, #1
    b.lt pmoMatMulExactOneStore
pmoMatMulExactOneLoop:
pmoMatMulExactOneSource:
    ldr  s4, [x1]
    ldr  s0, [x2]
    fmul s5, s4, s0
pmoMatMulExactOneAdd0:
    fadd s16, s16, s5
    add  x1, x1, #4
    add  x2, x2, x6
    subs x4, x4, #1
    b.ne pmoMatMulExactOneLoop
pmoMatMulExactOneStore:
    ldr  x3, [x0, #16]
pmoMatMulExactOneStore0:
    str  s16, [x3]
  EndASM
EndProcedure

; The general dispatch.  Every output is produced by exactly one body, and
; each body walks the same inner indices in the same order, so a result never
; depends on which body its output landed in.  Rows are taken four at a time
; while four remain and one at a time after that; columns sixteen at a time
; while sixteen remain and one at a time after that.  Nothing here needs the
; shape to be a multiple of anything, and an empty matrix writes nothing,
; exactly as the reference does.
Procedure PmTensorMatMul2ExactNeon(*a.i, *b.i, *dst.i, m.i, k.i, n.i)
  Protected row.i
  Protected col.i
  Protected lane.i
  Protected rowBlock.i
  Protected colBlock.i
  Protected t.PmTensorMatMul2ExactArgs
  If *a=0 Or *b=0 Or *dst=0 Or m<1 Or n<1
    ProcedureReturn
  EndIf
  ; The two block widths are named rather than written into the tests, so a
  ; control build can narrow either one and prove the remaining bodies still
  ; produce the reference's bits on their own.  Both tests are outside the
  ; reduction, once per block, not once per inner index.
  rowBlock=4
  colBlock=16
  t\Count=k
  t\ARowBytes=k*4
  t\BRowBytes=n*4
  t\DstRowBytes=n*4
  row=0
  While row<m
    If rowBlock>=4 And m-row>=4
      col=0
      While colBlock>=16 And n-col>=16
        t\A=*a+row*k*4 : t\B=*b+col*4 : t\Dst=*dst+(row*n+col)*4
        PmTensorMatMul2ExactFourBySixteen(@t)
        col+16
      Wend
      While col<n
        lane=0
        While lane<4
          t\A=*a+(row+lane)*k*4 : t\B=*b+col*4 : t\Dst=*dst+((row+lane)*n+col)*4
          PmTensorMatMul2ExactOneByOne(@t)
          lane+1
        Wend
        col+1
      Wend
      row+4
    Else
      col=0
      While colBlock>=16 And n-col>=16
        t\A=*a+row*k*4 : t\B=*b+col*4 : t\Dst=*dst+(row*n+col)*4
        PmTensorMatMul2ExactOneBySixteen(@t)
        col+16
      Wend
      While col<n
        t\A=*a+row*k*4 : t\B=*b+col*4 : t\Dst=*dst+(row*n+col)*4
        PmTensorMatMul2ExactOneByOne(@t)
        col+1
      Wend
      row+1
    EndIf
  Wend
EndProcedure

; ======================================================================
; Zero fill - the arena's own primitive.
; ----------------------------------------------------------------------
; DAcquire's contract is that a freshly acquired arena block reads as zero
; over its whole payload, and DAlloc clears its dimension scratch the same
; way.  Both go through DZero in tensor_dynamic_portable.pmi, which
; dispatches here under #PMD_NATIVE_BYTES=8 exactly as PmFastBinary and
; PmFastGemm dispatch to their kernels; the byte loop in that file remains
; the definition of the answer for every other target.
;
; THE ADDRESS IS ALIGNED BEFORE ANY WIDE STORE, and that is not tidiness.
; With the MMU off every data access on this part is Device-nGnRnE, and an
; unaligned 2/4/8/16-byte access to Device memory is an Alignment fault
; whatever SCTLR.A says - with no vector installed it is a silent runaway,
; not a message.  See the vault note "Unaligned access with the MMU off,
; 2026-08-27".  The resident model runner turns the MMU on for part of its
; run and leaves it off for the rest, so the fill has to be correct in both
; regimes and cannot assume the caller's alignment.  DAcquire's payloads
; happen to be 16-byte aligned already, so the prologue below costs three
; instructions there and exists for every other caller.
;
; DC ZVA IS DELIBERATELY NOT USED.  It zeroes a block whose size is only
; discoverable from DCZID_EL0, it is CONSTRAINED UNPREDICTABLE on Device
; memory - which is what this arena is whenever the runner has not enabled
; the MMU - and tools/a64/a64_interp.py does not model it at all, so the
; owning gate could neither execute it nor mutate it.  A store the gate
; cannot reach is a store nothing proves.
;
; Only caller-saved registers are touched: x0..x2 and v0..v3.
Procedure PmTensorZeroFillNeon(*destination.i, bytes.i)
  ASM
    ; x0=destination x1=bytes
    cmp  x1, #0
    b.le pmoNeonZeroFillDone
    movi v0.16b, #0
    movi v1.16b, #0
    movi v2.16b, #0
    movi v3.16b, #0
    ; Shifting the low four bits to the top is the mask: the result is
    ; zero exactly when the address is already on a 16-byte boundary.
    ; This assembler's `and` has no immediate form, and a shift says the
    ; same thing in one instruction without a scratch constant.
pmoNeonZeroFillAlign:
    lsl  x2, x0, #60
    cbz  x2, pmoNeonZeroFillBlock
    strb wzr, [x0]
    add  x0, x0, #1
    subs x1, x1, #1
    b.ne pmoNeonZeroFillAlign
    b    pmoNeonZeroFillDone
pmoNeonZeroFillBlock:
    cmp  x1, #64
    b.lt pmoNeonZeroFillSixteen
    st1  { v0.16b, v1.16b, v2.16b, v3.16b }, [x0], #64
    sub  x1, x1, #64
    b    pmoNeonZeroFillBlock
pmoNeonZeroFillSixteen:
    cmp  x1, #16
    b.lt pmoNeonZeroFillEight
    st1  { v0.16b }, [x0], #16
    sub  x1, x1, #16
    b    pmoNeonZeroFillSixteen
pmoNeonZeroFillEight:
    cmp  x1, #8
    b.lt pmoNeonZeroFillFour
    str  xzr, [x0]
    add  x0, x0, #8
    sub  x1, x1, #8
pmoNeonZeroFillFour:
    cmp  x1, #4
    b.lt pmoNeonZeroFillByte
    str  wzr, [x0]
    add  x0, x0, #4
    sub  x1, x1, #4
pmoNeonZeroFillByte:
    cbz  x1, pmoNeonZeroFillDone
    strb wzr, [x0]
    add  x0, x0, #1
    sub  x1, x1, #1
    b    pmoNeonZeroFillByte
pmoNeonZeroFillDone:
  EndASM
EndProcedure
