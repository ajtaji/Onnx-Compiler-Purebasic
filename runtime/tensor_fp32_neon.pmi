; ======================================================================
; tensor_fp32_neon.pmi - AArch64 Advanced SIMD acceleration for ONNX.
; ----------------------------------------------------------------------
; Include tensor_fp32.pmi first. A target profile selects these procedures
; behind the ordinary PMTensor ABI; neither ONNX
; lowering nor a model knows that this implementation uses Advanced SIMD.
;
; Vector reduction and FMLA intentionally do not promise bit identity with
; the scalar FP32 reference. Floating-point addition is non-associative and
; FMLA rounds once. The board gate therefore retains exact scalar checks and
; gives optimized runs an explicit numerical contract.
;
; Only caller-saved vector registers are used (v0..v7, v16..v31), so this
; remains safe when Forge eventually keeps language float values in FP/SIMD
; registers across calls. General-purpose state uses caller-saved x0..x17.
; ======================================================================

; A is MxK, B is KxN and dst is MxN, all row-major. Four adjacent columns
; are one vector. Every scalar A value is broadcast once and every matching
; run of four B values is fetched with one vector load.
Procedure PmTensorMatMul2Neon(*a.i, *b.i, *dst.i, m.i, k.i, n.i)
  ASM
    ; x0=a x1=b x2=dst x3=m x4=k x5=n
    cbz  x3, pmoNeonMatMulDone
    cbz  x5, pmoNeonMatMulDone
    lsl  x12, x5, #2                 ; bytes between B rows
    movz x6, #0                      ; row
pmoNeonMatMulRow:
    mul  x13, x6, x4
    lsl  x13, x13, #2
    add  x9, x0, x13                 ; A row base
    mul  x13, x6, x5
    lsl  x13, x13, #2
    add  x11, x2, x13                ; dst cursor
    movz x7, #0                      ; column
pmoNeonMatMulFourCheck:
    sub  x13, x5, x7
    cmp  x13, #4
    b.lt pmoNeonMatMulTailCheck
    movi v16.4s, #0
    lsl  x13, x7, #2
    add  x10, x1, x13                ; B row zero at this column
    mov  x14, x9                     ; A cursor
    mov  x8, x4                      ; remaining K
    cbz  x8, pmoNeonMatMulFourStore
pmoNeonMatMulFourInner:
    ldr  s0, [x14]
    dup  v0.4s, v0.s[0]
    ld1  { v1.4s }, [x10]
    fmla v16.4s, v1.4s, v0.4s
    add  x14, x14, #4
    add  x10, x10, x12
    subs x8, x8, #1
    b.ne pmoNeonMatMulFourInner
pmoNeonMatMulFourStore:
    st1  { v16.4s }, [x11], #16
    add  x7, x7, #4
    b    pmoNeonMatMulFourCheck

    ; One to three remaining columns keep the scalar left-to-right order.
pmoNeonMatMulTailCheck:
    cmp  x7, x5
    b.ge pmoNeonMatMulNextRow
    fmov s0, wzr
    lsl  x13, x7, #2
    add  x10, x1, x13
    mov  x14, x9
    mov  x8, x4
    cbz  x8, pmoNeonMatMulTailStore
pmoNeonMatMulTailInner:
    ldr  s4, [x14]
    ldr  s5, [x10]
    fmul s5, s5, s4
    fadd s0, s0, s5
    add  x14, x14, #4
    add  x10, x10, x12
    subs x8, x8, #1
    b.ne pmoNeonMatMulTailInner
pmoNeonMatMulTailStore:
    str  s0, [x11]
    add  x11, x11, #4
    add  x7, x7, #1
    b    pmoNeonMatMulTailCheck
pmoNeonMatMulNextRow:
    add  x6, x6, #1
    cmp  x6, x3
    b.lt pmoNeonMatMulRow
pmoNeonMatMulDone:
  EndASM
EndProcedure

CompilerIf #PMO_USE_CONV = 1
Structure PmTensorConv1DFp32FourArgs
  Src.i
  Weight.i
  Dst.i
  InWidth.i
  Kernel.i
  Stride.i
  Dilation.i
  InPerGroup.i
  InputChannelBase.i
  Batch.i
  InputChannels.i
  OutputChannel.i
  OutputX.i
  OutputWidth.i
  OutChannels.i
  PadLeft.i
  BiasValue.f
EndStructure

; Four fully in-range output positions.  Reduction remains icg-major then
; kx-major, and FMUL/FADD remain separate, so every lane follows the scalar
; FP32 operation order.  Strided outputs use lane loads because A64 NEON has
; no gather instruction.
Procedure PmTensorConv1DFp32Four(*a.PmTensorConv1DFp32FourArgs)
  ASM
    ldr x1, [x0, #0]
    ldr x2, [x0, #8]
    ldr x3, [x0, #16]
    ldr x4, [x0, #24]
    ldr x5, [x0, #32]
    ldr x6, [x0, #40]
    ldr x7, [x0, #48]
    ldr x8, [x0, #56]
    ldr x9, [x0, #64]
    ldr x10, [x0, #72]
    ldr x11, [x0, #80]
    mul x10, x10, x11
    add x10, x10, x9
    mul x10, x10, x4
    ldr x11, [x0, #96]
    mul x11, x11, x6
    ldr x13, [x0, #120]
    sub x11, x11, x13
    add x10, x10, x11
    lsl x10, x10, #2
    add x1, x1, x10
    ldr x10, [x0, #88]
    mul x10, x10, x8
    mul x10, x10, x5
    lsl x10, x10, #2
    add x2, x2, x10
    ldr s16, [x0, #128]
    dup v16.4s, v16.s[0]
    lsl x6, x6, #2
    lsl x7, x7, #2
    lsl x4, x4, #2
    movz x9, #0
pmoNeonConvFpFourChannel:
    mov x10, x1
    mov x11, x2
    mov x12, x5
pmoNeonConvFpFourKernel:
    ldr s0, [x11]
    dup v0.4s, v0.s[0]
    ldr s1, [x10]
    add x13, x10, x6
    ld1 {v1.s}[1], [x13]
    add x13, x13, x6
    ld1 {v1.s}[2], [x13]
    add x13, x13, x6
    ld1 {v1.s}[3], [x13]
    fmul v1.4s, v1.4s, v0.4s
    fadd v16.4s, v16.4s, v1.4s
    add x10, x10, x7
    add x11, x11, #4
    subs x12, x12, #1
    b.ne pmoNeonConvFpFourKernel
    add x1, x1, x4
    lsl x10, x5, #2
    add x2, x2, x10
    add x9, x9, #1
    cmp x9, x8
    b.lt pmoNeonConvFpFourChannel
    ldr x10, [x0, #72]
    ldr x11, [x0, #112]
    mul x10, x10, x11
    ldr x11, [x0, #88]
    add x10, x10, x11
    ldr x11, [x0, #104]
    mul x10, x10, x11
    ldr x11, [x0, #96]
    add x10, x10, x11
    lsl x10, x10, #2
    add x3, x3, x10
    st1 {v16.4s}, [x3]
  EndASM
EndProcedure

; One padded or tail output keeps the reference loop order through the scalar
; tensor accessors.  The fully in-range four-output body above owns the direct
; loads and stores used by the hot path.
Procedure PmTensorConv1DFp32One(*g.PmTensorConv1DArgs, bn.i, oc.i, ox.i)
  Protected icg.i
  Protected kx.i
  Protected ix.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected ic.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected sum.f
  inPerGroup=*g\InChannels / *g\Groups : outPerGroup=*g\OutChannels / *g\Groups
  group=oc/outPerGroup : sum=0.0
  If *g\Bias<>0 : sum=PmTensorGet(*g\Bias,oc) : EndIf
  icg=0
  While icg<inPerGroup
    ic=group*inPerGroup+icg : kx=0
    While kx<*g\Kernel
      ix=ox* *g\Stride-*g\PadLeft+kx* *g\Dilation
      If ix>=0 And ix<*g\InWidth
        srcIndex=(bn* *g\InChannels+ic)* *g\InWidth+ix
        weightIndex=(oc*inPerGroup+icg)* *g\Kernel+kx
        sum=sum+PmTensorGet(*g\Src,srcIndex)*PmTensorGet(*g\Weight,weightIndex)
      EndIf
      kx+1
    Wend
    icg+1
  Wend
  PmTensorPut(*g\Dst,(bn* *g\OutChannels+oc)* *g\OutWidth+ox,sum)
EndProcedure

Procedure PmTensorConv1DFp32Neon(*g.PmTensorConv1DArgs)
  Protected bn.i
  Protected oc.i
  Protected ox.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected first.i
  Protected last.i
  Protected lastNumerator.i
  Protected four.PmTensorConv1DFp32FourArgs
  If *g=0 Or *g\Batches<=0 Or *g\OutChannels<=0 Or *g\OutWidth<=0
    ProcedureReturn
  EndIf
  inPerGroup=*g\InChannels / *g\Groups : outPerGroup=*g\OutChannels / *g\Groups
  four\Src=*g\Src : four\Weight=*g\Weight : four\Dst=*g\Dst
  four\InWidth=*g\InWidth : four\Kernel=*g\Kernel : four\Stride=*g\Stride
  four\Dilation=*g\Dilation : four\InPerGroup=inPerGroup
  four\InputChannels=*g\InChannels : four\OutputWidth=*g\OutWidth
  four\OutChannels=*g\OutChannels : four\PadLeft=*g\PadLeft
  bn=0
  While bn<*g\Batches
    four\Batch=bn : oc=0
    While oc<*g\OutChannels
      group=oc/outPerGroup : four\InputChannelBase=group*inPerGroup
      four\OutputChannel=oc : four\BiasValue=0.0
      If *g\Bias<>0 : four\BiasValue=PmTensorGet(*g\Bias,oc) : EndIf
      first=(*g\PadLeft+*g\Stride-1)/ *g\Stride
      If first<0 : first=0 : EndIf
      lastNumerator=*g\InWidth-1+*g\PadLeft-(*g\Kernel-1)* *g\Dilation
      If lastNumerator<0
        last=-1
      Else
        last=lastNumerator/ *g\Stride
      EndIf
      If last>=*g\OutWidth : last=*g\OutWidth-1 : EndIf
      ox=0
      While ox<first And ox<*g\OutWidth : PmTensorConv1DFp32One(*g,bn,oc,ox) : ox+1 : Wend
      While ox+3<=last
        four\OutputX=ox : PmTensorConv1DFp32Four(@four) : ox+4
      Wend
      While ox<*g\OutWidth : PmTensorConv1DFp32One(*g,bn,oc,ox) : ox+1 : Wend
      oc+1
    Wend
    bn+1
  Wend
EndProcedure
CompilerEndIf

CompilerIf #PMO_USE_INT8 = 1
CompilerIf #PMO_USE_CONV = 1
Structure PmTensorConv1DNeonEightArgs
  Src.i
  Weight.i
  Dst.i
  InChannels.i
  InWidth.i
  OutChannels.i
  OutWidth.i
  Kernel.i
  PadLeft.i
  Dilation.i
  InPerGroup.i
  InputChannelBase.i
  Batch.i
  OutputChannel.i
  OutputX.i
  Scale.f
  BiasValue.f
EndStructure

Procedure PmTensorConv1DInt8One(*g.PmTensorConv1DArgs, bn.i, oc.i, ox.i, aScale.f)
  Protected icg.i
  Protected kx.i
  Protected ix.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected ic.i
  Protected srcIndex.i
  Protected weightIndex.i
  Protected accumulator.i
  Protected converted.f
  Protected sum.f
  inPerGroup = *g\InChannels / *g\Groups
  outPerGroup = *g\OutChannels / *g\Groups
  group = oc / outPerGroup : sum = 0.0 : accumulator = 0
  If *g\Bias <> 0 : sum = PmTensorGet(*g\Bias, oc) : EndIf
  icg = 0
  While icg < inPerGroup
    ic = group * inPerGroup + icg : kx = 0
    While kx < *g\Kernel
      ix = ox - *g\PadLeft + kx * *g\Dilation
      If ix >= 0 And ix < *g\InWidth
        srcIndex = (bn * *g\InChannels + ic) * *g\InWidth + ix
        weightIndex = (oc * inPerGroup + icg) * *g\Kernel + kx
        accumulator = accumulator + PeekB(PmTensorInt8Scratch + srcIndex) * PeekB(*g\Weight + weightIndex)
      EndIf
      kx = kx + 1
    Wend
    icg = icg + 1
  Wend
  converted = accumulator
  sum = sum + converted * aScale * PmTensorGet(*g\WeightScales, oc)
  PmTensorPut(*g\Dst, (bn * *g\OutChannels + oc) * *g\OutWidth + ox, sum)
EndProcedure

; Eight adjacent output positions share each signed INT8 weight.  The kernel
; widens products to signed 16-bit and accumulates in signed 32-bit lanes.
; The caller admits only positions whose complete dilated kernel is in range.
Procedure PmTensorConv1DInt8Eight(*g.PmTensorConv1DNeonEightArgs)
  ASM
    ; x0=args; structure offsets are eight-byte A64 integers through OutputX.
    ldr  x1, [x0, #0]               ; quantized source
    ldr  x2, [x0, #8]               ; signed INT8 weights
    ldr  x3, [x0, #16]              ; FP32 destination
    ldr  x4, [x0, #32]              ; input width
    ldr  x5, [x0, #56]              ; kernel width
    ldr  x6, [x0, #72]              ; dilation
    ldr  x7, [x0, #80]              ; input channels per group

    ldr  x8, [x0, #96]              ; batch
    ldr  x9, [x0, #24]              ; all input channels
    mul  x8, x8, x9
    ldr  x9, [x0, #88]              ; first input channel for this group
    add  x8, x8, x9
    mul  x8, x8, x4
    ldr  x9, [x0, #112]             ; output x
    add  x8, x8, x9
    ldr  x9, [x0, #64]              ; left pad
    sub  x8, x8, x9
    add  x1, x1, x8                 ; channel-zero source cursor

    ldr  x8, [x0, #104]             ; output channel
    mul  x8, x8, x7
    mul  x8, x8, x5
    add  x2, x2, x8                 ; channel-zero weight cursor

    movi v16.4s, #0
    movi v17.4s, #0
    movz x8, #0                     ; input-channel index
pmoNeonConv1EightChannel:
    mov  x9, x1
    mov  x10, x2
    mov  x11, x5
pmoNeonConv1EightKernel:
    ld1  { v1.8b }, [x9]
    ld1  { v0.b }[0], [x10]
    dup  v0.8b, v0.b[0]
    smull v2.8h, v1.8b, v0.8b
    sxtl v3.4s, v2.4h
    sxtl2 v4.4s, v2.8h
    add  v16.4s, v16.4s, v3.4s
    add  v17.4s, v17.4s, v4.4s
    add  x9, x9, x6
    add  x10, x10, #1
    subs x11, x11, #1
    b.ne pmoNeonConv1EightKernel
    add  x1, x1, x4
    add  x2, x2, x5
    add  x8, x8, #1
    cmp  x8, x7
    b.lt pmoNeonConv1EightChannel

    scvtf v16.4s, v16.4s
    scvtf v17.4s, v17.4s
    ldr  s0, [x0, #120]
    dup  v0.4s, v0.s[0]
    fmul v16.4s, v16.4s, v0.4s
    fmul v17.4s, v17.4s, v0.4s
    ldr  s1, [x0, #124]
    dup  v1.4s, v1.s[0]
    fadd v16.4s, v16.4s, v1.4s
    fadd v17.4s, v17.4s, v1.4s

    ldr  x8, [x0, #96]
    ldr  x9, [x0, #40]
    mul  x8, x8, x9
    ldr  x9, [x0, #104]
    add  x8, x8, x9
    ldr  x9, [x0, #48]
    mul  x8, x8, x9
    ldr  x9, [x0, #112]
    add  x8, x8, x9
    lsl  x8, x8, #2
    add  x3, x3, x8
    st1  { v16.4s }, [x3], #16
    st1  { v17.4s }, [x3]
  EndASM
EndProcedure

Procedure PmTensorConv1DNeon(*g.PmTensorConv1DArgs)
  Protected bn.i
  Protected oc.i
  Protected ox.i
  Protected group.i
  Protected inPerGroup.i
  Protected outPerGroup.i
  Protected aScale.f
  Protected eight.PmTensorConv1DNeonEightArgs
  If *g\WeightScales = 0
    PmTensorConv1DFp32Neon(*g)
    ProcedureReturn
  EndIf
  If *g\Stride <> 1
    PmTensorConv1D(*g)
    ProcedureReturn
  EndIf
  aScale = PmTensorDynamicScale(*g\Src, *g\Batches * *g\InChannels * *g\InWidth)
  PmTensorQuantizeBuffer(*g\Src, PmTensorInt8Scratch, *g\Batches * *g\InChannels * *g\InWidth, aScale)
  inPerGroup = *g\InChannels / *g\Groups
  outPerGroup = *g\OutChannels / *g\Groups
  eight\Src = PmTensorInt8Scratch : eight\Weight = *g\Weight : eight\Dst = *g\Dst
  eight\InChannels = *g\InChannels : eight\InWidth = *g\InWidth
  eight\OutChannels = *g\OutChannels : eight\OutWidth = *g\OutWidth
  eight\Kernel = *g\Kernel : eight\PadLeft = *g\PadLeft : eight\Dilation = *g\Dilation
  eight\InPerGroup = inPerGroup
  bn = 0
  While bn < *g\Batches
    eight\Batch = bn : oc = 0
    While oc < *g\OutChannels
      group = oc / outPerGroup
      eight\InputChannelBase = group * inPerGroup : eight\OutputChannel = oc
      eight\Scale = aScale * PmTensorGet(*g\WeightScales, oc)
      eight\BiasValue = 0.0 : If *g\Bias <> 0 : eight\BiasValue = PmTensorGet(*g\Bias, oc) : EndIf
      ox = 0
      While ox < *g\OutWidth And ox - *g\PadLeft < 0
        PmTensorConv1DInt8One(*g, bn, oc, ox, aScale) : ox = ox + 1
      Wend
      While ox + 7 < *g\OutWidth And ox + 7 - *g\PadLeft + (*g\Kernel - 1) * *g\Dilation < *g\InWidth
        eight\OutputX = ox : PmTensorConv1DInt8Eight(@eight) : ox = ox + 8
      Wend
      While ox < *g\OutWidth
        PmTensorConv1DInt8One(*g, bn, oc, ox, aScale) : ox = ox + 1
      Wend
      oc = oc + 1
    Wend
    bn = bn + 1
  Wend
EndProcedure
CompilerEndIf
CompilerEndIf

; Dominant Gemm contract: A and output are not transposed, B is N contiguous
; K-element rows (transB=1), alpha=beta=1, and C is one bias per output.
; Four output dots share each A vector. Other legal forms use the portable
; kernel, preserving the complete ONNX contract instead of approximating it.
Procedure PmTensorGemmNeon(*g.PmTensorGemmArgs)
  ASM
    ldr  x8, [x0, #56]               ; TransA
    cbnz x8, pmoNeonGemmFallback
    ldr  x8, [x0, #64]               ; TransB
    cmp  x8, #1
    b.ne pmoNeonGemmFallback
    ldr  w8, [x0, #72]               ; Alpha bits
    movz w9, #0x3f80, lsl #16        ; 1.0f
    cmp  w8, w9
    b.ne pmoNeonGemmFallback
    ldr  w8, [x0, #76]               ; Beta bits
    cmp  w8, w9
    b.ne pmoNeonGemmFallback
    ldr  x7, [x0, #48]               ; N
    ldr  x8, [x0, #80]               ; CCount
    cmp  x8, x7
    b.ne pmoNeonGemmFallback
    ldr  x3, [x0, #16]               ; C
    cbz  x3, pmoNeonGemmFallback

    ldr  x1, [x0]                    ; A
    ldr  x2, [x0, #8]                ; B
    ldr  x4, [x0, #24]               ; Dst
    ldr  x5, [x0, #32]               ; M
    ldr  x6, [x0, #40]               ; K
    cbz  x5, pmoNeonGemmDone
    cbz  x7, pmoNeonGemmDone
    movz x10, #0                     ; row
pmoNeonGemmRow:
    mul  x8, x10, x6
    lsl  x8, x8, #2
    add  x12, x1, x8                 ; A row base
    mul  x8, x10, x7
    lsl  x8, x8, #2
    add  x11, x4, x8                 ; dst cursor
    movz x9, #0                      ; column
pmoNeonGemmFourCheck:
    sub  x8, x7, x9
    cmp  x8, #4
    b.lt pmoNeonGemmTailCheck
    movi v16.4s, #0
    movi v17.4s, #0
    movi v18.4s, #0
    movi v19.4s, #0
    mul  x8, x9, x6
    lsl  x8, x8, #2
    add  x13, x2, x8                 ; four transposed-B row cursors
    lsl  x8, x6, #2
    add  x14, x13, x8
    add  x15, x14, x8
    add  x16, x15, x8
    mov  x17, x12                    ; A cursor
    mov  x0, x6                      ; remaining K
pmoNeonGemmFourVector:
    cmp  x0, #4
    b.lo pmoNeonGemmFourScalar
    ld1  { v0.4s }, [x17], #16
    ld1  { v1.4s }, [x13], #16
    ld1  { v2.4s }, [x14], #16
    ld1  { v3.4s }, [x15], #16
    ld1  { v4.4s }, [x16], #16
    fmla v16.4s, v0.4s, v1.4s
    fmla v17.4s, v0.4s, v2.4s
    fmla v18.4s, v0.4s, v3.4s
    fmla v19.4s, v0.4s, v4.4s
    sub  x0, x0, #4
    b    pmoNeonGemmFourVector
pmoNeonGemmFourScalar:
    cbz  x0, pmoNeonGemmFourReduce
    movi v0.4s, #0
    movi v1.4s, #0
    movi v2.4s, #0
    movi v3.4s, #0
    movi v4.4s, #0
    ld1  { v0.s }[0], [x17], #4
    ld1  { v1.s }[0], [x13], #4
    ld1  { v2.s }[0], [x14], #4
    ld1  { v3.s }[0], [x15], #4
    ld1  { v4.s }[0], [x16], #4
    fmla v16.4s, v0.4s, v1.4s
    fmla v17.4s, v0.4s, v2.4s
    fmla v18.4s, v0.4s, v3.4s
    fmla v19.4s, v0.4s, v4.4s
    sub  x0, x0, #1
    b    pmoNeonGemmFourScalar
pmoNeonGemmFourReduce:
    faddp v20.4s, v16.4s, v16.4s
    faddp v20.4s, v20.4s, v20.4s
    faddp v21.4s, v17.4s, v17.4s
    faddp v21.4s, v21.4s, v21.4s
    faddp v22.4s, v18.4s, v18.4s
    faddp v22.4s, v22.4s, v22.4s
    faddp v23.4s, v19.4s, v19.4s
    faddp v23.4s, v23.4s, v23.4s
    lsl  x8, x9, #2
    add  x17, x3, x8
    ldr  s0, [x17]
    fadd s20, s20, s0
    ldr  s0, [x17, #4]
    fadd s21, s21, s0
    ldr  s0, [x17, #8]
    fadd s22, s22, s0
    ldr  s0, [x17, #12]
    fadd s23, s23, s0
    str  s20, [x11]
    str  s21, [x11, #4]
    str  s22, [x11, #8]
    str  s23, [x11, #12]
    add  x11, x11, #16
    add  x9, x9, #4
    b    pmoNeonGemmFourCheck

    ; One to three output columns still vectorize the K reduction.
pmoNeonGemmTailCheck:
    cmp  x9, x7
    b.ge pmoNeonGemmNextRow
    movi v16.4s, #0
    mul  x8, x9, x6
    lsl  x8, x8, #2
    add  x13, x2, x8
    mov  x17, x12
    mov  x0, x6
pmoNeonGemmTailVector:
    cmp  x0, #4
    b.lo pmoNeonGemmTailScalar
    ld1  { v0.4s }, [x17], #16
    ld1  { v1.4s }, [x13], #16
    fmla v16.4s, v0.4s, v1.4s
    sub  x0, x0, #4
    b    pmoNeonGemmTailVector
pmoNeonGemmTailScalar:
    cbz  x0, pmoNeonGemmTailReduce
    movi v0.4s, #0
    movi v1.4s, #0
    ld1  { v0.s }[0], [x17], #4
    ld1  { v1.s }[0], [x13], #4
    fmla v16.4s, v0.4s, v1.4s
    sub  x0, x0, #1
    b    pmoNeonGemmTailScalar
pmoNeonGemmTailReduce:
    faddp v20.4s, v16.4s, v16.4s
    faddp v20.4s, v20.4s, v20.4s
    lsl  x8, x9, #2
    add  x17, x3, x8
    ldr  s0, [x17]
    fadd s20, s20, s0
    str  s20, [x11]
    add  x11, x11, #4
    add  x9, x9, #1
    b    pmoNeonGemmTailCheck
pmoNeonGemmNextRow:
    add  x10, x10, #1
    cmp  x10, x5
    b.lt pmoNeonGemmRow
pmoNeonGemmDone:
    b    pmoNeonGemmEnd
pmoNeonGemmFallback:
    bl   pmtensorgemm
pmoNeonGemmEnd:
  EndASM
EndProcedure
