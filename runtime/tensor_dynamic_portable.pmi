; Resident runtime dimensions in caller-owned memory. No heap service, files,
; graph interpreter, host process, or compiler is used by generated programs.
; Arena blocks use 16-byte headers and 16-byte alignment. First-fit allocation
; splits blocks; free coalesces adjacent blocks. Capacity includes all headers.
; Header words: span at +0, occupied at +4, previous span at +8. The
; boundary length permits local coalescing without a full arena walk.
Structure PmDynamicTensor
  Data.i
  Kind.i
  Rank.i
  Count.i
  Bytes.i
  Owned.i
  Scales.i
EndStructure
Global Dim Dt.PmDynamicTensor(#PMD_TENSOR_COUNT+1)
Global Dim DDims.i((#PMD_TENSOR_COUNT+1)*8)
CompilerIf #PMD_NATIVE_BYTES=8
Global Dim DMutable.i(#PMD_TENSOR_COUNT+1)
Global Dim DMutableCapacity.i(#PMD_TENSOR_COUNT+1)
CompilerEndIf
Global Dim DCall.i(16)
Global DError.i
Global DNode.i
Global DCancel.i
Global DLive.i
Global DPeak.i
Global DLimit.i
Global DHeap.i
Global DHeapBytes.i
Global DHeapUsed.i
Global DHeapPeak.i
; Optional caller-owned progress callback: (phase,node) -> nonzero to continue.
; It is called synchronously at bind/node boundaries only. It must not call
; back into any model or tensor procedure; doing so is rejected as re-entry.
#PMD_PROGRESS_BIND_BEFORE=1
#PMD_PROGRESS_BIND_AFTER=2
#PMD_PROGRESS_NODE_BEFORE=3
#PMD_PROGRESS_NODE_AFTER=4
Global *DProgressCallback
Global DProgressActive.i

Procedure.i DRejectProgressReentry()
  CompilerIf #PMD_NATIVE_BYTES=8
  If PmIdleActive
    DCancel=1 : DFail("Idle callback re-entered the model runtime.")
    ProcedureReturn 1
  EndIf
  CompilerEndIf
  If DProgressActive<>0
    DCancel=1
    DFail("Progress callback re-entered the model runtime.")
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i DSetProgressCallback(*callback)
  If DProgressActive<>0
    DCancel=1
    ProcedureReturn DFail("Progress callback cannot replace itself while running.")
  EndIf
  *DProgressCallback=*callback
  ProcedureReturn 1
EndProcedure

Procedure.i DPoll(Phase.i,Node.i)
  Protected keepGoing.i
  If DCancel<>0 : ProcedureReturn 0 : EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  PmKernelIdle()
  CompilerEndIf
  If *DProgressCallback=0 : ProcedureReturn 1 : EndIf
  If DRejectProgressReentry() : ProcedureReturn 0 : EndIf
  DProgressActive=1
  keepGoing=DProgressCallback(Phase,Node)
  DProgressActive=0
  If keepGoing=0 Or DCancel<>0 : DCancel=1 : ProcedureReturn 0 : EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i DMax(A.i,B.i)
  If A>B
    ProcedureReturn A
  EndIf
  ProcedureReturn B
EndProcedure
Procedure.i DMin(A.i,B.i)
  If A<B
    ProcedureReturn A
  EndIf
  ProcedureReturn B
EndProcedure
CompilerIf #PMD_NATIVE_BYTES=8
  #PMD_INTEGER_MAX=$7FFFFFFFFFFFFFFF
CompilerElse
  #PMD_INTEGER_MAX=$7FFFFFFF
CompilerEndIf
#PMD_INTEGER_MIN=-#PMD_INTEGER_MAX-1
Procedure.i DFail(Message.i)
  If DError=0
    DError=Message
  EndIf
  ProcedureReturn 0
EndProcedure
Procedure.i DIntegerOp(A.i,B.i,Op.i)
  Protected overflow.i=0
  If Op=0
    If B>0
      If A>#PMD_INTEGER_MAX-B
        overflow=1
      EndIf
    ElseIf B<0
      If A<#PMD_INTEGER_MIN-B
        overflow=1
      EndIf
    EndIf
    If overflow=0
      ProcedureReturn A+B
    EndIf
  ElseIf Op=1
    If B<0
      If A>#PMD_INTEGER_MAX+B
        overflow=1
      EndIf
    ElseIf B>0
      If A<#PMD_INTEGER_MIN+B
        overflow=1
      EndIf
    EndIf
    If overflow=0
      ProcedureReturn A-B
    EndIf
  ElseIf Op=2
    If A>0
      If B>0
        If A>#PMD_INTEGER_MAX/B
          overflow=1
        EndIf
      ElseIf B<0
        If B<#PMD_INTEGER_MIN/A
          overflow=1
        EndIf
      EndIf
    ElseIf A<0
      If B>0
        If A<#PMD_INTEGER_MIN/B
          overflow=1
        EndIf
      ElseIf B<0
        If A<#PMD_INTEGER_MAX/B
          overflow=1
        EndIf
      EndIf
    EndIf
    If overflow=0
      ProcedureReturn A*B
    EndIf
  ElseIf Op=3
    If B=0
      ProcedureReturn DFail("Integer division by zero.")
    EndIf
    If A=#PMD_INTEGER_MIN And B=-1
      overflow=1
    EndIf
    If overflow=0
      ProcedureReturn A/B
    EndIf
  EndIf
  DFail("Integer arithmetic exceeds the native signed execution range.")
  ProcedureReturn 0
EndProcedure
Procedure.i DIntegerPower(Base.i,Exponent.i)
  Protected result.i=1
  If Exponent<0
    ProcedureReturn DFail("Integer power requires a nonnegative exponent; check the exponent tensor.")
  EndIf
  While Exponent>0
    If (Exponent & 1)<>0
      result=DIntegerOp(result,Base,2)
      If DError<>0 : ProcedureReturn 0 : EndIf
    EndIf
    Exponent=Exponent>>1
    If Exponent>0
      Base=DIntegerOp(Base,Base,2)
      If DError<>0 : ProcedureReturn 0 : EndIf
    EndIf
  Wend
  ProcedureReturn result
EndProcedure
Procedure.f DFloat(Value.i)
  Protected r.f=0.0
  CompilerIf #PMD_NATIVE_BYTES=8
    ProcedureReturn MathFFromInt(Value)
  CompilerElse
    ; an assignment converts; returning the integer returned its bits
    r=Value
    ProcedureReturn r
  CompilerEndIf
EndProcedure
Procedure.f DReadF(Address.i)
  ProcedureReturn PmTensorGet(Address,0)
EndProcedure
Procedure DWriteF(Address.i,Value.f)
  PmTensorPut(Address,0,Value)
EndProcedure
Procedure.i DReadI64(Address.i)
  Protected value.i=0
  value=PmTensorGetI64(Address,0)
  If PmTensorInt64Ok=0
    DFail("INT64 value exceeds the native signed execution range.")
  EndIf
  ProcedureReturn value
EndProcedure
Procedure DWriteI64(Address.i,Value.i)
  PmTensorPutI64(Address,0,Value)
EndProcedure
Procedure DCopy(Source.i,Destination.i,Bytes.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  If ((Source | Destination) & 3)=0 And Bytes>=16
    If Destination<=Source Or Destination-Source>=Bytes
      PmTensorCopyAlignedNeon(Source,Destination,Bytes) : ProcedureReturn
    EndIf
  EndIf
  CompilerEndIf
  Protected i.i=0
  i=0
  ; Aligned words preserve the forward byte-copy contract on every target.
  If ((Source | Destination) & 3)=0
    While i+4<=Bytes
      PokeL(Destination+i,PeekL(Source+i))
      i=i+4
    Wend
  EndIf
  While i<Bytes
    PokeA(Destination+i,PeekA(Source+i))
    i=i+1
  Wend
EndProcedure
; Inference/state transfers may service the primary between word-aligned chunks.
; Raw DCopy stays callback-safe: transport callbacks can copy without a call
; cycle back into PmKernelIdle. Upward-overlap and non-word-aligned ranges retain
; the raw primitive's forward-copy behavior.
Procedure DCopyServiced(Source.i,Destination.i,Bytes.i)
  ; Exact short forward copies avoid another procedure call. Keep word
  ; accesses aligned and preserve the original order even for overlap.
  If Bytes=1
    PokeA(Destination,PeekA(Source)) : ProcedureReturn
  EndIf
  If ((Source | Destination) & 3)=0
    If Bytes=4
      PokeL(Destination,PeekL(Source)) : ProcedureReturn
    EndIf
    If Bytes=8
      PokeL(Destination,PeekL(Source))
      PokeL(Destination+4,PeekL(Source+4)) : ProcedureReturn
    EndIf
    If Bytes=16
      PokeL(Destination,PeekL(Source))
      PokeL(Destination+4,PeekL(Source+4))
      PokeL(Destination+8,PeekL(Source+8))
      PokeL(Destination+12,PeekL(Source+12)) : ProcedureReturn
    EndIf
  EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected offset.i=0
  If ((Source | Destination) & 3)=0 And Bytes>=65536
    If Destination<=Source Or Destination-Source>=Bytes
      While Bytes-offset>=65536
        DCopy(Source+offset,Destination+offset,65536)
        offset+65536 : PmKernelIdle()
      Wend
      DCopy(Source+offset,Destination+offset,Bytes-offset)
      ProcedureReturn
    EndIf
  EndIf
  CompilerEndIf
  DCopy(Source,Destination,Bytes)
EndProcedure
Procedure DCopyRowsServiced(Source.i,Destination.i,Bytes.i,SourceStep.i,DestinationStep.i,Rows.i)
 Protected row.i=0,wordRows.i=0
 If ((Source | Destination | SourceStep | DestinationStep) & 3)=0 And (Bytes=4 Or Bytes=8 Or Bytes=16) : wordRows=1 : EndIf
 While row<Rows
  CompilerIf #PMD_NATIVE_BYTES=8
  If (row & 255)=0 : PmKernelIdle() : EndIf
  CompilerEndIf
  If wordRows
   PokeL(Destination,PeekL(Source))
   If Bytes>=8 : PokeL(Destination+4,PeekL(Source+4)) : EndIf
   If Bytes=16
    PokeL(Destination+8,PeekL(Source+8)) : PokeL(Destination+12,PeekL(Source+12))
   EndIf
  Else
   DCopyServiced(Source,Destination,Bytes)
  EndIf
  Source+SourceStep : Destination+DestinationStep : row+1
 Wend
EndProcedure
; DZero is the arena's zero-fill primitive and the only one: DAcquire's
; contract is that a freshly acquired block reads as zero over its whole
; payload, and every other caller here clears its dimension scratch through
; the same procedure.  A64 owns the fill in PmTensorZeroFillNeon
; (tensor_fp32_neon.pmi), beside the other Advanced SIMD kernels, for the
; same reason PmFastBinary and PmFastGemm dispatch there: this file is the
; portable dispatcher and must not carry a target's assembly.  The kernel
; aligns before any wide store and accepts any address and any length, so
; there is nothing for a caller to arrange; the byte loop below remains the
; definition of the answer for every other target.
Procedure DZero(Address.i,Bytes.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  PmTensorZeroFillNeon(Address,Bytes)
  CompilerElse
  Protected index.i=0
  While index<Bytes
    PokeA(Address+index,0)
    index=index+1
  Wend
  CompilerEndIf
EndProcedure
Procedure.i DHeapBind(Address.i,Bytes.i)
  If Address=0 Or (Address & 15)<>0 Or Bytes<32 Or Bytes>$7FFFFF00
    ProcedureReturn DFail("Bind an aligned arena between 32 bytes and the signed addressable size limit.")
  EndIf
  DHeap=Address
  DHeapBytes=Bytes & -16
  DLimit=DHeapBytes
  DHeapUsed=0
  DHeapPeak=0
  PokeL(DHeap,DHeapBytes)
  PokeL(DHeap+4,0)
  PokeL(DHeap+8,0)
  ProcedureReturn 1
EndProcedure
Procedure.i DAcquireCore(Bytes.i,clear.i)
  Protected offset.i=0
  Protected span.i=0
  Protected needed.i=0
  Protected address.i=0
  If DHeap=0 Or Bytes<0 Or Bytes>DHeapBytes-16
    DFail("Allocation exceeds the bound arena.")
    ProcedureReturn 0
  EndIf
  needed=((DMax(Bytes,1)+15) & -16)+16
  offset=0
  While offset<DHeapBytes
    span=PeekL(DHeap+offset)
    If span<32 Or span>DHeapBytes-offset
      DFail("Arena block metadata is invalid.")
      ProcedureReturn 0
    EndIf
    If PeekL(DHeap+offset+4)=0 And span>=needed
      If span-needed>=32
        PokeL(DHeap+offset+needed,span-needed)
        PokeL(DHeap+offset+needed+4,0)
        PokeL(DHeap+offset+needed+8,needed)
        If offset+span<DHeapBytes : PokeL(DHeap+offset+span+8,span-needed) : EndIf
        span=needed
        PokeL(DHeap+offset,span)
      EndIf
      PokeL(DHeap+offset+4,1)
      DHeapUsed=DHeapUsed+span
      DHeapPeak=DMax(DHeapPeak,DHeapUsed)
      address=DHeap+offset+16
      ; THE WHOLE PAYLOAD IS ZEROED, NOT ONLY THE REQUESTED BYTES.  An
      ; acquired block reads as zero: DAlloc's consumers rely on it where a
      ; kernel writes only part of its output - ONNX LSTM leaves Y at zero
      ; for every timestep past a batch's sequence length, and the kernel
      ; skips those stores rather than writing zeros over them - and the
      ; rounding slack past the requested length is zeroed too so that a
      ; vector kernel reading a tail never meets a stale bit pattern.
      If clear
        DZero(address,span-16)
      Else
        ; Full-overwrite kernels own every requested byte. Keep the rounded
        ; tail zero for kernels whose vector loads may inspect that slack.
        DZero(address+Bytes,span-16-Bytes)
      EndIf
      ProcedureReturn address
    EndIf
    offset=offset+span
  Wend
  DFail("Request cannot fit in the remaining contiguous arena memory.")
  ProcedureReturn 0
EndProcedure
Procedure.i DAcquire(Bytes.i)
  ProcedureReturn DAcquireCore(Bytes,1)
EndProcedure
Procedure.i DAcquireOverwrite(Bytes.i)
  ProcedureReturn DAcquireCore(Bytes,0)
EndProcedure
Procedure DFree(Address.i)
  Protected offset.i=0
  Protected span.i=0
  Protected nextSpan.i=0
  If Address=0
    ProcedureReturn
  EndIf
  offset=Address-DHeap-16
  If offset<0 Or offset>=DHeapBytes Or (offset & 15)<>0
    DFail("Invalid arena release.")
    ProcedureReturn
  EndIf
  span=PeekL(DHeap+offset)
  If span<32 Or span>DHeapBytes-offset Or PeekL(DHeap+offset+4)<>1
    DFail("Invalid or duplicate arena release.")
    ProcedureReturn
  EndIf
  ; Boundary lengths in the unused header word identify both neighbours.
  ; Eager coalescing leaves no other free pair elsewhere in the arena.
  Protected previous.i=PeekL(DHeap+offset+8),nextOffset.i=offset+span
  If previous<0 Or previous>offset Or (previous & 15)<>0
    DFail("Arena previous-block metadata is invalid.") : ProcedureReturn
  EndIf
  If previous>0
    If PeekL(DHeap+offset-previous)<>previous
      DFail("Arena previous-block length is invalid.") : ProcedureReturn
    EndIf
  ElseIf offset<>0
    DFail("Arena previous-block boundary is missing.") : ProcedureReturn
  EndIf
  If nextOffset<DHeapBytes
    nextSpan=PeekL(DHeap+nextOffset)
    If nextSpan<32 Or nextSpan>DHeapBytes-nextOffset Or PeekL(DHeap+nextOffset+8)<>span
      DFail("Arena next-block metadata is invalid.") : ProcedureReturn
    EndIf
  EndIf
  PokeL(DHeap+offset+4,0)
  DHeapUsed=DHeapUsed-span
  If nextOffset<DHeapBytes And PeekL(DHeap+nextOffset+4)=0
    span+nextSpan : PokeL(DHeap+offset,span)
  EndIf
  If previous>0 And PeekL(DHeap+offset-previous+4)=0
    offset-previous : span+previous : PokeL(DHeap+offset,span)
  EndIf
  If offset+span<DHeapBytes : PokeL(DHeap+offset+span+8,span) : EndIf
EndProcedure
Procedure.i DSize(Kind.i)
  Select Kind
    Case 1
      ProcedureReturn 4
    Case 6
      ProcedureReturn 4
    Case 7
      ProcedureReturn 8
    Case 2
      ProcedureReturn 1
    Case 3
      ProcedureReturn 1
    Case 9
      ProcedureReturn 1
  EndSelect
  ProcedureReturn 0
EndProcedure
Procedure DRelease(Id.i)
  Protected i.i=0
  If Id<=0 Or Id>#PMD_TENSOR_COUNT
    ProcedureReturn
  EndIf
  If Dt(Id)\Owned
    DFree(Dt(Id)\Data)
    DLive=DLive-Dt(Id)\Bytes
  EndIf
  Dt(Id)\Data=0
  Dt(Id)\Kind=0
  Dt(Id)\Rank=0
  Dt(Id)\Count=0
  Dt(Id)\Bytes=0
  Dt(Id)\Owned=0
  Dt(Id)\Scales=0
  CompilerIf #PMD_NATIVE_BYTES=8
  DMutable(Id)=0 : DMutableCapacity(Id)=0
  CompilerEndIf
  For i=0 To 7
    DDims(Id*8+i)=0
  Next
EndProcedure
; Bind caller-owned immutable input/state storage without allocating or copying.
; The caller keeps the complete span valid until request reset/rebinding. This
; does not retain another tensor's allocation or permit concurrent mutation.
Procedure.i DBindBorrowed(Id.i,Kind.i,Rank.i,DimsAddress.i,Address.i,Available.i)
  Protected Dim dims.i(8)
  Protected count.i=1,size.i,bytes.i,extent.i,i.i
  If DError<>0 Or DCancel<>0 : ProcedureReturn DFail("Request cancelled or an earlier operation failed.") : EndIf
  If DRejectProgressReentry() : ProcedureReturn 0 : EndIf
  size=DSize(Kind)
  If Id<=0 Or Id>#PMD_TENSOR_COUNT Or Rank<0 Or Rank>8 Or size=0 Or (Rank>0 And DimsAddress=0)
    ProcedureReturn DFail("Unsupported borrowed tensor rank, type or dimensions.")
  EndIf
  For i=0 To Rank-1
    CompilerIf #PMD_NATIVE_BYTES=8
    extent=PeekN(DimsAddress+i*8)
    CompilerElse
    extent=PeekL(DimsAddress+i*4)
    CompilerEndIf
    If extent<0 Or extent>DLimit : ProcedureReturn DFail("Invalid borrowed tensor dimension.") : EndIf
    If extent>0 And count>DLimit/extent : ProcedureReturn DFail("Borrowed tensor count exceeds the arena limit.") : EndIf
    dims(i)=extent : count=count*extent
  Next
  If count>DLimit/size : ProcedureReturn DFail("Borrowed tensor bytes exceed the arena limit.") : EndIf
  bytes=count*size
  If Available<0 Or bytes>Available Or (bytes>0 And Address=0)
    ProcedureReturn DFail("Borrowed tensor storage is smaller than its shape.")
  EndIf
  ; Releasing this same tensor must not invalidate its new backing span.
  If Dt(Id)\Owned And Dt(Id)\Bytes>0 And bytes>0
    If (Address>=Dt(Id)\Data And Address-Dt(Id)\Data<Dt(Id)\Bytes) Or (Address<Dt(Id)\Data And Dt(Id)\Data-Address<bytes)
      ProcedureReturn DFail("Borrowed storage overlaps the tensor's owned allocation.")
    EndIf
  EndIf
  DRelease(Id)
  Dt(Id)\Data=Address : Dt(Id)\Kind=Kind : Dt(Id)\Rank=Rank
  Dt(Id)\Count=count : Dt(Id)\Bytes=bytes : Dt(Id)\Owned=0
  For i=0 To Rank-1 : DDims(Id*8+i)=dims(i) : Next
  ProcedureReturn 1
EndProcedure

CompilerIf #PMD_NATIVE_BYTES=8
; Explicit writable recurrent storage, with a 16-byte-aligned base.
; Caller owns the entire capacity outside
; the working arena, with no live aliases when a last-use operation consumes it.
; Writes are in-place and are not rolled back after cancellation or an error.
Procedure.i DBindMutableState(Id.i,Kind.i,Rank.i,DimsAddress.i,Address.i,Available.i)
 If DRejectProgressReentry() : ProcedureReturn 0 : EndIf
 If DHeap=0 Or Address<=0 Or (Address & 15)<>0 Or Available<0 Or Available>DLimit Or Address>#PMD_INTEGER_MAX-Available
  ProcedureReturn DFail("Mutable state needs an aligned caller-owned capacity.")
 EndIf
 If Address<DHeap
  If Available>DHeap-Address : ProcedureReturn DFail("Mutable state overlaps the working arena.") : EndIf
 Else
  If Address-DHeap<DHeapBytes : ProcedureReturn DFail("Mutable state overlaps the working arena.") : EndIf
 EndIf
 If DBindBorrowed(Id,Kind,Rank,DimsAddress,Address,Available)=0 : ProcedureReturn 0 : EndIf
 DMutable(Id)=1 : DMutableCapacity(Id)=Available
 ProcedureReturn 1
EndProcedure
CompilerEndIf

Procedure.i DAllocCore(Id.i,Kind.i,Rank.i,DimsAddress.i,clear.i)
  Protected i.i=0
  Protected count.i=0
  Protected extent.i=0
  Protected size.i=0
  Protected bytes.i=0
  Protected Dim dims.i(8)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If DError<>0 Or DCancel<>0
    ProcedureReturn DFail("Request cancelled or an earlier operation failed.")
  EndIf
  size=DSize(Kind)
  If Id<=0 Or Id>#PMD_TENSOR_COUNT Or Rank<0 Or Rank>8 Or size=0
    ProcedureReturn DFail("Unsupported tensor rank or type.")
  EndIf
  count=1
  For i=0 To Rank-1
    CompilerIf #PMD_NATIVE_BYTES=8
      extent=PeekN(DimsAddress+i*8)
    CompilerElse
      extent=PeekL(DimsAddress+i*4)
    CompilerEndIf
    If extent<0 Or extent>DLimit
      ProcedureReturn DFail("Invalid tensor dimension.")
    EndIf
    If extent>0 And count>DLimit/extent
      ProcedureReturn DFail("Tensor element count exceeds the arena limit.")
    EndIf
    dims(i)=extent
    count=count*extent
  Next
  If count>DLimit/size
    ProcedureReturn DFail("Tensor bytes exceed the arena limit.")
  EndIf
  bytes=count*size
  DRelease(Id)
  If bytes>DLimit-DLive
    ProcedureReturn DFail("Request exceeds its working-memory limit.")
  EndIf
  Dt(Id)\Data=DAcquireCore(bytes,clear)
  If Dt(Id)\Data=0
    ProcedureReturn 0
  EndIf
  Dt(Id)\Kind=Kind
  Dt(Id)\Rank=Rank
  Dt(Id)\Count=count
  Dt(Id)\Bytes=bytes
  Dt(Id)\Owned=1
  DLive=DLive+bytes
  DPeak=DMax(DPeak,DLive)
  For i=0 To Rank-1
    DDims(Id*8+i)=dims(i)
  Next
  ProcedureReturn 1
EndProcedure
Procedure.i DAlloc(Id.i,Kind.i,Rank.i,DimsAddress.i)
  ProcedureReturn DAllocCore(Id,Kind,Rank,DimsAddress,1)
EndProcedure
; Internal use only: the caller must write all logical output bytes before
; exposing the tensor. Ordinary allocation retains its zero-fill contract.
Procedure.i DAllocOverwrite(Id.i,Kind.i,Rank.i,DimsAddress.i)
  ProcedureReturn DAllocCore(Id,Kind,Rank,DimsAddress,0)
EndProcedure
Procedure.i DShape(Id.i,Kind.i,Rank.i,d0.i,d1.i,d2.i,d3.i)
  Protected Dim dims.i(8)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Rank>4
    ProcedureReturn DFail("Use DAlloc with eight dimensions for tensor rank above four.")
  EndIf
  dims(0)=d0
  dims(1)=d1
  dims(2)=d2
  dims(3)=d3
  ProcedureReturn DAlloc(Id,Kind,Rank,@dims(0))
EndProcedure
Procedure.i DShapeOverwrite(Id.i,Kind.i,Rank.i,d0.i,d1.i,d2.i,d3.i)
  Protected Dim dims.i(8)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Rank>4
    ProcedureReturn DFail("Use DAlloc with eight dimensions for tensor rank above four.")
  EndIf
  dims(0)=d0
  dims(1)=d1
  dims(2)=d2
  dims(3)=d3
  ProcedureReturn DAllocOverwrite(Id,Kind,Rank,@dims(0))
EndProcedure

Procedure.i DInt(Id.i,Index.i)
  If Id<=0 Or Id>#PMD_TENSOR_COUNT
    DFail("Invalid integer tensor ID.")
    ProcedureReturn 0
  EndIf
  If Index<0 Or Index>=Dt(Id)\Count
    DFail("Integer tensor read is out of bounds.")
    ProcedureReturn 0
  EndIf
  Select Dt(Id)\Kind
    Case 7
      ProcedureReturn DReadI64(Dt(Id)\Data+Index*8)
    Case 6
      ProcedureReturn PeekL(Dt(Id)\Data+Index*4)
    Case 9
      ProcedureReturn PeekA(Dt(Id)\Data+Index) & 255
    Case 2
      ProcedureReturn PeekA(Dt(Id)\Data+Index) & 255
    Case 3
      ProcedureReturn ((PeekA(Dt(Id)\Data+Index) & 255) ! 128) - 128
  EndSelect
  DFail("Integer shape controls require integer tensors.")
  ProcedureReturn 0
EndProcedure
Procedure.f DGet(Id.i,Index.i)
  If Id<=0 Or Id>#PMD_TENSOR_COUNT
    DFail("Invalid tensor ID.")
    ProcedureReturn 0.0
  EndIf
  If Index<0 Or Index>=Dt(Id)\Count
    DFail("Tensor read is out of bounds.")
    ProcedureReturn 0.0
  EndIf
  If Dt(Id)\Kind=1
    ProcedureReturn DReadF(Dt(Id)\Data+Index*4)
  EndIf
  ProcedureReturn DFloat(DInt(Id,Index))
EndProcedure
Procedure DPut(Id.i,Index.i,Value.f)
  Select Dt(Id)\Kind
    Case 1
      DWriteF(Dt(Id)\Data+Index*4,Value)
    Case 7
      DWriteI64(Dt(Id)\Data+Index*8,Int(Value))
    Case 6
      PokeL(Dt(Id)\Data+Index*4,Int(Value))
    Case 9
      ; not zero, a NaN included (forum 998): the bits, exact on every compiler
      PokeA(Dt(Id)\Data+Index,Bool((PeekL(@Value) & $7FFFFFFF)<>0))
    Case 2
      PokeA(Dt(Id)\Data+Index,Int(Value) & 255)
    Case 3
      PokeA(Dt(Id)\Data+Index,Int(Value) & 255)
  EndSelect
EndProcedure
; The FP32 LSTM's working memory and its input check: the reference LSTM
; refuses a NaN or an infinity in its first input row and holds
; Elements+Extra bytes for the call. An LSTM with an INT8 weight uses
; DInt8Begin instead.
Procedure.i DScratchBegin(Input.i,Elements.i,Extra.i)
  Protected i.i=0
  Protected bytes.i=0
  If Elements<0 Or Extra<0 Or Elements>DLimit-Extra
    ProcedureReturn DFail("INT8 activation scratch exceeds the arena limit.")
  EndIf
  bytes=Elements+Extra
  If bytes>DLimit-DLive
    ProcedureReturn DFail("INT8 scratch exceeds available working memory.")
  EndIf
  For i=0 To Elements-1
    If (PeekL(Input+i*4) & $7F800000)=$7F800000
      ProcedureReturn DFail("INT8 activations contain NaN or infinity.")
    EndIf
  Next
  PmTensorInt8Scratch=DAcquire(bytes)
  If PmTensorInt8Scratch=0
    ProcedureReturn 0
  EndIf
  PmTensorInt8ScratchBytes=bytes
  DLive=DLive+bytes
  DPeak=DMax(DPeak,DLive)
  ProcedureReturn 1
EndProcedure
Procedure DScratchEnd()
  If PmTensorInt8Scratch
    DFree(PmTensorInt8Scratch)
    DLive=DLive-PmTensorInt8ScratchBytes
  EndIf
  PmTensorInt8Scratch=0
  PmTensorInt8ScratchBytes=0
EndProcedure
; An INT8 operator's working memory, sized by the operator's own PmI8 size
; procedure. The operator finds its row scales itself and reports through
; PmTensorInt8Fault: 1 = a NaN or an infinity in its activations, 2 = working
; memory smaller than it needs. DInt8End turns either into the node's error.
Procedure.i DInt8Begin(Bytes.i)
  PmTensorInt8Fault=0
  If Bytes<0 Or Bytes>DLimit-DLive
    ProcedureReturn DFail("INT8 working memory for this operator exceeds the available arena. Raise the model's working memory limit; that is the first thing to check.")
  EndIf
  PmTensorInt8Scratch=DAcquire(Bytes)
  If PmTensorInt8Scratch=0
    ProcedureReturn 0
  EndIf
  PmTensorInt8ScratchBytes=Bytes
  DLive=DLive+Bytes
  DPeak=DMax(DPeak,DLive)
  ProcedureReturn 1
EndProcedure
Procedure.i DInt8BeginOverwrite(Bytes.i)
  PmTensorInt8Fault=0
  If Bytes<0 Or Bytes>DLimit-DLive
    ProcedureReturn DFail("INT8 working memory for this operator exceeds the available arena. Raise the model's working memory limit; that is the first thing to check.")
  EndIf
  PmTensorInt8Scratch=DAcquireOverwrite(Bytes)
  If PmTensorInt8Scratch=0
    ProcedureReturn 0
  EndIf
  PmTensorInt8ScratchBytes=Bytes
  DLive=DLive+Bytes
  DPeak=DMax(DPeak,DLive)
  ProcedureReturn 1
EndProcedure

Procedure.i DInt8End()
  If PmTensorInt8Scratch
    DFree(PmTensorInt8Scratch)
    DLive=DLive-PmTensorInt8ScratchBytes
  EndIf
  PmTensorInt8Scratch=0
  PmTensorInt8ScratchBytes=0
  If PmTensorInt8Fault=1
    ProcedureReturn DFail("INT8 activations contain NaN or infinity (fault 1); the operator refuses to quantize them. Check the node that produced this input.")
  EndIf
  If PmTensorInt8Fault<>0
    ProcedureReturn DFail("INT8 working memory is smaller than this operator needs (fault 2). The runtime sizes it itself, so this is a runtime defect; report the model and the node.")
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure.i DListValue(Text.i,Index.i)
  Protected address.i=0
  Protected field.i=0
  Protected value.i=0
  Protected sign.i=0
  Protected char.i=0
  address=Text
  field=1
  value=0
  sign=1
  While PeekA(address)
    char=PeekA(address) & 255
    If char=44
      If field=Index
        ProcedureReturn value*sign
      EndIf
      field=field+1
      value=0
      sign=1
    ElseIf char=45
      sign=-1
    ElseIf char>=48 And char<=57
      value=value*10+char-48
    EndIf
    address=address+1
  Wend
  If field=Index
    ProcedureReturn value*sign
  EndIf
  ProcedureReturn 0
EndProcedure
Procedure.i DListCount(Text.i)
  Protected address.i=0
  Protected count.i=0
  address=Text
  count=1
  While PeekA(address)
    If PeekA(address)=44
      count=count+1
    EndIf
    address=address+1
  Wend
  ProcedureReturn count
EndProcedure
Procedure PmFastBinary(A.i,B.i,Destination.i,Count.i,AStride.i,BStride.i,Op.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  ; A64 owns the elementwise arithmetic in tensor_fp32_neon.pmi, beside the
  ; other Advanced SIMD kernels, for the same reason PmFastGemm and
  ; PmFastReduce dispatch there: this file is the portable dispatcher and
  ; must not carry a target's assembly.  DBinary has already established
  ; FLOAT operands, a contiguous destination, Op 0..3 and AStride/BStride as
  ; Boolean 0/1 - the kernel's stated contract - and the scalar body below
  ; remains the definition of the answer for every other target.
  ;
  ; Op 4 is Pow, and it is here on the same terms as the other four: for the
  ; rows DBinary sends this way it has already established through
  ; DPowWholeExponent that B is ONE broadcast exponent (so BStride is 0) and
  ; that it is a whole number with |y| <= 64 - the case where Pow is repeated
  ; binary32 squaring, which is the same arithmetic per lane.  Every other
  ; exponent keeps the scalar Pow in DBinary; nothing is approximated here.
  PmTensorBinaryParallelNeon(A,B,Destination,Count,AStride,BStride,Op)
  CompilerElse
  Protected i.i=0
  Protected av.f=0.0
  Protected bv.f=0.0
  Protected value.f=0.0
  For i=0 To Count-1
    av=DReadF(A+i*AStride*4)
    bv=DReadF(B+i*BStride*4)
    Select Op
      Case 0
        value=av+bv
      Case 1
        value=av-bv
      Case 2
        value=av*bv
      Case 3
        value=av/bv
      Case 4
        value=Pow(av,bv)
    EndSelect
    DWriteF(Destination+i*4,value)
  Next
  CompilerEndIf
EndProcedure
; The A64 body is PmTensorMatMul2ExactNeon, which is bit-identical to
; PmTensorMatMul2: same sequential inner order, separate FMUL and FADD, one
; output column per vector lane.  the retired fused kernel is NOT dispatched any
; more - it contracts the multiply and the add into one fmla, so it rounds
; once where the reference rounds twice, and it reads B down a column.
;
; THE B COLUMN BLOCK IS PACKED when there is more than one row block to read
; it, which is where the model's time is.  The kernel's header has the board
; measurement and the cache argument; the arena part is here because this file
; owns the arena and tensor_fp32_neon.pmi must not.  The buffer is K*64 bytes -
; 128 KiB at the largest reduction Kokoro emits - acquired and released inside
; one call, so the arena's peak rises by ONE node's block.
;
; A shortfall is NOT a refusal here, unlike the LSTM's transposed weights, and
; the difference is worth stating: PmTensorMatMul2ExactNeon computes the same
; bits from the same B, so falling back costs a factor on one node and cannot
; change an answer, where the LSTM's fallback would have been several times
; slower over the whole recurrent layer with nothing to see.
Procedure PmFastGemm(A.i,B.i,Destination.i,M.i,K.i,N.i)
  CompilerIf #PMD_NATIVE_BYTES=8
    Protected bytes.i=0
    Protected pack.i=0
    Protected parts.i=1
    Protected columns.i=0
    If M>=32 And K>0 And N>=16 And M*K*N>=65536
      parts=PmParallelCores()
      If parts<1 : parts=1 : EndIf
      If parts>4 : parts=4 : EndIf
    EndIf
    If M>=1 And M<32 And K>0 And N>=64 And M*K*N>=65536
      columns=1 : parts=PmParallelCores()
      If parts<1 : parts=1 : EndIf
      If parts>4 : parts=4 : EndIf
    EndIf
      If columns And M<8
        PmTensorMatMul2ColumnsParallelNeon(A,B,Destination,M,K,N,0,parts)
        ProcedureReturn
      EndIf
    ; Below two row blocks the pack is read once and pays for nothing, and
    ; below sixteen columns there is no block to pack at all.
    If N>=16 And (M>=8 Or columns) And K>0
      bytes=K*64*parts
      If bytes<=DLimit-DLive
        pack=DAcquire(bytes)
      EndIf
    EndIf
    If pack
      DLive+bytes
      DPeak=DMax(DPeak,DLive)
      If columns
        PmTensorMatMul2ColumnsParallelNeon(A,B,Destination,M,K,N,pack,parts)
      Else
        PmTensorMatMul2ParallelNeon(A,B,Destination,M,K,N,pack,parts)
      EndIf
      DFree(pack)
      DLive-bytes
    Else
      PmTensorMatMul2ExactNeon(A,B,Destination,M,K,N)
    EndIf
  CompilerElse
    PmTensorMatMul2(A,B,Destination,M,K,N)
  CompilerEndIf
EndProcedure
Procedure PmFastReduce(Source.i,Destination.i,Outer.i,Width.i,Mean.i)
  CompilerIf #PMD_NATIVE_BYTES=8
    If Mean
      PmTensorReduceMeanLastNeon(Source,Destination,Outer,Width)
    Else
      PmTensorReduceSumLastNeon(Source,Destination,Outer,Width)
    EndIf
  CompilerElse
    If Mean
      PmTensorReduceMeanLast(Source,Destination,Outer,Width)
    Else
      PmTensorReduceSumLast(Source,Destination,Outer,Width)
    EndIf
  CompilerEndIf
EndProcedure
; PmTensorTrig owns the op set and refuses anything outside 0 Sin, 1 Cos,
; 2 Atan by clearing PmTensorTrigOk.  It cannot name DError - tensor_fp32.pmi
; is included before this file and is also used by statically emitted programs
; that have no DError at all - so the dispatcher that ran it is what turns the
; refusal into an error, the same way DReadI64 above does for PmTensorInt64Ok.
; Arming is per call so a refusal cannot be carried over from an earlier node.
;
; OP 2 HAS ITS OWN A64 KERNEL AND IT IS BIT-IDENTICAL, which the Sin/Cos
; kernel deliberately is not.  PmTensorTrigA64 owns 0 and 1 only - it
; branches every higher op straight back to PmTensorTrig - so the
; arctangent ran one element at a time through MathATan's software
; binary32 core, which is thousands of instructions per element and two
; seconds of a Kokoro request on one node.  PmTensorAtanFp32Neon runs
; MathATan's own statements four lanes at a time and hands any block it
; does not own back to PmTensorTrig, so the answer is the scalar's bits
; either way.  Anything outside 0..2 still reaches PmTensorTrig, which
; owns the op set and is what refuses it.
Procedure PmFastTrig(Source.i,Destination.i,Count.i,Op.i)
  PmTensorTrigOk=1
  CompilerIf #PMD_NATIVE_BYTES=8
  If Op=2
    PmTensorAtanFp32Neon(Source,Destination,Count)
  Else
    PmTensorTrigA64(Source,Destination,Count,Op)
  EndIf
  CompilerElse
  PmTensorTrig(Source,Destination,Count,Op)
  CompilerEndIf
  If PmTensorTrigOk=0
    DFail("Unsupported trigonometric operation code: this kernel computes 0 Sin, 1 Cos and 2 Atan only. Check the operator the model emitted for this node.")
  EndIf
EndProcedure
; The A64 LSTM kernel reads W and R as [gate][inner][unit] so that four
; adjacent UNITS of one gate are one 16-byte load; the model's weights are
; [gate][unit][inner], where the four lanes the reference gathers are
; Hidden*Count*4 bytes apart.  The copy is made here, once per LSTM call,
; because this file owns the arena and tensor_fp32_neon.pmi must not.
;
; THE ROW IS PADDED so that every vector address in the kernel is a
; multiple of sixteen whatever Hidden is: stride = (Hidden + 3) & -4.  The
; reason is in the kernel's header - with the MMU off this part's memory is
; Device, and an unaligned wide access there is a silent runaway.
;
; THE BUDGET, per node, in bytes, with stride = (Hidden + 3) & -4:
;
;     W'      Directions * 4 * stride * InputSize * 4
;     R'      Directions * 4 * stride * Hidden    * 4
;     sums    8 * stride * 4          (the 4*Hidden W.x and 4*Hidden R.h
;                                      dots of one timestep)
;
; Kokoro's six LSTMs are Directions 2, Hidden 256, InputSize 512 at the
; first and 640 at the other five, and 256 needs no padding: 6.0 MiB and
; 7.0 MiB respectively, plus 8 KiB of sums.  They are acquired and released
; inside one call, so the arena's peak rises by ONE node's copy, not by
; six.  The emitted working memory limit on this target is a flat 1 GiB
; (onnx_dynamic_emit.pbi:456), which is where the headroom comes from.
;
; A shortfall is a REFUSAL and not a quiet fall back to the reference: a
; model that silently runs several times slower than the export promised is
; the performance shape of a silent wrong answer, and the caller cannot see
; it happen.  The reference still owns every case this kernel does not
; claim - an INT8 weight set, and every non-A64 target.
; Square root, sigmoid and tanh.  Each of the three has a bit-identical A64
; kernel in tensor_fp32_neon.pmi and each was still reaching the scalar from
; DUnary: Sqr() is three SOFTWARE binary32 divisions per element, and the two
; activations are a software Exp each.  The sigmoid and tanh kernels are the
; ones the LSTM epilogue already uses, unchanged; this only gives the same
; kernels their elementwise caller.  The scalar bodies remain the definition
; of the answer for every other target, and for the values the kernels hand
; back to them.
Procedure PmFastSqrt(Source.i,Destination.i,Count.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  PmTensorSqrtFp32Neon(Source,Destination,Count)
  CompilerElse
  PmTensorUnaryMath(Source,Destination,Count,2)
  CompilerEndIf
EndProcedure
Procedure PmFastSigmoid(Source.i,Destination.i,Count.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  PmTensorSigmoidFp32Neon(Source,Destination,Count)
  CompilerElse
  PmTensorSigmoid(Source,Destination,Count)
  CompilerEndIf
EndProcedure
Procedure PmFastTanh(Source.i,Destination.i,Count.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  PmTensorTanhFp32Neon(Source,Destination,Count)
  CompilerElse
  PmTensorTanh(Source,Destination,Count)
  CompilerEndIf
EndProcedure
Procedure PmFastLstm(*g.PmTensorLstmArgs)
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected planes.i=0
  Protected stride.i=0
  Protected wtBytes.i=0
  Protected rtBytes.i=0
  Protected sumBytes.i=0
  Protected total.i=0
  Protected wt.i=0
  Protected rt.i=0
  Protected sums.i=0
  If *g\WScales=0 And *g\RScales=0
    planes=*g\Directions*4
    stride=(*g\Hidden+3) & -4
    wtBytes=planes * stride * *g\InputSize * 4
    rtBytes=planes * stride * *g\Hidden * 4
    sumBytes=*g\Directions * 8 * stride * 4
    total=wtBytes+rtBytes+sumBytes
    If total>DLimit-DLive
      DFail("The LSTM cannot reserve working memory for its transposed weight copy, which is Directions*4*Hidden*(InputSize+Hidden)*4 bytes plus 32*Hidden bytes of gate sums. Raise the model's working memory limit, which is the first thing to check, or export this graph for a smaller hidden size.")
      ProcedureReturn
    EndIf
    wt=DAcquire(wtBytes)
    rt=DAcquire(rtBytes)
    sums=DAcquire(sumBytes)
    If wt=0 Or rt=0 Or sums=0
      DFree(sums)
      DFree(rt)
      DFree(wt)
      DFail("The LSTM could not acquire its transposed weight buffers from the arena even though the total fits. The arena is fragmented; check what the nodes before this one left live.")
      ProcedureReturn
    EndIf
    DLive+total
    DPeak=DMax(DPeak,DLive)
    PmTensorLstmTransposeWeights(*g\W,wt,planes,*g\Hidden,*g\InputSize,stride)
    PmTensorLstmTransposeWeights(*g\R,rt,planes,*g\Hidden,*g\Hidden,stride)
    PmTensorLstmFp32Neon(*g,wt,rt,sums,stride)
    DFree(sums)
    DFree(rt)
    DFree(wt)
    DLive-total
    ProcedureReturn
  EndIf
  CompilerEndIf
  CompilerIf #PMD_NATIVE_BYTES=8 And #PMO_USE_INT8=1
  If *g\WScales<>0 Or *g\RScales<>0
    PmI8LstmParallelNeon(*g)
    ProcedureReturn
  EndIf
  CompilerEndIf
  PmTensorLstm(*g)
EndProcedure
Procedure.i PmFastConv(*g.PmTensorConv1DArgs,Available.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  ; PmParallelConv1D runs this convolution on every core the monitor will
  ; give it, and on exactly one when there is no monitor, no service, or a
  ; conv too small to be worth splitting. The single-core path it falls
  ; back to is PmTensorConv1DFp32Neon, unchanged, so the bytes are the same
  ; either way and nothing above here has a decision to make.
  PmParallelConv1D(*g)
  CompilerElse
  PmTensorConv1D(*g)
  CompilerEndIf
  ProcedureReturn 1
EndProcedure
Procedure.i PmFastConvTranspose(*g.PmTensorConvTranspose1DArgs,Available.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected scratch.i,bytes.i=25600,status.i
  If PmConvTransposeSixEligible(*g) And Available>=bytes
    scratch=DAcquireOverwrite(bytes)
    If scratch=0 : ProcedureReturn 0 : EndIf
    DLive=DLive+bytes : DPeak=DMax(DPeak,DLive)
    status=PmConvTransposeSixParallel(*g,scratch,bytes)
    If status<0
      ; Retain scratch after an incomplete dispatch. It must not be reused
      ; while an unjoined worker could still own it.
      DFail("Transposed convolution parallel worker failed.")
      ProcedureReturn 0
    EndIf
    DFree(scratch) : DLive=DLive-bytes
    If status>0 : ProcedureReturn 1 : EndIf
  EndIf
  PmTensorConvTranspose1DFp32Neon(*g)
  CompilerElse
  PmTensorConvTranspose1D(*g)
  CompilerEndIf
  ProcedureReturn 1
EndProcedure
Procedure.i DProduct(Id.i, First.i, Last.i)
  Protected i.i=0
  Protected n.i=1
  For i=First To Last
    n*DDims((Id)*8+(i))
  Next
  ProcedureReturn n
EndProcedure

Procedure.i DLike(Y.i,A.i,Kind.i)
  If Kind=0
    Kind=Dt(A)\Kind
  EndIf
  ProcedureReturn DAlloc(Y,Kind,Dt(A)\Rank,@DDims((A)*8+(0)))
EndProcedure
Procedure.i DLikeOverwrite(Y.i,A.i,Kind.i)
  If Kind=0
    Kind=Dt(A)\Kind
  EndIf
  ProcedureReturn DAllocOverwrite(Y,Kind,Dt(A)\Rank,@DDims((A)*8+(0)))
EndProcedure


Procedure.i DBroadcastIndex(Index.i,Y.i,A.i)
  Protected ax.i=0
  Protected src.i=0
  Protected coord.i=0
  Protected stride.i=1
  Protected result.i=0
  For ax=Dt(Y)\Rank-1 To 0 Step -1
    coord=Index % DDims((Y)*8+(ax))
    Index / DDims((Y)*8+(ax))
    src=ax-(Dt(Y)\Rank-Dt(A)\Rank)
    If src>=0
      If DDims((A)*8+(src))<>1
        result+coord*stride
      EndIf
      stride*DDims((A)*8+(src))
    EndIf
  Next
  ProcedureReturn result
EndProcedure

Procedure.i DBroadcast(Y.i,A.i,B.i,Kind.i)
  Protected rank.i=DMax(Dt(A)\Rank,Dt(B)\Rank)
  Protected i.i=0
  Protected ai.i=0
  Protected bi.i=0
  Protected ad.i=0
  Protected bd.i=0
  Protected Dim dims.i(8)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Kind=0
    Kind=Dt(A)\Kind
  EndIf
  For i=0 To rank-1
    ai=i-rank+Dt(A)\Rank
    bi=i-rank+Dt(B)\Rank
    ad=1
    bd=1
    If ai>=0
      ad=DDims((A)*8+(ai))
    EndIf
    If bi>=0
      bd=DDims((B)*8+(bi))
    EndIf
    If ad<>bd And ad<>1 And bd<>1
      ProcedureReturn DFail("Incompatible broadcast dimensions.")
    EndIf
    If ad=1
      dims(i)=bd
    Else
      dims(i)=ad
    EndIf
  Next
  ProcedureReturn DAllocOverwrite(Y,Kind,rank,@dims(0))
EndProcedure

; Pow(x,y) picks its algorithm from y ALONE - see math_a64.pmi:2184 and the
; same function in math_m0.pmi and math_m33.pmi.  A whole number with
; |y| <= 64 is MathPowInt, repeated squaring in binary32; everything else is
; Exp(y*Log(x)).  So when B is one broadcast element the choice is the same
; for every output element and can be made ONCE, here, instead of inside the
; loop Count times - which is what lets the whole-number case go down the
; same four-lane row path ops 0..3 use.
;
; This replaced a narrower rewrite that turned Pow(x,2) into DBinary's own
; multiply by aliasing B to A.  That was the k = 2 case of this and nothing
; more, it covered none of the other exponents Kokoro emits, and it was not
; actually the same function: a multiply QUIETS a signalling NaN base and
; Pow returns it untouched.
;
; A NaN exponent is excluded first because Int() has no answer for it; Pow
; returns the NaN from its own second early exit, on the scalar path below.
Procedure.i DPowWholeExponent(y.f)
  Protected k.i=0
  If y<>y
    ProcedureReturn 0
  EndIf
  If y < -64.0
    ProcedureReturn 0
  EndIf
  If y > 64.0
    ProcedureReturn 0
  EndIf
  k=Int(y)
  If DFloat(k)<>y
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure PmBroadcastRowsRange(Y.i,A.i,B.i,Op.i,width.i,astep.i,bstep.i,first.i,last.i)
  Protected row.i
  Protected i.i
  Protected ai.i
  Protected bi.i
  Protected arow.i=-1,brow.i=-1,adata.i=Dt(A)\Data,bdata.i=Dt(B)\Data,ydata.i=Dt(Y)\Data
  Protected acols.i=1,bcols.i=1,rows.i=Dt(Y)\Count/width
  If astep : acols=width : EndIf
  If bstep : bcols=width : EndIf
  If Dt(A)\Count=acols : arow=0 : ElseIf Dt(A)\Count=rows*acols : arow=acols : EndIf
  If Dt(B)\Count=bcols : brow=0 : ElseIf Dt(B)\Count=rows*bcols : brow=bcols : EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected Dim packed.i(10)
  Protected take.i
  If arow>=0 And brow>=0 And Op<=3
    packed(3)=width : packed(4)=astep : packed(5)=bstep : packed(6)=Op
    packed(7)=arow*4 : packed(8)=brow*4
    row=first
    While row<last
      take=last-row : If take>4096 : take=4096 : EndIf
      PmKernelIdle()
      packed(0)=adata+row*arow*4 : packed(1)=bdata+row*brow*4
      packed(2)=ydata+row*width*4 : packed(9)=take
      PmTensorBinaryRowsFp32Neon(@packed(0))
      row=row+take
    Wend
    ProcedureReturn
  EndIf
  CompilerEndIf
  For row=first To last-1
    i=row*width
    If arow>=0 : ai=row*arow : Else : ai=DBroadcastIndex(i,Y,A) : EndIf
    If brow>=0 : bi=row*brow : Else : bi=DBroadcastIndex(i,Y,B) : EndIf
    CompilerIf #PMD_NATIVE_BYTES=8
    If Op=4
      PmTensorPowIntFp32Neon(adata+ai*4,bdata+bi*4,ydata+i*4,width,astep)
    Else
      PmTensorBinaryFp32Neon(adata+ai*4,bdata+bi*4,ydata+i*4,width,astep,bstep,Op)
    EndIf
    CompilerElse
    PmFastBinary(adata+ai*4,bdata+bi*4,ydata+i*4,width,astep,bstep,Op)
    CompilerEndIf
  Next
EndProcedure
CompilerIf #PMD_NATIVE_BYTES=8
Global Dim PmBroadcastParts.i[36]
Procedure.i PmBroadcastWorker(*p.i)
  PmBroadcastRowsRange(PeekI(*p),PeekI(*p+8),PeekI(*p+16),PeekI(*p+24),PeekI(*p+32),PeekI(*p+40),PeekI(*p+48),PeekI(*p+56),PeekI(*p+64))
  ProcedureReturn 0
EndProcedure
CompilerEndIf
Procedure PmBroadcastRows(Y.i,A.i,B.i,Op.i,width.i,astep.i,bstep.i)
  Protected rows.i=Dt(Y)\Count/width
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected parts.i=1
  Protected i.i
  Protected first.i=0
  Protected last.i
  Protected at.i
  If rows>=8 And Dt(Y)\Count>=32768
    parts=PmParallelCores()
    If parts>4 : parts=4 : EndIf
  EndIf
  If parts>1
    For i=0 To parts-1
      last=rows*(i+1)/parts : at=i*9
      PmBroadcastParts[at]=Y : PmBroadcastParts[at+1]=A : PmBroadcastParts[at+2]=B
      PmBroadcastParts[at+3]=Op : PmBroadcastParts[at+4]=width
      PmBroadcastParts[at+5]=astep : PmBroadcastParts[at+6]=bstep
      PmBroadcastParts[at+7]=first : PmBroadcastParts[at+8]=last
      first=last
    Next
    If pmSvcParRun(@PmBroadcastWorker,@PmBroadcastParts[0],72,parts)=#PMP_SVC_OK : ProcedureReturn : EndIf
  EndIf
  CompilerEndIf
  PmBroadcastRowsRange(Y,A,B,Op,width,astep,bstep,0,rows)
EndProcedure

Declare.i DSpansOverlap(a.i,an.i,b.i,bn.i)
Procedure DBinary(Y.i,A.i,B.i,Op.i)
  Protected i.i=0
  Protected ai.i=0
  Protected bi.i=0
  Protected kind.i=Dt(A)\Kind
  Protected av.f=0.0
  Protected bv.f=0.0
  Protected v.f=0.0
  Protected ia.i=0
  Protected ib.i=0
  Protected iv.i=0
  Protected width.i=0
  Protected row.i=0
  Protected astep.i=0
  Protected bstep.i=0
  Protected maskfast.i=0,chunk.i,left.i,offset.i,arithfast.i,done.i
  Protected fastrow.i=0
  Protected amap.i=0
  Protected bmap.i=0
  If Op<=3
    fastrow=1
  EndIf
  If Op=4 And Dt(A)\Kind=1 And Dt(B)\Kind=1 And Dt(B)\Count=1
    fastrow=DPowWholeExponent(DReadF(Dt(B)\Data))
  EndIf
  If Op>=5
    kind=9
  EndIf
  If DBroadcast(Y,A,B,kind)=0
    ProcedureReturn
  EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  If Dt(A)\Kind=7 And Dt(B)\Kind=7 And ((Op>=0 And Op<=3) Or (Op>=5 And Op<=9))
    If PmTensorInt64Ok=0
      DFail("INT64 value exceeds the native signed execution range.") : ProcedureReturn
    EndIf
    width=1
    If Dt(Y)\Rank : width=DDims(Y*8+Dt(Y)\Rank-1) : EndIf
    If width=0 : ProcedureReturn : EndIf
    astep=0 : bstep=0
    If Dt(A)\Rank : astep=Bool(DDims(A*8+Dt(A)\Rank-1)<>1) : EndIf
    If Dt(B)\Rank : bstep=Bool(DDims(B*8+Dt(B)\Rank-1)<>1) : EndIf
    If (Dt(A)\Count=1 Or Dt(A)\Count=Dt(Y)\Count) And (Dt(B)\Count=1 Or Dt(B)\Count=Dt(Y)\Count)
      width=Dt(Y)\Count : astep=Bool(Dt(A)\Count<>1) : bstep=Bool(Dt(B)\Count<>1)
    EndIf
    If width=0 : ProcedureReturn : EndIf
    maskfast=Bool(Op>=5 And DSpansOverlap(Dt(Y)\Data,Dt(Y)\Bytes,Dt(A)\Data,Dt(A)\Bytes)=0 And DSpansOverlap(Dt(Y)\Data,Dt(Y)\Bytes,Dt(B)\Data,Dt(B)\Bytes)=0)
    arithfast=Bool(Op>=0 And Op<=1 And DSpansOverlap(Dt(Y)\Data,Dt(Y)\Bytes,Dt(A)\Data,Dt(A)\Bytes)=0 And DSpansOverlap(Dt(Y)\Data,Dt(Y)\Bytes,Dt(B)\Data,Dt(B)\Bytes)=0)
    For row=0 To Dt(Y)\Count/width-1
      ai=Dt(A)\Data+DBroadcastIndex(row*width,Y,A)*8
      bi=Dt(B)\Data+DBroadcastIndex(row*width,Y,B)*8
      If maskfast
        offset=0
        While offset<width
          chunk=width-offset : If chunk>256 : chunk=256 : EndIf
          PmTensorCompareI64Neon(ai+offset*astep*8,bi+offset*bstep*8,Dt(Y)\Data+row*width+offset,chunk,astep,bstep,Op)
          offset+chunk : PmKernelIdle()
        Wend
      ElseIf arithfast
        offset=0
        While offset<width
          chunk=width-offset : If chunk>256 : chunk=256 : EndIf
          done=PmTensorAddSubI64Native(ai+offset*astep*8,bi+offset*bstep*8,Dt(Y)\Data+(row*width+offset)*8,chunk,astep,bstep,Op)
          If done<>chunk : DFail("Integer arithmetic exceeds the native signed execution range.") : ProcedureReturn : EndIf
          offset+chunk : PmKernelIdle()
        Wend
      Else
      For i=row*width To (row+1)*width-1
        ia=PeekI(ai) : ib=PeekI(bi)
        If Op<=3
          If Op=3 And ib=0 : DFail("Integer division by zero.") : ProcedureReturn : EndIf
          iv=DIntegerOp(ia,ib,Op)
          If DError : ProcedureReturn : EndIf
          PokeI(Dt(Y)\Data+i*8,iv)
        Else
          Select Op
            Case 5 : iv=Bool(ia=ib)
            Case 6 : iv=Bool(ia>ib)
            Case 7 : iv=Bool(ia<ib)
            Case 8 : iv=Bool(ia>=ib)
            Case 9 : iv=Bool(ia<>0 And ib<>0)
          EndSelect
          PokeA(Dt(Y)\Data+i,iv)
        EndIf
        ai=ai+astep*8 : bi=bi+bstep*8
        If (i & 255)=255 : PmKernelIdle() : EndIf
      Next
      EndIf
      PmKernelIdle()
    Next
    ProcedureReturn
  EndIf
  CompilerEndIf
  If kind=1 And Dt(B)\Kind=1 And fastrow=1
    width=1
    If Dt(Y)\Rank
      width=DDims((Y)*8+(Dt(Y)\Rank-1))
    EndIf
    If width=0
      ProcedureReturn
    EndIf
    ; ONE CALL FOR THE WHOLE TENSOR when neither operand needs a per-row index.
    ; If A holds exactly Y's element count then A's index map IS the identity:
    ; every dimension of A is either Y's or a one where Y is also one, because
    ; a one against a larger Y dimension would have left A with fewer elements.
    ; And if A holds ONE element it is that same element for every output. The
    ; same two cases for B, and then DBroadcastIndex has nothing to say.
    ;
    ; The row loop below is otherwise Count/width copies of one call, and the
    ; model has a tensor shaped [1,102000,9]: 102,000 calls of nine elements.
    ; Measured on the board (V5 node ticks, request 2), the same operators run
    ; at 38-43 ns per element there against 3.2 ns per element on the
    ; generator's contiguous [1,128,20401] rows, which is the per-call cost and
    ; not the arithmetic.
    If (Dt(A)\Count=Dt(Y)\Count Or Dt(A)\Count=1) And (Dt(B)\Count=Dt(Y)\Count Or Dt(B)\Count=1)
      PmFastBinary(Dt(A)\Data,Dt(B)\Data,Dt(Y)\Data,Dt(Y)\Count,Bool(Dt(A)\Count<>1),Bool(Dt(B)\Count<>1),Op)
      ProcedureReturn
    EndIf
    If Dt(A)\Rank
      astep=Bool(DDims((A)*8+(Dt(A)\Rank-1))<>1)
    EndIf
    If Dt(B)\Rank
      bstep=Bool(DDims((B)*8+(Dt(B)\Rank-1))<>1)
    EndIf
    PmBroadcastRows(Y,A,B,Op,width,astep,bstep)
    ProcedureReturn
  EndIf
  ; Pow with one broadcast exponent that is NOT a whole number in [-64,64]:
  ; Exp(y*Log(x)) per element, which is what Pow computes and the only thing
  ; that computes it.  The whole-number exponents left through the row path
  ; above and never arrive here.
  If Op=4 And Dt(A)\Kind=1 And Dt(B)\Kind=1 And Dt(B)\Count=1 And Dt(A)\Count=Dt(Y)\Count
    bv=DReadF(Dt(B)\Data)
    For i=0 To Dt(Y)\Count-1
      DWriteF(Dt(Y)\Data+i*4,Pow(DReadF(Dt(A)\Data+i*4),bv))
    Next
    ProcedureReturn
  EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  If Op>=5 And Op<=9 And Dt(A)\Kind=1 And Dt(B)\Kind=1 And (Dt(A)\Count=1 Or Dt(A)\Count=Dt(Y)\Count) And (Dt(B)\Count=1 Or Dt(B)\Count=Dt(Y)\Count)
    PmTensorCompareFp32Neon(Dt(A)\Data,Dt(B)\Data,Dt(Y)\Data,Dt(Y)\Count,Bool(Dt(A)\Count<>1),Bool(Dt(B)\Count<>1),Op)
    ProcedureReturn
  EndIf
  If Op>=5 And Op<=9 And Dt(A)\Kind=1 And Dt(B)\Kind=1
    width=1
    If Dt(Y)\Rank : width=DDims(Y*8+Dt(Y)\Rank-1) : EndIf
    If width=0 : ProcedureReturn : EndIf
    astep=0 : bstep=0
    If Dt(A)\Rank : astep=Bool(DDims(A*8+Dt(A)\Rank-1)<>1) : EndIf
    If Dt(B)\Rank : bstep=Bool(DDims(B*8+Dt(B)\Rank-1)<>1) : EndIf
    For row=0 To Dt(Y)\Count/width-1
      ai=DBroadcastIndex(row*width,Y,A)
      bi=DBroadcastIndex(row*width,Y,B)
      PmTensorCompareFp32Neon(Dt(A)\Data+ai*4,Dt(B)\Data+bi*4,Dt(Y)\Data+row*width,width,astep,bstep,Op)
      PmKernelIdle()
    Next
    ProcedureReturn
  EndIf
  CompilerEndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  If Op=9 And Dt(A)\Kind=9 And Dt(B)\Kind=9 And DSpansOverlap(Dt(Y)\Data,Dt(Y)\Bytes,Dt(A)\Data,Dt(A)\Bytes)=0 And DSpansOverlap(Dt(Y)\Data,Dt(Y)\Bytes,Dt(B)\Data,Dt(B)\Bytes)=0
    width=1 : If Dt(Y)\Rank : width=DDims(Y*8+Dt(Y)\Rank-1) : EndIf
    If width=0 : ProcedureReturn : EndIf
    astep=0 : bstep=0
    If Dt(A)\Rank : astep=Bool(DDims(A*8+Dt(A)\Rank-1)<>1) : EndIf
    If Dt(B)\Rank : bstep=Bool(DDims(B*8+Dt(B)\Rank-1)<>1) : EndIf
    If (Dt(A)\Count=1 Or Dt(A)\Count=Dt(Y)\Count) And (Dt(B)\Count=1 Or Dt(B)\Count=Dt(Y)\Count)
      width=Dt(Y)\Count : astep=Bool(Dt(A)\Count<>1) : bstep=Bool(Dt(B)\Count<>1)
    EndIf
    If width=0 : ProcedureReturn : EndIf
    For row=0 To Dt(Y)\Count/width-1
      ai=Dt(A)\Data+DBroadcastIndex(row*width,Y,A) : bi=Dt(B)\Data+DBroadcastIndex(row*width,Y,B)
      offset=0
      While offset<width
        chunk=width-offset : If chunk>256 : chunk=256 : EndIf
        PmTensorAndBoolNeon(ai+offset*astep,bi+offset*bstep,Dt(Y)\Data+row*width+offset,chunk,astep,bstep)
        offset+chunk : PmKernelIdle()
      Wend
    Next
    ProcedureReturn
  EndIf
  CompilerEndIf
  If Op=9 And Dt(A)\Kind=9 And Dt(B)\Kind=9 And (Dt(A)\Count=1 Or Dt(A)\Count=Dt(Y)\Count) And (Dt(B)\Count=1 Or Dt(B)\Count=Dt(Y)\Count)
    ai=Dt(A)\Data : bi=Dt(B)\Data
    astep=Bool(Dt(A)\Count<>1) : bstep=Bool(Dt(B)\Count<>1)
    For i=0 To Dt(Y)\Count-1
      PokeA(Dt(Y)\Data+i,Bool(PeekA(ai)<>0 And PeekA(bi)<>0))
      ai+astep : bi+bstep
    Next
    ProcedureReturn
  EndIf
  If Op=9 And Dt(A)\Kind=9 And Dt(B)\Kind=9
    width=1
    If Dt(Y)\Rank : width=DDims(Y*8+Dt(Y)\Rank-1) : EndIf
    If width=0 : ProcedureReturn : EndIf
    astep=0 : bstep=0
    If Dt(A)\Rank : astep=Bool(DDims(A*8+Dt(A)\Rank-1)<>1) : EndIf
    If Dt(B)\Rank : bstep=Bool(DDims(B*8+Dt(B)\Rank-1)<>1) : EndIf
    For row=0 To Dt(Y)\Count/width-1
      ai=Dt(A)\Data+DBroadcastIndex(row*width,Y,A)
      bi=Dt(B)\Data+DBroadcastIndex(row*width,Y,B)
      For i=row*width To (row+1)*width-1
        PokeA(Dt(Y)\Data+i,Bool(PeekA(ai)<>0 And PeekA(bi)<>0))
        ai+astep : bi+bstep
      Next
      PmKernelIdle()
    Next
    ProcedureReturn
  EndIf
  ; The same two index maps the row path above hoists, hoisted here too, and
  ; this is where they are worth the most.  DBroadcastIndex walks the output
  ; rank with an integer division and a modulo PER AXIS, twice per element:
  ; the model's two Greater/Less nodes over 224,411 elements cost 644 ns an
  ; element on the board, which is about a thousand cycles for one comparison.
  ; A HOLDS Y'S COUNT means its index map is the identity; A holds ONE element
  ; means the index is zero.  Anything else still asks.
  amap=2
  bmap=2
  If Dt(A)\Count=Dt(Y)\Count
    amap=0
  ElseIf Dt(A)\Count=1
    amap=1
  EndIf
  If Dt(B)\Count=Dt(Y)\Count
    bmap=0
  ElseIf Dt(B)\Count=1
    bmap=1
  EndIf
  For i=0 To Dt(Y)\Count-1
    If amap=0
      ai=i
    ElseIf amap=1
      ai=0
    Else
      ai=DBroadcastIndex(i,Y,A)
    EndIf
    If bmap=0
      bi=i
    ElseIf bmap=1
      bi=0
    Else
      bi=DBroadcastIndex(i,Y,B)
    EndIf
    If Dt(A)\Kind=1
      av=DGet(A,ai)
      bv=DGet(B,bi)
      Select Op
        Case 0
          v=av+bv
        Case 1
          v=av-bv
        Case 2
          v=av*bv
        Case 3
          v=av/bv
        Case 4
          v=Pow(av,bv)
        Case 5
          v=DFloat(Bool(av=bv))
        Case 6
          v=DFloat(Bool(av>bv))
        Case 7
          v=DFloat(Bool(av<bv))
        Case 8
          v=DFloat(Bool(av>=bv))
        Case 9
          v=DFloat(Bool(av<>0 And bv<>0))
      EndSelect
      DPut(Y,i,v)
    Else
      ia=DInt(A,ai)
      ib=DInt(B,bi)
      Select Op
        Case 0
          iv=DIntegerOp(ia,ib,0)
        Case 1
          iv=DIntegerOp(ia,ib,1)
        Case 2
          iv=DIntegerOp(ia,ib,2)
        Case 3
          If ib=0
            DFail("Integer division by zero.")
            ProcedureReturn
          EndIf
          iv=DIntegerOp(ia,ib,3)
        Case 4
          If Dt(B)\Kind<>6 And Dt(B)\Kind<>7
            DFail("Integer power requires an integer exponent tensor; check the exponent type.")
            ProcedureReturn
          EndIf
          iv=DIntegerPower(ia,ib)
        Case 5
          iv=Bool(ia=ib)
        Case 6
          iv=Bool(ia>ib)
        Case 7
          iv=Bool(ia<ib)
        Case 8
          iv=Bool(ia>=ib)
        Case 9
          iv=Bool(ia<>0 And ib<>0)
        Default
          DFail("Unsupported integer arithmetic.")
          ProcedureReturn
      EndSelect
      If DError<>0
        ProcedureReturn
      EndIf
      If kind=7
        DWriteI64(Dt(Y)\Data+i*8,iv)
      ElseIf kind=6
        If iv< -2147483648 Or iv>2147483647
          DFail("INT32 arithmetic overflow.")
          ProcedureReturn
        EndIf
        PokeL(Dt(Y)\Data+i*4,iv)
      Else
        DPut(Y,i,DFloat(iv))
      EndIf
    EndIf
  Next
EndProcedure

; Internal schedule optimization: T must have no consumer except this Add.
; Its descriptor supplies the original intermediate broadcast shape; its
; storage is never read by the fast path and is released by the schedule.
CompilerIf #PMD_NATIVE_BYTES=8
Global Dim PmMultiplyAddParts.i[52]
Procedure.i PmMultiplyAddWorker(*p.i)
  Protected Dim local.i(13)
  Protected i.i,rows.i=PeekI(*p+88),take.i,limit.i=8192/PeekI(*p+32)
  If limit<1 : limit=1 : EndIf
  For i=0 To 12 : local(i)=PeekI(*p+i*8) : Next
  While rows>0
    take=rows : If take>limit : take=limit : EndIf
    local(11)=take
    PmKernelIdle()
    PmTensorMultiplyThenAddRows(@local(0))
    local(0)=local(0)+take*local(8) : local(1)=local(1)+take*local(9)
    local(2)=local(2)+take*local(10) : local(3)=local(3)+take*local(4)*4
    rows=rows-take
  Wend
  ProcedureReturn 0
EndProcedure

Procedure DMultiplyThenAdd(Y.i,T.i,A.i,B.i,C.i,reverse.i,mulNode.i,releaseMask.i)
  Protected addNode.i=DNode,width.i,rows.i,flat.i=0,parts.i=1,i.i,j.i,first.i,last.i,at.i
  Protected Dim input.i(3)
  Protected Dim steps.i(3)
  Protected Dim outer.i(3)
  Protected cols.i,id.i,total.i,axis.i,ta.i,td.i,cd.i,expanded.i=0
  DNode=mulNode
  If Dt(A)\Kind<>1 Or Dt(B)\Kind<>1 Or Dt(C)\Kind<>1
    DBinary(T,A,B,2)
    If DError<>0 : ProcedureReturn : EndIf
    If (releaseMask & 1)<>0 : DRelease(A) : EndIf
    If (releaseMask & 2)<>0 : DRelease(B) : EndIf
    DNode=addNode
    If reverse : DBinary(Y,C,T,0) : Else : DBinary(Y,T,C,0) : EndIf
    ProcedureReturn
  EndIf
  If DBroadcast(T,A,B,1)=0 : ProcedureReturn : EndIf
  ; When C expands the intermediate, preserve the original materialization
  ; and release boundary. Otherwise discard only T's storage: Y can reuse
  ; that block, so retaining A/B cannot raise the original allocation peak.
  For axis=0 To Dt(C)\Rank-1
    ta=axis+Dt(T)\Rank-Dt(C)\Rank : td=1
    If ta>=0 : td=DDims(T*8+ta) : EndIf
    cd=DDims(C*8+axis)
    If cd<>1 And cd<>td : expanded=1 : EndIf
  Next
  If expanded
    DBinary(T,A,B,2)
    If DError<>0 : ProcedureReturn : EndIf
    If (releaseMask & 1)<>0 : DRelease(A) : EndIf
    If (releaseMask & 2)<>0 : DRelease(B) : EndIf
    DNode=addNode
    If reverse : DBinary(Y,C,T,0) : Else : DBinary(Y,T,C,0) : EndIf
    ProcedureReturn
  EndIf
  DFree(Dt(T)\Data) : DLive=DLive-Dt(T)\Bytes
  Dt(T)\Data=0 : Dt(T)\Owned=0 : Dt(T)\Bytes=0
  DNode=addNode
  If DBroadcast(Y,T,C,1)=0 : ProcedureReturn : EndIf
  total=Dt(Y)\Count : If total=0 : ProcedureReturn : EndIf
  input(0)=A : input(1)=B : input(2)=C
  flat=1
  For j=0 To 2
    id=input(j)
    If Dt(id)\Count<>1 And Dt(id)\Count<>total : flat=0 : EndIf
  Next
  width=total : rows=1
  If flat=0
    width=1 : If Dt(Y)\Rank : width=DDims(Y*8+Dt(Y)\Rank-1) : EndIf
    rows=total/width
  EndIf
  For j=0 To 2
    id=input(j) : steps(j)=0 : outer(j)=0
    If flat
      steps(j)=Bool(Dt(id)\Count<>1)
    Else
      If Dt(id)\Rank : steps(j)=Bool(DDims(id*8+Dt(id)\Rank-1)<>1) : EndIf
      cols=1 : If steps(j) : cols=width : EndIf
      If Dt(id)\Count=cols
        outer(j)=0
      ElseIf Dt(id)\Count=rows*cols
        outer(j)=cols
      Else
        ; Preserve the original general broadcast and its intermediate.
        DRelease(Y) : DBinary(T,A,B,2)
        If DError<>0 : DNode=mulNode : ProcedureReturn : EndIf
        If (releaseMask & 1)<>0 : DRelease(A) : EndIf
        If (releaseMask & 2)<>0 : DRelease(B) : EndIf
        If reverse : DBinary(Y,C,T,0) : Else : DBinary(Y,T,C,0) : EndIf
        ProcedureReturn
      EndIf
    EndIf
  Next
  If total>=32768 And (flat Or rows>=8)
    parts=PmParallelCores() : If parts>4 : parts=4 : EndIf
  EndIf
  first=0
  For i=0 To parts-1
    last=rows*(i+1)/parts
    If flat : last=total*(i+1)/parts : EndIf
    at=i*13
    For j=0 To 2
      PmMultiplyAddParts[at+j]=Dt(input(j))\Data+first*outer(j)*4
      If flat : PmMultiplyAddParts[at+j]=Dt(input(j))\Data+first*steps(j)*4 : EndIf
      PmMultiplyAddParts[at+5+j]=steps(j)
      PmMultiplyAddParts[at+8+j]=outer(j)*4
    Next
    PmMultiplyAddParts[at+3]=Dt(Y)\Data+first*width*4
    PmMultiplyAddParts[at+4]=width : PmMultiplyAddParts[at+11]=last-first
    If flat
      PmMultiplyAddParts[at+3]=Dt(Y)\Data+first*4
      PmMultiplyAddParts[at+4]=last-first : PmMultiplyAddParts[at+11]=1
    EndIf
    PmMultiplyAddParts[at+12]=reverse
    first=last
  Next
  If parts>1
    If pmSvcParRun(@PmMultiplyAddWorker,@PmMultiplyAddParts[0],104,parts)=#PMP_SVC_OK : ProcedureReturn : EndIf
    ; Recompute all partitions after a refused parallel job.
  EndIf
  For i=0 To parts-1 : PmMultiplyAddWorker(@PmMultiplyAddParts[i*13]) : Next
EndProcedure
CompilerEndIf

Procedure PmUnaryRange(Source.i,Destination.i,Count.i,Op.i,Alpha.f)
  Protected done.i
  Select Op
    Case 0
      CompilerIf #PMD_NATIVE_BYTES=8 And #PMO_USE_EXPLOG=1
      PmTensorExpExactA64(Source,Destination,Count)
      CompilerElse
      PmTensorUnaryMath(Source,Destination,Count,Op)
      CompilerEndIf
    Case 1
      PmTensorUnaryMath(Source,Destination,Count,Op)
    Case 3
      CompilerIf #PMD_NATIVE_BYTES=8
      done=PmTensorSignBitsA64(Source,Destination,Count,0)
      PmTensorUnaryMath(Source+done*4,Destination+done*4,Count-done,Op)
      CompilerElse
      PmTensorUnaryMath(Source,Destination,Count,Op)
      CompilerEndIf
    Case 4
      CompilerIf #PMD_NATIVE_BYTES=8
      done=PmTensorSignBitsA64(Source,Destination,Count,1)
      PmTensorUnaryMath(Source+done*4,Destination+done*4,Count-done,Op)
      CompilerElse
      PmTensorUnaryMath(Source,Destination,Count,Op)
      CompilerEndIf
    Case 2
      PmFastSqrt(Source,Destination,Count)
    Case 5
      PmFastTrig(Source,Destination,Count,Op-5)
    Case 6
      PmFastTrig(Source,Destination,Count,Op-5)
    Case 7
      PmFastTrig(Source,Destination,Count,Op-5)
    Case 8
      PmFastSigmoid(Source,Destination,Count)
    Case 9
      PmFastTanh(Source,Destination,Count)
    Case 10
      CompilerIf #PMD_NATIVE_BYTES=8
      done=PmTensorFloorFourNeon(Source,Destination,Count)
      PmTensorFloor(Source+done*4,Destination+done*4,Count-done)
      CompilerElse
      PmTensorFloor(Source,Destination,Count)
      CompilerEndIf
    Case 11
      PmTensorRoundEven(Source,Destination,Count)
    Case 12
      CompilerIf #PMD_NATIVE_BYTES=8
      done=PmTensorLeakyReluA64(Source,Destination,Count,PeekL(@Alpha))
      PmTensorLeakyRelu(Source+done*4,Destination+done*4,Count-done,Alpha)
      CompilerElse
      PmTensorLeakyRelu(Source,Destination,Count,Alpha)
      CompilerEndIf
  EndSelect
EndProcedure

CompilerIf #PMD_NATIVE_BYTES=8
Global Dim PmUnaryParts.i[20]
Procedure.i PmUnaryWorker(*p.i)
  Protected first.i=0
  Protected count.i=PeekI(*p+16)
  Protected take.i
  While first<count
    take=count-first : If take>8192 : take=8192 : EndIf
    PmKernelIdle()
    PmUnaryRange(PeekI(*p)+first*4,PeekI(*p+8)+first*4,take,PeekI(*p+24),DReadF(*p+32))
    first=first+take
  Wend
  ProcedureReturn 0
EndProcedure
CompilerEndIf

Procedure PmUnaryDispatch(Source.i,Destination.i,Count.i,Op.i,Alpha.f)
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected parts.i=1
  Protected i.i
  Protected first.i=0
  Protected last.i
  Protected at.i
  If Count>=16384
    parts=PmParallelCores()
    If parts>4 : parts=4 : EndIf
  EndIf
  If parts>1
    For i=0 To parts-1
      last=Count
      If i<parts-1 : last=(Count*(i+1)/parts)/16*16 : EndIf
      at=i*5
      PmUnaryParts[at]=Source+first*4
      PmUnaryParts[at+1]=Destination+first*4
      PmUnaryParts[at+2]=last-first
      PmUnaryParts[at+3]=Op
      DWriteF(@PmUnaryParts[at+4],Alpha)
      first=last
    Next
    If pmSvcParRun(@PmUnaryWorker,@PmUnaryParts[0],40,parts)=#PMP_SVC_OK
      ProcedureReturn
    EndIf
  EndIf
  CompilerEndIf
  PmUnaryRange(Source,Destination,Count,Op,Alpha)
EndProcedure

Procedure DUnary(Y.i,A.i,Op.i,Alpha.f)
  If Dt(A)\Kind<>1
    DFail("This unary kernel requires FLOAT input.")
    ProcedureReturn
  EndIf
  If DLikeOverwrite(Y,A,0)=0
    ProcedureReturn
  EndIf
  ; PmTensorUnaryMath owns its op set and refuses anything outside 0 Exp,
  ; 1 Log, 2 Sqrt, 3 Abs, 4 Neg by clearing PmTensorUnaryMathOk.  It cannot
  ; name DError, so this dispatcher is what turns the refusal into one, the
  ; same way PmFastTrig does for PmTensorTrigOk.  Armed here, per DUnary call,
  ; so a refusal on one node is never read as a refusal on the next; only the
  ; unary-math kernel below ever clears it.
  PmTensorUnaryMathOk=1
  If Op<0 Or Op>12
      DFail("Unsupported unary operation code: this dispatcher routes 0 Exp, 1 Log, 2 Sqrt, 3 Abs, 4 Neg, 5 Sin, 6 Cos, 7 Atan, 8 Sigmoid, 9 Tanh, 10 Floor, 11 Round and 12 LeakyRelu only. Check the operator the model emitted for this node.")
      ProcedureReturn
  EndIf
  PmUnaryDispatch(Dt(A)\Data,Dt(Y)\Data,Dt(Y)\Count,Op,Alpha)
  If PmTensorUnaryMathOk=0
    DFail("Unsupported unary math operation code: this kernel computes 0 Exp, 1 Log, 2 Sqrt, 3 Abs and 4 Neg only. Check the operator the model emitted for this node.")
  EndIf
EndProcedure

Procedure DCast(Y.i,A.i,Kind.i)
  Protected i.i=0
  Protected value.i=0
  If DLikeOverwrite(Y,A,Kind)=0
    ProcedureReturn
  EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  If Dt(A)\Kind=1 And Kind=1
    DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Bytes) : ProcedureReturn
  EndIf
  CompilerEndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  If (Dt(A)\Kind=2 Or Dt(A)\Kind=3 Or Dt(A)\Kind=6 Or Dt(A)\Kind=9) And Kind=1
    PmTensorCastIntFloatNeon(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Count,Dt(A)\Kind)
    ProcedureReturn
  EndIf
  If Dt(A)\Kind=7 And Kind=1
    PmTensorCastI64FloatNeon(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Count)
    ProcedureReturn
  EndIf
  CompilerEndIf
  For i=0 To Dt(A)\Count-1
    If Dt(A)\Kind<>1 And Kind<>1
      value=DInt(A,i)
      If Kind=7
        DWriteI64(Dt(Y)\Data+i*8,value)
      ElseIf Kind=6
        If value< -2147483648 Or value>2147483647
          DFail("Cast exceeds INT32 execution range.")
          ProcedureReturn
        EndIf
        PokeL(Dt(Y)\Data+i*4,value)
      ElseIf Kind=9
        PokeA(Dt(Y)\Data+i,Bool(value<>0))
      ElseIf Kind=2 Or Kind=3
        PokeA(Dt(Y)\Data+i,value & 255)
      EndIf
    Else
      DPut(Y,i,DGet(A,i))
    EndIf
  Next
EndProcedure

Procedure DShapeOf(Y.i,A.i)
  Protected i.i=0
  If DShape(Y,7,1,Dt(A)\Rank,0,0,0)=0
    ProcedureReturn
  EndIf
  For i=0 To Dt(A)\Rank-1
    DWriteI64(Dt(Y)\Data+i*8,DDims((A)*8+(i)))
  Next
EndProcedure

; Consume a graph-proven last-use allocation or explicit writable state.
; Ordinary borrowed and same-ID inputs retain the copy path.
; The schedule releases the old input metadata.
Procedure.i DConsumeShape(Y.i,A.i,Rank.i,DimsAddress.i)
 Protected Dim dims.i(8)
 Protected i.i,count.i=1,extent.i,size.i,offset.i,span.i,state.i=0
 If A<=0 Or A>#PMD_TENSOR_COUNT Or Y<=0 Or Y>#PMD_TENSOR_COUNT Or Y=A : ProcedureReturn 0 : EndIf
 CompilerIf #PMD_NATIVE_BYTES=8
 If Dt(A)\Owned=0 And DMutable(A)=1 : state=1 : EndIf
 CompilerEndIf
 If Dt(A)\Owned<>1 And state=0 : ProcedureReturn 0 : EndIf
 If DError Or DCancel Or DRejectProgressReentry() : ProcedureReturn 0 : EndIf
 If Rank<0 Or Rank>8 Or (Rank>0 And DimsAddress=0) : ProcedureReturn DFail("Consumed view rank or dimensions are invalid.") : EndIf
 If state=0
 offset=Dt(A)\Data-DHeap-16
 If offset<0 Or offset>=DHeapBytes Or (offset & 15)<>0 : ProcedureReturn DFail("Consumed input has no owned arena block.") : EndIf
 span=PeekL(DHeap+offset)
 If span<32 Or span>DHeapBytes-offset Or PeekL(DHeap+offset+4)<>1 Or Dt(A)\Bytes<0 Or Dt(A)\Bytes>span-16 : ProcedureReturn DFail("Consumed input storage is invalid.") : EndIf
 Else
  CompilerIf #PMD_NATIVE_BYTES=8
  If Dt(A)\Data<=0 Or (Dt(A)\Data & 15)<>0 Or DMutableCapacity(A)<Dt(A)\Bytes Or DMutableCapacity(A)>DLimit
   ProcedureReturn DFail("Consumed mutable state capacity is invalid.")
  EndIf
  CompilerEndIf
 EndIf
 size=DSize(Dt(A)\Kind) : If size=0 : ProcedureReturn DFail("Consumed view type is invalid.") : EndIf
 For i=0 To Rank-1
  CompilerIf #PMD_NATIVE_BYTES=8
  extent=PeekN(DimsAddress+i*8)
  CompilerElse
  extent=PeekL(DimsAddress+i*4)
  CompilerEndIf
  If extent<0 Or extent>DLimit : ProcedureReturn DFail("Consumed view extent is invalid.") : EndIf
  If extent>0 And count>DLimit/extent : ProcedureReturn DFail("Consumed view count exceeds the arena limit.") : EndIf
  dims(i)=extent : count=count*extent
 Next
 If count>DLimit/size Or count<>Dt(A)\Count Or count*size<>Dt(A)\Bytes : ProcedureReturn DFail("Consumed view changes its element storage.") : EndIf
 DRelease(Y)
 If DError Or DCancel : ProcedureReturn 0 : EndIf
 Dt(Y)\Data=Dt(A)\Data : Dt(Y)\Kind=Dt(A)\Kind : Dt(Y)\Rank=Rank
 Dt(Y)\Count=count : Dt(Y)\Bytes=Dt(A)\Bytes : Dt(Y)\Owned=Dt(A)\Owned : Dt(Y)\Scales=0
 For i=0 To Rank-1 : DDims(Y*8+i)=dims(i) : Next
 CompilerIf #PMD_NATIVE_BYTES=8
 DMutable(Y)=DMutable(A) : DMutableCapacity(Y)=DMutableCapacity(A)
 DMutable(A)=0 : DMutableCapacity(A)=0
 CompilerEndIf
 Dt(A)\Owned=0
 ProcedureReturn 1
EndProcedure
Procedure.i DSpansOverlap(a.i,an.i,b.i,bn.i)
 If an<=0 Or bn<=0 : ProcedureReturn 0 : EndIf
 If a<=b : ProcedureReturn Bool(b-a<an) : EndIf
 ProcedureReturn Bool(a-b<bn)
EndProcedure
Procedure DReshapeCore(Y.i,A.i,Shape.i,AllowZero.i,Consume.i)
  Protected extent.i=0
  Protected Dim dims.i(8)
  Protected i.i=0
  Protected n.i=1
  Protected unknown.i=-1
  Protected rank.i=Dt(Shape)\Count
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If rank>8
    DFail("Reshape rank exceeds eight.")
    ProcedureReturn
  EndIf
  For i=0 To rank-1
    dims(i)=DInt(Shape,i)
    If dims(i)=0 And AllowZero=0
      If i>=Dt(A)\Rank
        DFail("Reshape zero axis is missing.")
        ProcedureReturn
      EndIf
      dims(i)=DDims((A)*8+(i))
    EndIf
    If dims(i)=-1
      If unknown>=0
        DFail("Reshape has multiple inferred axes.")
        ProcedureReturn
      EndIf
      unknown=i
    Else
      extent=dims(i)
      If extent<0
        DFail("Reshape extent is negative.")
        ProcedureReturn
      EndIf
      If extent>0
        If n>DLimit/extent
          DFail("Reshape extent overflow.")
          ProcedureReturn
        EndIf
      EndIf
      n*dims(i)
    EndIf
  Next
  If unknown>=0
    If n<=0 Or (Dt(A)\Count % n)<>0
      DFail("Reshape inferred extent is invalid.")
      ProcedureReturn
    EndIf
    dims(unknown)=Dt(A)\Count/n
    n=Dt(A)\Count
  EndIf
  If n<>Dt(A)\Count
    DFail("Reshape changes the element count.")
    ProcedureReturn
  EndIf
  If Consume And DConsumeShape(Y,A,rank,@dims(0)) : ProcedureReturn : EndIf
  If DAllocCore(Y,Dt(A)\Kind,rank,@dims(0),Bool(Y=A))
    DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Bytes)
  EndIf
EndProcedure

Procedure DReshape(Y.i,A.i,Shape.i,AllowZero.i)
 DReshapeCore(Y,A,Shape,AllowZero,0)
EndProcedure
Procedure DReshapeConsume(Y.i,A.i,Shape.i,AllowZero.i)
 DReshapeCore(Y,A,Shape,AllowZero,1)
EndProcedure

Procedure DViewAxesCore(Y.i,A.i,Axes.i,Unsqueeze.i,Consume.i)
  Protected Dim dims.i(8)
  Protected Dim mask.i(8)
  Protected i.i=0
  Protected ax.i=0
  Protected j.i=0
  Protected rank.i=Dt(A)\Rank
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  DZero(@mask(0),8*#PMD_NATIVE_BYTES)
  If Unsqueeze
    rank+Dt(Axes)\Count
  EndIf
  If rank>8
    DFail("View rank exceeds eight.")
    ProcedureReturn
  EndIf
  If Axes=0 And Unsqueeze=0
    For i=0 To rank-1
      mask(i)=Bool(DDims((A)*8+(i))=1)
    Next
  EndIf
  For i=0 To Dt(Axes)\Count-1
    ax=DInt(Axes,i)
    If ax<0
      ax+rank
    EndIf
    If ax<0 Or ax>=rank Or mask(ax)<>0
      DFail("View axis is invalid.")
      ProcedureReturn
    EndIf
    mask(ax)=1
  Next
  If Unsqueeze
    For i=0 To rank-1
      If mask(i)
        dims(i)=1
      Else
        dims(i)=DDims((A)*8+(j))
        j+1
      EndIf
    Next
  Else
    For i=0 To rank-1
      If mask(i)
        If DDims((A)*8+(i))<>1
          DFail("Cannot squeeze a non-unit axis.")
          ProcedureReturn
        EndIf
      Else
        dims(j)=DDims((A)*8+(i))
        j+1
      EndIf
    Next
    rank=j
  EndIf
  If Consume And DConsumeShape(Y,A,rank,@dims(0)) : ProcedureReturn : EndIf
  If DAllocCore(Y,Dt(A)\Kind,rank,@dims(0),Bool(Y=A))
    DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Bytes)
  EndIf
EndProcedure

Procedure DViewAxes(Y.i,A.i,Axes.i,Unsqueeze.i)
 DViewAxesCore(Y,A,Axes,Unsqueeze,0)
EndProcedure
Procedure DViewAxesConsume(Y.i,A.i,Axes.i,Unsqueeze.i)
 DViewAxesCore(Y,A,Axes,Unsqueeze,1)
EndProcedure

Procedure DTranspose(Y.i,A.i,Perm.i)
  Protected Dim dims.i(8)
  Protected Dim axes.i(8)
  Protected Dim strides.i(8)
  Protected Dim seen.i(8)
  Protected contiguous.i=1
  Protected tail.i
  Protected batch.i
  Protected height.i
  Protected width.i
  Protected rows.i
  Protected col.i
  Protected row.i
  Protected sp.i
  Protected dp.i
  Protected simple.i=1
  Protected prefix.i, pivot.i, expected.i
  Protected i.i=0
  Protected j.i=0
  Protected n.i=0
  Protected coord.i=0
  Protected src.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  Protected rank.i=Dt(A)\Rank
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  DZero(@axes(0),8*#PMD_NATIVE_BYTES)
  DZero(@strides(0),8*#PMD_NATIVE_BYTES)
  DZero(@seen(0),8*#PMD_NATIVE_BYTES)
  For i=0 To rank-1
    If PeekA(Perm)=0
      axes(i)=rank-i-1
    Else
      axes(i)=DListValue(Perm,i+1)
    EndIf
    If axes(i)<0 Or axes(i)>=rank
      DFail("Invalid transpose permutation.")
      ProcedureReturn
    EndIf
    If seen(axes(i))
      DFail("Transpose permutation has a duplicate axis.")
      ProcedureReturn
    EndIf
    seen(axes(i))=1
    dims(i)=DDims((A)*8+(axes(i)))
    strides(i)=DProduct(A,axes(i)+1,rank-1)
  Next
  If DAllocOverwrite(Y,Dt(A)\Kind,rank,@dims(0))=0
    ProcedureReturn
  EndIf
  ; Swap consecutive axis groups while keeping a contiguous trailing block.
  ; Attention layouts such as B,T,H,D -> B,H,T,D need no per-row divisions.
  CompilerIf #PMD_NATIVE_BYTES=8
  tail=rank-1 : contiguous=1
  While tail>=0
    If axes(tail)<>tail : Break : EndIf
    contiguous*dims(tail) : tail-1
  Wend
  prefix=0
  While prefix<=tail
    If axes(prefix)<>prefix : Break : EndIf
    prefix+1
  Wend
  If prefix<tail And tail<rank-1 And contiguous>0
    pivot=axes(prefix) : simple=Bool(pivot>prefix And pivot<=tail)
    For j=prefix To tail
      expected=pivot+j-prefix
      If expected>tail : expected=prefix+expected-tail-1 : EndIf
      If axes(j)<>expected : simple=0 : EndIf
    Next
    If simple And DSpansOverlap(Dt(A)\Data,Dt(A)\Bytes,Dt(Y)\Data,Dt(Y)\Bytes)=0
      height=DProduct(A,prefix,pivot-1) : width=DProduct(A,pivot,tail)
      If height>0 And width>0
        rows=Dt(A)\Count/(height*width*contiguous)
        For batch=0 To rows-1
          sp=Dt(A)\Data+batch*height*width*contiguous*size
          dp=Dt(Y)\Data+batch*height*width*contiguous*size
          For col=0 To width-1
            DCopyRowsServiced(sp+col*contiguous*size,dp+col*height*contiguous*size,contiguous*size,width*contiguous*size,contiguous*size,height)
          Next
        Next
      EndIf
      ProcedureReturn
    EndIf
  EndIf
  simple=1 : contiguous=1
  CompilerEndIf
  If rank>=2 And size=4
    ; A rotation of two consecutive axis groups is a matrix transpose.
    ; This also covers NCHW->NHWC after collapsing the spatial dimensions.
    prefix=0
    While prefix<rank
      If axes(prefix)<>prefix : Break : EndIf
      prefix+1
    Wend
    pivot=prefix
    If prefix<rank : pivot=axes(prefix) : EndIf
    If pivot<=prefix : simple=0 : EndIf
    For j=prefix To rank-1
      expected=pivot+j-prefix
      If expected>=rank : expected=prefix+expected-rank : EndIf
      If axes(j)<>expected : simple=0 : EndIf
    Next
    If simple
      height=DProduct(A,prefix,pivot-1) : width=DProduct(A,pivot,rank-1)
      If height>0 And width>0
        rows=Dt(A)\Count/(height*width)
        For batch=0 To rows-1
          CompilerIf #PMD_NATIVE_BYTES=8
          PmTransposeMatrixWords(Dt(A)\Data+batch*height*width*4,Dt(Y)\Data+batch*height*width*4,height,width)
          CompilerElse
          For col=0 To width-1
            sp=Dt(A)\Data+(batch*height*width+col)*4
            dp=Dt(Y)\Data+(batch*height*width+col*height)*4
            For row=0 To height-1
              PokeL(dp,PeekL(sp))
              sp+width*4 : dp+4
            Next
          Next
          CompilerEndIf
        Next
      EndIf
      ProcedureReturn
    EndIf
  EndIf
  ; Unchanged trailing axes form one contiguous run. Copy that run once;
  ; only the permuted prefix needs coordinate division.
  tail=rank-1
  While tail>=0
    If axes(tail)<>tail : Break : EndIf
    contiguous=contiguous*dims(tail)
    tail-1
  Wend
  If contiguous>1
    For i=0 To Dt(Y)\Count-1 Step contiguous
      n=i/contiguous : src=0
      For j=tail To 0 Step -1
        coord=n%dims(j) : n/dims(j)
        src+coord*strides(j)
      Next
      DCopyServiced(Dt(A)\Data+src*size,Dt(Y)\Data+i*size,contiguous*size)
    Next
    ProcedureReturn
  EndIf
  For i=0 To Dt(Y)\Count-1
    n=i
    src=0
    For j=rank-1 To 0 Step -1
      coord=n % dims(j)
      n/dims(j)
      src+coord*strides(j)
    Next
    DCopyServiced(Dt(A)\Data+src*size,Dt(Y)\Data+i*size,size)
  Next
EndProcedure

Procedure PmGatherAliased(Y.i,A.i,Indices.i,Axis.i)
  Protected Dim dims.i(8)
  Protected rank.i=Dt(A)\Rank+Dt(Indices)\Rank-1
  Protected i.i=0
  Protected j.i=0
  Protected k.i=0
  Protected p.i=0
  Protected idx.i=0
  Protected inner.i=0
  Protected outer.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Axis<0
    Axis+Dt(A)\Rank
  EndIf
  If rank>8 Or Axis<0 Or Axis>=Dt(A)\Rank
    DFail("Invalid Gather rank or axis.")
    ProcedureReturn
  EndIf
  For i=0 To Axis-1
    dims(p)=DDims((A)*8+(i))
    p+1
  Next
  For i=0 To Dt(Indices)\Rank-1
    dims(p)=DDims((Indices)*8+(i))
    p+1
  Next
  For i=Axis+1 To Dt(A)\Rank-1
    dims(p)=DDims((A)*8+(i))
    p+1
  Next
  If DAlloc(Y,Dt(A)\Kind,rank,@dims(0))=0
    ProcedureReturn
  EndIf
  inner=DProduct(A,Axis+1,Dt(A)\Rank-1)
  outer=DProduct(A,0,Axis-1)
  For i=0 To outer-1
    For j=0 To Dt(Indices)\Count-1
      idx=DInt(Indices,j)
      If idx<0
        idx+DDims((A)*8+(Axis))
      EndIf
      If idx<0 Or idx>=DDims((A)*8+(Axis))
        DFail("Gather index is out of bounds.")
        ProcedureReturn
      EndIf
      DCopyServiced(Dt(A)\Data+(i*DDims((A)*8+(Axis))+idx)*inner*size,Dt(Y)\Data+(i*Dt(Indices)\Count+j)*inner*size,inner*size)
    Next
  Next
EndProcedure

Procedure DGather(Y.i,A.i,Indices.i,Axis.i)
  Protected Dim dims.i(8)
  Protected rank.i=Dt(A)\Rank+Dt(Indices)\Rank-1
  Protected i.i=0
  Protected j.i=0
  Protected k.i=0
  Protected p.i=0
  Protected idx.i=0
  Protected inner.i=0
  Protected outer.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  Protected extent.i,take.i,look.i,bytes.i,srcStep.i,dstStep.i
  If Y=A Or Y=Indices
    PmGatherAliased(Y,A,Indices,Axis)
    ProcedureReturn
  EndIf
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Axis<0
    Axis+Dt(A)\Rank
  EndIf
  If rank>8 Or Axis<0 Or Axis>=Dt(A)\Rank
    DFail("Invalid Gather rank or axis.")
    ProcedureReturn
  EndIf
  For i=0 To Axis-1
    dims(p)=DDims((A)*8+(i))
    p+1
  Next
  For i=0 To Dt(Indices)\Rank-1
    dims(p)=DDims((Indices)*8+(i))
    p+1
  Next
  For i=Axis+1 To Dt(A)\Rank-1
    dims(p)=DDims((A)*8+(i))
    p+1
  Next
  If DAllocOverwrite(Y,Dt(A)\Kind,rank,@dims(0))=0
    ProcedureReturn
  EndIf
  inner=DProduct(A,Axis+1,Dt(A)\Rank-1)
  outer=DProduct(A,0,Axis-1)
  ; Index geometry is shared by every outer row. Consecutive source indices
  ; form a contiguous raw-byte span; destination rows remain independent.
  If outer<1 : ProcedureReturn : EndIf
  extent=DDims(A*8+Axis) : bytes=inner*size
  srcStep=extent*bytes : dstStep=Dt(Indices)\Count*bytes
  j=0
  While j<Dt(Indices)\Count
    idx=DInt(Indices,j)
    If idx<0 : idx+extent : EndIf
    If idx<0 Or idx>=extent
      DFail("Gather index is out of bounds.")
      ProcedureReturn
    EndIf
    take=1
    While take<Dt(Indices)\Count-j And take<extent-idx
      look=DInt(Indices,j+take)
      If look<0 : look+extent : EndIf
      If look<>idx+take : Break : EndIf
      take+1
    Wend
    DCopyRowsServiced(Dt(A)\Data+idx*bytes,Dt(Y)\Data+j*bytes,take*bytes,srcStep,dstStep,outer)
    j+take
  Wend
EndProcedure

; Explicit last-use selection from caller-owned writable recurrent storage.
; Immutable or arena-owned sources retain ordinary Gather's copied result.
; Read-only selection. The caller must retain A's backing through every use
; of Y. Generated code selects this only for already-pinned source tensors.
Procedure DGatherView(Y.i,A.i,Indices.i,Axis.i)
 CompilerIf #PMD_NATIVE_BYTES=8
 Protected Dim dims.i(8)
 Protected i.i,p.i,rank.i,idx.i,extent.i,inner.i,size.i,bytes.i,offset.i
 If Y<>A And Y<>Indices And A>0 And A<=#PMD_TENSOR_COUNT And Y>0 And Y<=#PMD_TENSOR_COUNT And Indices>0 And Indices<=#PMD_TENSOR_COUNT
 If Dt(A)\Rank>0 And (Axis=0 Or Axis=-Dt(A)\Rank) And Dt(Indices)\Count=1
  If DError Or DCancel : DFail("Request cancelled or an earlier operation failed.") : ProcedureReturn : EndIf
  If DRejectProgressReentry() : ProcedureReturn : EndIf
  rank=Dt(A)\Rank+Dt(Indices)\Rank-1
  If rank>8 : DFail("Invalid Gather rank or axis.") : ProcedureReturn : EndIf
  idx=DInt(Indices,0) : If DError : ProcedureReturn : EndIf
  extent=DDims(A*8) : If idx<0 : idx+extent : EndIf
  If idx<0 Or idx>=extent : DFail("Gather index is out of bounds.") : ProcedureReturn : EndIf
  inner=DProduct(A,1,Dt(A)\Rank-1) : size=DSize(Dt(A)\Kind)
  If inner<0 Or size=0 Or inner>DLimit/size : DFail("Borrowed Gather storage is invalid.") : ProcedureReturn : EndIf
  bytes=inner*size
  If bytes>Dt(A)\Bytes : DFail("Borrowed Gather span is invalid.") : ProcedureReturn : EndIf
  If bytes>0
   If idx>(Dt(A)\Bytes-bytes)/bytes : DFail("Borrowed Gather span is invalid.") : ProcedureReturn : EndIf
  EndIf
  offset=idx*bytes
  For i=0 To Dt(Indices)\Rank-1 : dims(p)=DDims(Indices*8+i) : p+1 : Next
  For i=1 To Dt(A)\Rank-1 : dims(p)=DDims(A*8+i) : p+1 : Next
  DBindBorrowed(Y,Dt(A)\Kind,rank,@dims(0),Dt(A)\Data+offset,bytes)
  ProcedureReturn
 EndIf
 EndIf
 CompilerEndIf
 DGather(Y,A,Indices,Axis)
EndProcedure

Procedure DGatherConsume(Y.i,A.i,Indices.i,Axis.i)
 CompilerIf #PMD_NATIVE_BYTES=8
 Protected Dim dims.i(8)
 Protected i.i,p.i,rank.i,idx.i,extent.i,inner.i,size.i,bytes.i,offset.i
 If Y<>A And Y<>Indices And A>0 And A<=#PMD_TENSOR_COUNT And Y>0 And Y<=#PMD_TENSOR_COUNT And Indices>0 And Indices<=#PMD_TENSOR_COUNT
 If Dt(A)\Owned=0 And DMutable(A)=1 And Dt(A)\Rank>0 And (Axis=0 Or Axis=-Dt(A)\Rank) And Dt(Indices)\Count=1
  If DError Or DCancel : DFail("Request cancelled or an earlier operation failed.") : ProcedureReturn : EndIf
  If DRejectProgressReentry() : ProcedureReturn : EndIf
  rank=Dt(A)\Rank+Dt(Indices)\Rank-1
  If rank>8 : DFail("Invalid Gather rank or axis.") : ProcedureReturn : EndIf
  idx=DInt(Indices,0) : If DError : ProcedureReturn : EndIf
  extent=DDims(A*8) : If idx<0 : idx+extent : EndIf
  If idx<0 Or idx>=extent : DFail("Gather index is out of bounds.") : ProcedureReturn : EndIf
  inner=DProduct(A,1,Dt(A)\Rank-1) : size=DSize(Dt(A)\Kind)
  If inner<0 Or size=0 Or inner>DLimit/size : DFail("Consumed Gather storage is invalid.") : ProcedureReturn : EndIf
  bytes=inner*size
  If bytes>Dt(A)\Bytes : DFail("Consumed Gather span is invalid.") : ProcedureReturn : EndIf
  If bytes>0
   If idx>(Dt(A)\Bytes-bytes)/bytes : DFail("Consumed Gather span is invalid.") : ProcedureReturn : EndIf
  EndIf
  offset=idx*bytes
  If (offset & 15)=0
   For i=0 To Dt(Indices)\Rank-1 : dims(p)=DDims(Indices*8+i) : p+1 : Next
   For i=1 To Dt(A)\Rank-1 : dims(p)=DDims(A*8+i) : p+1 : Next
   If DConsumeShape(Y,A,Dt(A)\Rank,@DDims(A*8))=0 : ProcedureReturn : EndIf
   Dt(Y)\Data=Dt(Y)\Data+offset : Dt(Y)\Count=inner : Dt(Y)\Bytes=bytes : Dt(Y)\Rank=rank
   DMutableCapacity(Y)=DMutableCapacity(Y)-offset
   For i=0 To rank-1 : DDims(Y*8+i)=dims(i) : Next
   ProcedureReturn
  EndIf
 EndIf
 EndIf
 CompilerEndIf
 DGather(Y,A,Indices,Axis)
EndProcedure

Procedure DConcat(Y.i,Inputs.i,Axis.i)
  Protected Dim dims.i(8)
  Protected count.i=DListCount(Inputs)
  Protected a.i=DListValue(Inputs,1)
  Protected i.i=0
  Protected j.i=0
  Protected outer.i=0
  Protected inner.i=0
  Protected offset.i=0
  Protected span.i=0
  Protected src.i,dst.i,bytes.i,step.i
  Protected size.i=DSize(Dt(a)\Kind)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Axis<0
    Axis+Dt(a)\Rank
  EndIf
  If Axis<0 Or Axis>=Dt(a)\Rank
    DFail("Invalid Concat axis.")
    ProcedureReturn
  EndIf
  For i=0 To Dt(a)\Rank-1
    dims(i)=DDims((a)*8+(i))
  Next
  dims(Axis)=0
  For i=1 To count
    a=DListValue(Inputs,i)
    If Dt(a)\Rank<>Dt(DListValue(Inputs,1))\Rank Or DSize(Dt(a)\Kind)<>size
      DFail("Concat rank/type mismatch.")
      ProcedureReturn
    EndIf
    For j=0 To Dt(a)\Rank-1
      If j<>Axis And DDims((a)*8+(j))<>dims(j)
        DFail("Concat non-axis extent mismatch.")
        ProcedureReturn
      EndIf
    Next
    dims(Axis)=dims(Axis)+DDims((a)*8+(Axis))
  Next
  If DAllocOverwrite(Y,Dt(a)\Kind,Dt(a)\Rank,@dims(0))=0
    ProcedureReturn
  EndIf
  outer=DProduct(Y,0,Axis-1)
  inner=DProduct(Y,Axis+1,Dt(Y)\Rank-1)
  ; Each input contributes disjoint output spans. Hoist its list parsing
  ; and row geometry, then write every byte without an initial zero fill.
  step=dims(Axis)*inner*size
  offset=0
  For i=1 To count
    a=DListValue(Inputs,i)
    span=DDims(a*8+Axis)*inner
    bytes=span*size
    src=Dt(a)\Data
    dst=Dt(Y)\Data+offset*size
    If bytes
      DCopyRowsServiced(src,dst,bytes,bytes,step,outer)
    EndIf
    offset+span
  Next
EndProcedure

Procedure DSlice(Y.i,A.i,Starts.i,Ends.i,Axes.i,Steps.i)
  Protected Dim dims.i(8)
  Protected Dim start.i(8)
  Protected Dim stepv.i(8)
  Protected Dim stride.i(8)
  Protected i.i=0
  Protected j.i=0
  Protected ax.i=0
  Protected s.i=0
  Protected e.i=0
  Protected st.i=0
  Protected n.i=0
  Protected src.i=0
  Protected c.i=0
  Protected block.i=1,axis.i,base.i=0,rows.i
  Protected size.i=DSize(Dt(A)\Kind)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  DZero(@start(0),8*#PMD_NATIVE_BYTES)
  DZero(@stepv(0),8*#PMD_NATIVE_BYTES)
  DZero(@stride(0),8*#PMD_NATIVE_BYTES)
  For i=0 To Dt(A)\Rank-1
    dims(i)=DDims((A)*8+(i))
    stepv(i)=1
    stride(i)=DProduct(A,i+1,Dt(A)\Rank-1)
  Next
  For i=0 To Dt(Starts)\Count-1
    ax=i
    If Axes
      ax=DInt(Axes,i)
    EndIf
    If ax<0
      ax+Dt(A)\Rank
    EndIf
    If ax<0 Or ax>=Dt(A)\Rank
      DFail("Invalid Slice axis.")
      ProcedureReturn
    EndIf
    n=DDims((A)*8+(ax))
    s=DInt(Starts,i)
    e=DInt(Ends,i)
    st=1
    If Steps
      st=DInt(Steps,i)
    EndIf
    If st=0
      DFail("Slice step is zero.")
      ProcedureReturn
    EndIf
    If s<0
      s+n
    EndIf
    If e<0
      e+n
    EndIf
    If st>0
      s=DMax(0,DMin(n,s))
      e=DMax(0,DMin(n,e))
      dims(ax)=DMax(0,(e-s+st-1)/st)
    Else
      s=DMax(-1,DMin(n-1,s))
      e=DMax(-1,DMin(n-1,e))
      dims(ax)=DMax(0,(s-e-st-1)/(-st))
    EndIf
    start(ax)=s
    stepv(ax)=st
  Next
  If DAllocOverwrite(Y,Dt(A)\Kind,Dt(A)\Rank,@dims(0))=0
    ProcedureReturn
  EndIf
  If Dt(Y)\Count=0 : ProcedureReturn : EndIf
  ; Coalesce the innermost contiguous suffix. The selected row may be only
  ; part of its source row; an outer stride mismatch stops coalescing there.
  axis=Dt(A)\Rank-1
  For j=0 To Dt(A)\Rank-1 : base=base+start(j)*stride(j) : Next
  While axis>=0
    If stepv(axis)<>1 Or stride(axis)<>block : Break : EndIf
    block=block*dims(axis) : axis=axis-1
  Wend
  If block>1
    rows=Dt(Y)\Count/block
    For i=0 To rows-1
      n=i : src=base
      For j=axis To 0 Step -1
        c=n % dims(j) : n=n/dims(j)
        src=src+c*stepv(j)*stride(j)
      Next
      DCopyServiced(Dt(A)\Data+src*size,Dt(Y)\Data+i*block*size,block*size)
    Next
    ProcedureReturn
  EndIf
  For i=0 To Dt(Y)\Count-1
    n=i
    src=0
    For j=Dt(Y)\Rank-1 To 0 Step -1
      c=n % dims(j)
      n/dims(j)
      src+(start(j)+c*stepv(j))*stride(j)
    Next
    DCopyServiced(Dt(A)\Data+src*size,Dt(Y)\Data+i*size,size)
  Next
EndProcedure

Procedure DExpandCore(Y.i,A.i,Shape.i,Consume.i)
  Protected Dim dims.i(8)
  Protected i.i=0
  Protected rank.i=Dt(Shape)\Count
  Protected size.i=DSize(Dt(A)\Kind)
  Protected ax.i=0,unchanged.i=1
  Protected width.i,step.i,row.i,source.i,x.i,destination.i,filled.i,take.i
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If rank>8 Or rank<Dt(A)\Rank
    DFail("Invalid Expand rank.")
    ProcedureReturn
  EndIf
  For i=0 To rank-1
    dims(i)=DInt(Shape,i)
    ax=i-rank+Dt(A)\Rank
    If ax>=0
      If dims(i)=1
        dims(i)=DDims((A)*8+(ax))
      EndIf
      If dims(i)<>DDims(A*8+ax) : unchanged=0 : EndIf
      If dims(i)<>DDims((A)*8+(ax)) And DDims((A)*8+(ax))<>1
        DFail("Invalid Expand extent.")
        ProcedureReturn
      EndIf
    Else
      If dims(i)<>1 : unchanged=0 : EndIf
    EndIf
  Next
  If Consume And unchanged
    If DConsumeShape(Y,A,rank,@dims(0)) : ProcedureReturn : EndIf
  EndIf
  If DAllocCore(Y,Dt(A)\Kind,rank,@dims(0),Bool(Y=A))=0
    ProcedureReturn
  EndIf
  If Dt(Y)\Count=0 : ProcedureReturn : EndIf
  If Dt(A)\Count=Dt(Y)\Count
    DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(Y)\Bytes) : ProcedureReturn
  EndIf
  width=1 : If rank : width=dims(rank-1) : EndIf
  step=0
  If Dt(A)\Rank : step=Bool(DDims(A*8+Dt(A)\Rank-1)<>1) : EndIf
  For row=0 To Dt(Y)\Count/width-1
    source=Dt(A)\Data+DBroadcastIndex(row*width,Y,A)*size
    If step
      DCopyServiced(source,Dt(Y)\Data+row*width*size,width*size)
    Else
      destination=Dt(Y)\Data+row*width*size
      DCopyServiced(source,destination,size)
      filled=1
      While filled<width
        take=DMin(filled,width-filled)
        DCopyServiced(destination,destination+filled*size,take*size)
        filled+take
      Wend
    EndIf
    PmKernelIdle()
  Next
EndProcedure
Procedure DExpand(Y.i,A.i,Shape.i)
 DExpandCore(Y,A,Shape,0)
EndProcedure
Procedure DExpandConsume(Y.i,A.i,Shape.i)
 DExpandCore(Y,A,Shape,1)
EndProcedure


Procedure DConstantShape(Y.i,Shape.i,Kind.i,Value.f)
  Protected Dim dims.i(8)
  Protected i.i=0
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Dt(Shape)\Count>8
    DFail("ConstantOfShape rank exceeds eight.")
    ProcedureReturn
  EndIf
  For i=0 To Dt(Shape)\Count-1
    dims(i)=DInt(Shape,i)
  Next
  If DAlloc(Y,Kind,Dt(Shape)\Count,@dims(0))
    ; DAlloc already wrote positive zero to every output byte.
    If PeekL(@Value)=0 : ProcedureReturn : EndIf
    For i=0 To Dt(Y)\Count-1
      DPut(Y,i,Value)
    Next
  EndIf
EndProcedure

Procedure DRange(Y.i,A.i,B.i,C.i)
  Protected first.i=0
  Protected final.i=0
  Protected stepInteger.i=0
  Protected distance.i=0
  Protected quotient.i=0
  Protected lastValue.i=0
  Protected start.f=DGet(A,0)
  Protected stop.f=DGet(B,0)
  Protected stepv.f=DGet(C,0)
  Protected n.i=0
  Protected i.i=0
  Protected extent.f=0.0
  If PmTensorIsNan(start) <> 0 Or PmTensorIsNan(stop) <> 0 Or PmTensorIsNan(stepv) <> 0
    DFail("Range start, limit and delta must be numbers; a NaN gives no element count.")
    ProcedureReturn
  EndIf
  If Dt(A)\Kind<>Dt(B)\Kind Or Dt(A)\Kind<>Dt(C)\Kind Or Dt(A)\Count<>1 Or Dt(B)\Count<>1 Or Dt(C)\Count<>1
    DFail("Range requires three scalars of the same type.")
    ProcedureReturn
  EndIf
  If Dt(A)\Kind<>1
    first=DInt(A,0)
    final=DInt(B,0)
    stepInteger=DInt(C,0)
    If stepInteger=0
      DFail("Integer Range step is zero.")
      ProcedureReturn
    EndIf
    n=0
    If stepInteger>0 And first<final
      distance=DIntegerOp(final,first,1)
      quotient=distance/stepInteger
      n=quotient
      If distance%stepInteger<>0
        n=n+1
      EndIf
    ElseIf stepInteger<0 And first>final
      distance=DIntegerOp(first,final,1)
      stepInteger=DIntegerOp(0,stepInteger,1)
      If DError<>0
        ProcedureReturn
      EndIf
      n=distance/stepInteger
      If distance%stepInteger<>0
        n=n+1
      EndIf
      stepInteger=-stepInteger
    EndIf
    If DError<>0
      ProcedureReturn
    EndIf
    If DShape(Y,Dt(A)\Kind,1,n,0,0,0)=0
      ProcedureReturn
    EndIf
    lastValue=first
    For i=0 To n-1
      If Dt(A)\Kind=7
        DWriteI64(Dt(Y)\Data+i*8,lastValue)
      Else
        PokeL(Dt(Y)\Data+i*4,lastValue)
      EndIf
      If i<n-1
        lastValue=DIntegerOp(lastValue,stepInteger,0)
      EndIf
    Next
    ProcedureReturn
  EndIf
  If stepv=0
    DFail("Range step is zero.")
    ProcedureReturn
  EndIf
  extent=(stop-start)/stepv
  If (PeekL(@extent) & $7F800000)=$7F800000 Or extent>DFloat(DLimit/DSize(Dt(A)\Kind))
    DFail("Range exceeds finite memory bounds.")
    ProcedureReturn
  EndIf
  n=Int(extent)
  If DFloat(n)<extent
    n=n+1
  EndIf
  n=DMax(0,n)
  If DShape(Y,Dt(A)\Kind,1,n,0,0,0)
    For i=0 To n-1
      DPut(Y,i,start+DFloat(i)*stepv)
    Next
  EndIf
EndProcedure

Procedure DWhere(Y.i,Cond.i,A.i,B.i)
  Protected width.i,row.i,j.i,vector.i
  Protected ci.i
  Protected ap.i
  Protected bp.i
  Protected cp.i
  Protected dp.i
  Protected astep.i
  Protected bstep.i
  Protected cstep.i
  Protected i.i=0
  Protected src.i=0
  Protected index.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  Protected rank.i=DMax(DMax(Dt(A)\Rank,Dt(B)\Rank),Dt(Cond)\Rank)
  Protected k.i=0
  Protected t.i=0
  Protected d.i=0
  Protected e.i=0
  Protected Dim dims.i(8)
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  ; The condition, X and Y broadcast together (Where-16).
  For i=0 To rank-1
    e=1
    For k=0 To 2
      t=B
      If k=0
        t=Cond
      ElseIf k=1
        t=A
      EndIf
      d=1
      If i-rank+Dt(t)\Rank>=0
        d=DDims((t)*8+(i-rank+Dt(t)\Rank))
      EndIf
      If d<>1
        If e<>1 And e<>d
          DFail("Incompatible broadcast dimensions.")
          ProcedureReturn
        EndIf
        e=d
      EndIf
    Next
    dims(i)=e
  Next
  If DAllocOverwrite(Y,Dt(A)\Kind,rank,@dims(0))=0
    ProcedureReturn
  EndIf
  If Dt(Cond)\Kind=9 And (Dt(Cond)\Count=1 Or Dt(Cond)\Count=Dt(Y)\Count) And (Dt(A)\Count=1 Or Dt(A)\Count=Dt(Y)\Count) And (Dt(B)\Count=1 Or Dt(B)\Count=Dt(Y)\Count)
    ap=Dt(A)\Data : bp=Dt(B)\Data : cp=Dt(Cond)\Data : dp=Dt(Y)\Data
    astep=Bool(Dt(A)\Count<>1)*size
    bstep=Bool(Dt(B)\Count<>1)*size
    cstep=Bool(Dt(Cond)\Count<>1)
    CompilerIf #PMD_NATIVE_BYTES=8
    If size=4 And ((ap | bp | dp) & 15)=0 And ((cp & 3)=0 Or cstep=0)
      PmTensorWhereWordsNeon(ap,bp,cp,dp,Dt(Y)\Count,astep,bstep,cstep)
      ProcedureReturn
    EndIf
    CompilerEndIf
    For i=0 To Dt(Y)\Count-1
      src=bp
      If PeekA(cp)<>0 : src=ap : EndIf
      If size=4
        PokeL(dp,PeekL(src))
      Else
        DCopyServiced(src,dp,size)
      EndIf
      ap+astep : bp+bstep : cp+cstep : dp+size
    Next
    ProcedureReturn
  EndIf
  If size=4 And Dt(Cond)\Kind=9 And rank>0
    width=dims(rank-1)
    If width=0 : ProcedureReturn : EndIf
    astep=0 : bstep=0 : cstep=0
    If Dt(A)\Rank>0
      If DDims(A*8+Dt(A)\Rank-1)>1 : astep=4 : EndIf
    EndIf
    If Dt(B)\Rank>0
      If DDims(B*8+Dt(B)\Rank-1)>1 : bstep=4 : EndIf
    EndIf
    If Dt(Cond)\Rank>0
      If DDims(Cond*8+Dt(Cond)\Rank-1)>1 : cstep=1 : EndIf
    EndIf
    For row=0 To Dt(Y)\Count/width-1
      i=row*width
      ap=Dt(A)\Data+DBroadcastIndex(i,Y,A)*4
      bp=Dt(B)\Data+DBroadcastIndex(i,Y,B)*4
      cp=Dt(Cond)\Data+DBroadcastIndex(i,Y,Cond)
      dp=Dt(Y)\Data+i*4
      src=0
      If cstep=0
        If PeekA(cp)<>0
          If astep=4 : src=ap : EndIf
        Else
          If bstep=4 : src=bp : EndIf
        EndIf
      EndIf
      If src<>0
        DCopyServiced(src,dp,width*4)
      Else
        vector=0
        CompilerIf #PMD_NATIVE_BYTES=8
        If ((ap | bp | dp) & 15)=0 And ((cp & 3)=0 Or cstep=0)
          PmTensorWhereWordsNeon(ap,bp,cp,dp,width,astep,bstep,cstep)
          vector=1
        EndIf
        CompilerEndIf
        If vector=0
          For j=0 To width-1
            src=bp : If PeekA(cp)<>0 : src=ap : EndIf
            PokeL(dp,PeekL(src))
            ap=ap+astep : bp=bp+bstep : cp=cp+cstep : dp=dp+4
          Next
        EndIf
      EndIf
    Next
    ProcedureReturn
  EndIf
  For i=0 To Dt(Y)\Count-1
    If DGet(Cond,DBroadcastIndex(i,Y,Cond))
      src=A
    Else
      src=B
    EndIf
    index=DBroadcastIndex(i,Y,src)
    DCopyServiced(Dt(src)\Data+index*size,Dt(Y)\Data+i*size,size)
  Next
EndProcedure


; An element other than zero; a NaN is one (forum 998).
Procedure.i DNonZeroAt(A.i,i.i)
  If Dt(A)\Kind=1
    If (PeekL(Dt(A)\Data+i*4) & $7FFFFFFF)<>0
      ProcedureReturn 1
    EndIf
    ProcedureReturn 0
  EndIf
  If DGet(A,i)<>0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

Procedure DNonZero(Y.i,A.i)
  Protected i.i=0
  Protected j.i=0
  Protected count.i=0
  Protected n.i=0
  Protected col.i=0
  Protected c.i=0
  For i=0 To Dt(A)\Count-1
    If DNonZeroAt(A,i)
      count+1
    EndIf
  Next
  If DShape(Y,7,2,Dt(A)\Rank,count,0,0)=0
    ProcedureReturn
  EndIf
  For i=0 To Dt(A)\Count-1
    If DNonZeroAt(A,i)
      n=i
      For j=Dt(A)\Rank-1 To 0 Step -1
        c=n % DDims((A)*8+(j))
        n/DDims((A)*8+(j))
        DWriteI64(Dt(Y)\Data+(j*count+col)*8,c)
      Next
      col+1
    EndIf
  Next
EndProcedure

Procedure DScatterCore(Y.i,A.i,Indices.i,Updates.i,Consume.i)
  Protected k.i=0
  Protected i.i=0
  Protected j.i=0
  Protected offset.i=0
  Protected idx.i=0
  Protected block.i=0
  Protected size.i=DSize(Dt(A)\Kind)
  Protected tuples.i=0,taken.i=0
  If Dt(Indices)\Rank<1
    DFail("ScatterND indices need a tuple axis.")
    ProcedureReturn
  EndIf
  k=DDims((Indices)*8+(Dt(Indices)\Rank-1))
  If k<=0 Or k>Dt(A)\Rank
    DFail("Invalid ScatterND tuple width.")
    ProcedureReturn
  EndIf
  block=DProduct(A,k,Dt(A)\Rank-1)
  tuples=Dt(Indices)\Count/k
  If Dt(Updates)\Count<>tuples*block
    DFail("ScatterND update count mismatch.")
    ProcedureReturn
  EndIf
  If Consume And Y<>A And Y<>Indices And Y<>Updates And A<>Indices And A<>Updates
    If DSpansOverlap(Dt(A)\Data,Dt(A)\Bytes,Dt(Indices)\Data,Dt(Indices)\Bytes)=0 And DSpansOverlap(Dt(A)\Data,Dt(A)\Bytes,Dt(Updates)\Data,Dt(Updates)\Bytes)=0
      taken=DConsumeShape(Y,A,Dt(A)\Rank,@DDims(A*8))
    EndIf
  EndIf
  If taken=0
  If Y=A Or Y=Indices Or Y=Updates
    If DLike(Y,A,0)=0 : ProcedureReturn : EndIf
  Else
    ; The following source copy overwrites every destination byte.
    If DLikeOverwrite(Y,A,0)=0 : ProcedureReturn : EndIf
  EndIf
  DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Bytes)
  EndIf
  For i=0 To tuples-1
    offset=0
    For j=0 To k-1
      idx=DInt(Indices,i*k+j)
      If idx<0
        idx+DDims((A)*8+(j))
      EndIf
      If idx<0 Or idx>=DDims((A)*8+(j))
        DFail("ScatterND index is out of bounds.")
        ProcedureReturn
      EndIf
      offset=offset*DDims((A)*8+(j))+idx
    Next
    DCopyServiced(Dt(Updates)\Data+i*block*size,Dt(Y)\Data+offset*block*size,block*size)
  Next
EndProcedure

Procedure DScatter(Y.i,A.i,Indices.i,Updates.i)
 DScatterCore(Y,A,Indices,Updates,0)
EndProcedure
Procedure DScatterConsume(Y.i,A.i,Indices.i,Updates.i)
 DScatterCore(Y,A,Indices,Updates,1)
EndProcedure

Procedure.i DMatMulInt8(*g.PmI8MatMulArgs)
  Protected parts.i=1
  Protected columns.i=0
  Protected bytesPerPart.i
  Protected bytes.i
  Protected ok.i
  CompilerIf #PMD_NATIVE_BYTES=8
  ; Tall projections with only one output column still split by independent
  ; activation rows. Each worker retains private quantization scratch.
  If *g\M>=32 And *g\N>=1 And *g\M* *g\K* *g\N>=65536
    parts=PmParallelCores()
    If parts>4 : parts=4 : EndIf
  EndIf
  If *g\M>=1 And *g\M<32 And *g\N>=64 And *g\M* *g\K* *g\N>=65536
    columns=1 : parts=PmParallelCores()
    If parts<1 : parts=1 : EndIf
    If parts>4 : parts=4 : EndIf
  EndIf
  CompilerEndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  If *g\M>=32 And *g\M<=128 And *g\N>=64 And *g\K* *g\N>=1048576
    If PmI8PackFind(*g\B,*g\K,*g\N,*g\Wide)<>0
      columns=1 : parts=PmParallelCores() : If parts>4 : parts=4 : EndIf
    EndIf
  EndIf
  CompilerEndIf
  bytes=PmI8ScratchBytes(*g\M* *g\K,*g\M,*g\Wide)
  If parts>1
    bytesPerPart=PmI8ScratchBytes(((*g\M+parts-1)/parts+4)* *g\K,(*g\M+parts-1)/parts+4,*g\Wide)
    If columns : bytesPerPart=PmI8ScratchBytes(*g\M* *g\K,*g\M,*g\Wide) : EndIf
    bytes=bytesPerPart*parts
  EndIf
  If columns And bytes>DLimit-DLive
    columns=0 : parts=1 : bytes=PmI8ScratchBytes(*g\M* *g\K,*g\M,*g\Wide)
  EndIf
  If DInt8Begin(bytes)=0 : ProcedureReturn 0 : EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
    If columns
      ok=PmI8MatMulColumnsParallelNeon(*g,parts,bytesPerPart)
    Else
      ok=PmI8MatMulParallelNeon(*g,parts,bytesPerPart)
    EndIf
  CompilerElse
    ok=PmI8MatMul(*g)
  CompilerEndIf
  If ok=0 And PmTensorInt8Fault=0 : PmTensorInt8Fault=2 : EndIf
  ProcedureReturn DInt8End()
EndProcedure

; Equal, contiguous FLOAT batches can share one four-core job. Each worker
; owns its packing scratch and uses the existing exact reduction kernel.
; Broadcast shapes and INT8 weights retain their original dispatch.
CompilerIf #PMD_NATIVE_BYTES=8
Global Dim PmGemmBatchParts.i[36]
Procedure.i PmGemmBatchWorker(*p.i)
  Protected a.i=PeekI(*p),b.i=PeekI(*p+8),dst.i=PeekI(*p+16)
  Protected m.i=PeekI(*p+24),k.i=PeekI(*p+32),n.i=PeekI(*p+40)
  Protected first.i=PeekI(*p+48),last.i=PeekI(*p+56),pack.i=PeekI(*p+64)
  While first<last
    PmTensorMatMul2ExactPackedNeon(a+first*m*k*4,b+first*k*n*4,dst+first*m*n*4,m,k,n,pack)
    first+1
  Wend
  ProcedureReturn 0
EndProcedure
CompilerEndIf
Procedure.i PmFastGemmBatches(a.i,b.i,dst.i,m.i,k.i,n.i,batches.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected parts.i,bytes.i,pack.i,i.i,first.i=0,last.i,at.i,status.i
  If batches<4 Or m<1 Or k<1 Or n<16 Or m*k*n*batches<65536 : ProcedureReturn 0 : EndIf
  parts=PmParallelCores() : If parts>4 : parts=4 : EndIf
  If parts<2 : ProcedureReturn 0 : EndIf
  If k>(DLimit-DLive)/64/parts : ProcedureReturn 0 : EndIf
  bytes=k*64*parts
  pack=DAcquire(bytes) : If pack=0 : ProcedureReturn 0 : EndIf
  DLive=DLive+bytes : DPeak=DMax(DPeak,DLive)
  For i=0 To parts-1
    last=batches*(i+1)/parts : at=i*9
    PmGemmBatchParts[at]=a : PmGemmBatchParts[at+1]=b : PmGemmBatchParts[at+2]=dst
    PmGemmBatchParts[at+3]=m : PmGemmBatchParts[at+4]=k : PmGemmBatchParts[at+5]=n
    PmGemmBatchParts[at+6]=first : PmGemmBatchParts[at+7]=last
    PmGemmBatchParts[at+8]=pack+i*k*64
    first=last
  Next
  status=pmSvcParRun(@PmGemmBatchWorker,@PmGemmBatchParts[0],72,parts)
  DFree(pack) : DLive=DLive-bytes
  ProcedureReturn Bool(status=#PMP_SVC_OK)
  CompilerElse
  ProcedureReturn 0
  CompilerEndIf
EndProcedure

Procedure DMatMul(Y.i,A.i,B.i)
  Protected Dim dims.i(8)
  Protected rank.i=DMax(Dt(A)\Rank,Dt(B)\Rank)
  Protected i.i=0
  Protected ai.i=0
  Protected bi.i=0
  Protected ad.i=0
  Protected bd.i=0
  Protected m.i=0
  Protected k.i=0
  Protected n.i=0
  Protected batches.i=0
  Protected batch.i=0
  Protected aoff.i=0
  Protected boff.i=0
  Protected idx.i=0
  Protected c.i=0
  Protected astride.i=0
  Protected bstride.i=0
  Protected flatBatch.i=Bool(Dt(A)\Rank=rank And Dt(B)\Rank=rank)
  Protected mm.PmI8MatMulArgs
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Dt(A)\Kind<>1 Or (Dt(B)\Kind<>1 And Dt(B)\Kind<>3 And Dt(B)\Kind<>33)
    DFail("MatMul requires FLOAT activations and FLOAT or INT8 weights.")
    ProcedureReturn
  EndIf
  If Dt(A)\Rank<2 Or Dt(B)\Rank<2 Or rank>8
    DFail("MatMul requires rank two or above.")
    ProcedureReturn
  EndIf
  m=DDims((A)*8+(Dt(A)\Rank-2))
  k=DDims((A)*8+(Dt(A)\Rank-1))
  n=DDims((B)*8+(Dt(B)\Rank-1))
  If k<>DDims((B)*8+(Dt(B)\Rank-2))
    DFail("MatMul contraction mismatch.")
    ProcedureReturn
  EndIf
  If Dt(B)\Kind=3 And (Dt(B)\Scales=0 Or k>133144)
    DFail("INT8 MatMul scales are missing or its reduction exceeds the INT32 bound.")
    ProcedureReturn
  EndIf
  If Dt(B)\Kind=33 And Dt(B)\Scales=0
    DFail("Wide INT8 MatMul scales are missing.")
    ProcedureReturn
  EndIf
  batches=1
  For i=0 To rank-3
    ai=i-rank+Dt(A)\Rank
    bi=i-rank+Dt(B)\Rank
    ad=1
    bd=1
    If ai>=0
      ad=DDims((A)*8+(ai))
    EndIf
    If bi>=0
      bd=DDims((B)*8+(bi))
    EndIf
    If ad<>bd And ad<>1 And bd<>1
      DFail("MatMul batch mismatch.")
      ProcedureReturn
    EndIf
    If ad<>bd : flatBatch=0 : EndIf
    dims(i)=DMax(ad,bd)
    batches*dims(i)
  Next
  dims(rank-2)=m
  dims(rank-1)=n
  If DAllocCore(Y,1,rank,@dims(0),Bool(k=0))=0
    ProcedureReturn
  EndIf
  If Dt(B)\Kind=1 And flatBatch
    If PmFastGemmBatches(Dt(A)\Data,Dt(B)\Data,Dt(Y)\Data,m,k,n,batches) : ProcedureReturn : EndIf
  EndIf
  For batch=0 To batches-1
    idx=batch
    aoff=0
    boff=0
    astride=m*k
    bstride=k*n
    For i=rank-3 To 0 Step -1
      c=idx % dims(i)
      idx/dims(i)
      ai=i-rank+Dt(A)\Rank
      bi=i-rank+Dt(B)\Rank
      If ai>=0
        If DDims((A)*8+(ai))<>1
          aoff+c*astride
        EndIf
        astride*DDims((A)*8+(ai))
      EndIf
      If bi>=0
        If DDims((B)*8+(bi))<>1
          boff+c*bstride
        EndIf
        bstride*DDims((B)*8+(bi))
      EndIf
    Next
    If Dt(B)\Kind=3 Or Dt(B)\Kind=33
      mm\Wide=Bool(Dt(B)\Kind=33)
      mm\A=Dt(A)\Data+aoff*4 : mm\B=Dt(B)\Data+boff : mm\Dst=Dt(Y)\Data+batch*m*n*4
      mm\M=m : mm\K=k : mm\N=n : mm\Scales=Dt(B)\Scales : mm\Elements=Dt(B)\Count
      If DMatMulInt8(@mm)=0
        ProcedureReturn
      EndIf
    Else
      PmFastGemm(Dt(A)\Data+aoff*4,Dt(B)\Data+boff*4,Dt(Y)\Data+batch*m*n*4,m,k,n)
    EndIf
  Next
EndProcedure

CompilerIf #PMD_NATIVE_BYTES=8
; MatMul of B transposed from [batch,K,head,N] to [batch,head,K,N].
; B's original row stride feeds the unchanged exact column kernels directly.
Global Dim PmInterleavedHeadParts.i[52]
Procedure PmInterleavedHeadRange(a.i,b.i,dst.i,ab.i,ah.i,bb.i,bh.i,m.i,k.i,n.i,outHeads.i,first.i,last.i)
 Protected job.i,batch.i,head.i,aa.i,ba.i,ap.i,bp.i,dp.i,row.i,col.i,lane.i
 Protected tile.PmTensorMatMul2ExactArgs
 tile\Count=k : tile\ARowBytes=k*4 : tile\BRowBytes=bh*n*4 : tile\DstRowBytes=n*4
 For job=first To last-1
  batch=job/outHeads : head=job % outHeads : aa=0 : ba=0
  If ab<>1 : aa=batch*ah*m*k : EndIf
  If ah<>1 : aa+head*m*k : EndIf
  If bb<>1 : ba=batch*k*bh*n : EndIf
  If bh<>1 : ba+head*n : EndIf
  ap=a+aa*4 : bp=b+ba*4 : dp=dst+job*m*n*4
    row=0
    While row<m
     col=0
     While col<n
      tile\A=ap+row*k*4 : tile\B=bp+col*4 : tile\Dst=dp+(row*n+col)*4
      If m-row>=4
       If n-col>=16
        PmTensorMatMul2ExactFourBySixteen(@tile) : col+16
       ElseIf n-col>=4
        PmTensorMatMul2ExactFourByFour(@tile) : col+4
       Else
        For lane=0 To 3
         tile\A=ap+(row+lane)*k*4 : tile\Dst=dp+((row+lane)*n+col)*4
         PmTensorMatMul2ExactOneByOne(@tile)
        Next
        col+1
       EndIf
      Else
       If n-col>=64
        PmTensorMatMul2ExactOneBySixtyFour(@tile) : col+64
       ElseIf n-col>=16
        PmTensorMatMul2ExactOneBySixteen(@tile) : col+16
       ElseIf n-col>=4
        PmTensorMatMul2ExactOneByFour(@tile) : col+4
       Else
        PmTensorMatMul2ExactOneByOne(@tile) : col+1
       EndIf
      EndIf
      PmKernelIdle()
     Wend
     If m-row>=4 : row+4 : Else : row+1 : EndIf
    Wend
 Next
EndProcedure
Procedure.i PmInterleavedHeadWorker(p.i)
 PmInterleavedHeadRange(PeekI(p),PeekI(p+8),PeekI(p+16),PeekI(p+24),PeekI(p+32),PeekI(p+40),PeekI(p+48),PeekI(p+56),PeekI(p+64),PeekI(p+72),PeekI(p+80),PeekI(p+88),PeekI(p+96))
 ProcedureReturn 0
EndProcedure

Procedure DMatMulInterleavedHeads(Y.i,T.i,A.i,B.i,Perm.i,transposeNode.i,releaseB.i)
 Protected Dim dims.i(8)
 Protected eligible.i=1,i.i,batch.i,head.i,ab.i,ah.i,bb.i,bh.i,k.i,n.i,col.i,m.i,row.i,lane.i,parts.i=1,totalJobs.i,first.i,last.i,at.i,status.i
 Protected aa.i,ba.i,ap.i,bp.i,dp.i,matmulNode.i=DNode
 Protected tile.PmTensorMatMul2ExactArgs
 If DError Or DCancel Or Dt(A)\Kind<>1 Or Dt(B)\Kind<>1 Or Dt(A)\Rank<>4 Or Dt(B)\Rank<>4 : eligible=0 : EndIf
 If eligible
  If DListCount(Perm)<>4 Or DListValue(Perm,1)<>0 Or DListValue(Perm,2)<>2 Or DListValue(Perm,3)<>1 Or DListValue(Perm,4)<>3 : eligible=0 : EndIf
  ab=DDims(A*8) : ah=DDims(A*8+1) : bb=DDims(B*8) : bh=DDims(B*8+2)
  k=DDims(B*8+1) : n=DDims(B*8+3) : m=DDims(A*8+2)
  If m<1 Or m>32 Or DDims(A*8+3)<>k Or k<0 Or k>4096 Or n<1 Or n>4096 Or ab<1 Or ah<1 Or bb<1 Or bh<1 Or ab>4096 Or ah>4096 Or bb>4096 Or bh>4096 : eligible=0 : EndIf
  If ab<>bb And ab<>1 And bb<>1 : eligible=0 : EndIf
  If ah<>bh And ah<>1 And bh<>1 : eligible=0 : EndIf
  totalJobs=DMax(ab,bb)*DMax(ah,bh)
  If totalJobs>256 Or m*k*n>1048576 Or m*k*n*totalJobs>8388608 : eligible=0 : EndIf
 EndIf
 If eligible
  dims(0)=DMax(ab,bb) : dims(1)=DMax(ah,bh) : dims(2)=m : dims(3)=n
  If DAllocCore(Y,1,4,@dims(0),Bool(k=0))=0 : ProcedureReturn : EndIf
  If m*k*n*totalJobs>=65536
    parts=PmParallelCores() : If parts>4 : parts=4 : EndIf
    If parts>totalJobs : parts=totalJobs : EndIf
  EndIf
  status=-1
  If parts>1
   first=0
   For i=0 To parts-1
    last=totalJobs*(i+1)/parts : at=i*13
    PmInterleavedHeadParts[at]=Dt(A)\Data : PmInterleavedHeadParts[at+1]=Dt(B)\Data : PmInterleavedHeadParts[at+2]=Dt(Y)\Data
    PmInterleavedHeadParts[at+3]=ab : PmInterleavedHeadParts[at+4]=ah : PmInterleavedHeadParts[at+5]=bb : PmInterleavedHeadParts[at+6]=bh
    PmInterleavedHeadParts[at+7]=m : PmInterleavedHeadParts[at+8]=k : PmInterleavedHeadParts[at+9]=n : PmInterleavedHeadParts[at+10]=dims(1)
    PmInterleavedHeadParts[at+11]=first : PmInterleavedHeadParts[at+12]=last : first=last
   Next
   status=pmSvcParRun(@PmInterleavedHeadWorker,@PmInterleavedHeadParts[0],104,parts)
  EndIf
  If status<>#PMP_SVC_OK
   PmInterleavedHeadRange(Dt(A)\Data,Dt(B)\Data,Dt(Y)\Data,ab,ah,bb,bh,m,k,n,dims(1),0,totalJobs)
  EndIf
  If releaseB : DRelease(B) : EndIf
 Else
  DNode=transposeNode : DTranspose(T,B,Perm)
  If DError : ProcedureReturn : EndIf
  If releaseB : DRelease(B) : EndIf
  DNode=matmulNode : DMatMul(Y,A,T)
 EndIf
EndProcedure


CompilerEndIf

Procedure DGemm(Y.i,A.i,B.i,C.i,TransA.i,TransB.i,Alpha.f,Beta.f)
  Protected g.PmTensorGemmArgs
  Protected scratch.i,bytes.i,bptr.i,at.i,ci.i,sum.f,bias.f
  DZero(@g,SizeOf(PmTensorGemmArgs))
  If Dt(A)\Kind<>1 Or (Dt(B)\Kind<>1 And Dt(B)\Kind<>3 And Dt(B)\Kind<>33) Or (C<>0 And Dt(C)\Kind<>1) Or TransA<0 Or TransA>1 Or TransB<0 Or TransB>1
    DFail("Gemm requires FLOAT activations, FLOAT/INT8 weights and valid transpose flags.")
    ProcedureReturn
  EndIf
  If Dt(A)\Rank<>2 Or Dt(B)\Rank<>2
    DFail("Gemm requires matrices.")
    ProcedureReturn
  EndIf
  g\M=DDims((A)*8+(TransA))
  g\K=DDims((A)*8+(1-TransA))
  g\N=DDims((B)*8+(1-TransB))
  If g\K<>DDims((B)*8+(TransB))
    DFail("Gemm contraction mismatch.")
    ProcedureReturn
  EndIf
  If DShape(Y,1,2,g\M,g\N,0,0)=0
    ProcedureReturn
  EndIf
  g\A=Dt(A)\Data
  g\B=Dt(B)\Data
  g\C=Dt(C)\Data
  g\Dst=Dt(Y)\Data
  g\CCount=Dt(C)\Count
  g\TransA=TransA
  g\TransB=TransB
  g\Alpha=Alpha
  g\Beta=Beta
  If Dt(B)\Kind=3 Or Dt(B)\Kind=33
    If Dt(B)\Scales=0 Or (Dt(B)\Kind=3 And g\K>133144)
      DFail("INT8 Gemm scales are missing or its reduction exceeds the INT32 bound.")
      ProcedureReturn
    EndIf
    g\Wide=Bool(Dt(B)\Kind=33)
    If DInt8Begin(PmI8ScratchBytes(g\M*g\K,g\M,g\Wide))=0
      ProcedureReturn
    EndIf
    g\WeightScales=Dt(B)\Scales
  EndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  If Dt(B)\Kind=1 And (TransA=0 Or g\M=1) And g\K>0 And g\N>=16 And g\M*g\K*g\N>=1024 And (g\CCount=0 Or g\CCount=1 Or g\CCount=g\N Or g\CCount=g\M*g\N)
    bptr=g\B
    If TransB
      bytes=g\K*g\N*4
      If bytes<=DLimit-DLive : scratch=DAcquire(bytes) : EndIf
      If scratch
        DLive+bytes : DPeak=DMax(DPeak,DLive)
        PmTransposeMatrixWords(g\B,scratch,g\N,g\K)
        bptr=scratch
      EndIf
    EndIf
    If TransB=0 Or scratch
      PmFastGemm(g\A,bptr,g\Dst,g\M,g\K,g\N)
      If scratch : DFree(scratch) : DLive-bytes : EndIf
      For at=0 To g\M*g\N-1
        sum=DReadF(g\Dst+at*4)
        sum=sum*g\Alpha
        If g\C And g\CCount>0
          ci=at
          If g\CCount=1 : ci=0 : ElseIf g\CCount=g\N : ci=at % g\N : EndIf
          bias=g\Beta*DReadF(g\C+ci*4)
          sum=sum+bias
        EndIf
        DWriteF(g\Dst+at*4,sum)
        If (at & 255)=255 : PmKernelIdle() : EndIf
      Next
      ProcedureReturn
    EndIf
  EndIf
  CompilerEndIf
  PmTensorGemm(@g)
  If Dt(B)\Kind=3 Or Dt(B)\Kind=33
    DInt8End()
  EndIf
EndProcedure

; ReduceSum and ReduceMean over any set of axes (absent or empty axes: all
; of them): every output sums its elements in row-major order, the mean
; divides that sum once by the count. The one-final-axis form keeps the fast
; kernel below.
Procedure DReduceAxes(Y.i,A.i,Axes.i,Keep.i,Mean.i)
  Protected Dim dims.i(8)
  Protected Dim stride.i(8)
  Protected i.i=0
  Protected j.i=0
  Protected d.i=0
  Protected rank.i=Dt(A)\Rank
  Protected axis.i=0
  Protected mask.i=0
  Protected count.i=0
  Protected outCount.i=1
  Protected inner.i=1
  Protected n.i=1
  Protected base.i=0
  Protected at.i=0
  Protected coord.i=0
  Protected acc.f=0.0
  Protected x.f=0.0
  Protected cf.f=0.0
  Protected integerAcc.i=0
  Protected integerValue.i=0
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Dt(A)\Kind<>1 And (Mean<>0 Or (Dt(A)\Kind<>6 And Dt(A)\Kind<>7))
    DFail("Reduction requires FLOAT, or an INT32/INT64 tensor for ReduceSum.")
    ProcedureReturn
  EndIf
  If Axes
    count=Dt(Axes)\Count
  EndIf
  For i=0 To count-1
    axis=DInt(Axes,i)
    If axis<0
      axis=axis+rank
    EndIf
    If axis<0 Or axis>=rank
      DFail("A reduction axis is outside the data rank.")
      ProcedureReturn
    EndIf
    If ((mask>>axis)&1)<>0
      DFail("Reduction axes name the same axis twice.")
      ProcedureReturn
    EndIf
    mask=mask|(1<<axis)
  Next
  If count=0
    mask=(1<<rank)-1
  EndIf
  n=1
  For d=rank-1 To 0 Step -1
    stride(d)=n
    n=n*DDims((A)*8+(d))
  Next
  j=0
  For d=0 To rank-1
    If ((mask>>d)&1)<>0
      inner=inner*DDims((A)*8+(d))
      If Keep
        dims(j)=1
        j=j+1
      EndIf
    Else
      dims(j)=DDims((A)*8+(d))
      j=j+1
      outCount=outCount*DDims((A)*8+(d))
    EndIf
  Next
  If DAlloc(Y,Dt(A)\Kind,j,@dims(0))=0
    ProcedureReturn
  EndIf
  cf=inner
  For i=0 To outCount-1
    base=0
    n=i
    For d=rank-1 To 0 Step -1
      If ((mask>>d)&1)=0
        coord=n%DDims((A)*8+(d))
        n=n/DDims((A)*8+(d))
        base=base+coord*stride(d)
      EndIf
    Next
    acc=0.0
    integerAcc=0
    For j=0 To inner-1
      at=base
      n=j
      For d=rank-1 To 0 Step -1
        If ((mask>>d)&1)<>0
          coord=n%DDims((A)*8+(d))
          n=n/DDims((A)*8+(d))
          at=at+coord*stride(d)
        EndIf
      Next
      If Dt(A)\Kind=1
        x=PmTensorGet(Dt(A)\Data,at)
        acc=acc+x
      Else
        integerValue=DInt(A,at)
        integerAcc=DIntegerOp(integerAcc,integerValue,0)
        If DError<>0 : ProcedureReturn : EndIf
      EndIf
    Next
    If Mean
      acc=acc/cf
    EndIf
    If Dt(A)\Kind=1
      PmTensorPut(Dt(Y)\Data,i,acc)
    ElseIf Dt(A)\Kind=7
      DWriteI64(Dt(Y)\Data+i*8,integerAcc)
    Else
      PokeL(Dt(Y)\Data+i*4,integerAcc)
    EndIf
  Next
EndProcedure

Procedure DReduce(Y.i,A.i,Axes.i,Keep.i,Mean.i)
  Protected Dim dims.i(8)
  Protected i.i=0
  Protected axis.i=0
  Protected rank.i=Dt(A)\Rank
  Protected width.i=0
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If Dt(A)\Kind<>1
    DReduceAxes(Y,A,Axes,Keep,Mean)
    ProcedureReturn
  EndIf
  If Axes=0
    DReduceAxes(Y,A,Axes,Keep,Mean)
    ProcedureReturn
  EndIf
  If Dt(Axes)\Count<>1
    DReduceAxes(Y,A,Axes,Keep,Mean)
    ProcedureReturn
  EndIf
  axis=DInt(Axes,0)
  If axis<0
    axis+rank
  EndIf
  If axis<>rank-1
    DReduceAxes(Y,A,Axes,Keep,Mean)
    ProcedureReturn
  EndIf
  For i=0 To rank-1
    dims(i)=DDims((A)*8+(i))
  Next
  width=dims(rank-1)
  If Keep
    dims(rank-1)=1
  Else
    rank-1
  EndIf
  If width<=0
    DFail("Reduction width is empty.")
    ProcedureReturn
  EndIf
  If DAlloc(Y,Dt(A)\Kind,rank,@dims(0))=0
    ProcedureReturn
  EndIf
  If Dt(A)\Kind<>1
    DFail("Reduction requires FLOAT.")
    ProcedureReturn
  EndIf
  PmFastReduce(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Count/width,width,Mean)
EndProcedure

; noop_with_empty_axes = 1: absent or empty axes copy the data unchanged.
Procedure DReduceNoopEmpty(Y.i,A.i,Axes.i,Keep.i,Mean.i)
  Protected empty.i=0
  If Axes=0
    empty=1
  ElseIf Dt(Axes)\Count=0
    empty=1
  EndIf
  If empty
    If DLike(Y,A,0)
      DCopyServiced(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Bytes)
    EndIf
    ProcedureReturn
  EndIf
  DReduce(Y,A,Axes,Keep,Mean)
EndProcedure

Procedure PmNormRowsRange(src.i,scale.i,bias.i,dst.i,rows.i,width.i,epsilon.f,op.i)
  If op=0
    CompilerIf #PMD_NATIVE_BYTES=8 And #PMO_USE_EXPLOG=1
    PmTensorSoftmaxExactA64(src,dst,rows,width)
    CompilerElse
    PmTensorSoftmaxLast(src,dst,rows,width)
    CompilerEndIf
  Else
    CompilerIf #PMD_NATIVE_BYTES=8
    Protected norm.PmTensorLayerNormArgs
    norm\Src=src : norm\Scale=scale : norm\Bias=bias : norm\Dst=dst
    norm\Mean=0 : norm\InvStdDev=0 : norm\Outer=rows : norm\Width=width : norm\Epsilon=epsilon
    PmTensorLayerNormExactNeon(@norm)
    CompilerElse
    PmTensorLayerNormLast(src,scale,bias,dst,rows,width,epsilon)
    CompilerEndIf
  EndIf
EndProcedure
CompilerIf #PMD_NATIVE_BYTES=8
Global Dim PmNormParts.i[32]
Procedure.i PmNormWorker(*p.i)
  PmNormRowsRange(PeekI(*p),PeekI(*p+8),PeekI(*p+16),PeekI(*p+24),PeekI(*p+32),PeekI(*p+40),DReadF(*p+48),PeekI(*p+56))
  ProcedureReturn 0
EndProcedure
CompilerEndIf
Procedure PmNormRows(src.i,scale.i,bias.i,dst.i,rows.i,width.i,epsilon.f,op.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected parts.i=1
  Protected i.i
  Protected first.i=0
  Protected last.i
  Protected at.i
  If rows>=8 And rows*width>=16384
    parts=PmParallelCores()
    If parts>4 : parts=4 : EndIf
  EndIf
  If parts>1
    For i=0 To parts-1
      last=rows*(i+1)/parts : at=i*8
      PmNormParts[at]=src+first*width*4 : PmNormParts[at+1]=scale : PmNormParts[at+2]=bias
      PmNormParts[at+3]=dst+first*width*4 : PmNormParts[at+4]=last-first : PmNormParts[at+5]=width
      DWriteF(@PmNormParts[at+6],epsilon) : PmNormParts[at+7]=op
      first=last
    Next
    If pmSvcParRun(@PmNormWorker,@PmNormParts[0],64,parts)=#PMP_SVC_OK : ProcedureReturn : EndIf
  EndIf
  CompilerEndIf
  PmNormRowsRange(src,scale,bias,dst,rows,width,epsilon,op)
EndProcedure

Procedure DSoftmax(Y.i,A.i,Axis.i)
  Protected width.i=0
  If Dt(A)\Rank<1 Or Dt(A)\Kind<>1
    DFail("Softmax requires a FLOAT tensor with an axis.")
    ProcedureReturn
  EndIf
  width=DDims((A)*8+(Dt(A)\Rank-1))
  If Axis<0
    Axis+Dt(A)\Rank
  EndIf
  If Axis<>Dt(A)\Rank-1 Or width<=0
    DFail("Softmax requires a nonempty final axis.")
    ProcedureReturn
  EndIf
  If DLikeOverwrite(Y,A,0)
    PmNormRows(Dt(A)\Data,0,0,Dt(Y)\Data,Dt(A)\Count/width,width,0.0,0)
  EndIf
EndProcedure

Procedure DLayerNorm(Y.i,A.i,Scale.i,Bias.i,Epsilon.f)
  Protected width.i=0
  If Dt(A)\Rank<1 Or Dt(A)\Kind<>1 Or Dt(Scale)\Kind<>1 Or (Bias<>0 And Dt(Bias)\Kind<>1)
    DFail("Layer normalization requires FLOAT tensors.")
    ProcedureReturn
  EndIf
  width=DDims((A)*8+(Dt(A)\Rank-1))
  If width<=0 Or Dt(Scale)\Count<>width
    DFail("Layer normalization width mismatch.")
    ProcedureReturn
  EndIf
  If Bias<>0 And Dt(Bias)\Count<>width
    DFail("Layer normalization bias width mismatch.")
    ProcedureReturn
  EndIf
  If DLikeOverwrite(Y,A,0)
    PmNormRows(Dt(A)\Data,Dt(Scale)\Data,Dt(Bias)\Data,Dt(Y)\Data,Dt(A)\Count/width,width,Epsilon,1)
  EndIf
EndProcedure

Procedure DCumSum(Y.i,A.i,AxisTensor.i,Exclusive.i,Reverse.i)
  Protected axis.i=DInt(AxisTensor,0)
  Protected outer.i=0
  Protected inner.i=0
  Protected width.i=0
  If Dt(A)\Kind<>1 And Dt(A)\Kind<>7
    DFail("CumSum requires FLOAT or INT64.")
    ProcedureReturn
  EndIf
  If axis<0
    axis+Dt(A)\Rank
  EndIf
  If axis<0 Or axis>=Dt(A)\Rank
    DFail("CumSum axis is invalid.")
    ProcedureReturn
  EndIf
  outer=DProduct(A,0,axis-1)
  inner=DProduct(A,axis+1,Dt(A)\Rank-1)
  width=DDims((A)*8+(axis))
  If DLike(Y,A,0)=0
    ProcedureReturn
  EndIf
  If Dt(A)\Kind=7
    PmTensorCumSumI64(Dt(A)\Data,Dt(Y)\Data,outer,width,inner,Exclusive,Reverse)
  Else
    PmTensorCumSumF32(Dt(A)\Data,Dt(Y)\Data,outer,width,inner,Exclusive,Reverse)
  EndIf
EndProcedure

Procedure DClip(Y.i,A.i,Lo.i,Hi.i)
  Protected low.f=-3.402823466e38
  Protected high.f=3.402823466e38
  If Dt(A)\Kind<>1
    DFail("Clip requires FLOAT input.")
    ProcedureReturn
  EndIf
  If Lo
    low=DGet(Lo,0)
  EndIf
  If Hi
    high=DGet(Hi,0)
  EndIf
  If DLike(Y,A,0)
    PmTensorClip(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Count,low,high)
  EndIf
EndProcedure

Procedure DConv()
  Protected allocated.i
  Protected Y.i=DCall(0)
  Protected A.i=DCall(1)
  Protected W.i=DCall(2)
  Protected B.i=DCall(3)
  Protected PadLeft.i=DCall(4)
  Protected PadRight.i=DCall(5)
  Protected Stride.i=DCall(6)
  Protected Dilation.i=DCall(7)
  Protected Groups.i=DCall(8)
  Protected g.PmTensorConv1DArgs
  DZero(@g,SizeOf(PmTensorConv1DArgs))
  If Dt(A)\Kind<>1 Or (Dt(W)\Kind<>1 And Dt(W)\Kind<>3 And Dt(W)\Kind<>33) Or (B<>0 And Dt(B)\Kind<>1)
    DFail("Conv requires FLOAT activations and FLOAT/INT8 weights.")
    ProcedureReturn
  EndIf
  If Dt(A)\Rank<>3 Or Dt(W)\Rank<>3 Or Stride<=0 Or Groups<=0
    DFail("Invalid Conv1D shape or attributes.")
    ProcedureReturn
  EndIf
  g\Batches=DDims((A)*8+(0))
  g\InChannels=DDims((A)*8+(1))
  g\InWidth=DDims((A)*8+(2))
  g\OutChannels=DDims((W)*8+(0))
  g\Kernel=DDims((W)*8+(2))
  g\OutWidth=(g\InWidth+PadLeft+PadRight-Dilation*(g\Kernel-1)-1)/Stride+1
  If g\InChannels<>DDims((W)*8+(1))*Groups Or (g\OutChannels % Groups)<>0
    DFail("Conv group/channel mismatch.")
    ProcedureReturn
  EndIf
  If B<>0 And Dt(B)\Count<>g\OutChannels
    DFail("Conv bias width mismatch.")
    ProcedureReturn
  EndIf
  If g\InChannels>0 And g\InWidth>0 And g\Kernel>0 And Dilation>0
    allocated=DShapeOverwrite(Y,1,3,g\Batches,g\OutChannels,g\OutWidth,0)
  Else
    allocated=DShape(Y,1,3,g\Batches,g\OutChannels,g\OutWidth,0)
  EndIf
  If allocated=0
    ProcedureReturn
  EndIf
  g\Src=Dt(A)\Data
  g\Weight=Dt(W)\Data
  g\Bias=Dt(B)\Data
  g\Dst=Dt(Y)\Data
  g\PadLeft=PadLeft
  g\Stride=Stride
  g\Dilation=Dilation
  g\Groups=Groups
  If Dt(W)\Kind=3 Or Dt(W)\Kind=33
    If Dt(W)\Scales=0 Or (Dt(W)\Kind=3 And g\InChannels/Groups*g\Kernel>133144)
      DFail("INT8 Conv scales are missing or its reduction exceeds the INT32 bound.")
      ProcedureReturn
    EndIf
    g\Wide=Bool(Dt(W)\Kind=33)
    If g\InChannels>0 And g\InWidth>0 And g\Kernel>0 And Dilation>0
      allocated=DInt8BeginOverwrite(PmI8ConvScratchBytes(@g))
    Else
      allocated=DInt8Begin(PmI8ConvScratchBytes(@g))
    EndIf
    If allocated=0
      ProcedureReturn
    EndIf
    g\WeightScales=Dt(W)\Scales
    CompilerIf #PMD_NATIVE_BYTES = 8
    PmTensorConv1DNeon(@g)
    CompilerElse
    PmTensorConv1D(@g)
    CompilerEndIf
    DInt8End()
  Else
    If PmFastConv(@g,DLimit-DLive)=0
      DFail("Convolution scratch exceeds available working memory.")
    EndIf
  EndIf
EndProcedure

; The compiler delays only a single-use intermediate whose lifetime ends at
; this Add. Exact-shape FLOAT residuals join the INT8 convolution epilogue;
; every unsupported case executes the original two operators. Inputs whose
; last use was the convolution are released at the same logical boundary.
Procedure DConvThenAdd(Y.i,T.i,C.i,Order.i,ConvNode.i,ReleaseMask.i)
 Protected a.i=DCall(1),w.i=DCall(2),b.i=DCall(3),at.i,ow.i,addNode.i=DNode,fast.i=0
 CompilerIf #PMD_NATIVE_BYTES=8 And #PMO_USE_INT8=1
 If Dt(a)\Kind=1 And (Dt(w)\Kind=3 Or Dt(w)\Kind=33) And Dt(C)\Kind=1 And Dt(a)\Rank=3 And Dt(w)\Rank=3 And Dt(C)\Rank=3 And DCall(6)>0 And DCall(8)>0
  ow=(DDims(a*8+2)+DCall(4)+DCall(5)-DCall(7)*(DDims(w*8+2)-1)-1)/DCall(6)+1
  If ow>0 And DDims(C*8)=DDims(a*8) And DDims(C*8+1)=DDims(w*8) And DDims(C*8+2)=ow
   fast=1 : PmConvAddBase=Dt(C)\Data : PmConvAddOrder=Order : DCall(0)=Y
  EndIf
 EndIf
 CompilerEndIf
 DNode=ConvNode : DConv()
 CompilerIf #PMD_NATIVE_BYTES=8 And #PMO_USE_INT8=1
 PmConvAddBase=0 : PmConvAddOrder=0
 CompilerEndIf
 DCall(0)=T
 If DError Or DCancel : ProcedureReturn : EndIf
 If ReleaseMask & 1 : DRelease(a) : EndIf
 If ReleaseMask & 2 : DRelease(w) : EndIf
 If ReleaseMask & 4 : DRelease(b) : EndIf
 DNode=addNode
 If fast : ProcedureReturn : EndIf
 If Order=0 : DBinary(Y,T,C,0) : Else : DBinary(Y,C,T,0) : EndIf
EndProcedure

Procedure DConvTranspose()
  Protected allocated.i
  Protected Y.i=DCall(0)
  Protected A.i=DCall(1)
  Protected W.i=DCall(2)
  Protected B.i=DCall(3)
  Protected PadLeft.i=DCall(4)
  Protected PadRight.i=DCall(5)
  Protected Stride.i=DCall(6)
  Protected Dilation.i=DCall(7)
  Protected Groups.i=DCall(8)
  Protected OutputPad.i=DCall(9)
  Protected g.PmTensorConvTranspose1DArgs
  DZero(@g,SizeOf(PmTensorConvTranspose1DArgs))
  If Dt(A)\Kind<>1 Or Dt(W)\Kind<>1 Or (B<>0 And Dt(B)\Kind<>1)
    DFail("Transposed Conv requires FLOAT tensors.")
    ProcedureReturn
  EndIf
  If Dt(A)\Rank<>3 Or Dt(W)\Rank<>3 Or Stride<=0 Or Groups<=0
    DFail("Invalid transposed convolution.")
    ProcedureReturn
  EndIf
  g\Batches=DDims((A)*8+(0))
  g\InChannels=DDims((A)*8+(1))
  g\InWidth=DDims((A)*8+(2))
  g\OutChannels=DDims((W)*8+(1))*Groups
  g\Kernel=DDims((W)*8+(2))
  g\OutWidth=(g\InWidth-1)*Stride-PadLeft-PadRight+Dilation*(g\Kernel-1)+1+OutputPad
  If g\InChannels<>DDims((W)*8+(0)) Or (g\InChannels % Groups)<>0
    DFail("Transposed Conv channel mismatch.")
    ProcedureReturn
  EndIf
  If B<>0 And Dt(B)\Count<>g\OutChannels
    DFail("Transposed Conv bias width mismatch.")
    ProcedureReturn
  EndIf
  If g\InChannels>0 And g\InWidth>0 And g\Kernel>0 And Dilation>0
    allocated=DShapeOverwrite(Y,1,3,g\Batches,g\OutChannels,g\OutWidth,0)
  Else
    allocated=DShape(Y,1,3,g\Batches,g\OutChannels,g\OutWidth,0)
  EndIf
  If allocated=0
    ProcedureReturn
  EndIf
  g\Src=Dt(A)\Data
  g\Weight=Dt(W)\Data
  g\Bias=Dt(B)\Data
  g\Dst=Dt(Y)\Data
  g\PadLeft=PadLeft
  g\Stride=Stride
  g\Dilation=Dilation
  g\Groups=Groups
  If PmFastConvTranspose(@g,DLimit-DLive)=0
    DFail("Transposed convolution scratch exceeds available working memory.")
  EndIf
EndProcedure

CompilerIf #PMD_NATIVE_BYTES=8
Global Dim PmResizeParts.i[32]
Procedure.i PmResizeWorker(*p.i)
  If PmTensorResize1DExactA64(*p) : ProcedureReturn 0 : EndIf
  PmTensorResize1D(PeekI(*p),PeekI(*p+8),PeekI(*p+16),PeekI(*p+24),PeekI(*p+32),PeekI(*p+40),PeekI(*p+48),DReadF(*p+56))
  ProcedureReturn 0
EndProcedure
CompilerEndIf
Procedure PmResizeRows(src.i,dst.i,rows.i,inWidth.i,outWidth.i,mode.i,coordinate.i,scale.f)
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected parts.i=1
  Protected i.i
  Protected first.i=0
  Protected last.i
  Protected at.i
  If rows>=8 And rows*outWidth>=16384
    parts=PmParallelCores() : If parts>4 : parts=4 : EndIf
  EndIf
  If parts>1
    For i=0 To parts-1
      last=rows*(i+1)/parts : at=i*8
      PmResizeParts[at]=src+first*inWidth*4 : PmResizeParts[at+1]=dst+first*outWidth*4
      PmResizeParts[at+2]=last-first : PmResizeParts[at+3]=inWidth : PmResizeParts[at+4]=outWidth
      PmResizeParts[at+5]=mode : PmResizeParts[at+6]=coordinate : DWriteF(@PmResizeParts[at+7],scale)
      first=last
    Next
    If pmSvcParRun(@PmResizeWorker,@PmResizeParts[0],64,parts)=#PMP_SVC_OK : ProcedureReturn : EndIf
  EndIf
  CompilerEndIf
  CompilerIf #PMD_NATIVE_BYTES=8
  PmResizeParts[0]=src : PmResizeParts[1]=dst : PmResizeParts[2]=rows
  PmResizeParts[3]=inWidth : PmResizeParts[4]=outWidth : PmResizeParts[5]=mode
  PmResizeParts[6]=coordinate : DWriteF(@PmResizeParts[7],scale)
  If PmTensorResize1DExactA64(@PmResizeParts[0]) : ProcedureReturn : EndIf
  CompilerEndIf
  PmTensorResize1D(src,dst,rows,inWidth,outWidth,mode,coordinate,scale)
EndProcedure

Procedure DResize(Y.i,A.i,Scales.i,Sizes.i,Mode.i,Coordinate.i)
  Protected Dim dims.i(8)
  Protected i.i=0
  Protected last.i=Dt(A)\Rank-1
  Protected scale.f=0.0
  DZero(@dims(0),8*#PMD_NATIVE_BYTES)
  If last<0 Or Dt(A)\Kind<>1
    DFail("Resize requires a FLOAT tensor with an axis.")
    ProcedureReturn
  EndIf
  For i=0 To last
    If Sizes
      dims(i)=DInt(Sizes,i)
    Else
      dims(i)=Int(DFloat(DDims((A)*8+(i)))*DGet(Scales,i))
    EndIf
    If i<last And dims(i)<>DDims((A)*8+(i))
      DFail("Resize supports the final axis only.")
      ProcedureReturn
    EndIf
  Next
  If DDims((A)*8+(last))<=0 Or dims(last)<=0
    DFail("Resize has an empty width.")
    ProcedureReturn
  EndIf
  scale=DFloat(dims(last))/DFloat(DDims((A)*8+(last)))
  If Scales
    scale=DGet(Scales,last)
  EndIf
  If DAllocOverwrite(Y,1,Dt(A)\Rank,@dims(0))
    PmResizeRows(Dt(A)\Data,Dt(Y)\Data,DProduct(A,0,last-1),DDims((A)*8+(last)),dims(last),Mode,Coordinate,scale)
  EndIf
EndProcedure

Procedure DLstm()
  Protected Y.i=DCall(0)
  Protected YH.i=DCall(1)
  Protected YC.i=DCall(2)
  Protected X.i=DCall(3)
  Protected W.i=DCall(4)
  Protected R.i=DCall(5)
  Protected B.i=DCall(6)
  Protected Seq.i=DCall(7)
  Protected IH.i=DCall(8)
  Protected IC.i=DCall(9)
  Protected Hidden.i=DCall(10)
  Protected Directions.i=DCall(11)
  Protected g.PmTensorLstmArgs
  Protected seq64.i=0
  Protected i.i=0
  Protected valid.i=0
  Protected seqBytes.i=0
  DZero(@g,SizeOf(PmTensorLstmArgs))
  If Dt(X)\Rank<>3 Or Dt(W)\Rank<>3 Or Dt(R)\Rank<>3 Or Dt(X)\Kind<>1 Or (Dt(W)\Kind<>1 And Dt(W)\Kind<>3 And Dt(W)\Kind<>33) Or (Dt(R)\Kind<>1 And Dt(R)\Kind<>3 And Dt(R)\Kind<>33)
    DFail("LSTM requires FLOAT activations and rank-three FLOAT/INT8 weights.")
    ProcedureReturn
  EndIf
  g\Sequence=DDims((X)*8+(0))
  g\Batch=DDims((X)*8+(1))
  g\InputSize=DDims((X)*8+(2))
  g\Hidden=Hidden
  g\Directions=Directions
  If Hidden<=0 Or Hidden>4096 Or Directions<1 Or Directions>2
    DFail("LSTM dimensions are invalid.")
    ProcedureReturn
  EndIf
  If DDims((W)*8+(0))<>Directions Or DDims((W)*8+(1))<>4*Hidden Or DDims((W)*8+(2))<>g\InputSize Or DDims((R)*8+(0))<>Directions Or DDims((R)*8+(1))<>4*Hidden Or DDims((R)*8+(2))<>Hidden
    DFail("LSTM weight dimensions do not match the input and hidden state.")
    ProcedureReturn
  EndIf
  If B<>0 And (Dt(B)\Kind<>1 Or Dt(B)\Count<>Directions*8*Hidden)
    DFail("LSTM bias dimensions are invalid.")
    ProcedureReturn
  EndIf
  If Seq<>0 And (Dt(Seq)\Kind<>6 Or Dt(Seq)\Count<>g\Batch)
    DFail("LSTM sequence lengths must be INT32 per batch.")
    ProcedureReturn
  EndIf
  If IH<>0 And (Dt(IH)\Kind<>1 Or Dt(IH)\Count<>Directions*g\Batch*Hidden)
    DFail("LSTM initial hidden state is invalid.")
    ProcedureReturn
  EndIf
  If IC<>0 And (Dt(IC)\Kind<>1 Or Dt(IC)\Count<>Directions*g\Batch*Hidden)
    DFail("LSTM initial cell state is invalid.")
    ProcedureReturn
  EndIf
  If DShape(Y,1,4,g\Sequence,Directions,g\Batch,Hidden)=0
    ProcedureReturn
  EndIf
  If DShape(YH,1,3,Directions,g\Batch,Hidden,0)=0
    ProcedureReturn
  EndIf
  If DShape(YC,1,3,Directions,g\Batch,Hidden,0)=0
    ProcedureReturn
  EndIf
  g\X=Dt(X)\Data
  g\W=Dt(W)\Data
  g\R=Dt(R)\Data
  g\B=Dt(B)\Data
  g\SeqLens=Dt(Seq)\Data
  g\InitialH=Dt(IH)\Data
  g\InitialC=Dt(IC)\Data
  g\Y=Dt(Y)\Data
  g\YH=Dt(YH)\Data
  g\YC=Dt(YC)\Data
  If 1 ; portable scalar LSTM consumes INT64 sequence metadata for both precisions
    If (Dt(W)\Kind<>1 And Dt(W)\Scales=0) Or (Dt(R)\Kind<>1 And Dt(R)\Scales=0) Or g\InputSize>133144 Or (Dt(R)\Kind=3 And g\Hidden>133144)
      DFail("INT8 LSTM scales are missing or reduction is too large.")
      ProcedureReturn
    EndIf
    ; the kernels read sequence_lens as INT32
    If Seq
      For i=0 To g\Batch-1
        valid=PeekL(Dt(Seq)\Data+i*4)
        If valid<0 Or valid>g\Sequence
          DFail("LSTM sequence length is out of bounds.")
          ProcedureReturn
        EndIf
      Next
    EndIf
    If Dt(W)\Kind=1 And Dt(R)\Kind=1
      If DScratchBegin(g\X,g\InputSize,g\Hidden)
        g\WScales=Dt(W)\Scales
        g\RScales=Dt(R)\Scales
        PmFastLstm(@g)
        DScratchEnd()
      EndIf
    Else
      g\WScales=Dt(W)\Scales : g\WWide=Bool(Dt(W)\Kind=33)
      g\RScales=Dt(R)\Scales : g\RWide=Bool(Dt(R)\Kind=33)
      CompilerIf #PMD_NATIVE_BYTES=8
      i=g\Directions
      CompilerElse
      i=1
      CompilerEndIf
      If DInt8Begin(PmI8LstmScratchBytes(g\InputSize,g\Hidden,g\WWide,g\RWide)*i)
        PmFastLstm(@g)
        DInt8End()
      EndIf
    EndIf
  Else
    PmFastLstm(@g)
  EndIf
EndProcedure

Procedure DStft(Y.i,A.i,StepTensor.i,Window.i,LengthTensor.i,OneSided.i)
  Protected g.PmTensorStftArgs
  Protected complex.i=1
  Protected extra.i=0
  DZero(@g,SizeOf(PmTensorStftArgs))
  If Dt(A)\Kind<>1 Or Dt(A)\Rank<2 Or Dt(A)\Rank>3
    DFail("STFT requires real FLOAT batches.")
    ProcedureReturn
  EndIf
  If Dt(A)\Rank=3 And DDims((A)*8+(2))<>1
    DFail("Complex STFT input is not implemented.")
    ProcedureReturn
  EndIf
  g\Batches=DDims((A)*8+(0))
  g\SignalLength=DDims((A)*8+(1))
  g\FrameStep=DInt(StepTensor,0)
  If LengthTensor
    g\FrameLength=DInt(LengthTensor,0)
  Else
    g\FrameLength=Dt(Window)\Count
  EndIf
  If g\FrameStep<=0 Or g\FrameLength<=0 Or g\FrameLength>65536
    DFail("STFT frame parameters are invalid.")
    ProcedureReturn
  EndIf
  If Window<>0 And (Dt(Window)\Kind<>1 Or Dt(Window)\Count<>g\FrameLength)
    DFail("STFT window length/type mismatch.")
    ProcedureReturn
  EndIf
  g\Frames=(g\SignalLength-g\FrameLength)/g\FrameStep+1
  g\Bins=g\FrameLength
  If OneSided
    g\Bins=g\FrameLength/2+1
  EndIf
  If DShape(Y,1,4,g\Batches,g\Frames,g\Bins,2)=0
    ProcedureReturn
  EndIf
  While complex<2*g\FrameLength-1
    complex*2
  Wend
  ; The A64 driver needs its per-stage root tables beside the ten planes the
  ; reference lays out, and they are sized HERE with the kernel's own
  ; function so the layout has one definition.  On every other target the
  ; extra is zero and the block is the size it always was.
  CompilerIf #PMD_NATIVE_BYTES=8
  extra=PmTensorStftRootWords(complex)*4
  CompilerEndIf
  If complex>(DLimit-DLive-extra)/40
    DFail("STFT scratch exceeds the working-memory limit.")
    ProcedureReturn
  EndIf
  g\ScratchComplex=complex
  g\Scratch=DAcquire(complex*40+extra)
  If g\Scratch=0
    DFail("STFT scratch allocation failed.")
    ProcedureReturn
  EndIf
  g\Signal=Dt(A)\Data
  g\Window=Dt(Window)\Data
  g\Dst=Dt(Y)\Data
  ; The A64 driver is PmTensorStft with the two per-frame transforms and the
  ; setup transform on the blocked butterfly path; its per-stage root tables
  ; live in the EXTRA words sized above, immediately after the ten planes the
  ; reference uses, so there is one definition of that layout.  Everything
  ; else in it is the reference's own lines and its answer is the same bits.
  CompilerIf #PMD_NATIVE_BYTES=8
  If PmTensorStftFp32Neon(@g)=0
    DFail("STFT execution failed.")
  EndIf
  CompilerElse
  If PmTensorStft(@g)=0
    DFail("STFT execution failed.")
  EndIf
  CompilerEndIf
  DFree(g\Scratch)
EndProcedure

; Shape start/end, Conv and ConvTranspose auto_pad SAME, ScatterND reductions.
XIncludeFile "tensor_dynamic_forms_portable.pmi"

; Adjacent single-use Sin/Cos and square retain both FP32 rounding steps.
CompilerIf #PMD_NATIVE_BYTES=8
Procedure.i PmTrigSquareRange(src.i,dst.i,count.i,op.i)
 Protected Dim scratch.i[128]
 Protected first.i=0,take.i
 While first<count
  If DCancel<>0 Or DError<>0 : ProcedureReturn 0 : EndIf
  PmKernelIdle()
  take=count-first : If take>256 : take=256 : EndIf
  PmFastTrig(src+first*4,@scratch[0],take,op)
  If PmTensorTrigOk=0 : ProcedureReturn 0 : EndIf
  PmTensorSquareExactNeon(@scratch[0],dst+first*4,take,1)
  first=first+take
 Wend
 ProcedureReturn 1
EndProcedure
Global Dim PmTrigSquareParts.i[16]
Procedure.i PmTrigSquareWorker(*p.i)
 If PmTrigSquareRange(PeekI(*p),PeekI(*p+8),PeekI(*p+16),PeekI(*p+24))=0 : ProcedureReturn 1 : EndIf
 ProcedureReturn 0
EndProcedure
Procedure.i PmTrigSquareDispatch(src.i,dst.i,count.i,op.i)
 Protected parts.i=1,i.i,first.i=0,last.i,at.i
 If count>=16384 : parts=PmParallelCores() : If parts>4 : parts=4 : EndIf : EndIf
 If parts>1
  For i=0 To parts-1
   last=count : If i<parts-1 : last=(count*(i+1)/parts)/16*16 : EndIf
   at=i*4
   PmTrigSquareParts[at]=src+first*4 : PmTrigSquareParts[at+1]=dst+first*4
   PmTrigSquareParts[at+2]=last-first : PmTrigSquareParts[at+3]=op
   first=last
  Next
  If pmSvcParRun(@PmTrigSquareWorker,@PmTrigSquareParts[0],32,parts)<>#PMP_SVC_OK : ProcedureReturn 0 : EndIf
  ProcedureReturn Bool(DError=0 And DCancel=0 And PmTensorTrigOk<>0)
 EndIf
 ProcedureReturn PmTrigSquareRange(src,dst,count,op)
EndProcedure
CompilerEndIf
Procedure DTrigThenSquare(Y.i,T.i,A.i,B.i,op.i,UnaryNode.i,releaseA.i)
 Protected powNode.i=DNode
 DNode=UnaryNode
 CompilerIf #PMD_NATIVE_BYTES=8
 If Y<>T And Y<>A And Y<>B And T<>A And T<>B And Dt(T)\Data=0 And Dt(A)\Kind=1 And Dt(B)\Kind=1 And Dt(B)\Count=1 And Dt(B)\Data<>0 And (op=5 Or op=6)
  If PeekL(Dt(B)\Data)=$40000000
   If DLikeOverwrite(Y,A,0)=0 : ProcedureReturn : EndIf
   If PmTrigSquareDispatch(Dt(A)\Data,Dt(Y)\Data,Dt(A)\Count,op-5)=0
    If DError=0 And DCancel=0 : DFail("Parallel trigonometric square did not complete.") : EndIf
    ProcedureReturn
   EndIf
   If releaseA : DRelease(A) : EndIf
   DNode=powNode
   ProcedureReturn
  EndIf
 EndIf
 CompilerEndIf
 DUnary(T,A,op,0.0)
 If DError<>0 Or DCancel<>0 : ProcedureReturn : EndIf
 If releaseA : DRelease(A) : EndIf
 DNode=powNode
 DBinary(Y,T,B,4)
EndProcedure
