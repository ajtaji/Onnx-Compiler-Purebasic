; ======================================================================
; tensor_dynamic_ops_portable.pmi - the portable adapter of
; tensor_dynamic_ops.pmi: how a runtime-dimension tensor's extent is read
; in this dialect. Include tensor_dynamic_portable.pmi and tensor_ops.pmi
; first, tensor_dynamic_ops.pmi after.
; ======================================================================
Procedure.i DOpDim(Id.i, Axis.i)
  ProcedureReturn DDims(Id * 8 + Axis)
EndProcedure



Procedure DOpUnaryChunk(src.i,dst.i,count.i,op.i,kind.i)
 CompilerIf #PMD_NATIVE_BYTES=8
 Protected done.i
 If op=13 And kind=1 And count>=4
  done=PmOpGeluVectorA64(src,dst,count)
  PmOpUnary(src+done*4,dst+done*4,count-done,op,kind)
  ProcedureReturn
 EndIf
 If op=6 And kind=1 And count>=4
  done=PmOpEluVectorA64(src,dst,count,PeekL(@PmOpF(0)))
  PmOpUnary(src+done*4,dst+done*4,count-done,op,kind)
  ProcedureReturn
 EndIf
 CompilerEndIf
 PmOpUnary(src,dst,count,op,kind)
EndProcedure

; Nonlinear unary kernels use read-only coefficients and node attributes
; during execution. Split independent elements, preserving scalar arithmetic.
CompilerIf #PMD_NATIVE_BYTES=8
Global Dim DOpUnaryParts.i[20]
Procedure.i DOpUnaryWorker(p.i)
 Protected src.i=PeekI(p),dst.i=PeekI(p+8),count.i=PeekI(p+16),op.i=PeekI(p+24),kind.i=PeekI(p+32)
 Protected at.i,take.i
 While at<count
  take=count-at : If take>128 : take=128 : EndIf
  DOpUnaryChunk(src+at*4,dst+at*4,take,op,kind)
  PmKernelIdle()
  at+take
 Wend
 ProcedureReturn 0
EndProcedure
CompilerEndIf
Procedure DOpRunUnary(src.i,dst.i,count.i,op.i,kind.i)
 If (op=6 Or op=13) And kind=1 : PmOpInit() : EndIf
 CompilerIf #PMD_NATIVE_BYTES=8
 Protected parts.i=1,i.i,first.i,last.i,at.i
 If kind=1 And (op=0 Or op=6 Or op=12 Or op=13) And count>=1024
  PmOpInit() : PmOpTrigInit()
  parts=PmParallelCores() : If parts>4 : parts=4 : EndIf
  If parts>1
   For i=0 To parts-1
    last=count : If i<parts-1 : last=(count*(i+1)/parts)/16*16 : EndIf
    at=i*5 : DOpUnaryParts[at]=src+first*4 : DOpUnaryParts[at+1]=dst+first*4
    DOpUnaryParts[at+2]=last-first : DOpUnaryParts[at+3]=op : DOpUnaryParts[at+4]=kind
    first=last
   Next
   If pmSvcParRun(@DOpUnaryWorker,@DOpUnaryParts[0],40,parts)=#PMP_SVC_OK : ProcedureReturn : EndIf
  EndIf
 EndIf
 CompilerEndIf
 DOpUnaryChunk(src,dst,count,op,kind)
EndProcedure
