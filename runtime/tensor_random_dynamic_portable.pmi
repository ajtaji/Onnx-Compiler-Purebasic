; ======================================================================
; tensor_random_dynamic_portable.pmi - runtime-dimension wrappers for the
; ONNX random operators on the portable targets (Pi 4, UNO Q, Pico, Pico 2).
; The generator and its contract live in tensor_random.pmi; this is the
; portable twin of tensor_random_dynamic_windows.pbi and differs only in how
; a dimension is read and in its fixed error texts.
;
; Kind: bit 0 is the distribution (0 uniform, 1 normal). Bit 1 says the node
; has no dtype attribute, so ONNX takes the output type from the input, and
; only a FLOAT input is accepted.
; ======================================================================

Global Dim PmRandomDims.i(8)

CompilerIf #PMD_NATIVE_BYTES=8
Global Dim PmRandomParts.i[40]
Global Dim PmRandomConstants.l[22]
Procedure.i PmRandomRangeA64(dst.i,first.i,count.i,node.i,hasSeed.i,seedBits.i,kind.i,p1Bits.i,p2Bits.i,request.i)
  Protected Dim normalArgs.i[9]
  Protected words.PmRandomPair
  Protected n0.i
  Protected n1.i
  Protected i.i
  Protected m.i
  Protected p1.f
  Protected p2.f
  Protected span.f
  Protected u.f
  Protected z.f
  Protected value.f
  PokeL(@p1,p1Bits) : PokeL(@p2,p2Bits)
  If hasSeed
    PmRandomThreefryA64(seedBits,0,node,1,@words)
  Else
    PmRandomThreefryA64(PmRandomModelSeed,0,node,0,@words)
  EndIf
  n0=words\Lo & $FFFFFFFF : n1=words\Hi & $FFFFFFFF
  span=p2-p1
  i=0
  If kind=0 : i=PmRandomUniformFourA64(dst,first,count,n0,n1,request,p1Bits,p2Bits) : EndIf
  If kind=1
    normalArgs[0]=dst : normalArgs[1]=first : normalArgs[2]=count
    normalArgs[3]=n0 : normalArgs[4]=n1 : normalArgs[5]=request
    normalArgs[6]=@PmRandomConstants[0] : normalArgs[7]=p1Bits : normalArgs[8]=p2Bits
    i=PmRandomNormalFourA64(@normalArgs[0])
  EndIf
  For i=i To count-1
    If (i & 1023)=0 : PmKernelIdle() : EndIf
    PmRandomThreefryA64(n0,n1,first+i,request,@words)
    If kind=0
      m=((words\Lo & $FFFFFFFF)>>8)&$FFFFFF : u=m : u=u*PmRandomTwoM24
      value=span*u : value=p1+value
    Else
      PokeL(@z,PmRandomNormalBitsA64(words\Lo,words\Hi,@PmRandomConstants[0]))
      value=p2*z : value=p1+value
    EndIf
    PokeL(dst+i*4,PeekL(@value))
  Next
  ProcedureReturn 1
EndProcedure
Procedure.i PmRandomWorker(*p.i)
  If PmRandomRangeA64(PeekI(*p),PeekI(*p+8),PeekI(*p+16),PeekI(*p+24),PeekI(*p+32),PeekI(*p+40),PeekI(*p+48),PeekI(*p+56),PeekI(*p+64),PeekI(*p+72))=0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure
CompilerEndIf

CompilerIf #PMD_NATIVE_BYTES=8
; Independent counter ranges; each synchronous job is complete on return.
Procedure.i PmRandomRangeParallel(dst.i,first.i,count.i,node.i,hasSeed.i,seedBits.i,kind.i,low.i,high.i,request.i)
  Protected parts.i=1,i.i,begin.i=0,last.i,at.i
  If first<0 Or count<0 Or first>$FFFFFFFF Or count>$100000000-first : ProcedureReturn 0 : EndIf
  If count=0 : ProcedureReturn 1 : EndIf
  PmRandomInit()
  If kind & 1
    PmRandomConstants[0]=PeekL(@PmRandomTwoM24)
    PmRandomConstants[1]=PeekL(@PmRandomLn2)
    PmRandomConstants[2]=PeekL(@PmRandomSqrt2)
    PmRandomConstants[3]=PeekL(@PmRandomTheta)
    PmRandomConstants[4]=PeekL(@PmRandomC3)
    PmRandomConstants[5]=PeekL(@PmRandomC5)
    PmRandomConstants[6]=PeekL(@PmRandomC7)
    PmRandomConstants[7]=PeekL(@PmRandomC9)
    PmRandomConstants[8]=PeekL(@PmRandomH6)
    PmRandomConstants[9]=PeekL(@PmRandomH24)
    PmRandomConstants[10]=PeekL(@PmRandomH120)
    PmRandomConstants[11]=PeekL(@PmRandomH720)
    PmRandomConstants[12]=PeekL(@PmRandomH5040)
    PmRandomConstants[13]=PeekL(@PmRandomH40320)
    PmRandomConstants[14]=PeekL(@PmRandomH362880)
    PmRandomConstants[15]=PeekL(@PmRandomH3628800)
    PmRandomConstants[16]=$3F800000
    PmRandomConstants[17]=$3F000000
    PmRandomConstants[18]=$3E800000
    PmRandomConstants[19]=$40800000
    PmRandomConstants[20]=$3EC00000
    PmRandomConstants[21]=$3F400000
  EndIf
  If count>=4096
    parts=PmParallelCores() : If parts>4 : parts=4 : EndIf
  EndIf
  If parts>1
    For i=0 To parts-1
      last=count*(i+1)/parts : at=i*10
      PmRandomParts[at]=dst+begin*4 : PmRandomParts[at+1]=first+begin
      PmRandomParts[at+2]=last-begin : PmRandomParts[at+3]=node
      PmRandomParts[at+4]=hasSeed : PmRandomParts[at+5]=seedBits : PmRandomParts[at+6]=kind & 1
      PmRandomParts[at+7]=low : PmRandomParts[at+8]=high : PmRandomParts[at+9]=request
      begin=last
    Next
    If pmSvcParRun(@PmRandomWorker,@PmRandomParts[0],80,parts)=#PMP_SVC_OK : ProcedureReturn 1 : EndIf
  EndIf
  ProcedureReturn PmRandomRangeA64(dst,first,count,node,hasSeed,seedBits,kind & 1,low,high,request)
EndProcedure
CompilerEndIf

Procedure.i DRandomFill(Y.i,Node.i,HasSeed.i,SeedBits.i,Kind.i,P1Bits.i,P2Bits.i)
  CompilerIf #PMD_NATIVE_BYTES=8
  Protected parts.i=1
  Protected count.i=Dt(Y)\Count
  Protected first.i=0
  Protected last.i
  Protected i.i
  Protected at.i
  If count>=16384 And ((count >> 16) >> 16)=0
    parts=PmParallelCores()
    If parts>4 : parts=4 : EndIf
  EndIf
  If parts>1
    PmRandomInit()
    PmRandomConstants[0]=PeekL(@PmRandomTwoM24)
    PmRandomConstants[1]=PeekL(@PmRandomLn2)
    PmRandomConstants[2]=PeekL(@PmRandomSqrt2)
    PmRandomConstants[3]=PeekL(@PmRandomTheta)
    PmRandomConstants[4]=PeekL(@PmRandomC3)
    PmRandomConstants[5]=PeekL(@PmRandomC5)
    PmRandomConstants[6]=PeekL(@PmRandomC7)
    PmRandomConstants[7]=PeekL(@PmRandomC9)
    PmRandomConstants[8]=PeekL(@PmRandomH6)
    PmRandomConstants[9]=PeekL(@PmRandomH24)
    PmRandomConstants[10]=PeekL(@PmRandomH120)
    PmRandomConstants[11]=PeekL(@PmRandomH720)
    PmRandomConstants[12]=PeekL(@PmRandomH5040)
    PmRandomConstants[13]=PeekL(@PmRandomH40320)
    PmRandomConstants[14]=PeekL(@PmRandomH362880)
    PmRandomConstants[15]=PeekL(@PmRandomH3628800)
    PmRandomConstants[16]=$3F800000
    PmRandomConstants[17]=$3F000000
    PmRandomConstants[18]=$3E800000
    PmRandomConstants[19]=$40800000
    PmRandomConstants[20]=$3EC00000
    PmRandomConstants[21]=$3F400000
    For i=0 To parts-1
      last=count
      If i<parts-1 : last=(count*(i+1)/parts)/16*16 : EndIf
      at=i*10
      PmRandomParts[at]=Dt(Y)\Data+first*4
      PmRandomParts[at+1]=first
      PmRandomParts[at+2]=last-first
      PmRandomParts[at+3]=Node
      PmRandomParts[at+4]=HasSeed
      PmRandomParts[at+5]=SeedBits
      PmRandomParts[at+6]=Kind & 1
      PmRandomParts[at+7]=P1Bits
      PmRandomParts[at+8]=P2Bits
      PmRandomParts[at+9]=PmRandomRequest
      first=last
    Next
    If pmSvcParRun(@PmRandomWorker,@PmRandomParts[0],80,parts)=#PMP_SVC_OK
      ProcedureReturn 1
    EndIf
  EndIf
  CompilerEndIf
  If PmRandomNodeBits(Dt(Y)\Data,Dt(Y)\Count,Node,HasSeed,SeedBits,Kind & 1,P1Bits,P2Bits)=0
    ProcedureReturn DFail("A random tensor has more than 4294967295 elements; the generator numbers elements with 32 bits. Check the shape feeding this node.")
  EndIf
  ProcedureReturn 1
EndProcedure

; RandomUniformLike / RandomNormalLike: the output takes the input's shape.
Procedure DRandomLike(Y.i,A.i,Node.i,HasSeed.i,SeedBits.i,Kind.i,P1Bits.i,P2Bits.i)
  If (Kind & 2)<>0 And Dt(A)\Kind<>1
    If (Kind & 1)=0
      DFail("RandomUniformLike has no dtype attribute, so its output would take the input's element type, which is not FLOAT; only FLOAT (1) random tensors are generated. Add dtype=1 to the node.")
    Else
      DFail("RandomNormalLike has no dtype attribute, so its output would take the input's element type, which is not FLOAT; only FLOAT (1) random tensors are generated. Add dtype=1 to the node.")
    EndIf
    ProcedureReturn
  EndIf
  If DLikeOverwrite(Y,A,1)=0
    ProcedureReturn
  EndIf
  DRandomFill(Y,Node,HasSeed,SeedBits,Kind,P1Bits,P2Bits)
EndProcedure

; RandomUniform / RandomNormal: the shape attribute, copied into PmRandomDims
; by the generated lines before the call.
Procedure DRandomShape(Y.i,Rank.i,Node.i,HasSeed.i,SeedBits.i,Kind.i,P1Bits.i,P2Bits.i)
  If DAllocOverwrite(Y,1,Rank,@PmRandomDims(0))=0
    ProcedureReturn
  EndIf
  DRandomFill(Y,Node,HasSeed,SeedBits,Kind,P1Bits,P2Bits)
EndProcedure

; Comparison mode: the caller supplied this node's tensor as a model input.
; A is the Like node's input (0 for the shape-attribute operators, whose
; shape is in PmRandomDims). The tensor must be FLOAT with the node's shape.
Procedure DRandomFed(Y.i,A.i,Rank.i)
  Protected i.i=0
  If Dt(Y)\Kind<>1
    DFail("A random node was compiled as a model input (--random-inputs) and its tensor was not supplied as FLOAT. Fill the input the manifest lists for this node before executing.")
    ProcedureReturn
  EndIf
  If A>0
    Rank=Dt(A)\Rank
  EndIf
  If Dt(Y)\Rank<>Rank
    DFail("A random node compiled as a model input (--random-inputs) was supplied with a rank different from the one the node produces. Supply the tensor with the node's shape.")
    ProcedureReturn
  EndIf
  For i=0 To Rank-1
    If A>0
      If DDims(Y*8+i)<>DDims(A*8+i)
        DFail("A random node compiled as a model input (--random-inputs) was supplied with an extent different from the one the node produces. Supply the tensor with the node's shape.")
        ProcedureReturn
      EndIf
    Else
      If DDims(Y*8+i)<>PmRandomDims(i)
        DFail("A random node compiled as a model input (--random-inputs) was supplied with an extent different from the one the node produces. Supply the tensor with the node's shape.")
        ProcedureReturn
      EndIf
    EndIf
  Next
EndProcedure

; Bernoulli: Y takes X's shape and Kind (the dtype attribute, or FLOAT when
; the node has none); X must be FLOAT.
Procedure DRandomBernoulli(Y.i,X.i,Node.i,HasSeed.i,SeedBits.i,Kind.i)
  If Dt(X)\Kind<>1
    DFail("Bernoulli takes FLOAT probabilities; its input has another element type.")
    ProcedureReturn
  EndIf
  If DLike(Y,X,Kind)=0
    ProcedureReturn
  EndIf
  If PmRandomBernoulli(Dt(X)\Data,Dt(Y)\Data,Dt(Y)\Count,Node,HasSeed,SeedBits,Kind)=0
    DFail("A random tensor has more than 4294967295 elements; the generator numbers elements with 32 bits. Check the shape feeding this node.")
  EndIf
EndProcedure

; Multinomial, first half: Y shaped [batch, Samples] of Kind and filled with
; the node's uniform draws as FLOAT; DOpMultinomialPick (tensor_dynamic_ops.pmi)
; turns them into class indices. Returns 0 after a refusal.
Procedure.i DRandomMultinomial(Y.i,X.i,Node.i,HasSeed.i,SeedBits.i,Samples.i,Kind.i)
  If Dt(X)\Kind<>1 Or Dt(X)\Rank<>2
    ProcedureReturn DFail("Multinomial takes a FLOAT input of shape [batch_size, class_size].")
  EndIf
  If DDims(X*8+1)<1
    ProcedureReturn DFail("Multinomial's input has no classes (class_size 0).")
  EndIf
  PmRandomDims(0)=DDims(X*8)
  PmRandomDims(1)=Samples
  If DAlloc(Y,Kind,2,@PmRandomDims(0))=0
    ProcedureReturn 0
  EndIf
  If PmRandomUniformDraws(Dt(Y)\Data,Dt(Y)\Count,Node,HasSeed,SeedBits)=0
    ProcedureReturn DFail("A random tensor has more than 4294967295 elements; the generator numbers elements with 32 bits. Check the shape feeding this node.")
  EndIf
  ProcedureReturn 1
EndProcedure

; Comparison mode for Bernoulli and Multinomial: the caller supplied the
; node's tensor. It must have the node's element type Kind and, for
; Bernoulli (Samples 0), X's shape; for Multinomial [X's first extent, Samples].
Procedure DRandomFedKind(Y.i,X.i,Samples.i,Kind.i)
  Protected i.i=0
  Protected ok.i=1
  If Dt(Y)\Kind<>Kind
    DFail("A random node compiled as a model input (--random-inputs) was supplied with an element type other than the one the node produces. Supply the tensor with the node's element type.")
    ProcedureReturn
  EndIf
  If Samples=0
    If Dt(Y)\Rank<>Dt(X)\Rank
      ok=0
    Else
      For i=0 To Dt(X)\Rank-1
        If DDims(Y*8+i)<>DDims(X*8+i)
          ok=0
        EndIf
      Next
    EndIf
  ElseIf Dt(Y)\Rank<>2 Or Dt(X)\Rank<>2
    ok=0
  ElseIf DDims(Y*8)<>DDims(X*8) Or DDims(Y*8+1)<>Samples
    ok=0
  EndIf
  If ok=0
    DFail("A random node compiled as a model input (--random-inputs) was supplied with a shape other than the one the node produces. Supply the tensor with the node's shape.")
  EndIf
EndProcedure
